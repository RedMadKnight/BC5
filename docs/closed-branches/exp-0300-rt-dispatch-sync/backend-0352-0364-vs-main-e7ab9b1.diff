new file mode 100644
index 0000000..cc4697e
--- /dev/null
+++ b/backend/tests/indirect_check_batch_test.cpp
@@ -0,0 +1,165 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Experiment 0352: the batched CP check (bc5/indirect_check.hpp, ProductLimit::batch).
+#include "bc5/indirect_check.hpp"
+
+#include <catch2/catch_test_macros.hpp>
+
+#include <cstdint>
+#include <vector>
+
+namespace {
+
+constexpr std::uint32_t kCondWrite = 0xC0074500u;
+constexpr std::uint32_t kCondExec = 0xC0032200u;
+constexpr std::uint32_t kPfpSyncMe = 0xC0004200u;
+constexpr std::uint32_t kDispatch = 0xC0011600u; // PKT3(DISPATCH_INDIRECT, 1, 0), GFX form
+constexpr std::uint32_t kSetSh = 0xC0047600u;    // PKT3(SET_SH_REG, 4, 0): 6 dwords
+
+std::vector<std::uint32_t> chain(std::size_t n) {
+    std::vector<std::uint32_t> ib;
+    for (std::size_t k = 0; k < n; ++k) {
+        ib.insert(ib.end(), {kSetSh, 0x243u, 1u, 2u, 3u, 4u});
+        ib.insert(ib.end(), {kDispatch, static_cast<std::uint32_t>(0x1000 * (k + 1)), 0x61u});
+    }
+    return ib;
+}
+
+std::size_t count(const std::vector<std::uint32_t> &ib, std::uint32_t header) {
+    std::size_t n = 0;
+    for (std::size_t i = 0; i < ib.size();) {
+        const std::uint32_t h = ib[i];
+        std::size_t len = 1;
+        if (h >> 30 == 3 || h >> 30 == 0) {
+            const std::uint32_t c = (h >> 16) & 0x3fff;
+            len = c == 0x3fff ? 1 : c + 2;
+        }
+        if (h == header) n++;
+        i += len;
+    }
+    return n;
+}
+
+} // namespace
+
+TEST_CASE("indirect_check: a chain shares one ME phase in the batched form (experiment 0352)", "[indirect_check][batch]") {
+    const std::uint32_t max[3] = {1u << 20, 1024, 1024};
+    const std::uint32_t draw_max[2] = {1u << 22, 1024};
+    bc5::indirect_check::ProductLimit product;
+    product.batch = 256;
+    const auto ib = chain(3);
+    std::vector<std::size_t> refs;
+    bc5::indirect_check::Stats st;
+    const auto out = bc5::indirect_check::apply(ib, 0x1100000000ull, max, draw_max, refs, st, false, &product);
+    REQUIRE(st.checked == 3);
+    REQUIRE(st.batched == 3);
+    REQUIRE(st.batches == 1);
+    REQUIRE(st.product_checked == 3);
+    REQUIRE(st.flag_dwords == 12);
+    REQUIRE(count(out, kCondWrite) == 18);         // 6 per dispatch
+    REQUIRE(count(out, kCondExec) == 6);           // 2 per dispatch
+    REQUIRE(count(out, kPfpSyncMe) == 1);          // one for the chain
+    REQUIRE(count(out, kDispatch) == 3);
+    REQUIRE(out[6] == ((3u << 30) | (14u << 16) | (0x37u << 8))); // after the first SET_SH_REG: WRITE_DATA of 12 dwords, the flags
+    REQUIRE(out.size() == ib.size() + 4 + 12 + 18 * 9 + 5 + 2 + 6 * 5); // WRITE_DATA 4 + 12 data, 18 COND_WRITEs, confirm, sync, 6 COND_EXECs
+    REQUIRE(st.inserted_dwords == out.size() - ib.size());
+    // the per-dispatch growth: (4 + 12 + 162 + 7 + 30) / 3 = 71.7 here, 68 + the shared 10 / n in general
+    // flag refs: the WRITE_DATA's address, then per dispatch 3 at q*16 and 3 at q*16+8, the confirm, then 2 per dispatch
+    REQUIRE(refs.size() == 1 + 3 * 6 + 1 + 3 * 2);
+    std::vector<std::uint32_t> patched(out);
+    bc5::indirect_check::patch(patched, refs, 0x2000'0000'1000ull);
+    REQUIRE(patched[8] == 0x1000u);   // the WRITE_DATA's lo
+    REQUIRE(patched[9] == 0x2000u);   // hi
+    // the last COND_EXEC pair (dispatch 2): flag at +32, flagB at +40
+    const std::size_t last = out.size() - 3 - 5 - 5;
+    REQUIRE(patched[last] == kCondExec);
+    REQUIRE(patched[last + 1] == 0x1000u + 32);
+    REQUIRE(patched[last + 5] == kCondExec);
+    REQUIRE(patched[last + 6] == 0x1000u + 40);
+    // the staircase's restoring COND_WRITE: function 2 (<=), data 1
+    bool restore = false;
+    for (std::size_t i = 0; i + 8 < out.size(); ++i)
+        if (out[i] == kCondWrite && (out[i + 1] & 7) == 2 && out[i + 8] == 1) restore = true;
+    REQUIRE(restore);
+}
+
+TEST_CASE("indirect_check: a single dispatch keeps the per-dispatch form; a SET_BASE cuts a chain", "[indirect_check][batch]") {
+    const std::uint32_t max[3] = {1u << 20, 1024, 1024};
+    const std::uint32_t draw_max[2] = {1u << 22, 1024};
+    bc5::indirect_check::ProductLimit product;
+    product.batch = 256;
+    {
+        const auto ib = chain(1);
+        std::vector<std::size_t> refs;
+        bc5::indirect_check::Stats st;
+        const auto out = bc5::indirect_check::apply(ib, 0x1100000000ull, max, draw_max, refs, st, false, &product);
+        REQUIRE(st.checked == 1);
+        REQUIRE(st.batched == 0);
+        REQUIRE(st.batches == 0);
+        REQUIRE(st.flag_dwords == 8);
+        REQUIRE(out.size() == ib.size() + bc5::indirect_check::kCheckDwords + bc5::indirect_check::kProductDwords);
+    }
+    {
+        auto ib = chain(2);
+        ib.insert(ib.end(), {0xC0021100u, 1u, 0x40000000u, 0x11u}); // SET_BASE index 1 = 0x1140000000
+        const auto more = chain(3);
+        ib.insert(ib.end(), more.begin(), more.end());
+        std::vector<std::size_t> refs;
+        bc5::indirect_check::Stats st;
+        const auto out = bc5::indirect_check::apply(ib, 0x1100000000ull, max, draw_max, refs, st, false, &product);
+        REQUIRE(st.checked == 5);
+        REQUIRE(st.batched == 5);
+        REQUIRE(st.batches == 2);
+        REQUIRE(st.flag_dwords == 12);
+        REQUIRE(count(out, kPfpSyncMe) == 2);
+        REQUIRE(count(out, kCondExec) == 10);
+    }
+    {
+        auto ib = chain(5);
+        product.batch = 2; // chains of at most 2: 2 + 2 + a single
+        std::vector<std::size_t> refs;
+        bc5::indirect_check::Stats st;
+        const auto out = bc5::indirect_check::apply(ib, 0x1100000000ull, max, draw_max, refs, st, false, &product);
+        REQUIRE(st.checked == 5);
+        REQUIRE(st.batched == 4);
+        REQUIRE(st.batches == 2);
+        REQUIRE(count(out, kPfpSyncMe) == 2 + 2); // one per batch, two in the single's staircase form
+    }
+}
+
+TEST_CASE("indirect_check: batching off leaves the per-dispatch form unchanged", "[indirect_check][batch]") {
+    const std::uint32_t max[3] = {1u << 20, 1024, 1024};
+    const std::uint32_t draw_max[2] = {1u << 22, 1024};
+    bc5::indirect_check::ProductLimit product; // batch = 0
+    const auto ib = chain(3);
+    std::vector<std::size_t> refs;
+    bc5::indirect_check::Stats st;
+    const auto out = bc5::indirect_check::apply(ib, 0x1100000000ull, max, draw_max, refs, st, false, &product);
+    REQUIRE(st.checked == 3);
+    REQUIRE(st.batched == 0);
+    REQUIRE(st.flag_dwords == 8);
+    REQUIRE(out.size() == ib.size() + 3 * (bc5::indirect_check::kCheckDwords + bc5::indirect_check::kProductDwords));
+}
+
+TEST_CASE("indirect_check: the check emitted twice keeps its refs and skips (experiment 0352 arm C)", "[indirect_check][batch]") {
+    const std::uint32_t max[3] = {1u << 20, 1024, 1024};
+    const std::uint32_t draw_max[2] = {1u << 22, 1024};
+    bc5::indirect_check::ProductLimit product;
+    product.twice = true;
+    const auto ib = chain(2);
+    std::vector<std::size_t> refs;
+    bc5::indirect_check::Stats st;
+    const auto out = bc5::indirect_check::apply(ib, 0x1100000000ull, max, draw_max, refs, st, false, &product);
+    const std::size_t one = bc5::indirect_check::kCheckDwords + bc5::indirect_check::kProductDwords;
+    REQUIRE(st.checked == 2);
+    REQUIRE(out.size() == ib.size() + 2 * 2 * one);
+    REQUIRE(count(out, kCondWrite) == 2 * 2 * 6);
+    REQUIRE(count(out, kPfpSyncMe) == 2 * 2 * 2);
+    // the first copy's outer COND_EXEC (the last packet of the first copy) skips the second copy and the dispatch
+    const std::size_t first_end = 6 + one; // after the first SET_SH_REG
+    REQUIRE(out[first_end - 5] == kCondExec);
+    REQUIRE(out[first_end - 1] == one + 3);
+    REQUIRE(out[first_end + one - 5] == kCondExec);
+    REQUIRE(out[first_end + one - 1] == 3);
+    REQUIRE(refs.size() == 2 * 2 * 12);
+    for (std::size_t r : refs) REQUIRE(r + 1 < out.size());
+}
