+
+#include <cstdint>
+
+namespace {
+
+using namespace bc5::user_data_hint;
+
+TEST_CASE("a user-data offset under the title's window is the pointer the GPU will use", "[user_data_hint]") {
+    std::uint64_t out = 0;
+    REQUIRE(candidate(0x1100000000ull, 0x10e1d700u, &out));
+    CHECK(out == 0x1110e1d700ull); // F467: USER_DATA_6 of the faulting dispatch
+    REQUIRE(candidate(0x1100000000ull, 0x8c632100u, &out));
+    CHECK(out == 0x118c632100ull);
+    // the window's low dword, if any, does not leak into the address
+    REQUIRE(candidate(0x1100abcdefull, 0x722cf000u, &out));
+    CHECK(out == 0x11722cf000ull);
+}
+
+TEST_CASE("small dwords and a missing window are not candidates", "[user_data_hint]") {
+    std::uint64_t out = 7;
+    CHECK_FALSE(candidate(0x1100000000ull, 0x11u, &out)); // USER_DATA_5: the high dword itself
+    CHECK_FALSE(candidate(0x1100000000ull, 0x40011u, &out));  // R1: USER_DATA_1 = 0x40011, a small value
+    CHECK_FALSE(candidate(0x1100000000ull, 0x100011u, &out)); // R2: USER_DATA_9 = 0x100011, above the size test, not aligned
+    CHECK(candidate(0x1100000000ull, 0x100000u, &out));
+    CHECK_FALSE(candidate(0, 0x10e1d700u, &out));
+}
+
+TEST_CASE("the window asked for and the region key", "[user_data_hint]") {
+    const std::uint64_t addr = 0x1110e1d700ull;
+    CHECK(window_lo(addr, 32ull << 20u) == 0x1110e10000ull - (32ull << 20u));
+    CHECK(window_hi(addr, 32ull << 20u) == 0x1110e10000ull + (32ull << 20u));
+    CHECK(window_lo(0x100000ull, 32ull << 20u) == 0); // never below zero
+    CHECK(region_key(addr) == 0x1110000000ull);
+    CHECK(region_key(0x1113ffffffull) == 0x1110000000ull);
+    CHECK(region_key(0x1114000000ull) == 0x1114000000ull);
+}
+
+TEST_CASE("the user-data registers are the sixteen at SH 0x240", "[user_data_hint]") {
+    CHECK(is_user_data(0x240));
+    CHECK(is_user_data(0x24f));
+    CHECK_FALSE(is_user_data(0x23f));
+    CHECK_FALSE(is_user_data(0x250));
+}
