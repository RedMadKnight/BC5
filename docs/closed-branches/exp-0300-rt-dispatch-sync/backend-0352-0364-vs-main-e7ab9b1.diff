+++ b/backend/include/bc5/user_data_hint.hpp
@@ -0,0 +1,55 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Experiment 0364: compute user-data hints — the pure rule.
+//
+// The second title places its shaders' buffers in a 4-GiB window (exp 0346 learns its high dword from the title's
+// own SET_BASEs: 0x1100000000) and passes 32-bit offsets in COMPUTE_USER_DATA_n with the high dword in another
+// user-data register. A dispatch's first write into a region the host has not imported for the GPU (a lazy view
+// no earlier fault has learned) faults, hangs the ring for the kernel's timeout and is recovered by a ring reset
+// (F443, F467–F469). The hint turns such offsets into addresses before the dispatch runs, so the host imports the
+// region as its render-target hints do for CB/DB bases. This header holds what a unit test can check: which
+// dwords are candidates, the window they ask for, and the key that keeps one import per region.
+#pragma once
+
+#include <cstdint>
+
+namespace bc5::user_data_hint {
+
+// Dwords below this are counts, indices and flags, never offsets worth an import (1 MiB; R1 of exp 0364 saw a
+// false candidate at 0x40011, the title's real offsets are 256 MiB and more).
+inline constexpr std::uint32_t kMinOffset = 0x100000;
+// One hint per 64 MiB region: the key an address falls into.
+inline constexpr std::uint64_t kRegion = 64ull << 20u;
+
+// The window's high part is the learned window's bits above 32; a user-data dword is its low part.
+inline bool candidate(std::uint64_t window, std::uint32_t dword, std::uint64_t* out) {
+    if (window == 0 || dword < kMinOffset || (dword & 0xfu) != 0) { // R2 of exp 0364: 0x100011 passed the size test; pointers are 16-byte aligned
+        return false;
+    }
+    *out = (window & ~0xffffffffull) | static_cast<std::uint64_t>(dword);
+    return true;
+}
+
+inline std::uint64_t region_key(std::uint64_t addr) {
+    return addr & ~(kRegion - 1);
+}
+
+// The span to ask the direct mapper for: like the render-target hints, `below` before the address's 64 KiB page
+// and `size` from it.
+inline std::uint64_t window_lo(std::uint64_t addr, std::uint64_t below) {
+    const std::uint64_t page = addr & ~0xffffull;
+    return page > below ? page - below : 0;
+}
+
+inline std::uint64_t window_hi(std::uint64_t addr, std::uint64_t size) {
+    return (addr & ~0xffffull) + size;
+}
+
+// SET_SH_REG offsets (relative to 0x2c00) of COMPUTE_USER_DATA_0..15 (Mesa's gfx10 register table).
+inline constexpr std::uint32_t kUserData0 = 0x240;
+inline constexpr std::uint32_t kUserDataCount = 16;
+
+inline bool is_user_data(std::uint32_t sh_offset) {
+    return sh_offset >= kUserData0 && sh_offset < kUserData0 + kUserDataCount;
+}
+
+} // namespace bc5::user_data_hint
