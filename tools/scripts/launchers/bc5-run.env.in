# BC5 track B: the settings the game is run with (one KEY=VALUE per line, no quotes).
# play-astro.sh reads this file at every start; it is updated whenever a setting has been
# confirmed by a GPU run. The emulator binary is always the latest build
# (~/bc5-work/kytyplus-build/src/kyty_emulator).
#
# Confirmed by run 115 (2026-10-01, jobs in flight, the maintainer at the controller): first level 47-55 fps, loading 60 fps, 492,815 submissions, none failed.
BC5_GC_MODE=direct
BC5_DIRECT_JOURNAL=min
BC5_DIRECT_LAZY_NAMES=orbis_user_malloc
BC5_DIRECT_EAGER_NAMES=GpuGarlicMemory,GpuOnionMemory
KYTY_GUEST_MEMORY_MB=13824
SDL_JOYSTICK_DISABLE_UDEV=1
SDL_VIDEODRIVER=wayland
SHADPS4_SYSMODULES_PACK_DIR=@HOME@/bc5-data/mnt/PPSA21567/fakelib
# Extra emulator arguments, e.g. --fullscreen
PLAY_ARGS=
# Input configuration (patch 0001, hostInput.cpp): bindings, disabled pad inputs, keyboard layout.
# See input.cfg next to this file and backend/kytyplus-patches/input.example.cfg in the repository.
KYTY_BC5_INPUT_CONFIG=@HOME@/bc5-work/input.cfg
# Confirmed by runs 120-131 (2026-10-06): the queue consumer does not finish jobs inline.
# Experiment 0045 (runs 162-163, 2026-10-10, unattended): the flip queued behind the frame and up to 24 jobs in flight;
# the GPU no longer drains at every flip, the first level 54 -> 57 fps. Remove both lines to go back.
BC5_DIRECT_FLIP_DEFER=1
# Experiment 0046 (runs 169-170, 2026-10-10, unattended): the title sizes its 3D view by the GPU time its timestamps show;
# scaled by 1.2 it renders at 3328x1872 instead of 3840x2160 and the first level runs at 59-60 fps. Remove to go back to native 4K.
# Experiment 0060: cross-queue waits a job already on the ring will satisfy go to the GPU
# 2026-10-13: ring order on again with the flip-label fix (exp. 0069); it tore the picture before
# 2026-10-13: the pad recorded as KYTY_BC5_INPUT_CMD lines, for replaying a route played by hand
KYTY_BC5_INPUT_RECORD=@HOME@/bc5-work/route-record.txt
# 2026-10-13: journal + frame profile of play sessions (play-astro.sh), for measurements
PLAY_CAPTURE=1
# 2026-10-13: ADR 0008 step 2, graphics pieces built but not submitted (journal: pieces dry)
# 2026-10-14: ADR 0008 step 4, graphics pieces on the GPU behind the full-state prefix (experiment 0077); remove to go back
# 2026-10-15 (maintainer said yes): pieces back on, now one job with their prefix (experiment 0119; 0118 tagged faults gone)
