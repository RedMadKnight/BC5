def reg_byte(mm, base_idx):
    return (GC_BASE[base_idx] + mm) * 4


# amdgpu_regs (v7.2 amdgpu_debugfs.c:52-191, amdgpu_debugfs_process_reg_op): *pos is the register's byte offset in
# bits 0..21 (`*pos &= (1UL << 22) - 1`), bit 62 asks for a GRBM bank select with SE in bits 24..33, SH/SA in 34..43
# and INSTANCE in 44..53 (taken under grbm_idx_mutex); size and pos must be multiples of 4.
REGS_OFFSET_MASK = (1 << 22) - 1


def regs_pos(byte_off, bank=None):
    if byte_off & 3 or byte_off & ~REGS_OFFSET_MASK:
        raise ValueError("bad register byte offset 0x%x" % byte_off)
    pos = byte_off
    if bank is not None:
        se, sh, inst = bank
        pos |= (1 << 62) | (se << 24) | (sh << 34) | (inst << 44)
    return pos


# amdgpu_wave (v7.2 amdgpu_debugfs.c:1136-1224, amdgpu_debugfs_wave_read): *pos bits 0..6 byte offset into the
# record, 7..14 SE, 15..22 SH/SA, 23..30 "CU/{WGP+SIMD}" (the GRBM INSTANCE), 31..36 wave, 37..44 SIMD. On gfx10 the
# SIMD is part of the INSTANCE and the simd field must be 0: gfx_v10_0_read_wave_data has WARN_ON(simd != 0)
# (gfx_v10_0.c:4498-4504). umr builds the INSTANCE as ((wgp << 2) | (simd & 3)) (umr src/lib/scan_waves.c:30
# MANY_TO_INSTANCE, used at 598 with simd 0) and scans 20 wave slots per SIMD on GC 10.1.x (scan_waves.c:671-672).
def wave_pos(se, sa, wgp, simd, wave):
    inst = (wgp << 2) | (simd & 3)
    return (se << 7) | (sa << 15) | (inst << 23) | (wave << 31)   # simd field (bits 37..44) stays 0


# The record (gfx_v10_0.c:4506-4523): dword 0 is the version (2 for gfx10), then 16 SQ_WAVE registers in this order.
WAVE_VERSION_GFX10 = 2
WAVE_FIELDS = ("STATUS", "PC_LO", "PC_HI", "EXEC_LO", "EXEC_HI", "HW_ID1", "HW_ID2", "INST_DW0", "GPR_ALLOC",
               "LDS_ALLOC", "TRAPSTS", "IB_STS", "IB_STS2", "IB_DBG1", "M0", "MODE")
WAVE_DWORDS = 1 + len(WAVE_FIELDS)   # 17 dwords, 68 bytes
WAVE_BYTES = WAVE_DWORDS * 4

# Field masks, v7.2 gc_10_1_0_sh_mask.h: SQ_WAVE_STATUS 42730-42769, SQ_WAVE_TRAPSTS 42771-42790, SQ_WAVE_PC_HI 42860,
# SQ_WAVE_HW_ID1 42887-42896, SQ_WAVE_HW_ID2 42898-42911, SQ_WAVE_IB_STS2 42937-42943.
STATUS_BITS = (("PRIV", 0x20), ("TRAP_EN", 0x40), ("EXECZ", 0x200), ("IN_BARRIER", 0x1000), ("HALT", 0x2000),
               ("TRAP", 0x4000), ("VALID", 0x10000), ("ECC_ERR", 0x20000), ("SKIP_EXPORT", 0x40000),
               ("FATAL_HALT", 0x800000), ("MUST_EXPORT", 0x8000000))
ST_VALID, ST_HALT = 0x10000, 0x2000
PC_HI_MASK = 0xFFFF
TRAPSTS_EXCP_MASK, TRAPSTS_ILLEGAL_INST, TRAPSTS_XNACK_ERROR = 0x1FF, 0x800, 0x10000000
IB_STS2_WAVE64 = 0x800
# umr skips a slot unless VALID, or HALT with a STATUS that is not its 0xbebebeef no-data pattern (scan_waves.c:603-605).
NO_DATA = (0xBEBEBEEF, 0xFFFFFFFF)


def _f(v, mask):
    shift = (mask & -mask).bit_length() - 1
    return (v & mask) >> shift


def decode_wave(dw):
    """dw: the dwords amdgpu_wave returned (version first). None if it is not a gfx10 record."""
    if len(dw) < WAVE_DWORDS or dw[0] != WAVE_VERSION_GFX10:
        return None
    r = dict(zip(WAVE_FIELDS, dw[1:WAVE_DWORDS]))
    st, h1, h2 = r["STATUS"], r["HW_ID1"], r["HW_ID2"]
    return {
        "regs": r,
        "status": st,
        "flags": [n for n, m in STATUS_BITS if st & m],
        "valid": bool(st & ST_VALID),
        "halt": bool(st & ST_HALT),
        "pc": ((r["PC_HI"] & PC_HI_MASK) << 32) | r["PC_LO"],
        "exec": (r["EXEC_HI"] << 32) | r["EXEC_LO"],
        # HW_ID1: WAVE_ID [4:0], SIMD_ID [9:8], WGP_ID [13:10], SA_ID [16], SE_ID [19:18]
        "hw": (_f(h1, 0xC0000), _f(h1, 0x10000), _f(h1, 0x3C00), _f(h1, 0x300), _f(h1, 0x1F)),
        # HW_ID2: QUEUE_ID [3:0], PIPE_ID [5:4], ME_ID [9:8], STATE_ID [14:12], WG_ID [20:16], VM_ID [27:24]
        "queue": _f(h2, 0xF), "pipe": _f(h2, 0x30), "me": _f(h2, 0x300), "state": _f(h2, 0x7000),
        "wg": _f(h2, 0x1F0000), "vmid": _f(h2, 0xF000000),
        "trapsts": r["TRAPSTS"],
        "wave64": bool(r["IB_STS2"] & IB_STS2_WAVE64),
    }


def slot_kept(dw):
    if len(dw) < 2 or dw[0] != WAVE_VERSION_GFX10:
        return False
    st = dw[1]
    return st not in NO_DATA and bool(st & (ST_VALID | ST_HALT))


# amdgpu_fence_info (v7.2 amdgpu_fence.c:883-924): per ring "--- ring %d (%s) ---", "Last signaled fence 0x%08x",
# "Last emitted 0x%08x"; GFX and SDMA rings add a trailing-fence pair (a second "Last emitted"), GFX rings add
# preempted/reset/both lines. Each read runs amdgpu_fence_process on every ring (line 894). Ring names: gfx10
# "gfx_%d.%d.%d" and "comp_%d.%d.%d" (gfx_v10_0.c:4671, 4700).
FENCE_HDR = re.compile(r"^--- ring (\d+) \((.*)\) ---\s*$")


def parse_fence_info(text):
    rings = collections.OrderedDict()
    cur = None
    for line in text.splitlines():
        m = FENCE_HDR.match(line)
        if m:
            cur = m.group(2)
            rings[cur] = [None, None]
            continue
        if cur is None:
            continue
        v = rings[cur]
        try:
            if line.startswith("Last signaled fence"):
                v[0] = int(line.split()[-1], 16)
            elif line.startswith("Last emitted") and v[0] is not None and v[1] is None:
                v[1] = int(line.split()[-1], 16)
        except ValueError:
            pass
    return collections.OrderedDict((k, (v[0], v[1])) for k, v in rings.items() if None not in v)


def format_fence_info(rings):
    """The kernel's text for {name: (signaled, emitted)} (used by the fake device and the tests)."""
    out = []
    for i, (name, (sig, emit)) in enumerate(rings.items()):
        out.append("--- ring %d (%s) ---" % (i, name))
        out.append("Last signaled fence          0x%08x" % sig)
        out.append("Last emitted                 0x%08x" % emit)
        if name.startswith("gfx") or name.startswith("sdma"):
            out.append("Last signaled trailing fence 0x%08x" % 0)
            out.append("Last emitted                 0x%08x" % 0)
        if name.startswith("gfx"):
            out.append("Last preempted               0x%08x" % 0)
            out.append("Last reset                   0x%08x" % 0)
            out.append("Last both                    0x%08x" % 0)
    return "\n".join(out) + "\n"


# /dev/kmsg (v7.2 Documentation/ABI/testing/dev-kmsg): one record per read(), "prefix,seq,usec,flags[,...];text\n"
# plus " KEY=value" continuation lines; prefix = facility << 3 | level; user space cannot inject facility 0, so
# bc5-gpu-watch's own lines (written with "<4>", and quoting the amdgpu line, F420) are facility 1.
# The timeout line: amdgpu_job.c:117 "ring %s timeout, but soft recovered" and :122 "ring %s timeout, signaled
# seq=%u, emitted seq=%u" (dev_err, so the text starts "amdgpu 0000:01:00.0: "). In v7.2 the line comes after
# amdgpu_job_core_dump (line 112) and the soft-recovery attempt (114-120), right before the ring reset (133-152).
TIMEOUT_RE = re.compile(r"\bring (\S+) timeout\b")

# Reset windows. In v7.2 a debugfs register or wave read does not wait for a GPU reset: amdgpu_debugfs_process_reg_op
# and amdgpu_debugfs_wave_read take no reset lock, and RREG32's amdgpu_device_skip_hw_access (amdgpu_device.c:827-852)
# skips the hardware only when no_hw_access is set (PCI error or unplug, :6753). So the sampler keeps its reads out of
# the window itself: from a timeout or reset-begin line until the reset's end line (the cap is the worst case).
# Lines: amdgpu_job.c:117/122 timeout, :136 "Starting %s ring reset", :145 "Ring %s reset succeeded", :151 "Ring %s
# reset failed", :174 "GPU Recovery Failed: %d"; amdgpu_device.c:5898 "GPU %s begin!. Source:  %d", :5793 "GPU
# reset(%d) failed with error %d", :5804 "GPU reset(%d) succeeded!", :5966 "GPU reset end with ret = %d"; nv.c:465-477
# "PCI reset", "BACO reset", "MODE1 reset". A failed ring reset went to MODE1 ~4 s later on the box (F420).
RESET_LINES = (   # first match wins
    (re.compile(r"Ring \S+ reset succeeded|GPU reset\(\d+\) succeeded|GPU reset end with ret = 0\b|"
                r"timeout, but soft recovered"), "end", 0.2),
    (re.compile(r"Ring \S+ reset failed|GPU reset\(\d+\) failed|GPU Recovery Failed"), "fail", 30.0),
    (re.compile(r"\bring \S+ timeout\b|Starting \S+ ring reset|GPU \w+ begin!|\b(PCI|BACO|MODE1|MODE2) reset\b"),
     "begin", 10.0),
)


def parse_kmsg_record(rec):
    head, sep, rest = rec.partition(";")
    if not sep:
        return None
    f = head.split(",")
    try:
        pri, seq, usec = int(f[0]), int(f[1]), int(f[2])
    except (ValueError, IndexError):
        return None
    return {"facility": pri >> 3, "level": pri & 7, "seq": seq, "usec": usec, "text": rest.split("\n", 1)[0]}


def kmsg_amdgpu_line(r):
    return r is not None and r["facility"] == 0 and "amdgpu" in r["text"] and "bc5-gpu-watch:" not in r["text"]


