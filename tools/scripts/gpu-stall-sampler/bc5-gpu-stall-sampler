class Config:
    def __init__(self, **kw):
        self.poll = 0.025
        self.thresholds = (0.5, 0.8, 1.1, 1.4, 1.7)
        self.write_at = 1.9
        self.share_tol = 0.15
        self.ses, self.sas, self.wgps, self.simds, self.waves = 2, 2, 5, 4, 20
        self.header_dump_reads = HEADER_DUMP_PERIOD
        self.rings = re.compile(r"^(gfx|comp)_")
        self.retire_after = 5.0
        self.kmsg_tail = 10.0
        self.force_min_period = 5.0
        # No read may run into a reset (see RESET_LINES): a sample starts only while every stalled ring's clock is
        # below sample_until (the kernel's clock is ours plus at most one poll, its timeout at 2.0 s; a scan is
        # tens of ms, to be measured at T1).
        self.sample_until = 1.85
        # exp 0374: the T1 forced wave scan under ASTRO BOT was followed 106 ms later by a GFX hang that the ring reset
        # could not recover; the scans read SQ_IND of running waves without a halt and returned torn records (PCs with
        # 0xbebebeef/0xbeef bytes, HW_ID1 naming SE 3 on a 2-SE chip). Until a scan is shown safe it needs --wave-scan.
        self.wave_scan = False
        for k, v in kw.items():
            setattr(self, k, v)


class Sample:
    __slots__ = ("idx", "kind", "t", "wall", "clocks", "fence_text", "gfxoff", "skipped", "regs", "banked",
                 "reg_errors", "regs_s", "waves", "slots_read", "wave_errors", "wave_errno", "scan_s", "badver", "dec",
                 "scanned")

    def __init__(self, kind, t, wall, fence_text):
        self.idx, self.kind, self.t, self.wall, self.fence_text = 0, kind, t, wall, fence_text
        self.clocks = {}
        self.gfxoff = None
        self.skipped = None
        self.regs = []          # (name, byte offset, [values])
        self.banked = []        # (name, se, sa, value)
        self.reg_errors = 0
        self.regs_s = 0.0
        self.waves = []         # (se, sa, wgp, simd, wave, dwords)
        self.slots_read = 0
        self.wave_errors = 0
        self.wave_errno = None
        self.scan_s = 0.0
        self.badver = 0
        self.dec = None         # [(slot, decode_wave)] once, on first use (the waves never change after the scan)
        self.scanned = False    # the wave slots were read (False: registers only)


def decoded(s):
    if s.dec is None:
        s.dec = [(w[:5], decode_wave(w[5])) for w in s.waves]
    return s.dec


def take_sample(dev, cfg, kind, t, wall, fence_text, pending, idle_ok=False, regs_only=False, banked=False,
                clock=time.monotonic):
    s = Sample(kind, t, wall, fence_text)
    s.gfxoff = dev.read_gfxoff()
    if not pending and not idle_ok:
        s.skipped = "no job pending on a watched ring (exp 0370 D5: read while GFX is up)"
        return s
    if not pending and s.gfxoff == 1:
        s.skipped = "GFXOFF state 1 and no job pending: not reading GC registers (exp 0370 D5)"
        return s
    t0 = clock()

    def read(off):
        try:
            return dev.read_reg(off)
        except OSError:
            s.reg_errors += 1
            return None
    witness = None
    for name, mm, bi in REGS:
        n = cfg.header_dump_reads if name in HEADER_DUMPS else 1
        if n <= 0:
            continue
        off = reg_byte(mm, bi)
        vals = [read(off) for _ in range(n)]
        s.regs.append((name, off, vals))
        if name == COMPUTE_BANK:
            witness = (off, vals)
        elif name == COMPUTE_LAST and witness:
            witness[1].append(read(witness[0]))   # the second witness read closes the COMPUTE_* block
    if banked:
        for name, mm, bi in BANKED_REGS:
            for se in range(cfg.ses):
                for sa in range(cfg.sas):
                    try:
                        v = dev.read_reg(reg_byte(mm, bi), (se, sa, 0))
                    except OSError:
                        s.reg_errors += 1
                        v = None
                    s.banked.append((name, se, sa, v))
    t1 = clock()
    s.regs_s = t1 - t0
    if regs_only:
        return s
    s.scanned = True
    ok = 0
    for se in range(cfg.ses):
        for sa in range(cfg.sas):
            for wgp in range(cfg.wgps):
                for simd in range(cfg.simds):
                    for wave in range(cfg.waves):
                        if s.wave_errors >= 64 and ok == 0:
                            break   # the file answers nothing (D5: log it, no retry inside the stall)
                        try:
                            dw = dev.read_wave(se, sa, wgp, simd, wave)
                        except OSError as e:
                            s.wave_errors += 1
                            s.wave_errno = e.errno
                            continue
                        ok += 1
                        if dw and dw[0] != WAVE_VERSION_GFX10:
                            s.badver += 1
                        if slot_kept(dw):
                            s.waves.append((se, sa, wgp, simd, wave, tuple(dw)))
    s.slots_read = ok
    s.scan_s = clock() - t1
    return s


def valid_pcs(s):
    return collections.Counter(d["pc"] for k, d in decoded(s) if d and d["valid"])


def hw_mismatches(s):
    """Slots whose HW_ID1 does not name the slot we addressed (umr's own race check, scan_waves.c:1183-1204)."""
    return sum(1 for k, d in decoded(s) if d and d["hw"] != k)


def pair_shape(a, b):
    pa = {k: d["pc"] for k, d in decoded(a) if d}
    pb = {k: d["pc"] for k, d in decoded(b) if d}
    both = set(pa) & set(pb)
    still = sum(1 for k in both if pa[k] == pb[k])
    moved = len(both) - still
    gone, new = len(set(pa) - set(pb)), len(set(pb) - set(pa))
    if not pa and not pb:
        guess = "no waves"
    elif pa and still >= 0.9 * len(pa) and new == 0:
        guess = "standing still"
    elif pa and gone >= 0.5 * len(pa):
        guess = "draining"
    elif moved > still:
        guess = "moving"
    else:
        guess = "mixed"
    return still, moved, gone, new, guess


def fmt_regs(s):
    out = ["# sample %d (%s) mono %.3f, clocks %s, gfxoff %s, registers in %.1f ms, %d read errors"
           % (s.idx, s.kind, s.t, fmt_clocks(s.clocks), s.gfxoff, s.regs_s * 1e3, s.reg_errors)]
    if s.skipped:
        out.append("# skipped: " + s.skipped)
    for name, off, vals in s.regs:
        for i, v in enumerate(vals):
            tag = "" if len(vals) == 1 else "[%d]" % i
            out.append("gfx1013.mm%s%s => %s   (byte 0x%05x)" % (name, tag, "ERROR" if v is None else "0x%08x" % v, off))
        if name in HEADER_DUMPS and len(vals) == 2 * HEADER_DUMP_PERIOD:   # the T1 check of HEADER_DUMPS
            out.append("# %s period %d: %s" % (name, HEADER_DUMP_PERIOD, "yes (reads 0-7 == reads 8-15)"
                                               if vals[:HEADER_DUMP_PERIOD] == vals[HEADER_DUMP_PERIOD:] else "NO"))
    for name, se, sa, v in s.banked:
        out.append("gfx1013.mm%s[se%d.sa%d] => %s" % (name, se, sa, "ERROR" if v is None else "0x%08x" % v))
    c = compute_dispatch(s)
    if c:
        out.extend(fmt_compute(c))
    return "\n".join(out) + "\n"


def fmt_wave_line(se, sa, wgp, simd, wave, dw):
    d = decode_wave(dw)
    head = "se%d sa%d wgp%d simd%d w%02d" % (se, sa, wgp, simd, wave)
    if d is None:
        return head + " raw " + " ".join("%08x" % x for x in dw)
    # exp 0370 D3's decoded line: slot, STATUS, PC, EXEC, HW_ID, TRAPSTS (all 17 raw dwords are in waves-N.bin)
    extra = []
    if d["trapsts"]:
        extra.append("TRAPSTS=0x%08x%s" % (d["trapsts"], "!" if d["trapsts"] & (
            TRAPSTS_EXCP_MASK | TRAPSTS_ILLEGAL_INST | TRAPSTS_XNACK_ERROR) else ""))
    if d["hw"] != (se, sa, wgp, simd, wave):
        extra.append("HW_ID1-mismatch(se%d sa%d wgp%d simd%d w%d)" % d["hw"])
    return ("%s %08x[%s] PC=%012x EXEC=%x me%d.p%d.q%d vm%d %s%s"
            % (head, d["status"], ",".join(d["flags"]), d["pc"], d["exec"], d["me"], d["pipe"], d["queue"], d["vmid"],
               "w64" if d["wave64"] else "w32", (" " + " ".join(extra)) if extra else ""))


def fmt_waves_txt(s):
    out = ["# sample %d (%s) mono %.3f, clocks %s: %d kept of %d slots read, %d errors (errno %s), %d bad versions, "
           "scan %.1f ms" % (s.idx, s.kind, s.t, fmt_clocks(s.clocks), len(s.waves), s.slots_read, s.wave_errors,
                             s.wave_errno, s.badver, s.scan_s * 1e3)]
    if s.skipped:
        out.append("# skipped: " + s.skipped)
    out.extend(fmt_wave_line(*w) for w in s.waves)
    return "\n".join(out) + "\n"


def pack_waves_bin(s):
    parts = [b"BC5WAVE1", struct.pack("<II", len(s.waves), WAVE_DWORDS)]
    for se, sa, wgp, simd, wave, dw in s.waves:
        dw = (tuple(dw) + (0,) * WAVE_DWORDS)[:WAVE_DWORDS]
        parts.append(struct.pack("<BBBBB3x%dI" % WAVE_DWORDS, se, sa, wgp, simd, wave, *dw))
    return b"".join(parts)


def unpack_waves_bin(b):
    if b[:8] != b"BC5WAVE1":
        raise ValueError("not a waves-N.bin")
    n, ndw = struct.unpack_from("<II", b, 8)
    rec = struct.Struct("<BBBBB3x%dI" % ndw)
    out, off = [], 16
    for _ in range(n):
        v = rec.unpack_from(b, off)
        out.append((v[0], v[1], v[2], v[3], v[4], tuple(v[5:])))
        off += rec.size
    return out


def fmt_clocks(clocks):
    return " ".join("%s=%.2f" % kv for kv in sorted(clocks.items())) or "-"


def fmt_sample_summary(s):
    lines = []
    head = " sample %d (%s) mono %.3f, clocks %s, gfxoff %s" % (s.idx, s.kind, s.t, fmt_clocks(s.clocks), s.gfxoff)
    if s.skipped:
        return [head, "   skipped: " + s.skipped]
    lines.append(head)
    if not s.scanned:
        lines.append("   registers %d (%d errors) in %.1f ms; waves not scanned (registers only)"
                     % (len(s.regs), s.reg_errors, s.regs_s * 1e3))
    else:
        lines.append("   registers %d (%d errors) in %.1f ms; waves %d kept of %d slots (%d errors, errno %s), scan %.1f "
                     "ms; HW_ID1 mismatches %d" % (len(s.regs), s.reg_errors, s.regs_s * 1e3, len(s.waves), s.slots_read,
                                                   s.wave_errors, s.wave_errno, s.scan_s * 1e3, hw_mismatches(s)))
    pcs = valid_pcs(s)
    lines.append("   distinct PCs %d: %s" % (len(pcs), ", ".join("0x%x x%d" % kv for kv in pcs.most_common(16)) or "-"))
    q = collections.Counter("me%d pipe%d q%d vmid%d" % (d["me"], d["pipe"], d["queue"], d["vmid"])
                            for k, d in decoded(s) if d)
    lines.append("   queues: %s" % (", ".join("%s x%d" % kv for kv in q.most_common(8)) or "-"))
    cp = {n: v[0] for n, o, v in s.regs if v and v[0] is not None}
    keys = ("GRBM_STATUS", "CP_STAT", "CP_PFP_INSTR_PNTR", "CP_ME_INSTR_PNTR", "CP_IB1_BASE_HI", "CP_IB1_BASE_LO",
            "CP_IB1_BUFSZ", "CP_IB1_CMD_BUFSZ")
    lines.append("   " + " ".join("%s=0x%x" % (k, cp[k]) for k in keys if k in cp))
    c = compute_dispatch(s)
    if c:
        lines.append("   compute: program=0x%x dim=%s threads=%s initiator=%s id=%s (%s)"
                     % (c["pgm"], _dims(c["dim"]), _dims(c["threads"]), _hex_or(c["initiator"]),
                        "-" if c["id"] is None else "%d" % c["id"], c["bank"]))
    return lines


# ---------------------------------------------------------------------------------------------------------------
# The writer (a thread: the poll loop keeps sampling while an event is written and fsynced)
# ---------------------------------------------------------------------------------------------------------------

class Writer:
    def __init__(self, out, uid=None, gid=None, threaded=True, gate=None, log=print):
        self.out, self.uid, self.gid, self.gate, self.log = out, uid, gid, gate, log
        self.threaded = threaded
        self.started = collections.deque(maxlen=256)
        self.finished = collections.deque(maxlen=256)
        self.errors = collections.deque(maxlen=64)
        self.q = queue.Queue(maxsize=64)
        if threaded:
            self.th = threading.Thread(target=self._run, name="bc5-stall-writer", daemon=True)
            self.th.start()

    def submit(self, task):
        if not self.threaded:
            self._do(task)
            return
        try:
            self.q.put_nowait(task)
        except queue.Full:
            self.log("bc5-gpu-stall-sampler: writer queue full, dropped %s %s" % (task[0], task[1]))

    def flush(self):
        if self.threaded:
            self.q.join()

    def close(self):
        if self.threaded:
            self.q.put(None)
            self.th.join(10)

    def _run(self):
        while True:
            task = self.q.get()
            try:
                if task is None:
                    return
                if self.gate:
                    self.gate(task)
                self._do(task)
            except Exception as e:   # the writer must not die; the sampler keeps sampling
                self.errors.append("%s: %r" % (task[:2], e))
                self.log("bc5-gpu-stall-sampler: write failed %s %s: %r" % (task[0], task[1], e))
            finally:
                self.q.task_done()

    def _own(self, fd):
        if self.uid is not None and hasattr(os, "fchown"):
            os.fchown(fd, self.uid, self.gid)

    def _fsync_dir(self, d):
        try:
            fd = os.open(d, os.O_RDONLY)
        except OSError:
            return   # (Windows test runs)
        try:
            os.fsync(fd)
        except OSError:
            pass
        finally:
            os.close(fd)

    def _write_file(self, path, data, mode=0o600):
        tmp = path + ".tmp"
        flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_BINARY", 0)
        try:
            os.unlink(tmp)
        except OSError:
            pass
        fd = os.open(tmp, flags, mode)
        try:
            os.write(fd, data)
            os.fsync(fd)
            self._own(fd)
        finally:
            os.close(fd)
        os.replace(tmp, path)

    def _do(self, task):
        kind, name = task[0], task[1]
        self.started.append((kind, name))
        if kind == "mkdir":
            d = os.path.join(self.out, name)
            os.mkdir(d, 0o700)
            fd = os.open(d, os.O_RDONLY) if hasattr(os, "fchown") else None
            if fd is not None:
                try:
                    self._own(fd)
                finally:
                    os.close(fd)
            self._fsync_dir(self.out)
        elif kind == "files":
            d = os.path.join(self.out, name)
            for fname, data in task[2]:
                if callable(data):
                    data = data()
                if isinstance(data, str):
                    data = data.encode()
                self._write_file(os.path.join(d, fname), data)
            self._fsync_dir(d)
        elif kind == "append":
            d = os.path.join(self.out, name) if name else self.out
            data = task[3].encode() if isinstance(task[3], str) else task[3]
            flags = os.O_WRONLY | os.O_APPEND | os.O_CREAT | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_BINARY", 0)
            fd = os.open(os.path.join(d, task[2]), flags, 0o600)
            try:
                os.write(fd, data)
                os.fsync(fd)
                self._own(fd)
            finally:
                os.close(fd)
        self.finished.append((kind, name))


# ---------------------------------------------------------------------------------------------------------------
# The engine: stall clocks, samples, episodes, events, census
# ---------------------------------------------------------------------------------------------------------------

class RingState:
    __slots__ = ("name", "sig", "emit", "t_change", "stall")

    def __init__(self, name, sig, emit, t):
        self.name, self.sig, self.emit, self.t_change, self.stall = name, sig, emit, t, None


class Stall:
    def __init__(self, ring, t_start, sig, emit, episode):
        self.ring, self.t_start, self.sig, self.emit, self.episode = ring, t_start, sig, emit, episode
        self.next_k, self.samples, self.missed = 0, [], 0
        self.deadline = False
        self.kmsg_line = None
        self.t_end = None


class Episode:
    """The rings that stall together share the samples (registers and waves belong to the whole GPU)."""

    def __init__(self, n, t):
        self.n, self.t_open = n, t
        self.samples, self.stalls = [], []
        self.event, self.event_t, self.event_reason = None, None, None
        self.written = 0          # samples already in the event directory
        self.closed_t = None
        self.notes = []

    def active(self):
        return [s for s in self.stalls if s.t_end is None]


class Engine:
    def __init__(self, dev, writer, cfg, clock=time.monotonic, wall=time.time, log=print, ddir="?"):
        self.dev, self.writer, self.cfg, self.clock, self.wall, self.log = dev, writer, cfg, clock, wall, log
        self.ddir = ddir
        self.rings = collections.OrderedDict()
        self.ep = None
        self.last_ep = None
        self.lingering = []
        self.n_ep = 0
        self.names = collections.deque(maxlen=64)    # recent directory names (same-second collisions)
        self.recent = collections.deque(maxlen=64)
        self.fence_text = ""
        self.fence_errors = 0
        # bounded: the service runs for weeks; the files on disk are the record
        self.census = collections.deque(maxlen=1000)  # census lines written (the tests read them)
        self.events = collections.deque(maxlen=1000)  # event directory names in order
        self.forced = collections.deque(maxlen=1000)
        self.force_req = None     # {"once", "period", "regs", "idle"}
        self.force_last = -1e9
        self.quiet_until = -1e9   # no register or wave read before this (a reset in progress, RESET_LINES)
        self.fail_t = -1e9

    # -- helpers ---------------------------------------------------------------------------------------------
    def _stamp(self, wall=None):
        w = self.wall() if wall is None else wall
        return time.strftime("%Y-%m-%dT%H:%M:%S", time.localtime(w)) + ".%03d" % (int(w * 1000) % 1000)

    def _name(self, prefix, suffix=""):
        base = prefix + time.strftime("%Y%m%d-%H%M%S", time.localtime(self.wall())) + suffix
        n, i = base, 2
        while n in self.names:
            n, i = "%s-%d" % (base, i), i + 1
        self.names.append(n)
        return n

    def _census(self, line):
        line = self._stamp() + " " + line
        self.census.append(line)
        self.writer.submit(("append", None, "stalls.log", line + "\n"))
        self.log("bc5-gpu-stall-sampler: " + line)

    def _pending(self, fences):
        return [n for n, (sig, emit) in fences.items() if self.cfg.rings.search(n) and sig != emit]

    # -- the poll --------------------------------------------------------------------------------------------
    def tick(self, now):
        try:
            text = self.dev.read_fence()
        except OSError as e:
            self.fence_errors += 1
            if self.fence_errors in (1, 10, 100) or self.fence_errors % 1000 == 0:
                self.log("bc5-gpu-stall-sampler: amdgpu_fence_info read failed (%d): %s" % (self.fence_errors, e))
            return
        self.fence_text = text
        fences = parse_fence_info(text)
        for name, (sig, emit) in fences.items():
            if not self.cfg.rings.search(name):
                continue
            st = self.rings.get(name)
            if st is None:
                self.rings[name] = RingState(name, sig, emit, now)
                continue
            if (sig, emit) != (st.sig, st.emit):
                if st.stall is not None:
                    self._end_stall(st.stall, now, sig, emit)
                    st.stall = None
                st.sig, st.emit, st.t_change = sig, emit, now
            elif sig != emit and st.stall is None and now - st.t_change >= self.cfg.thresholds[0]:
                st.stall = self._open_stall(st, now)
        ep = self.ep
        if ep is not None:
            th, tol = self.cfg.thresholds, self.cfg.share_tol
            act = ep.active()
            due = any(s.next_k < len(th) and now - s.t_start >= th[s.next_k] for s in act)
            hot = [s.ring for s in act if now - s.t_start >= self.cfg.sample_until]
            if due and (hot or now < self.quiet_until):
                # too close to a kernel timeout, or inside a reset window: no read; the thresholds count as missed
                if not ep.notes or not ep.notes[-1].startswith("no sample"):
                    ep.notes.append("no sample at mono %.3f: %s" % (now, ("stall clock past %.2f s on %s" % (
                        self.cfg.sample_until, ",".join(hot))) if hot else "inside a reset window (kernel line)"))
                for s in act:
                    while s.next_k < len(th) and now - s.t_start >= th[s.next_k]:
                        s.next_k += 1
                        s.missed += 1
            elif due:
                smp = take_sample(self.dev, self.cfg, "stall", now, self.wall(), text, True,
                                  regs_only=not self.cfg.wave_scan, clock=self.clock)
                smp.idx = len(ep.samples) + 1
                for s in act:
                    c = now - s.t_start
                    smp.clocks[s.ring] = c
                    if s.next_k < len(th) and c >= th[s.next_k] - tol:
                        s.samples.append((smp.idx, c))
                        s.next_k += 1
                        while s.next_k < len(th) and c >= th[s.next_k] - tol:
                            s.next_k += 1
                            s.missed += 1
                ep.samples.append(smp)   # complete before the writer thread can see it
                if ep.event is not None:
                    self._event_update(ep, new_samples=True)
            now2 = self.clock()
            for s in ep.active():
                if not s.deadline and now2 - s.t_start >= self.cfg.write_at:
                    s.deadline = True
                    if ep.event is None:
                        self._event_write(ep, "stall clock %.2f s on %s (written before the kernel's 2-s timeout)"
                                          % (now2 - s.t_start, s.ring))
                    else:
                        ep.notes.append("%s: stall clock passed %.1f s at mono %.3f" % (s.ring, self.cfg.write_at, now2))
                        self._event_update(ep)
        if self.force_req is not None and (self.ep is None or not self.ep.active()):
            self._forced(now, fences, text)

    def _open_stall(self, st, now):
        ep = self.ep
        if ep is not None and ep.event is not None and now - ep.event_t > self.cfg.retire_after:
            # a ring that stays stuck long after its event (a reset that never moved its fences): retire that episode
            ep.notes.append("retired at mono %.3f: a new stall opened %.1f s after the event" % (now, now - ep.event_t))
            self._event_update(ep)
            self.lingering.extend(ep.active())
            self.last_ep, self.ep, ep = ep, None, None
        if ep is None:
            self.n_ep += 1
            ep = self.ep = Episode(self.n_ep, now)
        s = Stall(st.name, st.t_change, st.sig, st.emit, ep)
        ep.stalls.append(s)
        return s

    def _end_stall(self, s, now, sig, emit):
        s.t_end = now
        ep = s.episode
        first = None
        if s.samples:
            first = ep.samples[s.samples[0][0] - 1]
        pcs = valid_pcs(first).most_common(4) if first else []
        nw = (len(first.waves) if first.scanned else "-") if first and not first.skipped else 0
        c = compute_dispatch(first) if first else None
        self._census("stall ring=%s dur=%.2f sig=0x%08x emit=0x%08x now_sig=0x%08x samples=%d missed=%d waves@first=%s "
                     "top=%s pgm@first=%s kmsg_timeout=%s event=%s"
                     % (s.ring, now - s.t_start, s.sig, s.emit, sig, len(s.samples), s.missed, nw,
                        ",".join("0x%x:%d" % kv for kv in pcs) or "-", "0x%x" % c["pgm"] if c else "-",
                        "yes" if s.kmsg_line else "no", ep.event or "-"))
        if s in self.lingering:
            self.lingering.remove(s)
        if ep is self.ep and not ep.active():
            ep.closed_t = now
            if ep.event is not None:
                ep.notes.append("all stalls ended at mono %.3f" % now)
                self._event_update(ep)
            self.last_ep, self.ep = ep, None

    # -- events ----------------------------------------------------------------------------------------------
    def _event_write(self, ep, reason, ring=None):
        ring = ring or (ep.stalls[0].ring if ep.stalls else "none")
        ep.event = self._name("event-", "-" + re.sub(r"[^A-Za-z0-9_.]", "_", ring))
        ep.event_t, ep.event_reason = self.clock(), reason
        self.events.append(ep.event)
        # the summary decodes every wave: formatted in the writer thread, so the poll keeps its 25 ms
        files = [("summary.txt", lambda ep=ep: self._summary(ep)), ("fence.txt", self._fence_file(ep)),
                 ("kmsg.txt", "## recent amdgpu kernel lines (facility 0), oldest first\n"
                  + "".join(l + "\n" for l in self.recent))]
        files += self._sample_files(ep.samples)
        ep.written = len(ep.samples)
        self.writer.submit(("mkdir", ep.event))
        self.writer.submit(("files", ep.event, files))
        self.log("bc5-gpu-stall-sampler: event %s: %s (%d samples)" % (ep.event, reason, len(ep.samples)))

    def _event_update(self, ep, new_samples=False):
        if ep.event is None:
            return
        files = []
        if new_samples and ep.written < len(ep.samples):
            files += self._sample_files(ep.samples[ep.written:])
            ep.written = len(ep.samples)
            files.append(("fence.txt", self._fence_file(ep)))
        files.append(("summary.txt", lambda ep=ep: self._summary(ep)))
        self.writer.submit(("files", ep.event, files))

    @staticmethod
    def _sample_files(samples):
        out = []
        for s in samples:
            out.append(("regs-%d.txt" % s.idx, lambda s=s: fmt_regs(s)))
            if s.scanned:
                out.append(("waves-%d.txt" % s.idx, lambda s=s: fmt_waves_txt(s)))
                out.append(("waves-%d.bin" % s.idx, lambda s=s: pack_waves_bin(s)))
        return out

    def _fence_file(self, ep):
        out = []
        for s in ep.samples:
            out.append("## sample %d, mono %.3f, clocks %s\n%s" % (s.idx, s.t, fmt_clocks(s.clocks), s.fence_text))
        out.append("## at write, mono %.3f\n%s" % (self.clock(), self.fence_text))
        return "".join(out)

    def _summary(self, ep):
        L = ["bc5-gpu-stall-sampler %s event %s" % (VERSION, ep.event),
             "reason: %s" % ep.event_reason,
             "written: %s (mono %.3f); debugfs %s" % (self._stamp(), self.clock(), self.ddir),
             "rings:"]
        for s in ep.stalls:
            L.append(" %s: stalled since mono %.3f (sig 0x%08x emit 0x%08x), samples at clock %s, missed %d, "
                     "past %.1f s: %s, kmsg timeout: %s, %s"
                     % (s.ring, s.t_start, s.sig, s.emit, " ".join("%.2f" % c for i, c in s.samples) or "-", s.missed,
                        self.cfg.write_at, "yes" if s.deadline else "no", s.kmsg_line or "no",
                        "ended after %.2f s" % (s.t_end - s.t_start) if s.t_end else "still stalled"))
        L.append("samples: %d (registers%s of the whole GPU, shared by the rings above)"
                 % (len(ep.samples), " and waves" if self.cfg.wave_scan else ", no wave scan"))
        for s in ep.samples:
            L.extend(fmt_sample_summary(s))
        shapes = [pair_shape(a, b) for a, b in zip(ep.samples, ep.samples[1:])]
        for i, (still, moved, gone, new, guess) in enumerate(shapes):
            L.append(" samples %d->%d: still %d, moved %d, gone %d, new %d: %s" % (i + 1, i + 2, still, moved, gone, new,
                                                                              guess))
        if shapes:
            g = set(x[4] for x in shapes)
            L.append("shape: %s" % ("standing still in every interval (F249's halted shape)" if g == {"standing still"}
                                     else "draining (progress, not a stuck shader)" if "draining" in g and len(g) == 1
                                     else "moving (a loop inside one program? arm A)" if g == {"moving"}
                                     else "mixed: " + ", ".join(x[4] for x in shapes)))
        L.append("program names: match the compute program address (and any PCs) offline against the host journal's "
                 "dispatch and timeout-probe lists (exp 0370 K4, F113, F528).")
        L.extend("note: " + n for n in ep.notes)
        return "\n".join(L) + "\n"

    # -- kmsg ------------------------------------------------------------------------------------------------
    def on_kmsg(self, now, rec):
        r = parse_kmsg_record(rec) if isinstance(rec, str) else rec
        if not kmsg_amdgpu_line(r):
            return
        line = "[%5d.%06d] %s" % (r["usec"] // 1000000, r["usec"] % 1000000, r["text"])
        self.recent.append(line)
        self._reset_window(now, r["text"])
        m = TIMEOUT_RE.search(r["text"])
        ep = self.ep
        target = None
        if ep is not None:
            target = ep
        elif self.last_ep is not None and self.last_ep.event is not None and self.last_ep.closed_t is not None \
                and now - self.last_ep.closed_t <= self.cfg.kmsg_tail:
            target = self.last_ep
        if m:
            ring = m.group(1)
            if target is ep and ep is not None:
                for s in ep.stalls:
                    if s.ring == ring and s.kmsg_line is None:
                        s.kmsg_line = line
                if not any(s.ring == ring for s in ep.stalls):
                    ep.notes.append("timeout line for %s, which the sampler did not see stalled" % ring)
                if ep.event is None:
                    self._event_write(ep, "kernel timeout line for %s" % ring)
                    return
                self.writer.submit(("append", ep.event, "kmsg.txt", line + "\n"))
                self._event_update(ep)
                return
            if target is None:
                # a timeout with no stall in progress: write what there is, with no sample after the line (F112)
                self.n_ep += 1
                e2 = Episode(self.n_ep, now)
                e2.notes.append("no sampled stall: the sampler saw no stall >= %.1f s before this line"
                                % self.cfg.thresholds[0])
                self._event_write(e2, "kernel timeout line for %s" % ring, ring)
                e2.closed_t = now
                self.last_ep = e2
                return
        if target is not None and target.event is not None:
            self.writer.submit(("append", target.event, "kmsg.txt", line + "\n"))

    def _reset_window(self, now, text):
        for rx, kind, secs in RESET_LINES:
            if rx.search(text):
                if kind == "end":
                    if now - self.fail_t > 30.0:      # a failed reset's window is not shortened by another ring
                        self.quiet_until = min(self.quiet_until, now + secs)
                else:
                    if kind == "fail":
                        self.fail_t = now
                    self.quiet_until = max(self.quiet_until, now + secs)
                return kind
        return None

    # -- forced samples (T1/T2) ------------------------------------------------------------------------------
    def request_force(self, req):
        self.force_req = req

    def offer_force(self, txt, on_done=None):
        """The owner's request file, read once a second (None: no file). A one-shot request still waiting for a job is
        replaced when the file says something else, so a later "idle" never waits behind a "once" (exp 0374); a
        request ends when its file is removed; a periodic one keeps its rhythm while the file is unchanged."""
        req = self.force_req
        if txt is None:
            self.force_req = None
            return
        new = parse_force_request(txt)
        if req is not None and new["text"] == req["text"]:
            return
        if new["once"] and on_done:
            new["on_done"] = on_done
        self.force_req = new

    def _forced(self, now, fences, text):
        req = self.force_req
        if now < self.quiet_until:
            return   # a reset in progress
        if req["period"] and now - self.force_last < req["period"]:
            return
        if now - self.force_last < self.cfg.force_min_period:
            return
        pending = self._pending(fences)
        if not pending and not req["idle"]:
            return   # wait for a job in flight (GFX up, D5)
        scan = req["waves"] and not req["regs"] and self.cfg.wave_scan
        refused = " waves refused (no --wave-scan)" if req["waves"] and not self.cfg.wave_scan else ""
        smp = take_sample(self.dev, self.cfg, "forced", now, self.wall(), text, bool(pending), idle_ok=req["idle"],
                          regs_only=not scan, banked=True, clock=self.clock)
        smp.idx = 1
        smp.clocks = {n: now - self.rings[n].t_change for n in pending if n in self.rings}
        self.force_last = now
        name = self._name("forced-")
        self.forced.append(name)
        head = ["bc5-gpu-stall-sampler %s forced sample %s (request: %s)" % (VERSION, name, req["text"]),
                "pending rings: %s" % (", ".join(pending) or "none")]
        files = [("summary.txt", lambda h=head, s=smp: "\n".join(h + fmt_sample_summary(s)) + "\n"),
                 ("fence.txt", text)] + self._sample_files([smp])
        self.writer.submit(("mkdir", name))
        self.writer.submit(("files", name, files))
        c = compute_dispatch(smp)
        self._census("forced dir=%s pending=%s waves=%d slots=%d scan_ms=%.1f regs_ms=%.1f gfxoff=%s pgm=%s%s%s"
                     % (name, ",".join(pending) or "-", len(smp.waves), smp.slots_read, smp.scan_s * 1e3,
                        smp.regs_s * 1e3, smp.gfxoff, "0x%x" % c["pgm"] if c else "-",
                        " skipped" if smp.skipped else "", refused))
        if not req["period"]:
            self.force_req = None
            if req.get("on_done"):
                req["on_done"]()


def parse_force_request(text):
    req = {"once": True, "period": 0.0, "regs": False, "waves": False, "idle": False,
           "text": " ".join(text.split()) or "once"}
    for tok in text.split():
        if tok == "regs":
            req["regs"] = True
        elif tok == "waves":
            req["waves"] = True
        elif tok == "idle":
            req["idle"] = True
        elif tok == "once":
            pass
        else:
            try:
                req["period"] = max(5.0, float(tok))
                req["once"] = False
            except ValueError:
                pass
    return req


def read_force_file(path):
    """The owner's request file. Opened without following links, regular files only, at most 256 bytes."""
    try:
        fd = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0))
    except OSError:
        return None
    try:
        import stat
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            return None
        return os.read(fd, 256).decode("ascii", "replace")
    finally:
        os.close(fd)


