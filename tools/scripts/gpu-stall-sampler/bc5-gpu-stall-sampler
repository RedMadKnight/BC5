# Which instance a plain read of the COMPUTE_* registers returns (exp 0377). amdgpu_regs selects a ME/pipe/queue
# only when the position has bit 61 (v7.2 amdgpu_debugfs.c:109-116, 145-147); without it RREG32 (:157) reads
# whatever GRBM_GFX_CNTL selects. The kernel writes GRBM_GFX_CNTL under srbm_mutex and puts it back to ME 0, pipe 0,
# queue 0, VMID 0 (nv.c:317-327 nv_grbm_select; amdgpu_debugfs.c:179-181; gfx_v10_0.c:3867, 5218, 5378, 6875,
# 7165). ME 0 is the gfx ME (compute rings use ME = MEC + 1, gfx_v10_0.c:4689-4690), so a plain read gives the gfx
# ME's pipe-0 values, the ring gfx_0.0.0: the ring the title dispatches on and the one the F403 class stops (F253: a
# foreign client's COMPUTE_PGM_HI was left on that ring; F527: the ME waits). The sampler never sets bit 61: that
# select is a kernel write to GRBM_GFX_CNTL in the middle of a stall, which nothing shows safe, and the gfx ring
# needs none; so compute rings' values are out of reach. It reads GRBM_GFX_CNTL before and after the block instead:
# no ME/pipe/queue/VMID bit in either read (gc_10_1_0_sh_mask.h:5925-5932) means no select was in place at either
# end. A select made and undone between the two reads would go unseen; the kernel makes them at queue setup, reset
# and KFD/MQD operations, not per submission, and the sampler stays out of reset windows (RESET_LINES).
# TODO(verify) at T1: that these SH registers read back at all on gfx1013 and that GRBM_GFX_CNTL banks them per ME;
# the MQD keeps a copy per compute queue (v10_structs.h:675-709), which says per-queue state, not the gfx ME's.
COMPUTE_BANK = "GRBM_GFX_CNTL"
COMPUTE_LAST = "COMPUTE_DISPATCH_ID"
GRBM_GFX_CNTL_SELECT = 0x7FF   # PIPEID 0x3 | MEID 0xC | VMID 0xF0 | QUEUEID 0x700 (gc_10_1_0_sh_mask.h:5929-5932)

# Field masks, v7.2 gc_10_1_0_sh_mask.h (line): COMPUTE_PGM_HI DATA 0xff (17128; Mesa's gfx10.json has DATA [7:0]);
# COMPUTE_PGM_LO/HI hold the program address >> 8 and >> 40 (gfx_v9_0.c:4758-4764 writes them so; the backend's
# own dispatch_min.cpp:52 does the same). COMPUTE_NUM_THREAD_X NUM_THREAD_FULL 0xffff (17105).
# COMPUTE_DISPATCH_INITIATOR (17071-17083):
INITIATOR_BITS = (("COMPUTE_SHADER_EN", 0x1), ("PARTIAL_TG_EN", 0x2), ("FORCE_START_AT_000", 0x4),
                  ("ORDERED_APPEND_ENBL", 0x8), ("ORDERED_APPEND_MODE", 0x10), ("USE_THREAD_DIMENSIONS", 0x20),
                  ("ORDER_MODE", 0x40), ("SCALAR_L1_INV_VOL", 0x400), ("VECTOR_L1_INV_VOL", 0x800),
                  ("TUNNEL_ENABLE", 0x2000), ("RESTORE", 0x4000), ("CS_W32_EN", 0x8000))
PGM_HI_DATA = 0xFF
NUM_THREAD_FULL = 0xFFFF


def compute_dispatch(s):
    """The decoded compute dispatch registers of a sample (None if the sample did not read them)."""
    v = {n: (vals[0] if vals else None) for n, o, vals in s.regs}
    if v.get("COMPUTE_PGM_LO") is None or v.get("COMPUTE_PGM_HI") is None:
        return None
    bank = [x for n, o, vals in s.regs if n == COMPUTE_BANK for x in vals]
    init = v.get("COMPUTE_DISPATCH_INITIATOR")

    def xyz(prefix, mask=0xFFFFFFFF):
        t = [v.get(prefix + a) for a in "XYZ"]
        return None if None in t else tuple(x & mask for x in t)
    if len(bank) == 2 and None not in bank and not (bank[0] | bank[1]) & GRBM_GFX_CNTL_SELECT:
        where = "gfx ME0 pipe0 queue0 (gfx_0.0.0)"
    else:
        where = "UNKNOWN bank (GRBM_GFX_CNTL %s: a kernel select overlapped)" % "/".join(
            "ERROR" if x is None else "0x%x" % x for x in bank)
    return {
        "pgm": ((v["COMPUTE_PGM_HI"] & PGM_HI_DATA) << 40) | (v["COMPUTE_PGM_LO"] << 8),
        "dim": xyz("COMPUTE_DIM_"), "start": xyz("COMPUTE_START_"),
        "threads": xyz("COMPUTE_NUM_THREAD_", NUM_THREAD_FULL),
        "initiator": init,
        "flags": [n for n, m in INITIATOR_BITS if init is not None and init & m],
        "rsrc": tuple(v.get("COMPUTE_PGM_RSRC%d" % i) for i in (1, 2, 3)),
        "id": v.get("COMPUTE_DISPATCH_ID"),
        "bank": where,
    }


def _hex_or(x):
    return "-" if x is None else "0x%x" % x


def _dims(t):
    return "-" if t is None else "[%s]" % " ".join("%d" % a for a in t)


def fmt_compute(c):
    """The decoded lines for regs-N.txt. DIM after a DISPATCH_INDIRECT: TODO(verify) whether the CP copies the
    indirect arguments into COMPUTE_DIM_X/Y/Z (F528's x = 0 question)."""
    return ["# compute dispatch, %s:" % c["bank"],
            "#   program address = PGM_HI:PGM_LO << 8 = 0x%x   (match against the host journal's dispatch list, F528)"
            % c["pgm"],
            "#   dim %s, start %s, threads %s, initiator %s [%s], dispatch id %s"
            % (_dims(c["dim"]), _dims(c["start"]), _dims(c["threads"]), _hex_or(c["initiator"]), ",".join(c["flags"]),
               "-" if c["id"] is None else "%d" % c["id"]),
            "#   rsrc1 %s rsrc2 %s rsrc3 %s" % tuple(_hex_or(x) for x in c["rsrc"])]
