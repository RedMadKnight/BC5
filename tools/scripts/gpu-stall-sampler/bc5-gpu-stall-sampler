DEBUGFS_FILES = ("amdgpu_fence_info", "amdgpu_regs", "amdgpu_wave")


def find_debugfs_dir(pci, root="/sys/kernel/debug/dri"):
    """The amdgpu debugfs directory of PCI device `pci`. v7.2 names the device's directory after dev->unique, which
    is dev_name(parent) = the PCI address (drm_drv.c:785, drm_debugfs.c:401-407), with "<minor>" symlinks to it
    (drm_debugfs.c:433-441); older kernels have only the numbered directories. Both carry `name`, "amdgpu
    dev=<pci> ... unique=<pci>" (drm_debugfs.c:54-73). TODO(verify) at T1: whether card1's index is 0 or 1."""
    try:
        entries = sorted(os.listdir(root))
    except OSError as e:
        raise RuntimeError("cannot list %s: %s" % (root, e))
    seen = []
    order = [pci] + [e for e in entries if e != pci] if pci in entries else entries
    for e in order:
        d = os.path.join(root, e)
        if not all(os.path.exists(os.path.join(d, f)) for f in DEBUGFS_FILES):
            continue
        name = ""
        try:
            with open(os.path.join(d, "name")) as fh:
                name = fh.read().strip()
        except OSError:
            pass
        toks = name.split()
        seen.append("%s: %s" % (e, name or "(no name file)"))
        if e == pci or (toks and toks[0] == "amdgpu" and ("dev=" + pci in toks or "unique=" + pci in toks)):
            return d, name
    raise RuntimeError("no amdgpu debugfs directory for %s under %s (seen: %s)" % (pci, root, "; ".join(seen) or "none"))


class Device:
    """The open debugfs files. Every access is a pread on a held descriptor: no process, no halt, no write."""

    def __init__(self, ddir):
        self.dir = ddir
        self.fence_fd = os.open(os.path.join(ddir, "amdgpu_fence_info"), os.O_RDONLY)
        self.regs_fd = os.open(os.path.join(ddir, "amdgpu_regs"), os.O_RDONLY)
        self.wave_fd = os.open(os.path.join(ddir, "amdgpu_wave"), os.O_RDONLY)
        try:
            # amdgpu_debugfs_gfxoff_read (v7.2 amdgpu_debugfs.c:1528-1562) returns adev->gfx.gfx_off_state as a u32:
            # a software flag, no SMU message. TODO(verify) at T1: its value on the box at idle and in play.
            self.gfxoff_fd = os.open(os.path.join(ddir, "amdgpu_gfxoff"), os.O_RDONLY)
        except OSError:
            self.gfxoff_fd = None

    def read_fence(self):
        # seq_files support pread (v7.2 fs/seq_file.c:78); a read at 0 restarts the show (seq_read_iter, 189-196).
        chunks, off = [], 0
        while off < (1 << 20):
            b = os.pread(self.fence_fd, 65536, off)
            chunks.append(b)
            off += len(b)
            if len(b) < 65536:   # single_open: the first read returns the whole text when it fits
                break
        return b"".join(chunks).decode("ascii", "replace")

    def read_reg(self, byte_off, bank=None):
        b = os.pread(self.regs_fd, 4, regs_pos(byte_off, bank))
        if len(b) != 4:
            raise OSError(0, "short register read (%d bytes)" % len(b))
        return struct.unpack("<I", b)[0]

    def read_gfxoff(self):
        if self.gfxoff_fd is None:
            return None
        try:
            b = os.pread(self.gfxoff_fd, 4, 0)
            return struct.unpack("<I", b)[0] if len(b) == 4 else None
        except OSError:
            return None

    def read_wave(self, se, sa, wgp, simd, wave):
        b = os.pread(self.wave_fd, WAVE_BYTES, wave_pos(se, sa, wgp, simd, wave))
        return struct.unpack("<%dI" % (len(b) // 4), b[: len(b) // 4 * 4])


