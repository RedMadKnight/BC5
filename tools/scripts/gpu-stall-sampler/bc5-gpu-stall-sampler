def gen_trace(spec, length, rings=("gfx_0.0.0", "comp_1.0.0"), idle=()):
    """Synthetic fence traces, simulated in 2-ms steps. spec: list of (ring, t_stall, t_resolve or None). Outside its
    stalls a ring pushes one job every 16 ms and completes it 8 ms later (a 60-Hz game); in a stall window the job in
    flight (or one pushed at its start) never completes and nothing is pushed; at t_resolve it completes (a reset
    force-completes it the same way). In an `idle` window (t0, t1) nothing is pushed and nothing is pending."""
    ev = [(0.0, "fence", "%s 0x100 0x100" % r) for r in rings]
    st = {r: [0x100, 0x100, None] for r in rings}   # signaled, emitted, completion due
    step = 0.002
    for i in range(1, int(round(length / step))):
        t = round(i * step, 6)
        for j, r in enumerate(rings):
            sig, emit, due = st[r]
            changed = False
            if any(sr == r and ts <= t and (te is None or t < te) for sr, ts, te in spec):
                if sig == emit:
                    emit += 1
                    changed = True
                due = None
            elif any(sr == r and te is not None and te <= t < te + step for sr, ts, te in spec) and sig != emit:
                sig, due, changed = emit, None, True
            else:
                if due is not None and t >= due - 1e-9:
                    sig, due, changed = emit, None, True
                if due is None and sig == emit and (i + 3 * j) % 8 == 0 and not any(a <= t < b for a, b in idle):
                    emit, due, changed = emit + 1, t + 0.008, True
            st[r] = [sig, emit, due]
            if changed:
                ev.append((t, "fence", "%s 0x%x 0x%x" % (r, sig, emit)))
    ev.append((length, "end", ""))
    return ev


def kmsg_timeout(t, ring, sig=1, emit=2):
    return (t, "kmsg", "3 amdgpu 0000:01:00.0: ring %s timeout, signaled seq=%d, emitted seq=%d" % (ring, sig, emit))


def _read(path, mode="r"):
    with open(path, mode, **({} if "b" in mode else {"encoding": "utf-8"})) as fh:
        return fh.read()


def _sorted(ev):
    return sorted(ev, key=lambda e: e[0])


def _census_dur(line):
    m = re.search(r" dur=([\d.]+) ", line)
    return float(m.group(1)) if m else -1.0


def _event_files(out, name):
    d = os.path.join(out, name)
    return d, sorted(os.listdir(d))


