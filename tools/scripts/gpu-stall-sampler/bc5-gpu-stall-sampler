def run_scenario(name, events, check, tmp_root, cfg=None):
    """The scenarios check wave contents, so they run with --wave-scan unless cfg says otherwise."""
    out = os.path.join(tmp_root, re.sub(r"[^a-z0-9]+", "-", name.lower())[:40])
    os.makedirs(out, exist_ok=True)
    eng, dev = replay(events, out, cfg or Config(wave_scan=True))
    f = check(eng, dev, out)
    if dev.warn_simd:
        f.append("a wave read set the simd field (the kernel's WARN_ON)")
    return f


def scenario_second_stall_while_writing(tmp_root):
    """An event is being written (the writer blocked in its first file write) while a second ring stalls: the
    second stall is sampled during the write, and its event is written after the first one finishes."""
    out = os.path.join(tmp_root, "second-stall-while-writing")
    os.makedirs(out, exist_ok=True)
    release = threading.Event()
    blocked = threading.Event()

    def gate(task):
        if task[0] == "files" and task[1].endswith("gfx_0.0.0") and not release.is_set():
            blocked.set()
            release.wait(30)
    w = Writer(out, threaded=True, gate=gate, log=lambda s: None)
    seen = {}

    def on_tick(eng, t):
        if eng.events and not blocked.is_set():
            blocked.wait(5)      # the replay runs faster than a thread switch: let the writer reach its first write
        if blocked.is_set() and not release.is_set():
            comp = [s for e in [eng.ep] if e for s in e.stalls if s.ring == "comp_1.1.0"]
            if comp:
                seen["comp_samples_during_write"] = len(comp[0].samples)
            if len(eng.events) == 2:
                seen["second_queued"] = True
                seen["second_finished_before_release"] = any(n == eng.events[1] for k, n in w.finished)
                release.set()
    ev = gen_trace([("gfx_0.0.0", 1.0, 3.0), ("comp_1.1.0", 3.4, 6.0)], 8.0, rings=("gfx_0.0.0", "comp_1.1.0"))
    ev += [(1.0, "busy", "32 0xaaaa00"), (3.0, "busy", "0 0"), (3.4, "busy", "48 0xbbbb00")]
    eng, dev = replay(sorted(ev, key=lambda e: e[0]), out, Config(wave_scan=True), writer=w, on_tick=on_tick)
    release.set()
    w.flush()
    w.close()
    f = []
    if len(eng.events) != 2:
        return ["events %d, expected 2" % len(eng.events)]
    if seen.get("comp_samples_during_write", 0) != 5:
        f.append("comp_1.1.0 samples taken while event 1 was being written: %s, expected 5"
                 % seen.get("comp_samples_during_write"))
    if not seen.get("second_queued") or seen.get("second_finished_before_release"):
        f.append("event 2 was not queued behind event 1: %s" % seen)
    order = [n for k, n in w.finished if k == "files"]
    if order[:1] != [eng.events[0]] or eng.events[1] not in order or order.index(eng.events[1]) < 1:
        f.append("write order: %s" % order)
    for e in eng.events:
        if not os.path.exists(os.path.join(out, e, "waves-5.bin")):
            f.append("%s lacks waves-5.bin" % e)
    if w.errors:
        f.append("writer errors: %s" % w.errors)
    return f


def selftest_decoder():
    f = []
    rec = make_wave_record(ST_VALID | 0x20, 0x11D049AA04, exec_=0xFFFF0000FFFF, hw1=hw_id1(1, 0, 4, 3, 19),
                           hw2=(2 << 8) | (3 << 4) | 5 | (9 << 24), trapsts=0x800, ib_sts2=IB_STS2_WAVE64)
    d = decode_wave(rec)
    want = {"pc": 0x11D049AA04, "exec": 0xFFFF0000FFFF, "hw": (1, 0, 4, 3, 19), "me": 2, "pipe": 3, "queue": 5,
            "vmid": 9, "valid": True, "wave64": True}
    for k, v in want.items():
        if d[k] != v:
            f.append("decode %s: %r != %r" % (k, d[k], v))
    if not slot_kept(rec) or slot_kept(make_wave_record(0xBEBEBEEF, 0)) or slot_kept(make_wave_record(0, 5)):
        f.append("slot_kept")
    pos = wave_pos(1, 1, 4, 3, 19)
    if (pos >> 7) & 0xFF != 1 or (pos >> 15) & 0xFF != 1 or (pos >> 23) & 0xFF != 19 or (pos >> 31) & 0x3F != 19 \
            or (pos >> 37) & 0xFF != 0 or pos & 0x7F:
        f.append("wave_pos 0x%x" % pos)
    if reg_byte(0x0DA4, 0) != 0x8010 or reg_byte(0x2200, 1) != 0x30800:
        f.append("reg_byte")
    return f


def selftest_compute():
    """exp 0377: the COMPUTE_* block is read between two GRBM_GFX_CNTL reads, and decoded (the program address too)."""
    f = []
    log = []

    class Dev(FakeDevice):
        def __init__(self, cntl):
            FakeDevice.__init__(self, FakeClock())
            self.cntl = list(cntl)

        def read_reg(self, byte_off, bank=None):
            log.append(byte_off)
            if byte_off == reg_byte(0x0DC2, 0):
                return self.cntl.pop(0)
            if byte_off == reg_byte(0x1BAD, 0):
                return 0x12            # a high byte, to check the << 40
            return FakeDevice.read_reg(self, byte_off, bank)
    s = take_sample(Dev((0, 0)), Config(), "once", 0, 0, "", True, regs_only=True)
    names = {reg_byte(mm, bi): n for n, mm, bi in REGS}
    seq = [names[o] for o in log]
    i, j = seq.index(COMPUTE_BANK), len(seq) - 1 - seq[::-1].index(COMPUTE_BANK)
    if seq.count(COMPUTE_BANK) != 2 or not all(n.startswith("COMPUTE_") for n in seq[i + 1:j]) \
            or len(seq[i + 1:j]) != 16:
        f.append("the COMPUTE_* block is not bracketed by two %s reads: %s" % (COMPUTE_BANK, seq[i:j + 1]))
    c = compute_dispatch(s)
    want = {"pgm": 0x12 << 40 | 0x11d028dd00, "dim": (40, 23, 1), "threads": (8, 8, 1), "id": 4711,
            "flags": ["COMPUTE_SHADER_EN", "USE_THREAD_DIMENSIONS", "CS_W32_EN"]}
    for k, v in want.items():
        if not c or c[k] != v:
            f.append("compute %s: %r != %r" % (k, c and c[k], v))
    txt = fmt_regs(s)
    if "program address = PGM_HI:PGM_LO << 8 = 0x1211d028dd00" not in txt or "gfx ME0 pipe0 queue0" not in txt:
        f.append("regs-N.txt lacks the decoded program line")
    if not any("compute: program=0x1211d028dd00 dim=[40 23 1]" in x for x in fmt_sample_summary(s)):
        f.append("the summary lacks the compute line")
    s = take_sample(Dev((0, 0x4)), Config(), "once", 0, 0, "", True, regs_only=True)   # MEID 1 at the second read
    if "UNKNOWN bank (GRBM_GFX_CNTL 0x0/0x4" not in compute_dispatch(s)["bank"]:
        f.append("a select seen by the witness is not flagged: %s" % compute_dispatch(s)["bank"])
    return f


