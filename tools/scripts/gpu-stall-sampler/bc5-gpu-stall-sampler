    f = []
    if dev.wave_reads:
        f.append("%d wave reads without --wave-scan" % dev.wave_reads)
    if len(eng.events) != 1:
        return f + ["events %d, expected 1" % len(eng.events)]
    files = sorted(os.listdir(os.path.join(out, eng.events[0])))
    if [x for x in files if x.startswith("waves-")] or "regs-5.txt" not in files:
        f.append("event files: %s" % files)
    summ = _read(os.path.join(out, eng.events[0], "summary.txt"))
    if summ.count("waves not scanned (registers only)") != 5 or "no wave scan" not in summ:
        f.append("summary does not say registers only")
    clock = FakeClock(10.0)
    dev2 = FakeDevice(clock)
    w = Writer(out, threaded=False, log=lambda s: None)
    eng2 = Engine(dev2, w, Config(), clock=clock, wall=lambda: 1.9e9 + clock.t, log=lambda s: None)
    dev2.fences["gfx_0.0.0"] = (5, 6)
    dev2.busy = busy_slots(8, 0xaaaa00)
    eng2.offer_force("once waves\n")
    eng2.tick(clock.t)
    if dev2.wave_reads or not dev2.reg_reads or not eng2.census or "waves refused" not in eng2.census[-1]:
        f.append("forced waves without --wave-scan: %d wave reads, census %s" % (dev2.wave_reads, list(eng2.census)))
    return f


def run_selftest(tmp_root=None):
    """Every scenario with the fake device and a scratch output directory (removed when all pass)."""
    import shutil
    import tempfile
    tmp = tmp_root or tempfile.mkdtemp(prefix="bc5-stall-selftest-")
    results = [("wave decoder and debugfs positions", selftest_decoder()),
               ("compute dispatch registers: bracketed by the bank witness, decoded (exp 0377)", selftest_compute())]
    for name, ev, chk in scenarios():
        results.append((name, run_scenario(name, ev, chk, tmp)))
    results.append(("a second stall while an event is being written", scenario_second_stall_while_writing(tmp)))
    results.append(("the default: registers only, no wave read, forced waves refused", scenario_default_regs_only(tmp)))
    bad = 0
    for name, f in results:
        print("%s  %s" % ("ok  " if not f else "FAIL", name))
        for x in f:
            print("        " + x)
        bad += bool(f)
    if bad or tmp_root:
        print("selftest: %d/%d passed (output kept in %s)" % (len(results) - bad, len(results), tmp))
    else:
        shutil.rmtree(tmp, ignore_errors=True)
        print("selftest: %d/%d passed" % (len(results), len(results)))
    return 1 if bad else 0


# ---------------------------------------------------------------------------------------------------------------
# --compare-check: install.sh's sampler-versus-umr file
# ---------------------------------------------------------------------------------------------------------------

# umr -r prints "<ip>.<reg> => 0x%08lx" (umr src/app/scan.c:108-109; e.g. "gfx1013.mmCP_STAT => 0x9507a200" in exp
# 0137 raw/runs-561-564.txt:47); umr -lr prints "\t<asic>.<ip>.<reg> (<type>) => 0x%05lx" with the register's dword
# address (umr src/app/main.c:1112-1122; scan.c:86-100 reads MMIO at addr * 4). The sampler's own lines use the same
# "gfx1013.mm<reg> => 0x..." shape.
UMR_READ_RE = re.compile(r"^\s*(?:\S+\.)?gfx1013\.mm(\w+?)(?:\[[^\]]*\])?\s+=>\s+(0x[0-9a-fA-F]+)")
UMR_LIST_RE = re.compile(r"^\s*\S+\.gfx1013\.mm(\w+)\s+\(\d+\)\s+=>\s+(0x[0-9a-fA-F]+)")


def compare_check(text):
    sec, data = None, {"read1": {}, "umr": {}, "list": {}, "read2": {}}
    for line in text.splitlines():
        line = re.sub(r"\x1b\[[0-9;]*m", "", line)    # umr colours its "-r" output (umr src/app/scan.c:108-109)
        if line.startswith("## "):
            h = line[3:].strip()
            sec = ("read1" if h.startswith("sampler read 1") else "read2" if h.startswith("sampler read 2")
                   else "umr" if h.startswith("umr -r") else "list" if h.startswith("umr -lr") else None)
            continue
        if sec == "list":
            m = UMR_LIST_RE.match(line)
        elif sec:
            m = UMR_READ_RE.match(line)
            if m and "[" in line.split("=>")[0]:
                continue   # banked or repeated reads are not compared
        else:
            m = None
        if m:
            data[sec].setdefault(m.group(1), int(m.group(2), 16))
    rows, counts = [], collections.Counter()
    for name, mm, bi in REGS + BANKED_REGS:
        off = reg_byte(mm, bi)
        a, u, b = data["read1"].get(name), data["umr"].get(name), data["read2"].get(name)
        la = data["list"].get(name)
        if la is None:
            addr = "umr-unlisted"
        elif la == off:
            addr = "addr ok (byte)"
        elif la == off // 4:
            addr = "addr ok (dword)"
        else:
            addr = "ADDR DIFF umr 0x%x" % la
        if a is None or b is None:
            val = "not read"
        elif u is None:
            val = "umr missing"
        elif a == u == b:
            val = "same"
        elif a == b != u:
            val = "MISMATCH (stable here, umr differs)"
        else:
            val = "changing (inconclusive)"
        counts[val.split(" (")[0]] += 1
        counts[addr.split(" (")[0].split(" umr")[0]] += 1
        rows.append("%-32s 0x%05x  %-10s %-10s %-10s %-36s %s" % (name, off, "-" if a is None else "0x%08x" % a,
                                                                   "-" if u is None else "0x%08x" % u,
                                                                   "-" if b is None else "0x%08x" % b, val, addr))
    head = "%-32s %-7s  %-10s %-10s %-10s %-36s %s" % ("register", "byte", "read 1", "umr -r", "read 2", "values",
                                                      "address")
    return "\n".join([head] + rows + ["totals: " + ", ".join("%s %d" % kv for kv in sorted(counts.items()))]) + "\n"


# ---------------------------------------------------------------------------------------------------------------
# The service and the root one-shots
# ---------------------------------------------------------------------------------------------------------------

def mlockall(log):
    try:
        import ctypes
        libc = ctypes.CDLL(None, use_errno=True)
        if libc.mlockall(3) != 0:   # MCL_CURRENT | MCL_FUTURE
            log("bc5-gpu-stall-sampler: mlockall failed: errno %d" % ctypes.get_errno())
            return False
        return True
    except Exception as e:
        log("bc5-gpu-stall-sampler: mlockall unavailable: %r" % e)
        return False


def open_device(pci, wait, log):
    """At boot the sampler can start before amdgpu has probed: wait up to `wait` seconds, then exit (systemd
    restarts it)."""
    t_end = time.monotonic() + wait
    next_log = 0.0
    while True:
        try:
            d, name = find_debugfs_dir(pci)
            return Device(d), d, name
        except (RuntimeError, OSError) as e:
            if time.monotonic() >= t_end:
                raise
            if time.monotonic() >= next_log:
                log("bc5-gpu-stall-sampler: waiting for the amdgpu debugfs directory: %s" % e)
                next_log = time.monotonic() + 30
        time.sleep(2)


def owner_ids(owner):
    import pwd
    pw = pwd.getpwnam(owner)
    return pw.pw_uid, pw.pw_gid, pw.pw_dir


def run_service(args, cfg):
    log = lambda s: print(s, flush=True)
    uid, gid, home = owner_ids(args.owner)
    out = args.out or os.path.join(home, "bc5-data", "captures", "gpu-stall")
    if not os.path.isdir(out):
        os.makedirs(out, 0o700)
        os.chown(out, uid, gid)
    dev, ddir, name = open_device(args.pci, 120, log)
    kfd = os.open("/dev/kmsg", os.O_RDONLY | os.O_NONBLOCK)
    os.lseek(kfd, 0, os.SEEK_END)
    threading.stack_size(512 * 1024)   # mlockall's MCL_FUTURE would otherwise pin the writer's default 8-MiB stack
    locked = mlockall(log)
    writer = Writer(out, uid, gid, threaded=True, log=log)
    eng = Engine(dev, writer, cfg, log=log, ddir=ddir)
    eng._census("start pid=%d version=%s debugfs=%s (%s) realpath=%s gfxoff=%s rings=%s poll_ms=%d samples_at=%s "
                "write_at=%.1f slots=%dx%dx%dx%dx%d header_dump_reads=%d wave_scan=%s mlockall=%s"
                % (os.getpid(), VERSION, ddir, name, os.path.realpath(ddir), dev.read_gfxoff(), cfg.rings.pattern,
                   cfg.poll * 1000, ",".join("%.1f" % x for x in cfg.thresholds), cfg.write_at, cfg.ses, cfg.sas,
                   cfg.wgps, cfg.simds, cfg.waves, cfg.header_dump_reads, "on" if cfg.wave_scan else "off", locked))
    import select
    import signal
    signal.signal(signal.SIGTERM, lambda *a: sys.exit(0))   # systemctl stop: let the writer finish (finally below)
    poller = select.poll()
    poller.register(kfd, select.POLLIN)
    force_path = os.path.join(out, "force")
    next_tick = time.monotonic()
    next_force_check = next_tick
    lost = 0
    try:
        while True:
            now = time.monotonic()
            timeout_ms = max(0, int((next_tick - now) * 1000 + 0.999))
            for fd, evm in poller.poll(timeout_ms):
                while True:
                    try:
                        b = os.read(kfd, 16384)
                    except BlockingIOError:
                        break
                    except BrokenPipeError:
                        lost += 1   # records overwritten while we were away (EPIPE); the read position moved on
                        if lost in (1, 10, 100) or lost % 1000 == 0:
                            log("bc5-gpu-stall-sampler: /dev/kmsg overran %d times (kernel lines lost)" % lost)
                        continue
                    if not b:
                        break
                    eng.on_kmsg(time.monotonic(), b.decode("utf-8", "replace"))
            now = time.monotonic()
            if now >= next_tick:
                eng.tick(now)
                next_tick += cfg.poll
                if next_tick < time.monotonic():
                    next_tick = time.monotonic() + cfg.poll
            if now >= next_force_check:
                next_force_check = now + 1.0

                def done(p=force_path):
                    try:
                        os.unlink(p)
                    except OSError:
                        pass
                eng.offer_force(read_force_file(force_path), done)
    finally:
        writer.close()


def run_once(args, cfg):
    d, name = find_debugfs_dir(args.pci)
    dev = Device(d)
    fences = parse_fence_info(dev.read_fence())
    pending = [n for n, (s, e) in fences.items() if cfg.rings.search(n) and s != e]
    s = take_sample(dev, cfg, "once", time.monotonic(), time.time(), "", bool(pending), idle_ok=args.idle_ok,
                    regs_only=args.regs_only or not cfg.wave_scan, banked=True)
    print("# bc5-gpu-stall-sampler %s --once: debugfs %s (%s), pending rings: %s, gfxoff %s"
          % (VERSION, d, name, ", ".join(pending) or "none", s.gfxoff))
    sys.stdout.write(fmt_regs(s))
    if s.scanned:
        sys.stdout.write(fmt_waves_txt(s))
        print("\n".join(fmt_sample_summary(s)))
    return 0 if not s.skipped else 2


def run_find(args):
    d, name = find_debugfs_dir(args.pci)
    root = os.path.dirname(d)
    links = []
    for e in sorted(os.listdir(root)):
        p = os.path.join(root, e)
        if os.path.islink(p) and os.path.realpath(p) == os.path.realpath(d):
            links.append(e)
    print("debugfs %s realpath %s name '%s' links %s" % (d, os.path.realpath(d), name, ",".join(links) or "-"))
    for f in DEBUGFS_FILES + ("amdgpu_gfxoff",):
        print("  %s %s" % (f, "present" if os.path.exists(os.path.join(d, f)) else "MISSING"))
    return 0


def main(argv=None):
    ap = argparse.ArgumentParser(description="BC5 non-halting GPU stall sampler (exp 0370 design, exp 0373 T0)")
    ap.add_argument("--owner", help="user who owns the captures (the service)")
    ap.add_argument("--out", help="capture directory (default ~OWNER/bc5-data/captures/gpu-stall)")
    ap.add_argument("--pci", default="0000:01:00.0", help="the amdgpu device (default 0000:01:00.0)")
    ap.add_argument("--wgps", type=int, default=5, help="WGPs per shader array to scan (default 5: 40 CU)")
    ap.add_argument("--waves-per-simd", type=int, default=20, help="wave slots per SIMD (default 20, GC 10.1.x)")
    ap.add_argument("--header-dump-reads", type=int, default=HEADER_DUMP_PERIOD,
                    help="reads of CP_PFP/ME_HEADER_DUMP per sample: 8 (default), 0 or 16 (see HEADER_DUMPS)")
    ap.add_argument("--rings", default=r"^(gfx|comp)_", help="regex of the rings to watch")
    ap.add_argument("--test", action="store_true", help="built-in self-test, no device")
    ap.add_argument("--replay", metavar="TRACE", help="replay a trace file, no device")
    ap.add_argument("--find", action="store_true", help="print the debugfs directory and exit (root)")
    ap.add_argument("--once", action="store_true", help="take one sample now and print it (root)")
    ap.add_argument("--regs-only", action="store_true", help="with --once: registers only (the default since exp 0374)")
    ap.add_argument("--wave-scan", action="store_true",
                    help="allow wave-slot scans through amdgpu_wave (off by default: exp 0374)")
    ap.add_argument("--idle-ok", action="store_true", help="with --once: read even with no job pending")
    ap.add_argument("--list-regs", action="store_true", help="print the register table and exit")
    ap.add_argument("--compare-check", metavar="FILE", help="compare install.sh's check file and exit")
    a = ap.parse_args(argv)
    if a.header_dump_reads not in (0, 8, 16):
        ap.error("--header-dump-reads: 0, 8 or 16")
    cfg = Config(wgps=a.wgps, waves=a.waves_per_simd, header_dump_reads=a.header_dump_reads, rings=re.compile(a.rings),
                 wave_scan=a.wave_scan)
    if a.test:
        return run_selftest()
    if a.list_regs:
        # third column: "sampled" (one read per sample: umr -r may read it too), "sampled-x8"/"x16" (a header
        # history: never read once, see HEADER_DUMPS), "sampled-x2" (the bank witness, COMPUTE_BANK: its value is
        # not compared), "skipped", "banked"
        for name, mm, bi in REGS:
            hd = name in HEADER_DUMPS
            print("%s 0x%05x %s" % (name, reg_byte(mm, bi), ("sampled-x%d" % a.header_dump_reads if a.header_dump_reads
                                                             else "skipped") if hd else "sampled-x2"
                                     if name == COMPUTE_BANK else "sampled"))
        for name, mm, bi in BANKED_REGS:
            print("%s 0x%05x banked" % (name, reg_byte(mm, bi)))
        return 0
    if a.compare_check:
        with open(a.compare_check) as fh:
            sys.stdout.write(compare_check(fh.read()))
        return 0
    if a.replay:
        import tempfile
        out = a.out or tempfile.mkdtemp(prefix="bc5-stall-replay-")
        with open(a.replay) as fh:
            eng, dev = replay(read_trace(fh), out, cfg, log=print)
        print("replay: %d census lines, %d events, %d wave reads; output in %s" % (len(eng.census), len(eng.events),
                                                                                   dev.wave_reads, out))
        return 0
    if a.find:
        return run_find(a)
    if a.once:
        return run_once(a, cfg)
    if not a.owner:
        ap.error("--owner is required for the service")
    run_service(a, cfg)
    return 0


if __name__ == "__main__":
    sys.exit(main())
