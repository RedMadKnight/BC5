def make_wave_record(status, pc, exec_=0xFFFFFFFF, hw1=0, hw2=0, trapsts=0, ib_sts2=0):
    regs = {"STATUS": status, "PC_LO": pc & 0xFFFFFFFF, "PC_HI": (pc >> 32) & PC_HI_MASK,
            "EXEC_LO": exec_ & 0xFFFFFFFF, "EXEC_HI": exec_ >> 32, "HW_ID1": hw1, "HW_ID2": hw2, "TRAPSTS": trapsts,
            "IB_STS2": ib_sts2}
    return (WAVE_VERSION_GFX10,) + tuple(regs.get(f, 0) for f in WAVE_FIELDS)


def hw_id1(se, sa, wgp, simd, wave):
    return (se << 18) | (sa << 16) | (wgp << 10) | (simd << 8) | wave


# A dispatch as SET_SH_REG would leave it: program 0x11d028dd00 (F527's first candidate), 40x23x1 groups of 8x8x1,
# wave32; GRBM_GFX_CNTL 0 (no select in flight).
FAKE_COMPUTE = {"GRBM_GFX_CNTL": 0, "COMPUTE_DISPATCH_INITIATOR": 0x8021, "COMPUTE_DIM_X": 40, "COMPUTE_DIM_Y": 23,
                "COMPUTE_DIM_Z": 1, "COMPUTE_START_X": 0, "COMPUTE_START_Y": 0, "COMPUTE_START_Z": 0,
                "COMPUTE_NUM_THREAD_X": 8, "COMPUTE_NUM_THREAD_Y": 8, "COMPUTE_NUM_THREAD_Z": 1,
                "COMPUTE_PGM_LO": 0x11d028dd00 >> 8 & 0xFFFFFFFF, "COMPUTE_PGM_HI": 0x11d028dd00 >> 40,
                "COMPUTE_PGM_RSRC1": 0x60af0041, "COMPUTE_PGM_RSRC2": 0x90, "COMPUTE_PGM_RSRC3": 0,
                "COMPUTE_DISPATCH_ID": 4711}
FAKE_COMPUTE_BYTES = {reg_byte(mm, bi): FAKE_COMPUTE[n] for n, mm, bi in REGS if n in FAKE_COMPUTE}


class FakeDevice:
    """Fence values set by the trace; waves: `busy` maps a slot to a PC while any watched ring is pending."""

    def __init__(self, clock, scan_cost=0.06, regs_cost=0.0005):
        self.clock = clock
        self.fences = collections.OrderedDict()
        self.busy = {}
        self.scan_cost, self.regs_cost = scan_cost, regs_cost
        self.wave_reads = 0
        self.reg_reads = 0
        self.gfxoff = 0
        self.warn_simd = 0

    def read_fence(self):
        return format_fence_info(self.fences)

    def read_reg(self, byte_off, bank=None):
        regs_pos(byte_off, bank)
        self.reg_reads += 1
        if self.reg_reads % len(REGS) == 0:
            self.clock.advance(self.regs_cost)
        if byte_off in FAKE_COMPUTE_BYTES:
            return FAKE_COMPUTE_BYTES[byte_off]
        return (byte_off * 2654435761) & 0xFFFFFFFF

    def read_gfxoff(self):
        return self.gfxoff

    def read_wave(self, se, sa, wgp, simd, wave):
        pos = wave_pos(se, sa, wgp, simd, wave)
        if (pos >> 37) & 0xFF:
            self.warn_simd += 1
        self.wave_reads += 1
        if self.wave_reads % 1600 == 0:
            self.clock.advance(self.scan_cost)
        pc = self.busy.get((se, sa, wgp, simd, wave))
        if pc is None:
            return make_wave_record(0, 0, 0)
        return make_wave_record(ST_VALID, pc, hw1=hw_id1(se, sa, wgp, simd, wave), hw2=(1 << 8) | (6 << 24))


class FakeClock:
    def __init__(self, t=0.0):
        self.t = t

    def __call__(self):
        return self.t

    def advance(self, d):
        self.t += d


def read_trace(lines):
    """Trace lines: "<t> fence <ring> <signaled> <emitted>", "<t> kmsg <prefix> <text>", "<t> busy <n> <pc>" (n waves
    at pc from now on; n 0 clears), "<t> end". '#' starts a comment. Times in seconds, values decimal or 0x."""
    ev = []
    for ln in lines:
        ln = ln.split("#", 1)[0].strip() if not re.match(r"^\s*[\d.]+\s+kmsg\s", ln) else ln.strip()
        if not ln:
            continue
        p = ln.split(None, 2)
        t, kind = float(p[0]), p[1]
        rest = p[2] if len(p) > 2 else ""
        ev.append((t, kind, rest))
    ev.sort(key=lambda e: e[0])
    return ev


def busy_slots(n, pc):
    out, i = {}, 0
    for se in range(2):
        for sa in range(2):
            for wgp in range(5):
                for simd in range(4):
                    for wave in range(20):
                        if i >= n:
                            return out
                        out[(se, sa, wgp, simd, wave)] = pc
                        i += 1
    return out


def replay(events, out, cfg=None, writer=None, log=None, scan_cost=0.06, on_tick=None):
    """Drive an Engine over the trace with a fake clock: one tick per poll (later when a sample took time)."""
    cfg = cfg or Config()
    clock = FakeClock()
    dev = FakeDevice(clock, scan_cost=scan_cost)
    log = log or (lambda s: None)
    writer = writer or Writer(out, threaded=False, log=log)
    eng = Engine(dev, writer, cfg, clock=clock, wall=lambda: 1.8e9 + clock.t, log=log, ddir="(replay)")
    end = max([e[0] for e in events] + [0.0])
    i, seq = 0, 0
    next_tick = 0.0
    while True:
        clock.t = max(clock.t, next_tick)
        while i < len(events) and events[i][0] <= clock.t:
            t, kind, rest = events[i]
            i += 1
            if kind == "fence":
                ring, sig, emit = rest.split()
                dev.fences[ring] = (int(sig, 0), int(emit, 0))
            elif kind == "kmsg":
                pri, text = rest.split(None, 1)
                seq += 1
                eng.on_kmsg(clock.t, "%s,%d,%d,-;%s\n" % (pri, seq, int(t * 1e6), text))
            elif kind == "busy":
                n, pc = rest.split()
                dev.busy = busy_slots(int(n), int(pc, 0))
        if clock.t > end:
            break
        eng.tick(clock.t)
        if on_tick:
            on_tick(eng, clock.t)
        next_tick += cfg.poll
        if next_tick < clock.t:          # a sample took longer than a poll: as the service, no catch-up burst
            next_tick = clock.t + cfg.poll
    writer.flush()
    return eng, dev


