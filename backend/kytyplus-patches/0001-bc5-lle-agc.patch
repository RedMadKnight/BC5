+static void SecToTimespec(KernelTimespec* ts, double sec) {
+	ts->tv_sec  = static_cast<int64_t>(sec);
+	ts->tv_nsec = static_cast<int64_t>((sec - static_cast<double>(ts->tv_sec)) * 1000000000.0);
+}
