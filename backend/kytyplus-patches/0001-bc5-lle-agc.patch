+int KYTY_SYSV_ABI SaveDataDirNameSearch(const SaveDataDirNameSearchCond* cond,
+                                        SaveDataDirNameSearchResult*     result) {
+	PRINT_NAME();
+
+	if (cond == nullptr || result == nullptr ||
+	    static_cast<uint32_t>(cond->key) > static_cast<uint32_t>(SaveDataSortKey::FreeBlocks) ||
+	    static_cast<uint32_t>(cond->order) > static_cast<uint32_t>(SaveDataSortOrder::Descent)) {
+		return SAVE_DATA_ERROR_PARAMETER;
+	}
+
+	LOGF("\t user_id       = %d\n"
+	     "\t title_id      = %s\n"
+	     "\t dir_name      = %s\n"
+	     "\t key           = %" PRIu32 "\n"
+	     "\t order         = %" PRIu32 "\n"
+	     "\t dir_names_num = %" PRIu32 "\n",
+	     cond->user_id, cond->title_id != nullptr ? cond->title_id->data : "<default>",
+	     cond->dir_name != nullptr ? cond->dir_name->data : "<all>",
+	     static_cast<uint32_t>(cond->key), static_cast<uint32_t>(cond->order),
+	     result->dir_names_num);
+
+	result->hit_num = 0;
+	result->pad     = 0;
+	result->set_num = 0;
+	std::memset(result->reserved, 0, sizeof(result->reserved));
+	result->pad2 = 0;
+
+	// BC5 (search). Ported from AnyPS5 core/libs/prx/libSceSaveData.native/Export.cpp @ 7f596df
+	// (GPL-2.0), dirNameSearch: every save directory whose name matches the pattern, in name
+	// order, then stably by the sort key (user param, blocks, mtime or free blocks; the name key
+	// changes nothing), reversed for the descending order; params and infos from the sidecars.
+	// A title id other than this title's finds nothing (AnyPS5); the name match is case-insensitive
+	// here as before.
+	struct Match {
+		std::string        name;
+		std::string        path;
+		SaveDataParam      param;
+		SaveDataSearchInfo info;
+	};
+	std::vector<Match> matches;
+	const std::string  root = save_data_title_root();
+
+	if (cond->title_id != nullptr && cond->title_id->data[0] != '\0' &&
+	    std::strncmp(cond->title_id->data, get_title_id().c_str(), sizeof(cond->title_id->data)) != 0) {
+		LOGF("\t title_id %s is not this title's; no match\n", cond->title_id->data);
+	} else if (Common::File::IsDirectoryExisting(root)) {
+		const std::string pattern =
+		    cond->dir_name != nullptr ? Common::ToLower(std::string(cond->dir_name->data)) : std::string();
+		for (const auto& entry: Common::File::GetDirEntries(root)) {
+			if (!entry.is_file && entry.name != "." && entry.name != ".." &&
+			    !Common::StartsWith(entry.name, "sce_") &&
+			    dir_name_match(Common::ToLower(entry.name).c_str(), pattern.c_str())) {
+				Match m;
+				m.name  = entry.name;
+				m.path  = root + "/" + entry.name;
+				m.param = save_data_load_param(m.path);
+				m.info  = save_data_search_info(m.path);
+				matches.push_back(std::move(m));
+			}
+		}
+	}
+
+	std::sort(matches.begin(), matches.end(),
+	          [](const Match& a, const Match& b) { return std::strcmp(a.name.c_str(), b.name.c_str()) < 0; });
+	switch (cond->key) {
+		case SaveDataSortKey::UserParam:
+			std::stable_sort(matches.begin(), matches.end(),
+			                 [](const Match& a, const Match& b) { return a.param.user_param < b.param.user_param; });
+			break;
+		case SaveDataSortKey::Blocks:
+			std::stable_sort(matches.begin(), matches.end(),
+			                 [](const Match& a, const Match& b) { return a.info.blocks < b.info.blocks; });
+			break;
+		case SaveDataSortKey::Mtime:
+			std::stable_sort(matches.begin(), matches.end(),
+			                 [](const Match& a, const Match& b) { return a.param.mtime < b.param.mtime; });
+			break;
+		case SaveDataSortKey::FreeBlocks:
+			std::stable_sort(matches.begin(), matches.end(),
+			                 [](const Match& a, const Match& b) { return a.info.free_blocks < b.info.free_blocks; });
+			break;
+		case SaveDataSortKey::DirName: break;
+	}
+	if (cond->order == SaveDataSortOrder::Descent) {
+		std::reverse(matches.begin(), matches.end());
+	}
+
+	const size_t max_count =
+	    result->dir_names == nullptr ? 0 : std::min<size_t>(result->dir_names_num, matches.size());
+
+	result->hit_num = static_cast<uint32_t>(matches.size());
+	result->set_num = static_cast<uint32_t>(max_count);
+
+	for (size_t i = 0; i < max_count; i++) {
+		std::snprintf(result->dir_names[i].data, sizeof(result->dir_names[i].data), "%s",
+		              matches[i].name.c_str());
+		if (result->params != nullptr) {
+			result->params[i] = matches[i].param;
+		}
+		if (result->infos != nullptr) {
+			result->infos[i] = matches[i].info;
+		}
+		if ((g_bc5_save_trace && ::Log::Bc5LoggingOn())) {
+			std::fprintf(stderr, "save trace: search[%zu] %s user_param %u mtime %" PRId64 " blocks %" PRIu64 " free %" PRIu64 "\n",
+			             i, matches[i].name.c_str(), matches[i].param.user_param, matches[i].param.mtime,
+			             matches[i].info.blocks, matches[i].info.free_blocks);
+		}
+	}
+
+	return OK;
+}
+
+int KYTY_SYSV_ABI SaveDataMount3(const SaveDataMount3* mount, SaveDataMountResult* mount_result) {
+	PRINT_NAME();
+
+	EXIT_NOT_IMPLEMENTED(mount == nullptr);
+	EXIT_NOT_IMPLEMENTED(mount_result == nullptr);
+	EXIT_NOT_IMPLEMENTED(mount->dir_name == nullptr);
+
+	LOGF("\t user_id       = %d\n"
+	     "\t dir_name      = %s\n"
+	     "\t blocks        = %" PRIu64 "\n"
+	     "\t system_blocks = %" PRIu64 "\n"
+	     "\t mount_mode    = %" PRIu32 "\n"
+	     "\t resource      = %" PRId32 "\n",
+	     mount->user_id, mount->dir_name->data, mount->blocks, mount->system_blocks,
+	     mount->mount_mode, mount->resource);
+
+	*mount_result = {};
+
+	Common::LockGuard lock(g_mount_mutex);
+	const std::string dir_name = mount->dir_name->data;
+	const std::string mount_dir =
+	    std::string(SAVE_DATA_DIR) + "/" + get_title_id() + "/" + dir_name;
+	const bool create  = ((mount->mount_mode & 4u) != 0);
+	const bool create2 = ((mount->mount_mode & 32u) != 0);
+	const bool open    = (!create && !create2 && ((mount->mount_mode & 3u) != 0));
+
+	const int slot = g_mount_slots.FindAvailable(dir_name);
+	if (slot == SaveDataMountSlots::BUSY) {
+		return SAVE_DATA_ERROR_BUSY;
+	}
+	if (slot == SaveDataMountSlots::FULL) {
+		return SAVE_DATA_ERROR_MOUNT_FULL;
+	}
+
+	if (!create && !create2 && !open) {
+		LOGF("\t SaveDataMount: unknown mount mode 0x%08" PRIx32 "\n", mount->mount_mode);
+		g_mount_slots.Release(static_cast<size_t>(slot));
+		return SAVE_DATA_ERROR_PARAMETER;
+	}
+
+	if (open && !Common::File::IsDirectoryExisting(mount_dir)) {
+		return SAVE_DATA_ERROR_NOT_FOUND;
+	}
+
+	if (create && Common::File::IsDirectoryExisting(mount_dir)) {
+		return SAVE_DATA_ERROR_EXISTS;
+	}
+
+	bool created = false;
+	if ((create || create2) && !Common::File::IsDirectoryExisting(mount_dir)) {
+		Common::File::CreateDirectories(mount_dir);
+		created = true;
+
+		if (!Common::File::IsDirectoryExisting(mount_dir)) {
+			// The host refused to create the save directory (permissions, read-only
+			// medium). Report it to the guest instead of aborting the title.
+			g_mount_slots.Release(static_cast<size_t>(slot));
+			return SAVE_DATA_ERROR_NO_PERMISSION;
+		}
+	}
+
+	// BC5 (blocks): the size the title asked for is kept with the save it created (AnyPS5 mount3);
+	// a save from before this had no record and gets one from the first mount that names a size.
+	if (mount->blocks != 0 &&
+	    (created || !Common::File::IsFileExisting(save_data_blocks_path(Common::FixFilenameSlash(mount_dir))))) {
+		save_data_keep_blocks(Common::FixFilenameSlash(mount_dir), mount->blocks);
+	}
+
+	return mount_save_data(slot, dir_name, mount_dir, created ? 1u : 0u, mount_result);
+}
+
+// BC5 (run 115): the save data memory lives in a file, so that a save outlasts the process — the
+// game saves through sceSaveDataSetSaveDataMemory2 only, and this library kept the memory in a
+// vector. The file is _SaveData/<title>/sce_sdmemory/memory.dat under the working directory, or
+// under KYTY_BC5_SAVEDATA_DIR when that is set; it is read once, before the first use, and
+// rewritten (temporary file, then rename) after every set.
+static std::mutex g_save_data_memory_mutex;
+static bool       g_save_data_memory_loaded = false;
+
+static std::string save_data_memory_dir() {
+	const char* root = std::getenv("KYTY_BC5_SAVEDATA_DIR");
+	return std::string(root != nullptr && root[0] != 0 ? root : SAVE_DATA_DIR) + "/" + get_title_id() + "/sce_sdmemory";
+}
+
+static void save_data_memory_load() {
+	if (g_save_data_memory_loaded) {
+		return;
+	}
+	g_save_data_memory_loaded = true;
+	const std::string path    = save_data_memory_dir() + "/memory.dat";
+	std::FILE*        f       = std::fopen(path.c_str(), "rb");
+	if (f == nullptr) {
+		LOGF("\t save data memory: no file at %s\n", path.c_str());
+		return;
+	}
+	std::vector<uint8_t> data;
+	uint8_t              buf[65536];
+	size_t               n = 0;
+	while ((n = std::fread(buf, 1, sizeof(buf), f)) > 0) {
+		data.insert(data.end(), buf, buf + n);
+	}
+	std::fclose(f);
+	if (data.size() > g_save_data_memory.size()) {
+		g_save_data_memory.resize(data.size());
+	}
+	if (!data.empty()) {
+		std::memcpy(g_save_data_memory.data(), data.data(), data.size());
+	}
+	LOGF("\t save data memory: %zu bytes read from %s\n", data.size(), path.c_str());
+}
+
+static void save_data_memory_store() {
+	const std::string dir = save_data_memory_dir();
+	std::error_code   ec;
+	std::filesystem::create_directories(dir, ec);
+	const std::string path = dir + "/memory.dat";
+	const std::string tmp  = path + ".tmp";
+	std::FILE*        f    = std::fopen(tmp.c_str(), "wb");
+	if (f == nullptr) {
+		LOGF("\t save data memory: cannot write %s\n", tmp.c_str());
+		return;
+	}
+	const size_t written = std::fwrite(g_save_data_memory.data(), 1, g_save_data_memory.size(), f);
+	const bool   ok      = (std::fclose(f) == 0 && written == g_save_data_memory.size());
+	if (!ok || std::rename(tmp.c_str(), path.c_str()) != 0) {
+		LOGF("\t save data memory: writing %s failed\n", path.c_str());
+		std::remove(tmp.c_str());
+		return;
+	}
+	LOGF("\t save data memory: %zu bytes written to %s\n", written, path.c_str());
+}
