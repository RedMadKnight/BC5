+bool Network::HttpValid(Id http_ctx_id) {
+	Common::LockGuard lock(m_mutex);
+
+	return (http_ctx_id.GetType() == Id::Type::Http && http_ctx_id.GetId() >= 0 &&
+	        http_ctx_id.GetId() < HTTP_MAX && m_http[http_ctx_id.GetId()].used);
+}
