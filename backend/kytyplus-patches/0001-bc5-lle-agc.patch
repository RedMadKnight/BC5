+static bool Bc5UsbKnownDevice(void* device) {
+	auto&           st = Bc5Usb();
+	std::lock_guard lock(st.mutex);
+	return Bc5UsbKnownDeviceLocked(st, device);
+}
+
+static bool Bc5UsbKnownHandle(void* handle) {
+	auto&           st = Bc5Usb();
+	std::lock_guard lock(st.mutex);
+	return handle != nullptr && st.handles.count(handle) != 0;
+}
