 };
 
+// BC5: the adaptive trigger's state as libScePad reports it, from the last effect the game set
+// per trigger and the trigger's analog value. Layout and values from duaLib's public header
+// (github.com/WujekFoliarz/duaLib, MIT: `scePadGetTriggerEffectState(int handle, int state[2])`,
+// SCE_PAD_TRIGGER_STATE_* 1..7) and the state machine of KytyPS5 pull request #1132 (GPL-2.0),
+// which fixed ASTRO BOT's frog gloves upstream: the game sets a weapon effect {start 3, end 5,
+// strength 3} and waits for WEAPON_FULLY_PRESSED before it punches.
+//   0 off; feedback 1 no force / 2 pushing; weapon 3 not pressed / 4 almost / 5 fully pressed
+//   (latched until the trigger drops below the start); vibration 6 not firing / 7 firing.
+// The trigger's position is 0 for 0, 9 for 255, else 1 + value / 32 (nonuniform travel).
+struct Bc5TriggerEffect {
+	uint32_t mode     = 0;
+	uint8_t  data[48] = {};
+	bool     fired    = false; // weapon: FULLY_PRESSED latched
+};
+static Bc5TriggerEffect g_bc5_effect[2];
+
+static int32_t Bc5TriggerEffectState(Bc5TriggerEffect& e, int value) {
+	const int pos = value <= 0 ? 0 : (value >= 255 ? 9 : 1 + value / 32);
+	switch (e.mode) {
+		case 1: // feedback: position, strength
+			return (e.data[1] != 0 && pos >= e.data[0]) ? 2 : 1;
+		case 2: { // weapon: start, end, strength
+			if (value < e.data[0] * 32) {
+				e.fired = false;
+				return 3;
+			}
+			const int end = e.data[1] * 32 < 254 ? e.data[1] * 32 : 254;
+			if (e.fired || value >= end) {
+				e.fired = true;
+				return 5;
+			}
+			return 4;
