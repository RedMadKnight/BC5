+static const std::vector<std::pair<uint32_t, uint32_t>>& uconfig_force() {
+	static const std::vector<std::pair<uint32_t, uint32_t>> v = [] {
+		std::vector<std::pair<uint32_t, uint32_t>> r;
+		if (const char* e = std::getenv("BC5_DIRECT_UCONFIG_FORCE"); e != nullptr) {
+			for (const char* c = e; *c != 0;) {
+				char*               end = nullptr;
+				const unsigned long reg = std::strtoul(c, &end, 16);
+				if (end == c || *end != ':') break;
+				const unsigned long val = std::strtoul(end + 1, &end, 16);
+				r.emplace_back(static_cast<uint32_t>(reg & 0xffffu), static_cast<uint32_t>(val));
+				c = (*end == ',') ? end + 1 : end;
+			}
+		}
+		return r;
+	}();
+	return v;
+}
+static std::pair<uint32_t, uint32_t> ge_probe_range() {
+	static const std::pair<uint32_t, uint32_t> r = [] {
+		std::pair<uint32_t, uint32_t> v {0, 0};
+		if (const char* e = BC5_DIAG_ENV("BC5_DIRECT_GE_PROBE"); e != nullptr) {
+			unsigned a = 0, b = 0;
+			if (std::sscanf(e, "%u:%u", &a, &b) == 2) v = {a, b};
+		}
+		return v;
+	}();
+	return r;
