+// BC5 (rumble): one place for the two motor bytes to leave the host. The native DualSense driver
+// opens a device on Windows only (dualsense.cpp, OpenWindows), so on the box the path that reaches
+// the pad is SDL's game-controller rumble on the controller window.cpp opened for slot 0; SDL
+// takes the motors as 16-bit values, low frequency (large) first.
+// TODO(verify): which actuator the console drives for each byte of scePadSetVibration; the
+// large/small naming here follows dualsense.h and AnyPS5 (large = the vibration stream's left
+// channel), neither of which was checked against a console.
+// BC5 (experiment 0267): the write to the pad happens on a thread of its own. SDL_JoystickRumble
+// takes the joystick lock, which the window thread holds while it scans /dev/input on a hotplug,
+// and then does an ioctl and a write on the device; called from the title's pad thread
+// (scePadSetVibration) or its audio thread (the vibration-port fallback), that could hold them
+// for the length of a scan. The latest value wins; nothing waits.
+namespace {
+struct RumbleOutput {
+	std::mutex              mutex;
+	std::condition_variable cv;
+	uint8_t                 large = 0, small = 0;
+	uint32_t                duration_ms = 0;
+	uint64_t                seq         = 0;
+};
+RumbleOutput& RumbleOut() {
+	static RumbleOutput r;
+	return r;
+}
+
+// The write itself. A pad window.cpp opened as a raw joystick (no game-controller mapping, as can
+// happen after a replug) has no SDL_GameController, so the joystick API is the fallback; a failure
+// is logged once per pad instance (KYTY_BC5_INPUT_TRACE=1 logs every change too).
+void RumbleWrite(uint8_t large, uint8_t small, uint32_t duration_ms) {
+	auto* ds = static_cast<Libs::DualSense::DualSenseDriver*>(DualSenseDriverInstance());
+	if (ds != nullptr && ds->IsOpen()) {
+		Libs::DualSense::VibrationParam v;
+		v.large_motor = large;
+		v.small_motor = small;
+		ds->SetVibration(v);
+	}
+	if (g_controller == nullptr) {
+		return;
+	}
+	const int id = g_controller->InstanceId(0);
+	if (id < 0) {
+		return;
+	}
+	const auto  lo  = static_cast<Uint16>(static_cast<unsigned>(large) * 257u);
+	const auto  hi  = static_cast<Uint16>(static_cast<unsigned>(small) * 257u);
+	int         rc  = -1;
+	const char* via = "none";
+	if (SDL_GameController* pad = SDL_GameControllerFromInstanceID(id); pad != nullptr) {
+		rc  = SDL_GameControllerRumble(pad, lo, hi, duration_ms);
+		via = "game controller";
+	} else if (SDL_Joystick* joy = SDL_JoystickFromInstanceID(id); joy != nullptr) {
+		rc  = SDL_JoystickRumble(joy, lo, hi, duration_ms);
+		via = "raw joystick";
+	}
+	static const bool trace     = std::getenv("KYTY_BC5_INPUT_TRACE") != nullptr;
+	static int        failed_id = -1;
+	if (rc != 0 && failed_id != id) {
+		failed_id = id;
+		LOGF("rumble: pad instance %d via %s: %s\n", id, via,
+		     std::strcmp(via, "none") == 0 ? "no SDL device for this instance id" : SDL_GetError());
+	} else if (rc == 0 && failed_id == id) {
+		failed_id = -1;
+	}
+	if (trace) {
+		std::fprintf(stderr, "input trace: rumble %u/%u for %u ms via %s -> %d\n", large, small, duration_ms, via, rc);
+	}
+}
+
+void RumbleThread() {
+	auto&    out  = RumbleOut();
+	uint64_t seen = 0;
+	for (;;) {
+		uint8_t  large       = 0;
+		uint8_t  small       = 0;
+		uint32_t duration_ms = 0;
+		{
+			std::unique_lock<std::mutex> lock(out.mutex);
+			out.cv.wait(lock, [&] { return out.seq != seen; });
+			seen        = out.seq;
+			large       = out.large;
+			small       = out.small;
+			duration_ms = out.duration_ms;
+		}
+		RumbleWrite(large, small, duration_ms);
+	}
+}
+} // namespace
+
+void ControllerRumble(uint8_t large, uint8_t small, uint32_t duration_ms) {
+	static const bool started = [] {
+		std::thread(RumbleThread).detach();
+		return true;
+	}();
+	(void)started;
+	auto& out = RumbleOut();
+	{
+		std::lock_guard<std::mutex> lock(out.mutex);
+		out.large       = large;
+		out.small       = small;
+		out.duration_ms = duration_ms;
+		out.seq++;
+	}
+	out.cv.notify_one();
+}
+
+// Ported from AnyPS5 core/libs/prx/libScePad/src/PadState.cpp @ 7f596df (GPL-2.0):
+// PadSubmitAudioHaptics keeps the maximum of the values submitted and PadFetchOutput releases
+// them 80 ms after the last non-zero submission. Here the value goes out when it changes, and is
+// refreshed every 40 ms while non-zero because SDL's rumble runs for a duration (100 ms here).
+void ControllerAudioRumble(uint8_t large, uint8_t small) {
+	using Clock = std::chrono::steady_clock;
+	static std::mutex        mutex;
+	static uint8_t           held_large = 0, held_small = 0, sent_large = 0, sent_small = 0;
+	static Clock::time_point hold_end, sent_at;
+	std::lock_guard<std::mutex> lock(mutex);
+	const auto                  now = Clock::now();
+	if (now >= hold_end) {
+		held_large = held_small = 0;
+	}
+	if (large != 0 || small != 0) {
+		held_large = std::max(held_large, large);
+		held_small = std::max(held_small, small);
+		hold_end   = now + std::chrono::milliseconds(80);
+	}
+	const bool changed = held_large != sent_large || held_small != sent_small;
+	const bool refresh = (held_large != 0 || held_small != 0) && now - sent_at >= std::chrono::milliseconds(40);
+	if (changed || refresh) {
+		ControllerRumble(held_large, held_small, 100);
+		sent_large = held_large;
+		sent_small = held_small;
+		sent_at    = now;
+	}
+}
+
+// BC5: KYTY_BC5_INPUT_RECORD=<file> writes what the real pad does as KYTY_BC5_INPUT_CMD lines
+// (hold/release, stick, trigger, with wait lines between them), so that a route played once by
+// hand can be replayed by a script. Stick moves are written at most every 30 ms, when one axis
+// moved by more than 6. The scripted input itself (id -1000) is not recorded.
+static std::mutex g_rec_mutex;
+static FILE*      Bc5RecFile() {
+	static FILE* f = [] {
+		const char* path = BC5_DIAG_ENV("KYTY_BC5_INPUT_RECORD");
+		return (path != nullptr && *path != 0) ? std::fopen(path, "w") : nullptr;
+	}();
+	return f;
+}
+static void Bc5RecLine(const char* line) { // the caller holds g_rec_mutex
+	static auto last = std::chrono::steady_clock::now();
+	static bool first = true;
+	const auto  now   = std::chrono::steady_clock::now();
+	const auto  ms    = std::chrono::duration_cast<std::chrono::milliseconds>(now - last).count();
+	FILE*       f     = Bc5RecFile();
+	if (!first && ms > 0) std::fprintf(f, "wait %lld\n", static_cast<long long>(ms));
+	first = false;
+	last  = now;
+	std::fprintf(f, "%s\n", line);
+	std::fflush(f);
+}
+static void Bc5RecButton(int id, uint32_t button, bool down) {
+	if (id == -1000 || Bc5RecFile() == nullptr) return;
+	static const std::pair<const char*, uint32_t> names[] = {
+	    {"cross", PAD_BUTTON_CROSS}, {"circle", PAD_BUTTON_CIRCLE}, {"square", PAD_BUTTON_SQUARE},
+	    {"triangle", PAD_BUTTON_TRIANGLE}, {"options", PAD_BUTTON_OPTIONS}, {"up", PAD_BUTTON_UP},
+	    {"down", PAD_BUTTON_DOWN}, {"left", PAD_BUTTON_LEFT}, {"right", PAD_BUTTON_RIGHT},
+	    {"l1", PAD_BUTTON_L1}, {"r1", PAD_BUTTON_R1}, {"l2", PAD_BUTTON_L2}, {"r2", PAD_BUTTON_R2},
+	    {"l3", PAD_BUTTON_L3}, {"r3", PAD_BUTTON_R3}, {"touchpad", PAD_BUTTON_TOUCH_PAD}};
+	std::lock_guard lock(g_rec_mutex);
+	for (const auto& [name, bit]: names) {
+		if ((button & bit) == 0) continue;
+		char line[64];
+		std::snprintf(line, sizeof(line), "%s %s", down ? "hold" : "release", name);
+		Bc5RecLine(line);
+	}
+}
+static void Bc5RecAxis(int id, Axis axis, int value) {
+	if (id == -1000 || Bc5RecFile() == nullptr) return;
+	static int  cur[6] = {128, 128, 128, 128, 0, 0}, written[6] = {128, 128, 128, 128, 0, 0};
+	static auto last_write = std::chrono::steady_clock::now();
+	const int   a          = static_cast<int>(axis);
+	if (a < 0 || a >= 6) return;
+	std::lock_guard lock(g_rec_mutex);
+	cur[a] = value;
+	if (std::abs(cur[a] - written[a]) <= 6 && !(value == 128 && a < 4 && written[a] != 128) && !(value == 0 && a >= 4 && written[a] != 0)) return;
+	const auto now = std::chrono::steady_clock::now();
+	const bool settle = (a < 4 && value == 128) || (a >= 4 && value == 0); // a stick back to rest is never dropped
+	if (!settle && now - last_write < std::chrono::milliseconds(30)) return;
+	last_write = now;
+	char line[64];
+	if (a < 4) {
+		const int sx = a < 2 ? 0 : 2;
+		std::snprintf(line, sizeof(line), "stick %s %d %d", a < 2 ? "l" : "r", cur[sx], cur[sx + 1]);
+		written[sx]     = cur[sx];
+		written[sx + 1] = cur[sx + 1];
+	} else {
+		std::snprintf(line, sizeof(line), "trigger %s %d", a == 4 ? "l2" : "r2", cur[a]);
+		written[a] = cur[a];
+	}
+	Bc5RecLine(line);
+}
+
+void ControllerButton(int id, uint32_t button, bool down) {
+	EXIT_IF(g_controller == nullptr);
+	Bc5RecButton(id, button, down);
+	g_controller->Button(id, button, down);
+}
+
+void ControllerAxis(int id, Axis axis, int value) {
+	EXIT_IF(g_controller == nullptr);
+	Bc5RecAxis(id, axis, value);
+	g_controller->Axis(id, axis, value);
+}
