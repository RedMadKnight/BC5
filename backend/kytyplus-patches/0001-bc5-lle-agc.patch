+static void AprWorkerThread(size_t qi) {
+	char name[16];
+	std::snprintf(name, sizeof(name), "bc5-apr-q%zu", qi);
+	pthread_setname_np(pthread_self(), name);
+	std::unique_lock<std::recursive_mutex> lock(g_apr_queue_mutex);
+	auto&                                  queue = g_apr_parked[qi];
+	for (;;) {
+		while (queue.empty()) {
+			g_apr_queue_cv.wait(lock);
+		}
+		// Only this thread pops this queue, and a deque's push_back keeps references valid, so the
+		// front can run with the queue unlocked and submitters never wait for a batch.
+		ParkedAprBuffer& front  = queue.front();
+		int32_t          result = OK;
+		uint32_t         offset = 0;
+		if (AprReadahead() > 0) { // BC5 (experiment 0203): KYTY_BC5_APR_READAHEAD
+			while (front.ra_state == 1) {
+				// exp 0216: the reader sets 2 and notifies under the lock; the 50-ms limit is only a safety net
+				g_apr_queue_cv.wait_for(lock, std::chrono::milliseconds(50));
+			}
+			if (front.ra_state == 0) {
+				front.ra_state = 4;
+			}
+		}
+		const bool prefetched = front.ra_state == 2;
+		lock.unlock();
+		const bool done = RunOrderedAprCommands(front.command_buffer, front.state, front.ordered, &front.next, &result, &offset,
+		                                        prefetched ? &front.ra_data : nullptr, prefetched ? &front.ra_rc : nullptr);
+		lock.lock();
+		if (!done) {
+			g_apr_queue_cv.wait_for(lock, std::chrono::microseconds(500));
+			continue;
+		}
+		FinishAprSubmission(front, result, offset);
+		if (AmmTrace()) {
+			AmmTraceStamp(), std::fprintf(stderr, "amm trace: submission 0x%016" PRIx64 " finished on worker %zu = 0x%08x\n", front.command_buffer, qi,
+			                              static_cast<unsigned>(result));
+		}
+		if (prefetched) {
+			g_apr_ra_bytes -= std::min(g_apr_ra_bytes, AprReadBytes(front));
+		}
+		queue.pop_front();
+		if (AprReadahead() > 0) {
+			g_apr_queue_cv.notify_all(); // the freed read-ahead budget may let a reader go on
+		}
+	}
