+	std::lock_guard<std::mutex> lock(g_input_mutex);
+	const auto&                 map     = Map();
+	auto                        control = map.FindKey(key_code);
+	const char*                 origin  = "configuration";
+	if (control == INVALID_CONTROL && map.DefaultKeys()) {
+		// The built-in layout, minus the controls the configuration binds elsewhere.
+		control = DefaultControlForKey(key_code);
+		origin  = "built-in layout";
+		if (control != INVALID_CONTROL && map.ControlBound(control)) {
+			control = INVALID_CONTROL;
+			origin  = "built-in layout, control bound elsewhere";
+		}
+	}
+	// BC5: KYTY_BC5_INPUT_TRACE=1 writes every key to stderr with what it does.
+	if (Trace()) {
+		std::fprintf(stderr, "input trace: t=%.3f key %d (%s) %s -> %s (%s)\n",
+		             Controller::InputTraceSeconds(), key_code,
+		             SDL_GetKeyName(static_cast<SDL_Keycode>(key_code)), down ? "down" : "up",
+		             control == INVALID_CONTROL ? "nothing" : std::string(Info(control).name).c_str(), origin);
+		std::fflush(stderr);
+	}
+	if (control == INVALID_CONTROL) {
+		return;
+	}
+	const double now = NowSeconds();
+	if (down) {
+		g_pending.erase(key_code); // a repeat pair: the key stays held
+		g_down_at[key_code] = now;
+		SetControl(control, true);
+		return;
+	}
+	const auto   it   = g_down_at.find(key_code);
+	const double held = it != g_down_at.end() ? (now - it->second) * 1000.0 : 1e9;
+	if (held < MinHoldMs()) {
+		g_pending[key_code] = PendingRelease {control, it->second + MinHoldMs() / 1000.0};
+		StartReleaseThread();
+		g_pending_cv.notify_all();
+		if (Trace()) {
+			std::fprintf(stderr, "input trace: t=%.3f release of %s held back, the press lasted %.1f ms\n",
+			             Controller::InputTraceSeconds(), std::string(Info(control).name).c_str(), held);
+			std::fflush(stderr);
+		}
+		return;
