+// Experiment 0301: MangoHud in every build. Its Vulkan layer is an implicit layer that the loader
+// enables for MANGOHUD=1 (MangoHud's mangohud.json.in, enable_environment), and the layer reads its
+// whole configuration from MANGOHUD_CONFIG when that is set (no file is read without read_cfg;
+// overlay_params.cpp parse_overlay_config, v0.8.2). The layout is the one of the former
+// tools/scripts/mangohud-bc5.conf: no fps or frame time, since the window presents at every vblank
+// whatever the title's rate (its own counter, KYTY_BC5_OSD_FPS, shows that), and no GPU clock,
+// which amdgpu's gpu_metrics does not report reliably on the BC-250. no_display starts it hidden;
+// control=<name> makes it listen on an abstract unix socket and toggle no_display for each ":hud;"
+// it reads (control.cpp parse_command), between two presents (vulkan.cpp snapshot_swapchain_frame).
+// While hidden it draws nothing and records nothing (render_swapchain_display, update_hud_info).
+constexpr const char* MANGOHUD_LAYOUT =
+    "legacy_layout=false,position=top-left,font_size=20,background_alpha=0.45,round_corners=6,"
+    "fps_sampling_period=500,cpu_stats,cpu_temp,cpu_mhz,cpu_power,gpu_name,gpu_stats,gpu_temp,gpu_power,vram,"
+    "ram,resolution,time,"
+    // MangoHud's keys (X11 only, they do not reach it from the container), away from F1, F2 and F11
+    "toggle_hud=Shift_R+F12,toggle_logging=Shift_L+F10,toggle_fps_limit=Shift_L+F9,reload_cfg=Shift_L+F4";
+
