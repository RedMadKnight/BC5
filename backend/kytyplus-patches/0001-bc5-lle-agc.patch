+static void Bc5AutoPress(std::string plan) {
+	pthread_setname_np(pthread_self(), "bc5-autopress");
+	const auto start = std::chrono::steady_clock::now();
+	size_t     pos   = 0;
+	while (pos < plan.size()) {
+		size_t end = plan.find(',', pos);
+		if (end == std::string::npos) end = plan.size();
+		const std::string item  = plan.substr(pos, end - pos);
+		pos                     = end + 1;
+		const size_t      colon = item.find(':');
+		if (colon == std::string::npos) continue;
+		const double      at   = std::atof(item.substr(0, colon).c_str());
+		const std::string what = item.substr(colon + 1);
+		std::this_thread::sleep_until(start + std::chrono::milliseconds(static_cast<int64_t>(at * 1000.0)));
+		if (what == "shake") {
+			for (int k = 0; k < 40; k++) {
+				const float a[3] = {(k & 1) != 0 ? 3.0f : -3.0f, 1.0f, (k & 1) != 0 ? -2.0f : 2.0f};
