+		if (what == "circle") button = PAD_BUTTON_CIRCLE;
+		if (what == "square") button = PAD_BUTTON_SQUARE;
+		if (what == "triangle") button = PAD_BUTTON_TRIANGLE;
+		if (what == "options") button = PAD_BUTTON_OPTIONS;
+		if (button == 0) continue;
+		ControllerButton(-1000, button, true);
+		std::this_thread::sleep_for(std::chrono::milliseconds(150));
+		ControllerButton(-1000, button, false);
+		LOGF("[bc5] autopress: %s at %.1f s\n", what.c_str(), at);
+	}
