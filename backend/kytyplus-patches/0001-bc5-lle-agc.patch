+std::filesystem::path MountPoints::GetRealFilename(const std::string& bc5_guest_name) {
+	Common::LockGuard lock(m_mutex);
+
+	// Experiment 0405 (KYTY_BC5_FS_FIXES sk05): off, mounted_file_name is the caller's name, as today; on, the normalised
+	// name, in the directory form when it names a mount point without its '/' (KK35).
+	const bool  bc5_sk05 = Bc5FsFix(BC5_FS_SK05);
+	std::string bc5_normalized;
+	if (bc5_sk05) {
+		bc5_normalized = Bc5NormalizeGuestPath(Common::FixFilenameSlash(bc5_guest_name));
+		for (const auto& p: m_mount_pairs) {
+			if (bc5_normalized + "/" == p.point) {
+				bc5_normalized += "/";
+				break;
+			}
+		}
+	}
+	const std::string& mounted_file_name = bc5_sk05 ? bc5_normalized : bc5_guest_name;
+
+	auto mounted_path =
+	    Common::DirectoryWithoutFilename(Common::FixFilenameSlash(mounted_file_name));
+
+	auto it = std::find_if(
+	    m_mount_pairs.begin(), m_mount_pairs.end(),
+	    [&mounted_path](const MountPair& p) { return Common::StartsWith(mounted_path, p.point); });
+	if (bc5_sk05) {
+		it = Bc5LongestMount(m_mount_pairs, mounted_path); // experiment 0405 (sk05): the longest mount point
+	}
+	if (it != m_mount_pairs.end()) {
+		const auto& p = *it;
+		auto        rel_path =
+		    Common::RemoveFirst(Common::FixFilenameSlash(mounted_file_name), p.point.size());
+		while (Common::StartsWith(rel_path, '/')) {
+			rel_path = Common::RemoveFirst(rel_path, 1);
+		}
+#if KYTY_PLATFORM == KYTY_PLATFORM_WINDOWS
+		if (HasWindowsForbiddenFilenameCharacter(rel_path)) {
+			::printf("FileSystem: Windows-incompatible guest filename: %s\n",
+			         mounted_file_name.c_str());
+		}
+		return p.dir / rel_path;
+#else
+		// BC5: KYTY_BC5_APP0_OVERRIDE=<dir> serves <dir>/<path> in place of /app0/<path> when it exists.
+		static const char* app0_override = std::getenv("KYTY_BC5_APP0_OVERRIDE");
+		if (app0_override != nullptr && app0_override[0] != 0 && Common::StartsWith(p.point, "/app0")) {
+			std::error_code ec;
+			const auto      o = std::filesystem::path(app0_override) / rel_path;
+			if (std::filesystem::is_regular_file(o, ec)) {
+				::printf("FileSystem: %s served from %s\n", mounted_file_name.c_str(), o.c_str());
+				return o;
+			}
+		}
+		return ResolvePathIgnoringCase(p.dir / rel_path);
+#endif
+	}
+
+	// BC5 (KytyPS5 a107d1e): a guest path under no mount point must not reach the host's
+	// file system; an empty path says so, and every caller answers ENOENT.
+	return {};
+}
+
+std::filesystem::path MountPoints::GetRealDirectory(const std::string& bc5_guest_directory) {
+	Common::LockGuard lock(m_mutex);
+
+	// Experiment 0405 (KYTY_BC5_FS_FIXES sk05): off, mounted_directory is the caller's name, as today; on, normalised.
+	const bool  bc5_sk05 = Bc5FsFix(BC5_FS_SK05);
+	std::string bc5_normalized;
+	if (bc5_sk05) {
+		bc5_normalized = Bc5NormalizeGuestPath(Common::FixFilenameSlash(bc5_guest_directory));
+	}
+	const std::string& mounted_directory = bc5_sk05 ? bc5_normalized : bc5_guest_directory;
+
+	auto mounted_path = Common::FixDirectorySlash(mounted_directory);
+
+	auto it = std::find_if(
+	    m_mount_pairs.begin(), m_mount_pairs.end(),
+	    [&mounted_path](const MountPair& p) { return Common::StartsWith(mounted_path, p.point); });
+	if (bc5_sk05) {
+		it = Bc5LongestMount(m_mount_pairs, mounted_path); // experiment 0405 (sk05): the longest mount point
+	}
+	if (it != m_mount_pairs.end()) {
+		const auto& p = *it;
+		auto        rel_path =
+		    Common::RemoveFirst(Common::FixDirectorySlash(mounted_directory), p.point.size());
+		while (Common::StartsWith(rel_path, '/')) {
+			rel_path = Common::RemoveFirst(rel_path, 1);
+		}
+#if KYTY_PLATFORM == KYTY_PLATFORM_WINDOWS
+		return p.dir / rel_path;
+#else
+		return ResolvePathIgnoringCase(p.dir / rel_path);
+#endif
+	}
+
+	return {}; // BC5 (KytyPS5 a107d1e): see GetRealFilename
+}
