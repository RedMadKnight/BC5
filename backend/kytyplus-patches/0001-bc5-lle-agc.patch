+struct SpecWait {
+	uint32_t pkt[10];
+	bool     is64;
+	uint64_t since;
+};
+static std::mutex             g_spec_mutex;
+static std::vector<SpecWait>  g_spec;
+static std::atomic<uint64_t>  g_spec_waits {0}, g_spec_fired {0};
+static void spec_watchdog() {
+	pthread_setname_np(pthread_self(), "bc5-wdog");
+	for (;;) {
+		std::this_thread::sleep_for(std::chrono::milliseconds(1));
+		std::lock_guard lk(g_spec_mutex);
+		const uint64_t  now = SoftCp::now_ns();
+		for (size_t k = 0; k < g_spec.size();) {
+			SpecWait& w = g_spec[k];
+			if (wait_satisfied(w.pkt, w.is64)) {
+				g_spec[k] = g_spec.back();
+				g_spec.pop_back();
+				continue;
+			}
+			if (now - w.since >= spec_wait_ns()) {
+				// The awaited value, as the wait compares it: reference under the mask, the rest kept.
+				const uint64_t a    = (w.pkt[2] & ~3u) | (static_cast<uint64_t>(w.pkt[3] & 0xffffu) << 32u);
+				const uint32_t fn   = w.pkt[1] & 7u;
+				if (w.is64) {
+					const uint64_t ref = w.pkt[4] | (static_cast<uint64_t>(w.pkt[5]) << 32u), mask = w.pkt[6] | (static_cast<uint64_t>(w.pkt[7]) << 32u);
+					auto*          v   = reinterpret_cast<volatile uint64_t*>(a & ~7ull);
+					const uint64_t was = *v;
+					*v                 = (was & ~mask) | ((fn == 6 || fn == 4 ? ref + 1 : (fn == 1 ? ref - 1 : ref)) & mask);
+					journal("spec watchdog: label 0x%" PRIx64 " function %u still 0x%" PRIx64 " after %.1f ms; wrote 0x%" PRIx64 " (%" PRIu64 " fired)\n", a, fn, was,
+					        static_cast<double>(now - w.since) / 1e6, *v, ++g_spec_fired);
+				} else {
+					const uint32_t ref = w.pkt[4], mask = w.pkt[5];
+					auto*          v   = reinterpret_cast<volatile uint32_t*>(a & ~3ull);
+					const uint32_t was = *v;
+					*v                 = (was & ~mask) | ((fn == 6 || fn == 4 ? ref + 1 : (fn == 1 ? ref - 1 : ref)) & mask);
+					journal("spec watchdog: label 0x%" PRIx64 " function %u still 0x%x after %.1f ms; wrote 0x%x (%" PRIu64 " fired)\n", a, fn, was,
+					        static_cast<double>(now - w.since) / 1e6, *v, ++g_spec_fired);
+				}
+				g_spec[k] = g_spec.back();
+				g_spec.pop_back();
+				continue;
+			}
+			k++;
+		}
+	}
+}
+static void spec_watch(const uint32_t* p, uint32_t len, bool is64) {
+	static std::once_flag once;
+	std::call_once(once, [] { std::thread(spec_watchdog).detach(); });
+	SpecWait w {};
+	for (uint32_t k = 0; k < len && k < 10; k++) w.pkt[k] = p[k];
+	w.is64  = is64;
+	w.since = SoftCp::now_ns();
+	std::lock_guard lk(g_spec_mutex);
+	g_spec.push_back(w);
+	if ((g_spec_waits++ & 0x3ffu) == 0) journal("spec waits: %" PRIu64 " graphics waits left to the GPU before their compute writer, %" PRIu64 " released by the watchdog\n", g_spec_waits.load(), g_spec_fired.load());
+}
