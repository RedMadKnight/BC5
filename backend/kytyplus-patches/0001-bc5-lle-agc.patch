+// BC5 (experiment 0042): KYTY_BC5_RANGE_WATCH=lo:hi (hex) writes every edit of the guest's ranges
+// that overlaps [lo, hi) to stderr, with the monotonic clock (the direct path's journal prints its
+// own zero on that clock once, "bc5 clock").
+static void Bc5RangeWatch(const char* what, uint64_t start, uint64_t size, int protection, int type, const char* name, bool ok) {
+	static const std::pair<uint64_t, uint64_t> w = [] {
+		const char* e = BC5_DIAG_ENV("KYTY_BC5_RANGE_WATCH");
+		if (e == nullptr) return std::pair<uint64_t, uint64_t> {0, 0};
+		char*          end = nullptr;
+		const uint64_t lo  = std::strtoull(e, &end, 16);
+		const uint64_t hi  = (end != nullptr && *end == ':') ? std::strtoull(end + 1, nullptr, 16) : 0;
+		return std::pair<uint64_t, uint64_t> {lo, hi};
+	}();
+	if (w.second == 0 || start + size <= w.first || start >= w.second) return;
+	timespec ts {};
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	std::fprintf(stderr, "range watch: mono %.3f %s 0x%" PRIx64 "+0x%" PRIx64 " prot %d type %d %s%s\n",
+	             static_cast<double>(ts.tv_sec) + static_cast<double>(ts.tv_nsec) / 1e9, what, start, size, protection, type,
+	             name != nullptr ? name : "", ok ? "" : " (refused)");
+}
