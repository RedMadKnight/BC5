+static uint32_t Bc5MoveSdkVersion() {
+	static const uint32_t v = [] {
+		uint32_t       out  = 0x0A000000u;
+		const uint64_t pp   = Loader::Bc5ProcParam();
+		uint64_t       size = 0;
+		uint64_t       sdk  = 0;
