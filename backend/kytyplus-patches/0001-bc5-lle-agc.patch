+	if (!Lzr0401::due(o, g_lzr, now) || merged != 0) return out;
+	static Lzr0401::Covers cov;
+	static uint64_t        cov_sig = 0;
+	static bool            cov_ok  = false;
+	if (!cov_ok || cov_sig != sig) {
