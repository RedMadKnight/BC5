+			pthread_setname_np(pthread_self(), "kyty-pipeline"); // BC5 (F81)
+			WorkerLoop();
+		});
 	}
 	LOGF("AsyncPipelineCompiler: started %zu worker threads\n", kWorkerCount);
 }
