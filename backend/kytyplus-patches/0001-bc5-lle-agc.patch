+	if (r.timed_out) timeout_probe(sub_ib, sub_n, kind, g_submits.load(), &r.executed_offsets); // experiment 0160
+	if (r.pending) { // BC5_DIRECT_ASYNC: the completion thread waits for it and journals the result
+		g_ok++;
+		chain_mark_executed(chain, ib, num_dwords, r.executed_offsets);
+		for (const auto& nb: r.nested) {
+			SoftCp::set_gpu_executed(reinterpret_cast<const uint32_t*>(nb.cpu_addr), nb.num_dwords, nb.executed_offsets);
+		}
+		CqItem it;
+		it.fence          = true;
+		it.job.n          = n;
+		it.job.kind       = kind;
+		it.job.num_dwords = num_dwords;
+		it.job.ib         = ib;
+		if (BC5_DIAG_ENV("BC5_DIRECT_TIMEOUT_PROBE") != nullptr) { it.job.ib_copy.assign(sub_ib, sub_ib + sub_n); it.job.ran_copy = r.executed_offsets; } // experiment 0160
