+// Experiment 0405 (KYTY_BC5_FS_FIXES kk04): a host name, compared without its trailing '/' (a directory opened with
+// O_DIRECTORY keeps its name with one).
+static std::string Bc5HostKey(const std::filesystem::path& p) {
+	std::string s = p.generic_string();
+	while (s.size() > 1 && s.back() == '/') {
+		s.pop_back();
+	}
+	return s;
+}
+
+// Experiment 0405 (kk04): the descriptors of a file that was replaced or unlinked keep their file (Linux keeps an open
+// file's inode) and lose its host name, so that the path functions that look an open file up by its host name
+// (KernelTruncate, KernelUnlink) do not take them for a newer file of that name (sharpemu 1811cef's rule).
+void FileDescriptors::Bc5Forget(const std::filesystem::path& real_name) {
+	const std::string key = Bc5HostKey(real_name);
+	if (key.empty()) {
+		return;
+	}
+	Common::LockGuard lock(m_mutex);
+	for (auto* f: m_files) {
+		if (f != nullptr && !f->real_name.empty() && Bc5HostKey(f->real_name) == key) {
+			Common::LockGuard file_lock(f->mutex);
+			f->real_name.clear();
+		}
+	}
+}
+
+// Experiment 0405 (kk04): after a rename on the host the open descriptors follow it, as on FreeBSD (a descriptor names
+// a vnode, not a path): those of the source and of anything under a renamed directory take the new host name, those of
+// a replaced target lose theirs (Bc5Forget).
+void FileDescriptors::Bc5Rename(const std::filesystem::path& from, const std::filesystem::path& to) {
+	const std::string from_key = Bc5HostKey(from);
+	const std::string to_key   = Bc5HostKey(to);
+	if (from_key.empty() || to_key.empty() || from_key == to_key) {
+		return;
+	}
+	Bc5Forget(to);
+	Common::LockGuard lock(m_mutex);
+	for (auto* f: m_files) {
+		if (f == nullptr || f->real_name.empty()) {
+			continue;
+		}
+		const std::string s = Bc5HostKey(f->real_name);
+		if (s == from_key) {
+			Common::LockGuard file_lock(f->mutex);
+			f->real_name = to;
+		} else if (s.size() > from_key.size() && s.compare(0, from_key.size(), from_key) == 0 && s[from_key.size()] == '/') {
+			Common::LockGuard file_lock(f->mutex);
+			f->real_name = std::filesystem::path(to_key + s.substr(from_key.size()));
+		}
+	}
+}
+
+void MountPoints::Mount(const std::filesystem::path& folder, const std::string& point) {
+	Common::LockGuard lock(m_mutex);
+
+	auto folder_str = Common::FixDirectorySlash(Common::PathToGenericString(folder));
+	auto point_str  = Common::FixDirectorySlash(point);
+
+	Umount(point_str);
+
+	MountPair p;
+	p.dir   = folder_str;
+	p.point = point_str;
+
+	m_mount_pairs.push_back(p);
+}
+
+void MountPoints::Umount(const std::string& folder_or_point) {
+	Common::LockGuard lock(m_mutex);
+
+	auto folder_or_point_str = Common::FixDirectorySlash(folder_or_point);
+
+	const auto it = std::find_if(
+	    m_mount_pairs.begin(), m_mount_pairs.end(), [&folder_or_point_str](const MountPair& p) {
+		    return Common::PathToGenericString(p.dir) == folder_or_point_str ||
+		           p.point == folder_or_point_str;
+	    });
+	if (it != m_mount_pairs.end()) {
+		m_mount_pairs.erase(it);
+	}
+}
+
+#if KYTY_PLATFORM != KYTY_PLATFORM_WINDOWS
+// BC5 (experiment 0022): for a file that does not exist the resolver below listed the whole
+// directory to look for a name differing only in case. ASTRO BOT asks for some 17,000 missing
+// files while its first level loads, in directories of up to 12,000 entries behind the game
+// image's FUSE mount, under the mount table's lock: the load took four minutes for it. The
+// names of a directory are kept, folded to lower case, while its modification time is unchanged.
+// Returns the real name for `name`, empty when the directory has none that matches.
+static std::string Bc5FoldedLookup(const std::filesystem::path& dir, const std::string& name) {
+	struct Entry {
+		bool                                         filled = false;
+		std::filesystem::file_time_type              mtime {};
+		std::unordered_map<std::string, std::string> names;
+	};
+	static std::mutex                             mutex;
+	static std::unordered_map<std::string, Entry> cache;
+	auto fold = [](std::string text) {
+		for (auto& c: text) {
+			c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+		}
+		return text;
+	};
+	std::error_code ec;
+	const auto      mtime = std::filesystem::last_write_time(dir, ec);
+	if (ec) {
+		return {};
+	}
+	std::lock_guard lock(mutex);
+	auto&           e = cache[dir.string()];
+	if (!e.filled || e.mtime != mtime) {
+		e.names.clear();
+		e.mtime  = mtime;
+		e.filled = true;
+		for (std::filesystem::directory_iterator entry(dir, ec), end; entry != end; entry.increment(ec)) {
+			if (ec) {
+				break;
+			}
+			const std::string real = entry->path().filename().string();
+			e.names.emplace(fold(real), real); // the first of several that differ only in case, as before
+		}
+	}
+	const auto found = e.names.find(fold(name));
+	return found != e.names.end() ? found->second : std::string();
+}
+
+// Resolve guest paths case-insensitively on case-sensitive hosts.
+static std::filesystem::path ResolvePathIgnoringCase(const std::filesystem::path& path) {
+	std::error_code ec;
+	if (std::filesystem::exists(path, ec)) {
+		return path;
+	}
+
+	// Preserve unmatched components for the caller's ENOENT path.
+	std::filesystem::path resolved =
+	    path.has_root_path() ? path.root_path() : std::filesystem::path(".");
+	bool matched = true;
+
+	for (const auto& component: path.relative_path()) {
+		if (component.empty()) {
+			continue;
+		}
+
+		auto candidate = resolved / component;
+		if (!matched || std::filesystem::exists(candidate, ec)) {
+			resolved = std::move(candidate);
+			continue;
+		}
+
+		bool found = false;
+		if (const std::string real = Bc5FoldedLookup(resolved, component.string()); !real.empty()) {
+			resolved /= real;
+			found = true;
+		}
+
+		if (!found) {
+			resolved = std::move(candidate);
+			matched  = false;
+		}
+	}
+
+	return resolved;
+}
+#else
+static bool HasWindowsForbiddenFilenameCharacter(const std::string& relative_path) {
+	return relative_path.find_first_of("<>:\"|?*") != std::string::npos;
+}
+#endif
