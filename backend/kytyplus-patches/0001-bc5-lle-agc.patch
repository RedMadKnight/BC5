+							        kind, num_dwords, i, label, kept ? "kept for the GPU" : (ok ? "satisfied" : "NOT served"), static_cast<double>(SoftCp::now_ns() - t1) / 1e6,
+							        split ? ", head split off" : "", n_two.load(), n_two_split.load(), n_two_kept.load(), n_two_ok.load(), n_two_lost.load());
+						}
+						frame_profile_wait(on_game_thread(), false, static_cast<double>(SoftCp::now_ns() - t0) / 1e6);
+						if (kept) {
+							t_keep_waits.push_back(p);
