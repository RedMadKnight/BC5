+			const char* e = BC5_DIAG_ENV("BC5_DIRECT_WATCH_VA");
+			if (e == nullptr) return std::pair<uint64_t, uint64_t> {0, 0};
+			char*          end = nullptr;
+			const uint64_t lo  = std::strtoull(e, &end, 16);
+			const uint64_t hi  = (end != nullptr && *end == ':') ? std::strtoull(end + 1, nullptr, 16) : lo + 0x1000;
+			return std::pair<uint64_t, uint64_t> {lo, hi};
+		}();
