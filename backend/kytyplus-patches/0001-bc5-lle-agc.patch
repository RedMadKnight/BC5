+			// under g_apr_queue_mutex: a submit, and the worker's pop_front, which frees read-ahead budget and
+			// moves the window. The 5-ms poll it replaces cost the idle readers about 1.6 % of one core (exp 0214).
+			// The 1-s limit is a safety net: the wait thread's pump (StartAprWaitThread) pops without a notify.
+			g_apr_queue_cv.wait_for(lock, std::chrono::seconds(1));
+			continue;
+		}
+		pick->ra_state = 1; // the worker leaves it in the queue until it is 2, so the reference stays valid
+		lock.unlock();
+		const auto&                       reads = pick->state.read_file_commands;
+		std::vector<std::vector<uint8_t>> data(reads.size());
+		std::vector<int32_t>              rc(reads.size(), OK);
+		for (size_t r = 0; r < reads.size(); r++) {
+			std::string host_path;
+			rc[r] = AprShared::TryGetHostPath(reads[r].file_id, &host_path)
+			            ? ReadHostFileToHost(host_path, reads[r].file_offset, reads[r].size, &data[r])
+			            : LibKernel::KERNEL_ERROR_ENOENT;
+			if (pick->state.bc5_journal && AprJournalFile(reads[r].file_id)) { // KYTY_BC5_APR_FILE_JOURNAL
+				AprJournal("readahead cb 0x%016" PRIx64 " read file 0x%08" PRIx32 " +0x%" PRIx64 " size 0x%" PRIx64 " = 0x%08x, 0x%zx bytes into host memory",
+				           pick->command_buffer, reads[r].file_id, reads[r].file_offset, reads[r].size,
+				           static_cast<unsigned>(rc[r]), data[r].size());
+			}
+		}
+		lock.lock();
+		pick->ra_data  = std::move(data);
+		pick->ra_rc    = std::move(rc);
+		pick->ra_state = 2;
+		g_apr_queue_cv.notify_all();
+	}
+}
