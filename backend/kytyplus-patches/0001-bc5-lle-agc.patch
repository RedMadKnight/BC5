+static void StartAprWaitThread() {
+	static std::once_flag once;
+	std::call_once(once, [] {
+		std::thread([] {
+			pthread_setname_np(pthread_self(), "bc5-apr-wait");
+			for (;;) {
+				std::this_thread::sleep_for(std::chrono::microseconds(500));
