+		     "\t sub_title  = %s\n"
+		     "\t detail     = %s\n"
+		     "\t user_param = %u\n",
+		     p->title, p->sub_title, p->detail, p->user_param);
+
+		// BC5 (params): kept in the save's .param sidecar for the search and GetParam (AnyPS5
+		// store_param); before this the call was a log line and the search reported zeros.
+		if (p != nullptr && param_buf_size >= sizeof(SaveDataParam)) {
+			Common::LockGuard lock(g_mount_mutex);
+			const int         slot = g_mount_slots.Find(mount_point->data);
+			if (slot >= 0) {
+				save_data_store_param(save_data_title_root() + "/" +
