+					}
+					// Experiment 0055: BC5_DIRECT_DCB_WAIT_UNBLOCKED_MS=<ms> — while the compute queue is not
+					// blocked on a label of its own, what this game-thread wait needs is on its way (the
+					// second title's scene change: a label the compute work set to 0 14-15 ms into a wait
+					// given up at 8 ms), so the wait gets that long; the short limit stays for a blocked
+					// queue, where a cycle is possible.
+					static const uint64_t unblocked_ns = (std::getenv("BC5_DIRECT_DCB_WAIT_UNBLOCKED_MS") ? std::strtoull(std::getenv("BC5_DIRECT_DCB_WAIT_UNBLOCKED_MS"), nullptr, 10) : 0ull) * 1'000'000ull;
+					const bool            adaptive     = unblocked_ns > limit && limit == dcb_ns && std::strcmp(kind, "acb") != 0 && on_game_thread();
+					if (!broken && (!g_dev || !g_dev->wedged())) {
+						while (!(ok = wait_satisfied(p, op == 0x93))) {
+							const uint64_t now = SoftCp::now_ns() - t0;
+							if (now >= (adaptive && g_unready_label.load() == 0 ? unblocked_ns : limit)) break;
+							std::this_thread::sleep_for(std::chrono::microseconds(50));
+						}
+					}
+					if (!ok && pieces_full() && dry_here && on_game_thread() && i > start && g_stage != Stage::MapOnly && (!g_dev || !g_dev->wedged())) {
+						if ((start > 0 || prefix_all()) && !full_prefix.empty()) submit_prefixed(full_prefix, ib + start, i - start, false);
+						else submit_one(ib + start, i - start, kind, from_header && start == 0);
+						chain_flush(1); // ADR 0010
+						full_prefix = prefix_of(*dry);
+						const uint32_t head_from = start;
+						start                    = i;
+						full_used                = true;
+						const uint64_t t1        = SoftCp::now_ns();
+						while (!(ok = wait_satisfied(p, op == 0x93))) {
+							if (SoftCp::now_ns() - t1 >= limit) break;
+							std::this_thread::sleep_for(std::chrono::microseconds(50));
+						}
+						g_full_pieces++;
+						(ok ? g_full_ok : g_full_failed)++;
+						static std::atomic<uint32_t> n_logged {0};
+						if (n_logged++ < 100) {
+							journal("piece: %s %u..%u of %u dwords went ahead of the wait at %u on 0x%" PRIx64 "; the wait then %s after %.1f ms; rest behind a prefix of %zu dwords\n",
+							        kind, head_from, i, num_dwords, i, label, ok ? "satisfied" : "not satisfied", static_cast<double>(SoftCp::now_ns() - t1) / 1e6,
+							        full_prefix.size());
+						}
+					}
+					if (!ok && op == 0x93 && len >= 8) {
+						journal("  wait detail: function %u, value 0x%" PRIx64 ", reference 0x%" PRIx64 ", mask 0x%" PRIx64 "\n", p[1] & 7u,
+						        *reinterpret_cast<const volatile uint64_t*>(label & ~7ull), p[4] | (static_cast<uint64_t>(p[5]) << 32u), p[6] | (static_cast<uint64_t>(p[7]) << 32u));
+					}
+					if (!ok || journal_all()) journal("cpu-wait %s at %u on 0x%" PRIx64 ": %s after %.1f ms\n", op == 0x93 ? "WAIT_REG_MEM64" : "WAIT_REG_MEM", i, label, ok ? "satisfied" : (broken ? "CYCLE" : (limit < 1'000'000'000ull ? "GIVEN UP" : "TIMEOUT")), static_cast<double>(SoftCp::now_ns() - t0) / 1e6);
+					if (!ok) t_wait_given_up = true;
+					if (dry_here) (ok ? g_dry_ok : g_dry_failed)++;
+					frame_profile_wait(on_game_thread(), false, static_cast<double>(SoftCp::now_ns() - t0) / 1e6);
+					static const bool timing_waits_env = std::getenv("BC5_DIRECT_TIMING") != nullptr;
+					const bool timing_waits = timing_waits_env && ::Log::Bc5LoggingOn();
+					if (timing_waits) journal("timing: t %.3f s after that wait (%s %u dwords)\n", timing_now(), kind, num_dwords);
+					SoftCp::set_gpu_executed(p, len, {0}); // the soft CP must not wait again
+				}
+			}
+		}
+		i += len;
+	}
+	if ((start > 0 || prefix_all()) && full_used && !full_prefix.empty()) {
+		submit_prefixed(full_prefix, ib + start, num_dwords - start, false);
+		return;
+	}
+	if (start > 0) {
+		uint32_t        n   = 0;
+		const uint32_t* pre = state_prefix(ib, start, &n);
+		static std::atomic<uint64_t> n_rest {0};
+		if (journal_sample(n_rest, 0x3ffu)) journal("%s rest %u..%u of %u dwords: state prefix of %u dwords replayed first\n", kind, start, num_dwords, num_dwords, n);
+		if (pre != nullptr) submit_one(pre, n, "dcb-state", false);
+		submit_one(ib + start, num_dwords - start, kind, false);
+		return;
+	}
+	submit_one(ib, num_dwords, kind, from_header);
+}
