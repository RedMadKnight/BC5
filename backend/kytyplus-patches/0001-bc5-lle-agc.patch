+// BC5 (NpManager callbacks). Ported from AnyPS5 core/libs/prx/libSceNpManager/Export.cpp
+// @ 7f596df (GPL-2.0), lines 11-130 and the Register/Unregister exports: PSN is not emulated, so
+// every user is signed out (state 1) and a title that registers a state callback is told so once,
+// from its own sceNpCheckCallback, as on a console whose user is signed out. Up to eight
+// sceNpRegisterStateCallbackA callbacks (the id is the slot plus one; a null or an already
+// registered function is refused), one legacy sceNpRegisterStateCallback, and one reachability
+// callback, retained and never called (reachability stays 0, unavailable). Error codes as AnyPS5
+// (shadPS4's PS4 values).
+// TODO(verify): the signed-out error this file answers is 0x80550006 (np_error_signed_out) where
+// libNp.cpp answers 0x80550005 (NP_NOT_SIGNED_IN); AnyPS5 uses 0x80550006 (shadPS4's PS4 value).
+// Which the console gives a signed-out user is unverified on both sides.
+constexpr int      np_error_callback_already_registered = -2141913080; /* 0x80550008 */
+constexpr int      np_error_callback_not_registered     = -2141913079; /* 0x80550009 */
+constexpr int      np_error_callback_max                = -2141913059; /* 0x8055001D */
+constexpr uint32_t NP_STATE_SIGNED_OUT                  = 1;
+constexpr int      NP_STATE_CALLBACK_MAX                = 8;
+constexpr int      NP_INITIAL_USER_ID                   = 1000; // libUserService.cpp, UserServiceGetInitialUser
+
+struct NpStateCallbackSlotA {
+	NpStateCallbackA callback = nullptr;
+	void*            userdata = nullptr;
+	bool             pending  = false;
+};
+
+struct NpStateCallbackSlot {
+	NpStateCallback callback = nullptr;
+	void*           userdata = nullptr;
+	bool            pending  = false;
+};
+
+static Common::Mutex                                         g_np_state_mutex;
+static std::array<NpStateCallbackSlotA, NP_STATE_CALLBACK_MAX> g_np_state_callbacks_a;
+static NpStateCallbackSlot                                   g_np_state_callback;
+static void*                                                 g_np_reachability_callback = nullptr;
+static void*                                                 g_np_reachability_userdata = nullptr;
+
+int KYTY_SYSV_ABI NpCheckCallback() {
+	PRINT_NAME();
+
+	// The pending callbacks are copied and cleared under the lock, then called without it: a
+	// callback may register or unregister another one.
+	std::array<NpStateCallbackSlotA, NP_STATE_CALLBACK_MAX> callbacks_a;
+	NpStateCallbackSlot                                      legacy;
+	{
+		Common::LockGuard lock(g_np_state_mutex);
+		callbacks_a = g_np_state_callbacks_a;
+		legacy      = g_np_state_callback;
+		for (auto& slot: g_np_state_callbacks_a) {
+			slot.pending = false;
+		}
+		g_np_state_callback.pending = false;
+	}
+	if (legacy.pending && legacy.callback != nullptr) {
+		LOGF("\t state callback: user %d signed out\n", NP_INITIAL_USER_ID);
+		legacy.callback(NP_INITIAL_USER_ID, NP_STATE_SIGNED_OUT, nullptr, legacy.userdata);
+	}
+	for (int i = 0; i < NP_STATE_CALLBACK_MAX; i++) {
+		const auto& slot = callbacks_a[static_cast<size_t>(i)];
+		if (slot.pending && slot.callback != nullptr) {
+			LOGF("\t state callback %d: user %d signed out\n", i + 1, NP_INITIAL_USER_ID);
+			slot.callback(NP_INITIAL_USER_ID, NP_STATE_SIGNED_OUT, slot.userdata);
+		}
+	}
+
+	return OK;
+}
