+	std::lock_guard<std::mutex> lock(g_input_mutex);
+	Map();
+	return g_config_path;
+}
+
+bool HostInputApply(const std::vector<std::string>& lines, std::string* error) {
+	std::vector<std::pair<std::string, std::string>> numbered;
+	for (std::size_t i = 0; i < lines.size(); i++) {
+		numbered.emplace_back(lines[i], "line " + std::to_string(i + 1));
+	}
+	auto map = std::make_unique<InputMap>();
+	if (!map->Load(numbered, error)) {
+		return false;
+	}
+	std::lock_guard<std::mutex> lock(g_input_mutex);
+	ReleaseAll();
+	g_pending.clear();
+	map->Log();
+	g_map = std::move(map);
+	return true;
+}
+
+bool HostInputSave(const std::string& path, const std::vector<std::string>& lines, std::string* error) {
+	const std::string tmp = path + ".tmp";
+	{
+		std::ofstream file(tmp, std::ios::trunc);
+		if (!file) {
+			if (error != nullptr) {
+				*error = "cannot write " + tmp;
+			}
+			return false;
+		}
+		file << "# BC5 input configuration, written by the settings overlay (F2). Hand edits are fine;\n"
+		        "# the grammar and the names are in backend/kytyplus-patches/input.example.cfg.\n";
+		for (const auto& line: lines) {
+			file << line << '\n';
+		}
+	}
+	if (std::rename(tmp.c_str(), path.c_str()) != 0) {
+		if (error != nullptr) {
+			*error = "cannot replace " + path;
+		}
+		return false;
+	}
+	return true;
+}
+
+void HostInputReleaseAll() {
+	std::lock_guard<std::mutex> lock(g_input_mutex);
+	Map();
+	ReleaseAll();
+	g_pending.clear();
+}
+
 } // namespace Libs::Graphics
