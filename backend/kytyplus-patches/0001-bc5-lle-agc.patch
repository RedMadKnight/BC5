+	    gpu_available == nullptr) {
+		return KERNEL_ERROR_EFAULT;
+	}
+
+	const auto cpu_used =
+	    (g_virtual_ranges != nullptr ? g_virtual_ranges->CountPageTableEntries(false) : 0);
+	const auto gpu_used =
+	    (g_virtual_ranges != nullptr ? g_virtual_ranges->CountPageTableEntries(true) : 0);
