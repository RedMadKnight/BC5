+// Bit i: TABLES[i]'s switch is on. Read once; the first call prints the line.
+static uint32_t On() {
+	static const uint32_t on = [] {
+		uint32_t    bits = 0;
+		std::string items;
+		for (size_t i = 0; i < TABLE_COUNT; i++) {
+			const char* e = std::getenv(TABLES[i].env);
+			if (e != nullptr && e[0] != '\0' && std::strcmp(e, "0") != 0) {
+				bits |= 1u << i;
+				items += items.empty() ? "" : ",";
+				items += TABLES[i].item;
+			}
+		}
+		if (bits == 0) {
