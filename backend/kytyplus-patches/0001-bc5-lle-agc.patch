+static std::atomic<bool>     g_rt_on {[] { const char* e = std::getenv("KYTY_BC5_RT"); return !(e != nullptr && e[0] == '0' && e[1] == 0); }()};
+static std::atomic<int>      g_rt_pending {-1};
