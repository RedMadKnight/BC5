+	if (ret == OK && addr != nullptr && *addr != nullptr) {
+		const auto out_addr = reinterpret_cast<uint64_t>(*addr);
+		g_physical_memory->SetVirtualRangeMemoryType(out_addr, len, type);
+		g_virtual_ranges->SetMemoryType(out_addr, len, type);
