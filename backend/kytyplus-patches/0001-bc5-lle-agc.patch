+bool GetMainPass(uint32_t* w, uint32_t* h) {
+#if defined(KYTY_BC5_DIRECT)
+	*w = g_main_w.load(std::memory_order_relaxed);
+	*h = g_main_h.load(std::memory_order_relaxed);
+	return *w != 0;
+#else
+	*w = *h = 0;
+	return false;
+#endif
