-int KYTY_SYSV_ABI Select(int nfds, void* readfds, void* writefds, void* exceptfds,
-                         const void* timeout) {
-	PRINT_NAME();
-
-	if (nfds < 0 || nfds > SOCKET_FD_MAX) {
-		*Posix::GetErrorAddr() = Posix::POSIX_EINVAL;
