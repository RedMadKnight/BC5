+// The GPU writes flip labels here (EOP flips); the driver reads them back to know a flip landed.
+static KYTY_SYSV_ABI int GetBufferLabelAddress(int handle, uint64_t** out) {
+	PRINT_NAME();
+	if (out == nullptr) {
+		return LibKernel::KERNEL_ERROR_EINVAL;
+	}
+	*out = Bc5Gc::g_labels;
+	LOGF("[bc5-gc] VideoOutGetBufferLabelAddress(%d) -> %p\n", handle, static_cast<void*>(*out));
+	return 0;
+}
+
+// (handle, index, flip_mode, flip_arg, ...): treated as a CPU flip for now.
+// TODO(bc5): the EOP part (flip when the GPU reaches the end of the submitted DCB).
+static KYTY_SYSV_ABI int SubmitEopFlip(int handle, int index, int flip_mode, int64_t flip_arg,
+                                       void* unk) {
+	PRINT_NAME();
+	// Direct mode: does the GPU write the display buffer? A sparse sum over the surface, journaled
+	// per flip (zero = nobody rendered into it; the game's last pass targets these very buffers).
+	if (std::getenv("BC5_GC_MODE") != nullptr && std::strcmp(std::getenv("BC5_GC_MODE"), "direct") == 0) {
+		uint64_t a = 0, n = 0;
+		if (VideoOut::Bc5VideoOutBufferRange(handle, index, &a, &n) && a != 0 && n != 0) {
+			const auto* w = reinterpret_cast<const volatile uint32_t*>(a);
+			uint64_t sum = 0, nonzero = 0, samples = 0;
+			for (uint64_t k = 0; k < n / 4; k += 1024, samples++) {
+				const uint32_t v = w[k];
+				sum += v;
+				nonzero += v != 0;
+			}
+			Bc5Gc::Direct::journal("flip %d/%d buffer 0x%" PRIx64 " +0x%" PRIx64 ": sum 0x%" PRIx64 " nonzero %" PRIu64 "/%" PRIu64 "\n", handle, index, a, n, sum, nonzero, samples);
+			// Do any render targets or depth buffers receive pixels at all? Sample 4 MiB from each
+			// base the hint mapper saw (run 60: the flip buffer stays zero with sane counters).
+			for (const auto& t: Bc5Gc::Direct::g_recent_targets) {
+				const auto* tw = reinterpret_cast<const volatile uint32_t*>(t.second);
+				uint64_t nz = 0, smp = 0;
+				std::vector<uint32_t> vals;
+				for (uint64_t k = 0; k < (4u << 20u) / 4; k += 1024, smp++) { const uint32_t v = tw[k]; nz += v != 0; vals.push_back(v); }
+				std::sort(vals.begin(), vals.end());
+				const size_t distinct = static_cast<size_t>(std::unique(vals.begin(), vals.end()) - vals.begin());
+				// a clear leaves one value, rasterised content many (run 62: are the draws real?)
+				Bc5Gc::Direct::journal("  target %s 0x%" PRIx64 ": distinct %zu min 0x%08x max 0x%08x, ", t.first, t.second, distinct, vals.front(), vals[distinct - 1]);
+				Bc5Gc::Direct::journal("  target %s 0x%" PRIx64 ": nonzero %" PRIu64 "/%" PRIu64 "\n", t.first, t.second, nz, smp);
+			}
+			LOGF("[bc5-direct] flip buffer 0x%" PRIx64 ": nonzero samples %" PRIu64 "/%" PRIu64 "\n", a, nonzero, samples);
+		}
+	}
+	LOGF("[bc5-gc] VideoOutSubmitEopFlip(%d, %d, %d, 0x%" PRIx64 ", %p)\n", handle, index,
+	     flip_mode, flip_arg, unk);
+	return VideoOut::VideoOutSubmitFlip(handle, index, flip_mode, flip_arg);
+}
