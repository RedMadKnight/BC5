-static NpRequest* np_get_request_locked(int req_id) {
-	if (req_id <= 0) {
-		return nullptr;
-	}
-
-	const auto index = static_cast<size_t>(req_id - 1);
-	if (index >= g_np_requests.size() || g_np_requests[index].state == NpRequestState::Free) {
-		return nullptr;
-	}
-
-	return &g_np_requests[index];
-}
