+static KYTY_SYSV_ABI int SysGetBus(int handle) {
+	PRINT_NAME();
+	static int logged = 0;
+	if (Bc5Gc::gc_log_few(&logged)) {
+		LOGF("[bc5-gc] VideoOutSysGetBus(%d) -> 0\n", handle);
