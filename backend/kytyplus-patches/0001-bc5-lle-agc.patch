+int KYTY_SYSV_ABI NpRegisterStateCallback(NpStateCallback callback, void* userdata) {
+	PRINT_NAME();
+
+	LOGF("\t callback = %016" PRIx64 "\n", reinterpret_cast<uint64_t>(callback));
+
+	if (callback == nullptr) {
+		return np_error_invalid_argument;
+	}
+
+	Common::LockGuard lock(g_np_state_mutex);
+	if (g_np_state_callback.callback != nullptr) {
+		return np_error_callback_already_registered;
+	}
+	g_np_state_callback = {callback, userdata, true};
+
+	return OK;
+}
+
+int KYTY_SYSV_ABI NpUnregisterStateCallback() {
+	PRINT_NAME();
+
+	Common::LockGuard lock(g_np_state_mutex);
+	if (g_np_state_callback.callback == nullptr) {
+		return np_error_callback_not_registered;
+	}
+	g_np_state_callback = {};
+
+	return OK;
+}
+
+int KYTY_SYSV_ABI NpRegisterStateCallbackA(NpStateCallbackA callback, void* userdata) {
+	PRINT_NAME();
+
+	LOGF("\t callback = %016" PRIx64 "\n", reinterpret_cast<uint64_t>(callback));
+
+	if (callback == nullptr) {
+		return np_error_invalid_argument;
+	}
+
+	Common::LockGuard lock(g_np_state_mutex);
+	for (const auto& slot: g_np_state_callbacks_a) {
+		if (slot.callback == callback) {
+			return np_error_callback_already_registered;
+		}
+	}
+	for (int i = 0; i < NP_STATE_CALLBACK_MAX; i++) {
+		auto& slot = g_np_state_callbacks_a[static_cast<size_t>(i)];
+		if (slot.callback == nullptr) {
+			slot = {callback, userdata, true};
+			return i + 1;
+		}
+	}
+
+	return np_error_callback_max;
+}
+
+int KYTY_SYSV_ABI NpUnregisterStateCallbackA(int callback_id) {
+	PRINT_NAME();
+
+	LOGF("\t callback_id = %d\n", callback_id);
+
+	if (callback_id < 1 || callback_id > NP_STATE_CALLBACK_MAX) {
+		return np_error_invalid_argument;
+	}
+
+	Common::LockGuard lock(g_np_state_mutex);
+	auto&             slot = g_np_state_callbacks_a[static_cast<size_t>(callback_id - 1)];
+	if (slot.callback == nullptr) {
+		return np_error_callback_not_registered;
+	}
+	slot = {};
+
+	return OK;
+}
