+	const auto ms = [](int v) { std::this_thread::sleep_for(std::chrono::milliseconds(v)); };
+	uint32_t   held = 0;
+	const auto reset = [&] {
+		for (int a = 0; a < 4; a++) ControllerAxis(-1000, static_cast<Axis>(a), 128);
+		ControllerAxis(-1000, Axis::TriggerLeft, 0);
+		ControllerAxis(-1000, Axis::TriggerRight, 0);
