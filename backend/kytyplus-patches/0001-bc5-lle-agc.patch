+// BC5: KYTY_BC5_AUTOPRESS="47:cross,52:cross,480:shake,500:options" presses pad buttons (cross,
+// circle, square, triangle, options) or shakes the pad (two seconds of alternating acceleration)
+// at the given seconds after start — for unattended runs past the title screen. Nothing is
+// pressed without the variable.
+static void Bc5AutoPress(std::string plan) {
+	pthread_setname_np(pthread_self(), "bc5-autopress");
+	const auto start = std::chrono::steady_clock::now();
+	size_t     pos   = 0;
+	while (pos < plan.size()) {
+		size_t end = plan.find(',', pos);
+		if (end == std::string::npos) end = plan.size();
+		const std::string item  = plan.substr(pos, end - pos);
+		pos                     = end + 1;
+		const size_t      colon = item.find(':');
+		if (colon == std::string::npos) continue;
+		const double      at   = std::atof(item.substr(0, colon).c_str());
+		const std::string what = item.substr(colon + 1);
+		std::this_thread::sleep_until(start + std::chrono::milliseconds(static_cast<int64_t>(at * 1000.0)));
+		if (what == "shake") {
+			for (int k = 0; k < 40; k++) {
+				const float a[3] = {(k & 1) != 0 ? 3.0f : -3.0f, 1.0f, (k & 1) != 0 ? -2.0f : 2.0f};
+				const float w[3] = {(k & 1) != 0 ? 8.0f : -8.0f, 0.0f, 0.0f};
+				ControllerMotion(-1000, false, a);
+				ControllerMotion(-1000, true, w);
+				std::this_thread::sleep_for(std::chrono::milliseconds(50));
+			}
+			const float rest[3] = {0.0f, 1.0f, 0.0f}, still[3] = {0.0f, 0.0f, 0.0f};
+			ControllerMotion(-1000, false, rest);
+			ControllerMotion(-1000, true, still);
+			LOGF("[bc5] autopress: shake at %.1f s\n", at);
+			continue;
+		}
+		uint32_t button = 0;
+		if (what == "cross") button = PAD_BUTTON_CROSS;
+		if (what == "circle") button = PAD_BUTTON_CIRCLE;
+		if (what == "square") button = PAD_BUTTON_SQUARE;
+		if (what == "triangle") button = PAD_BUTTON_TRIANGLE;
+		if (what == "options") button = PAD_BUTTON_OPTIONS;
+		if (button == 0) continue;
+		ControllerButton(-1000, button, true);
+		std::this_thread::sleep_for(std::chrono::milliseconds(150));
+		ControllerButton(-1000, button, false);
+		LOGF("[bc5] autopress: %s at %.1f s\n", what.c_str(), at);
+	}
+}
