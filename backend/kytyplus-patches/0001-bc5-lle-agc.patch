+static void Bc5PrtAdd(uint64_t start, uint64_t end) {
+	auto it = g_bc5_prt.upper_bound(start);
+	if (it != g_bc5_prt.begin()) {
+		const auto prev = std::prev(it);
+		if (prev->second >= start) {
+			start = prev->first;
+			end   = std::max(end, prev->second);
+			it    = g_bc5_prt.erase(prev);
+		}
+	}
+	while (it != g_bc5_prt.end() && it->first <= end) {
+		end = std::max(end, it->second);
+		it  = g_bc5_prt.erase(it);
+	}
+	g_bc5_prt[start] = end;
+}
+
+static void Bc5PrtRemove(uint64_t start, uint64_t end) {
+	auto it = g_bc5_prt.upper_bound(start);
+	if (it != g_bc5_prt.begin()) {
+		--it;
+	}
+	while (it != g_bc5_prt.end() && it->first < end) {
+		const uint64_t s = it->first;
+		const uint64_t e = it->second;
+		if (e <= start) {
+			++it;
+			continue;
+		}
+		it = g_bc5_prt.erase(it);
+		if (s < start) {
+			g_bc5_prt[s] = start;
+		}
+		if (e > end) {
+			g_bc5_prt[end] = e;
+			break;
+		}
+	}
