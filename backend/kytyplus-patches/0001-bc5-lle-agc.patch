+#include "libs/libs.h"
+#include "loader/symbolDatabase.h"
+
+#if defined(KYTY_BC5_DIRECT)
+#include "bc5/direct.hpp"
+#include <sys/mman.h>
+#include <unistd.h>
+#endif
+
+#include <algorithm>
+#include <atomic>
