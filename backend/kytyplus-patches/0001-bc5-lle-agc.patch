-bool FlipQueue::Flip(uint32_t micros) {
-	KYTY_PROFILER_BLOCK("FlipQueue::Flip");
-
-	m_mutex.Lock();
-	if (m_requests.empty()) {
-		m_submit_cond_var.WaitFor(&m_mutex, micros);
