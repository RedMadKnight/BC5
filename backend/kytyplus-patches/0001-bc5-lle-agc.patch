+void HostMenuMangoHudSet(bool on) {
+	g_hud_on.store(on, std::memory_order_release);
+}
+
+bool HostMenuMangoHudOn() noexcept {
+	return g_hud_on.load(std::memory_order_acquire);
+}
+
+bool HostMenuMangoHudPending() noexcept {
+	return g_hud_socket[0] != 0 && !g_hud_lost.load(std::memory_order_acquire) &&
+	       g_hud_on.load(std::memory_order_acquire) != g_hud_shown.load(std::memory_order_acquire);
+}
+
+void HostMenuMangoHudSync() {
+	if (!HostMenuMangoHudPending()) {
+		return;
+	}
+	if (g_hud_fd < 0) {
+		// The layer opened its socket at vkCreateInstance, long before the first present; a refused
+		// connection means the layer is not there (not installed, or MANGOHUD=0).
+		const int fd = ::socket(AF_UNIX, SOCK_STREAM | SOCK_NONBLOCK | SOCK_CLOEXEC, 0);
+		if (fd < 0) {
+			MangoHudLost("socket", errno);
+			return;
+		}
+		sockaddr_un addr {};
+		addr.sun_family  = AF_UNIX;
+		const size_t len = std::strlen(g_hud_socket);
+		std::memcpy(addr.sun_path + 1, g_hud_socket, len); // abstract name: a leading NUL, no file (mesa os_socket.c)
+		if (::connect(fd, reinterpret_cast<sockaddr*>(&addr), static_cast<socklen_t>(offsetof(sockaddr_un, sun_path) + 1 + len)) != 0) {
+			const int e = errno;
+			::close(fd);
+			MangoHudLost("is not loaded", e);
+			return;
+		}
+		g_hud_fd = fd;
+		std::fprintf(stderr, "host menu: MangoHud control socket @%s connected\n", g_hud_socket);
+	}
+	// MangoHud greets each client with its version lines and answers nothing else: drop them.
+	char buf[256];
+	while (::recv(g_hud_fd, buf, sizeof(buf), MSG_DONTWAIT) > 0) {
+	}
+	if (::send(g_hud_fd, ":hud;", 5, MSG_DONTWAIT | MSG_NOSIGNAL) != 5) {
+		MangoHudLost("control socket", errno);
+		return;
+	}
+	const bool shown = !g_hud_shown.load(std::memory_order_acquire);
+	g_hud_shown.store(shown, std::memory_order_release);
+	std::fprintf(stderr, "host menu: MangoHud %s\n", shown ? "shown" : "hidden");
+}
+
+void HostMenuDraw(float width, float height, float scale) {
+	if (!g_visible.load(std::memory_order_acquire)) {
+		return;
+	}
+	auto&      s        = GetState();
+	const bool launcher = g_launcher.load(std::memory_order_acquire);
+	const bool has_dir  = MenuDir() != nullptr;
+	LoadRecent(s);
+
+	if (ImGui::BeginMainMenuBar()) {
+		if (ImGui::BeginMenu("File")) {
+			if (ImGui::MenuItem("Open game image...", nullptr, false, has_dir)) {
+				s.browser.Start(Kind::Image);
+			}
+			if (ImGui::MenuItem("Open package (.pkg)...", nullptr, false, has_dir)) {
+				s.browser.Start(Kind::Package);
+			}
+			if (ImGui::BeginMenu("Recent", has_dir && !s.recent.empty())) {
+				for (size_t i = 0; i < s.recent.size(); i++) {
+					const auto label = s.recent[i] + "##r" + std::to_string(i);
+					if (ImGui::MenuItem(label.c_str())) {
+						OpenPath(s, s.recent[i]);
+					}
+				}
+				ImGui::Separator();
+				if (ImGui::MenuItem("Clear list")) {
+					s.recent.clear();
+					WriteLines(MenuFile("recent.txt"), {});
+				}
+				ImGui::EndMenu();
+			}
+			if (!has_dir && ImGui::IsItemHovered(ImGuiHoveredFlags_AllowWhenDisabled)) {
+				ImGui::SetTooltip("Start the emulator through play-any.sh to open games from here.");
+			}
+			ImGui::Separator();
+			if (ImGui::MenuItem("Close session", nullptr, false, !launcher)) {
+				CloseSession();
+			}
+			if (ImGui::MenuItem("Quit")) {
+				Quit();
+			}
+			ImGui::EndMenu();
+		}
+		if (ImGui::BeginMenu("Emulation")) {
+			const bool paused = WindowIsPaused();
+			if (ImGui::MenuItem(paused ? "Resume" : "Pause", "Space", false, !launcher)) {
+				WindowSetPaused(!paused);
+			}
+			if (ImGui::MenuItem("Restart", nullptr, false, !launcher)) {
+				s.want_restart = true;
+			}
+			ImGui::Separator();
+			if (ImGui::MenuItem("Settings...", "F2")) {
+				SettingsOverlayOpen();
+			}
+			if (ImGui::MenuItem("Fullscreen", "F11", WindowIsFullscreen())) {
+				WindowSetFullscreen(!WindowIsFullscreen());
+			}
+			ImGui::Separator();
+			// The session's logging switch (journal, LOGF, traces, profile, tally); BC5_LOGGING=0 starts it off.
+			const bool logging = Log::Bc5LoggingOn();
+			if (ImGui::MenuItem(logging ? "Logging: on" : "Logging: off", nullptr, logging)) {
+				Log::Bc5SetLogging(!logging);
+				std::fprintf(stderr, "host menu: logging %s\n", logging ? "off" : "on");
+			}
+			// Experiment 0273: the ray-tracing switch (default on; KYTY_BC5_RT=0 or the title's
+			// RayTracing.<TITLE_ID>=off starts it off). It takes effect at the next flip and is saved per
+			// title into the input configuration, as the Video tab saves RenderScale.<TITLE_ID>.
+			{
+				bool rt = Libs::Bc5Gc::Direct::GetRayTracing();
+				if (ImGui::MenuItem("Ray tracing", nullptr, rt, !launcher)) {
+					rt = !rt;
+					Libs::Bc5Gc::Direct::SetRayTracing(rt);
+					SaveTitleSwitch("RayTracing", "ray tracing", rt);
+				}
+			}
+			// Experiment 0301: MangoHud's hardware figures and the title's frame rate (default off;
+			// KYTY_BC5_MANGOHUD=1 or the title's MangoHud.<TITLE_ID>=on starts it on). It shows or hides
+			// at the next present and is saved per title like the switch above.
+			{
+				bool hud = HostMenuMangoHudOn();
+				if (ImGui::MenuItem("MangoHud", nullptr, hud, !launcher)) {
+					hud = !hud;
+					HostMenuMangoHudSet(hud);
+					SaveTitleSwitch("MangoHud", "MangoHud", hud);
+				}
+				if (g_hud_lost.load(std::memory_order_acquire) && ImGui::IsItemHovered()) {
+					ImGui::SetTooltip("MangoHud is not loaded: only the game's frame rate is shown.");
+				}
+			}
+			// Experiment 0359: game fixes - TEMPORARY game-code workarounds, per title, saved like the switches above;
+			// applied at load, so a change takes effect at the next start.
+			if (ImGui::BeginMenu("Game fixes")) {
+				const int  v  = HostInputJobArenaFix();
+				const bool on = v == 1 || (v < 0 && HostInputTitleId() == "PPSA03671");
+				if (ImGui::MenuItem("Job-arena fix (temporary, next start)", nullptr, on, !launcher)) {
+					HostInputSetJobArenaFix(on ? 0 : 1);
+					SaveTitleSwitch("JobArenaFix", "job-arena fix", !on);
+				}
+				if (ImGui::IsItemHovered()) {
+					ImGui::SetTooltip("Wraps the title's frame-end job run on its main thread in the title's own arena window\n"
+					                  "(experiment 0359): a workaround for the null-arena crash at the fight. Takes effect at the\n"
+					                  "next start. To be removed once the host's throughput at the fight is fixed.");
+				}
+				ImGui::EndMenu();
+			}
+			ImGui::EndMenu();
+		}
+		if (ImGui::BeginMenu("Help")) {
+			if (ImGui::MenuItem("About")) {
+				s.want_about = true;
+			}
+			ImGui::EndMenu();
+		}
+		if (!launcher) {
+			const char* hint = Log::Bc5LoggingOn() ? "F1 / PS: hide menu" : "logging off   F1 / PS: hide menu";
+			ImGui::SameLine(ImGui::GetWindowWidth() - ImGui::CalcTextSize(hint).x - ImGui::GetStyle().ItemSpacing.x * 4.0f);
+			ImGui::TextDisabled("%s", hint);
+		}
+		ImGui::EndMainMenuBar();
+	}
+
+	if (launcher) {
+		DrawLauncherPage(s, width, height, scale);
+	} else if (!s.status.empty() && !s.browser.open) {
+		ImGui::SetNextWindowPos({8.0f, ImGui::GetFrameHeight() + 6.0f});
+		ImGui::SetNextWindowBgAlpha(0.8f);
+		ImGui::Begin("##status", nullptr,
+		             ImGuiWindowFlags_NoDecoration | ImGuiWindowFlags_AlwaysAutoResize | ImGuiWindowFlags_NoSavedSettings |
+		                 ImGuiWindowFlags_NoFocusOnAppearing);
+		ImGui::TextColored({1.0f, 0.8f, 0.2f, 1.0f}, "%s", s.status.c_str());
+		ImGui::SameLine();
+		if (ImGui::SmallButton("Dismiss")) {
+			s.status.clear();
+		}
+		ImGui::End();
+	}
+	DrawBrowser(s, width, height, scale);
+	DrawRestartPopup(s, scale);
+	DrawAboutPopup(s, scale);
+}
