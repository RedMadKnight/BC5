+	return r != OK ? r : BC5_MOVE_NO_CONTROLLER;
+}
+
+static int Bc5MoveOutput(int32_t handle) {
+	const int r = Bc5MoveCheck(handle, true);
+	return r != OK ? r : BC5_MOVE_NO_CONTROLLER;
