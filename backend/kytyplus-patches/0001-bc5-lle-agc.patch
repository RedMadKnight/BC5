+		return Bc5UsbNoAnswer("sceUsbdHandleEvents", BC5_USB_LOCKED_TWICE);
+	}
+	const int answer = Bc5UsbHandleLocked(ev, nullptr);
+	Bc5UsbReleaseAndUnclaim(ev);
+	return answer;
+}
