+
+int GameController::ReadStateForSlot(int index, ControllerState* state, bool* flag, int* count) {
+	EXIT_IF(flag == nullptr);
+	EXIT_IF(count == nullptr);
+	EXIT_IF(state == nullptr);
+
+	Common::LockGuard lock(m_mutex);
+
+	EnsureSlot(index);
+
+	*flag  = SlotConnected(index);
+	*count = PresentCount();
+	*state = GetLastState(index);
+	ApplyMotion(index, state);
+	ApplyTouch(index, state);
+
+	static const bool trace_env = BC5_DIAG_ENV("KYTY_BC5_INPUT_TRACE") != nullptr;
+	const bool trace = trace_env && ::Log::Bc5LoggingOn();
+	if (trace) {
+		g_pad_read_stats.read_state++;
+		TracePadReads(InputTraceSeconds());
+	}
+
+	return 0;
+}
+
+int GameController::ReadStatesForSlot(int index, ControllerState* states, int states_num,
+	                                     bool* flag, int* count) {
+	EXIT_IF(flag == nullptr);
+	EXIT_IF(count == nullptr);
+	EXIT_IF(states == nullptr);
+	EXIT_IF(states_num < 1 || states_num > STATES_MAX);
+
+	Common::LockGuard lock(m_mutex);
+
+	if (index < 0 || index >= PAD_MAX_CONTROLLERS) {
+		*flag  = false;
+		*count = PresentCount();
+		return 0;
+	}
+
+	EnsureSlot(index);
+
+	*flag  = SlotConnected(index);
+	*count = PresentCount();
+
+	int ret_num = 0;
+
+	auto& s = m_slots[index];
+	static const bool trace_env   = BC5_DIAG_ENV("KYTY_BC5_INPUT_TRACE") != nullptr;
+	const bool trace = trace_env && ::Log::Bc5LoggingOn();
+	uint32_t          skipped = 0;
+	if (SlotConnected(index) && s.states_num != 0) {
+		// BC5: the newest states, as scePadRead gives them, not the oldest unread ones. A pad
+		// reports about 250 times a second; a game that asks for one state a frame would
+		// otherwise read input up to STATES_MAX reports (a quarter of a second) late, and the
+		// ring would drop most states unread.
+		uint32_t unread = 0;
+		for (uint32_t i = 0; i < s.states_num; i++) {
+			if (!s.obtained[(s.first_state + i) % STATES_MAX]) {
+				unread++;
+			}
+		}
+		for (uint32_t i = 0; i < s.states_num && unread > static_cast<uint32_t>(states_num); i++) {
+			const auto idx = (s.first_state + i) % STATES_MAX;
+			if (!s.obtained[idx]) {
+				s.obtained[idx] = true;
+				unread--;
+				skipped++;
+			}
+		}
+		for (uint32_t i = 0; i < s.states_num; i++) {
+			if (ret_num >= states_num) {
+				break;
+			}
+			auto state_index = (s.first_state + i) % STATES_MAX;
+			if (!s.obtained[state_index]) {
+				s.obtained[state_index] = true;
+				states[ret_num]         = s.states[state_index];
+				ApplyMotion(index, &states[ret_num]);
+				ApplyTouch(index, &states[ret_num]);
+				ret_num++;
+			}
+		}
+	}
+
+	if (trace) {
+		g_pad_read_stats.read++;
+		g_pad_read_stats.asked += static_cast<uint32_t>(states_num);
+		g_pad_read_stats.got += static_cast<uint32_t>(ret_num);
+		g_pad_read_stats.skipped += skipped;
+		TracePadReads(InputTraceSeconds());
+	}
+
+	return ret_num;
+}
