+				return nullptr;
+			}
+		}
+		std::lock_guard  calling(callbacks.calling);
+		Bc5EventDelivery delivery {};
+		{
+			std::lock_guard lock(callbacks.mutex);
+			if (worker->stopping) {
+				return nullptr;
+			}
+			if (callbacks.pending.empty()) {
+				continue;
+			}
+			delivery = callbacks.pending.front();
+			callbacks.pending.pop_front();
+			callbacks.delivering = std::this_thread::get_id();
+		}
+		delivery.callback(&delivery.event, delivery.userdata);
+		std::lock_guard lock(callbacks.mutex);
+		callbacks.delivering = {};
+	}
+}
+
+static bool bc5_start_event_delivery() {
+	auto&           callbacks = bc5_event_callbacks();
+	auto            worker    = std::make_unique<Bc5EventWorker>();
+	std::lock_guard lock(callbacks.mutex);
+	if (callbacks.worker != nullptr) {
+		return true;
+	}
+	if (LibKernel::PthreadCreate(&worker->thread, nullptr, bc5_deliver_events, worker.get(),
+	                            "SceSaveDataEventCallback") != OK) {
+		return false;
+	}
+	callbacks.worker = worker.release();
+	return true;
+}
+
+static Bc5EventWorker* bc5_detach_event_delivery() {
+	auto&           callbacks = bc5_event_callbacks();
+	std::lock_guard lock(callbacks.mutex);
+	callbacks.callback = nullptr;
+	callbacks.userdata = nullptr;
+	callbacks.pending.clear();
+	auto* worker = std::exchange(callbacks.worker, nullptr);
+	if (worker != nullptr) {
+		worker->stopping = true;
+	}
+	return worker;
+}
+
+static void bc5_join_event_delivery(Bc5EventWorker* worker) {
+	bc5_event_callbacks().wake.notify_all();
+	const int rc = LibKernel::PthreadJoin(worker->thread, nullptr);
+	if (rc != OK) {
+		std::fprintf(stderr, "[bc5] exp 0401: the savedata event thread did not join (%d); its worker is kept\n", rc);
+		return;
+	}
+	delete worker;
+}
+
+static bool bc5_in_event_callback() {
+	auto&           callbacks = bc5_event_callbacks();
+	std::lock_guard lock(callbacks.mutex);
+	return callbacks.delivering == std::this_thread::get_id();
+}
+
+static void bc5_deliver_event(const SaveDataEvent& event) {
+	auto& callbacks = bc5_event_callbacks();
+	{
+		std::lock_guard lock(callbacks.mutex);
+		if (callbacks.callback == nullptr || callbacks.worker == nullptr) {
+			return;
+		}
+		callbacks.pending.push_back({event, callbacks.callback, callbacks.userdata});
+	}
+	callbacks.wake.notify_all();
+}
+
+// SaveDataTerminate with the switch on: AnyPS5's sceSaveDataTerminate on this file's rules.
+static int bc5_terminate() {
+	if (bc5_in_event_callback()) {
+		return SAVE_DATA_ERROR_BUSY;
+	}
+	Bc5EventWorker* stopped = nullptr;
+	{
+		Common::LockGuard lock(g_mount_mutex);
+		if (!g_mount_slots.Empty()) {
+			return SAVE_DATA_ERROR_BUSY;
+		}
+		{
+			std::lock_guard events(g_bc5_save_data_events_mutex);
+			g_save_data_events.clear();
+		}
+		if (g_bc5_initializations > 0 && --g_bc5_initializations == 0) {
+			stopped = bc5_detach_event_delivery();
+		}
+	}
+	if (stopped != nullptr) {
+		bc5_join_event_delivery(stopped);
+	}
+	return OK;
+}
