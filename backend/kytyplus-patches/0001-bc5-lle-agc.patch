+// ---- the recorders ----
+static bool Bc5AppendCounterRecord(void* command_buffer, CommandBufferState::Bc5CounterCommand command) {
+	const auto            cb = reinterpret_cast<uint64_t>(command_buffer);
+	std::scoped_lock      lock(g_command_buffer_mutex);
+	CommandBufferIterator it;
+	if (!GetOrCreateCommandBufferStateLocked(cb, &it)) {
+		return false;
+	}
+	auto& state = it->second;
+	if (!EnsureCommandBufferRecordSpace(cb, &state, BC5_AMPR_COUNTER_RECORD_SIZE)) {
+		return false;
+	}
+	command.record_offset = state.write_offset;
+	std::memset(reinterpret_cast<void*>(state.buffer + state.write_offset), 0, static_cast<size_t>(BC5_AMPR_COUNTER_RECORD_SIZE));
+	state.bc5_counter_commands.push_back(command);
+	return CommitCommandBufferRecord(cb, &state, BC5_AMPR_COUNTER_RECORD_SIZE);
+}
+
+static bool Bc5InMap(void* command_buffer) { // [InMap]: an APR map group (MapBegin ... MapEnd) is open
+	uint32_t type = 0;
+	return AprShared::ReadGuest(reinterpret_cast<uint64_t>(command_buffer) + COMMAND_BUFFER_TYPE_OFFSET, &type) &&
+	       (type & APR_TYPE_MAP_ACTIVE) != 0;
+}
+
+static int Bc5WaitOnCounter0401(void* command_buffer, uint8_t counter, uint8_t access, uint64_t reference, uint8_t compare,
+                                uint8_t mask_operation, uint64_t mask, uint8_t flush) { // [Export.cpp:587-591]
+	if (command_buffer == nullptr || access >= 8 || compare > 6 || mask_operation >= 2 || flush >= 2) {
+		return LibKernel::KERNEL_ERROR_EINVAL;
+	}
+	CommandBufferState::Bc5CounterCommand c {};
+	c.kind    = 1;
+	c.counter = counter;
+	c.access  = access;
+	c.compare = compare;
+	c.value   = reference;
+	c.mask    = mask_operation != 0 ? mask : ~uint64_t {0};
+	return Bc5AppendCounterRecord(command_buffer, c) ? OK : LibKernel::KERNEL_ERROR_EBUSY;
+}
+
+static int Bc5WriteCounter0401(void* command_buffer, uint8_t counter, uint8_t access, uint64_t value, uint8_t operation,
+                               uint32_t at_start) { // [Export.cpp:614-618]
+	if (command_buffer == nullptr || (counter & 0x80u) != 0 || access >= 8 || operation >= 5) {
+		return LibKernel::KERNEL_ERROR_EINVAL;
+	}
+	if (at_start == 0 && Bc5InMap(command_buffer)) {
+		return LibKernel::KERNEL_ERROR_EPERM;
+	}
+	CommandBufferState::Bc5CounterCommand c {};
+	c.kind      = 0;
+	c.counter   = counter;
+	c.access    = access;
+	c.operation = operation;
+	c.value     = value;
+	return Bc5AppendCounterRecord(command_buffer, c) ? OK : LibKernel::KERNEL_ERROR_EBUSY;
+}
+
+static int Bc5WriteAddressFromCounter0401(void* command_buffer, volatile uint64_t* address, uint8_t counter, bool pair,
+                                          bool completion) { // [Export.cpp:306-316]
+	const auto addr = reinterpret_cast<uint64_t>(address);
+	if (command_buffer == nullptr || addr == 0 || (addr & 7u) != 0 || (pair ? (counter & 0x81u) != 0 : counter >= 128)) {
+		return LibKernel::KERNEL_ERROR_EINVAL;
+	}
+	if (completion && Bc5InMap(command_buffer)) {
+		return LibKernel::KERNEL_ERROR_EPERM;
+	}
+	CommandBufferState::Bc5CounterCommand c {};
+	c.kind    = pair ? 3 : 2;
+	c.counter = counter;
+	c.address = addr;
+	return Bc5AppendCounterRecord(command_buffer, c) ? OK : LibKernel::KERNEL_ERROR_EBUSY;
+}
