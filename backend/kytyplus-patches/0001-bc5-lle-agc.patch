+// Returns to the pool the direct memory of the automatic maps inside [va, va + size): an unmap,
+// or a new map replacing part of an old one. Partial overlaps keep the rest of the mapping.
+static void AmmAutoReleaseVa(uint64_t va, uint64_t size) {
+	std::scoped_lock lock(g_amm_auto_pool_mutex);
+	const uint64_t   end = va + size;
+	auto             it  = g_amm_auto_maps.lower_bound(va);
+	if (it != g_amm_auto_maps.begin()) {
+		--it; // the mapping before may reach into the range
+	}
+	while (it != g_amm_auto_maps.end() && it->first < end) {
+		const uint64_t m_va   = it->first;
+		const uint64_t m_end  = m_va + it->second.size;
+		const uint64_t m_dmem = it->second.dmem;
+		if (m_end <= va) {
+			++it;
+			continue;
+		}
+		const uint64_t o0 = std::max(va, m_va);
+		const uint64_t o1 = std::min(end, m_end);
+		g_amm_auto_maps.erase(it);
+		AmmAutoFreeLocked(m_dmem + (o0 - m_va), o1 - o0);
+		if (m_va < o0) {
+			g_amm_auto_maps[m_va] = AmmAutoMapping {m_dmem, o0 - m_va};
+		}
+		if (o1 < m_end) {
+			g_amm_auto_maps[o1] = AmmAutoMapping {m_dmem + (o1 - m_va), m_end - o1};
+		}
+		it = g_amm_auto_maps.lower_bound(o1);
+	}
+}
