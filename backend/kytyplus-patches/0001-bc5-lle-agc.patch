+static int64_t save_data_dir_mtime(const std::string& directory);
+
+// ---- experiment 0401 series e4: SaveData sort keys (exp 0402 Top 10 item 9), switch KYTY_BC5_SAVEDATA_SORT ----
+// Ported from KytyPS5 (github.com/KytyPS5/KytyPS5, GPL-2.0, as KytyPlus; the ported lines keep its authors' copyright),
+// src/libs/libSaveData.cpp @ dfec14a (dfec14aa8c59f8ea2bc4d87eba9854fc370161c6), newest_save_time and load_save_param
+// (411-440): the mtime its search sorts by since 4b0282e (4b0282e3430ec64b5012d1c5c5a90f495f05df76, "savedata: sort
+// directory searches by the requested key") and that its search and GetParam report. A save's mtime is the newest write
+// time of its files, whatever the title put in the param's mtime. shadPS4 (param.sfo's write time) and AnyPS5 @ 4f41f4c37
+// (the time of the last SetParam) do not take the title's mtime either; this file did.
+// Fitted to this file: KytyPS5 keeps the param and the blocks record inside the save (sce_sys/param.bin,
+// sce_sys/blocks.bin), where they count among its files; this file keeps them beside it (<dir>.param, <dir>.blocks), so
+// they count from there. A save with no file at all keeps this file's rule (run 573: the directory's time), not 0.
+// Of the three key definitions in which this file differs from KytyPS5 4b0282e only this one is ported. Kept as they are
+// (reasons in experiments/0401-mesa-preamble-switches/sav0401-notes.md): free blocks (here the save's blocks less its
+// files, as shadPS4 and AnyPS5 sort and report them; KytyPS5 reports its total as free and sorts by it) and a save without
+// a blocks record (here the maximum, as shadPS4 and AnyPS5; KytyPS5 sorts it as 0 and its search and GetMountInfo report
+// it BROKEN).
+// On: KYTY_BC5_SAVEDATA_SORT set, non-empty and not "0", read once; save_data_load_param takes the files' time (the
+// search's mtime order and the params it returns, and GetParam). Off: today's (the title's mtime, else the directory's).
+// One stderr line either way, at the library's registration.
+static bool bc5_savedata_sort_on() {
+	static const bool on = [] {
+		const char* e = std::getenv("KYTY_BC5_SAVEDATA_SORT");
+		const bool  v = e != nullptr && e[0] != '\0' && std::strcmp(e, "0") != 0;
+		std::fprintf(stderr, "[bc5] exp 0401: savedata sort %s\n", v ? "on" : "off");
+		return v;
+	}();
+	return on;
+}
+
+// KytyPS5 newest_save_time: the newest write time, in seconds, of the regular files in the save, 0 if it has none; here
+// with the save's two records beside it.
+static int64_t bc5_newest_save_time(const std::string& directory) {
+	int64_t     newest = 0;
+	struct stat st {};
+	for (const std::string& record: {save_data_param_path(directory), save_data_blocks_path(directory)}) {
+		std::error_code record_ec;
+		if (std::filesystem::is_regular_file(record, record_ec) && ::stat(record.c_str(), &st) == 0) {
+			newest = std::max<int64_t>(newest, st.st_mtime);
+		}
+	}
+	std::error_code ec;
+	for (auto it = std::filesystem::recursive_directory_iterator(
+	         directory, std::filesystem::directory_options::skip_permission_denied, ec);
+	     !ec && it != std::filesystem::recursive_directory_iterator(); it.increment(ec)) {
+		std::error_code file_ec;
+		if (it->is_regular_file(file_ec) && ::stat(it->path().string().c_str(), &st) == 0) {
+			newest = std::max<int64_t>(newest, st.st_mtime);
+		}
+	}
+	return newest;
+}
+// ---- end of experiment 0401 series e4's sort block ----
+
+// The param the title set, or zeros; an mtime of 0 becomes the directory's time (run 573).
+static SaveDataParam save_data_load_param(const std::string& directory) {
+	SaveDataParam param {};
+	std::FILE*    f = std::fopen(save_data_param_path(directory).c_str(), "rb");
+	if (f != nullptr) {
+		if (std::fread(&param, 1, sizeof(param), f) != sizeof(param)) {
+			param = {};
+		}
+		std::fclose(f);
+	}
+	if (bc5_savedata_sort_on()) { // experiment 0401 series e4 (KytyPS5 load_save_param): the files' newest time
+		param.mtime = bc5_newest_save_time(directory);
+	}
+	if (param.mtime == 0) {
+		param.mtime = save_data_dir_mtime(directory);
+	}
+	return param;
+}
+
+static void save_data_store_param(const std::string& directory, const SaveDataParam& param) {
+	const std::string path = save_data_param_path(directory);
+	const std::string tmp  = path + ".tmp";
+	std::FILE*        f    = std::fopen(tmp.c_str(), "wb");
+	if (f == nullptr) {
+		LOGF("\t save data: the param of %s could not be kept\n", directory.c_str());
+		return;
+	}
+	const bool ok = std::fwrite(&param, 1, sizeof(param), f) == sizeof(param);
+	std::fclose(f);
+	std::error_code ec;
+	if (ok) {
+		std::filesystem::rename(tmp, path, ec);
+	}
+	if (!ok || ec) {
+		std::filesystem::remove(tmp, ec);
+		LOGF("\t save data: the param of %s could not be kept\n", directory.c_str());
+	}
+}
+
+// BC5 (run 573): the time of a save directory for SaveDataParam::mtime, seconds since the epoch —
+// the newest write of a file in it (the directory's own time changes on create and rename only).
+// Titles that never call SaveDataSetParam (the second title) otherwise show 01/01/1970 in their
+// slot lists.
+static int64_t save_data_dir_mtime(const std::string& directory) {
+	struct stat st {};
+	if (::stat(directory.c_str(), &st) != 0) {
+		return 0;
+	}
+	int64_t newest = st.st_mtime;
+	for (const auto& entry: Common::File::GetDirEntries(directory)) {
+		if (entry.is_file && ::stat((directory + "/" + entry.name).c_str(), &st) == 0 &&
+		    st.st_mtime > newest) {
+			newest = st.st_mtime;
+		}
+	}
+	return newest;
+}
