+// The GPU writes flip labels here (EOP flips); the driver reads them back to know a flip landed.
+static KYTY_SYSV_ABI int GetBufferLabelAddress(int handle, uint64_t** out) {
+	PRINT_NAME();
+	if (out == nullptr) {
+		return LibKernel::KERNEL_ERROR_EINVAL;
+	}
+	*out = Bc5Gc::g_labels;
+	static int logged = 0;
+	if (Bc5Gc::gc_log_few(&logged)) {
+		LOGF("[bc5-gc] VideoOutGetBufferLabelAddress(%d) -> %p\n", handle, static_cast<void*>(*out));
+	}
+	return 0;
+}
+
+// (handle, index, flip_mode, flip_arg, ...): treated as a CPU flip for now.
+// TODO(bc5): the EOP part (flip when the GPU reaches the end of the submitted DCB).
+static KYTY_SYSV_ABI int SubmitEopFlip(int handle, int index, int flip_mode, int64_t flip_arg,
+                                       void* unk) {
+	PRINT_NAME();
+	static int flip_logged = 0;
+	if (Bc5Gc::gc_log_few(&flip_logged)) {
+		LOGF("[bc5-gc] VideoOutSubmitEopFlip(%d, %d, %d, 0x%" PRIx64 ", %p)\n", handle, index,
+		     flip_mode, flip_arg, unk);
+	}
+	// BC5_GC_QUEUE_TABLE=<hex address>[:entries]: the driver library's own queue table (entries
+	// of 0x90 bytes; +0x70 pointer to the read pointer the kernel publishes, +0x7c ring bytes,
+	// +0x88 the driver's write pointer in dwords — read off its free-space loop, experiment 0018),
+	// journaled every 8th flip for the entries in use: which ring fills up because nobody
+	// advances its read pointer? The address is the maintainer's to give; nothing of the
+	// library is in this source.
+	{
+		static const char* qt_env = std::getenv("BC5_GC_QUEUE_TABLE");
+		static const uint64_t qt = qt_env != nullptr ? std::strtoull(qt_env, nullptr, 16) : 0;
+		static const uint32_t qn = [&]() -> uint32_t {
+			const char* c = qt_env != nullptr ? std::strchr(qt_env, ':') : nullptr;
+			return c != nullptr ? static_cast<uint32_t>(std::strtoul(c + 1, nullptr, 0)) : 56;
+		}();
+		static uint32_t flips_seen = 0;
+		if (qt != 0 && (flips_seen++ % 8) == 0) {
+			for (uint32_t k = 0; k < qn; k++) {
+				const auto* e = reinterpret_cast<const volatile uint8_t*>(qt + static_cast<uint64_t>(k) * 0x90);
+				const uint64_t rp   = *reinterpret_cast<const volatile uint64_t*>(e + 0x70);
+				const uint32_t size = *reinterpret_cast<const volatile uint32_t*>(e + 0x7c);
+				const uint32_t wp   = *reinterpret_cast<const volatile uint32_t*>(e + 0x88);
+				if (wp == 0 || rp < 0x10000 || size == 0) continue;
+				const uint32_t r = *reinterpret_cast<const volatile uint32_t*>(rp);
+				Bc5Gc::Direct::journal("queue table flip %u entry %u: wptr %u rptr %u (at 0x%" PRIx64 ") ring %u dwords, pending %d\n", flips_seen - 1, k, wp, r, rp, size / 4,
+				                       static_cast<int32_t>(wp - r));
+			}
+		}
+	}
+	// Experiment 0025: BC5_DIRECT_FLIP_DEFER=1 — with jobs in flight the flip is not waited for
+	// here. It is queued behind the frame's jobs and submitted by the completion thread once the
+	// GPU has finished them, the buffer's label reset with it; the game's thread goes on with the
+	// next frame instead of idling at the flip, and the GPU does not idle while it does (run 117:
+	// the wait at the flip is where the two wait for each other).
+	static const bool defer = std::getenv("BC5_DIRECT_FLIP_DEFER") != nullptr && Bc5Gc::Direct::async_on();
+	const double t_drain = Bc5Gc::Direct::timing_now();
+	if (!defer) Bc5Gc::Direct::drain(); // BC5_DIRECT_ASYNC: nothing of the frame may still be in flight
+	Bc5Gc::Direct::frame_profile_flip((Bc5Gc::Direct::timing_now() - t_drain) * 1e3);
+	if (defer) {
+		if (index >= 0 && index < 64) {
+			Bc5Gc::g_flip_pending[index]++; // experiment 0069
+		}
+		Bc5Gc::Direct::post([handle, index, flip_mode, flip_arg](bool) {
+			VideoOut::VideoOutSubmitFlip(handle, index, flip_mode, flip_arg);
+			if (index >= 0 && index < 64) {
+				// Experiment 0069: the flip only queues the request; the buffer is read by the
+				// presentation thread later, at the display's refresh. Experiment 0070: the label is
+				// cleared (and the next frame may render into the buffer) once the flip has been
+				// copied into the presenter's own frame (KytyPlus FlipQueue::Prepare records the copy,
+				// Complete marks it done), which is what the console's flip guarantees for the
+				// buffer; the presentation at the refresh shows the copy. A thread of its own waits,
+				// so that the completion thread goes on with the jobs. (Waiting for the flip to be
+				// shown instead gave 30 fps in the later level, run 303.)
+				static std::mutex                           m;
+				static std::condition_variable              cv;
+				static std::deque<std::pair<int, int>>      q;
+				static std::once_flag                       started;
+				std::call_once(started, [] {
+					std::thread([] {
+						pthread_setname_np(pthread_self(), "bc5-flipdone");
+						for (;;) {
+							std::pair<int, int> it;
+							{
+								std::unique_lock lk(m);
+								cv.wait(lk, [] { return !q.empty(); });
+								it = q.front();
+								q.pop_front();
+							}
+							VideoOut::Bc5VideoOutWaitFlipCopied(it.first, it.second);
+							Bc5Gc::g_labels[it.second] = 0;
+							Bc5Gc::g_flip_pending[it.second]--;
+						}
+					}).detach();
+				});
+				{
+					std::lock_guard lk(m);
+					q.emplace_back(handle, index);
+				}
+				cv.notify_one();
+			}
+		});
+		return 0;
+	}
+	// BC5_DIRECT_FLIP_BRIGHT=<t0>[:<points>]: from t0 s on, the share of non-black samples in the display buffer
+	// at each flip (every 1024th dword, whatever its tiling: a menu over black is a few per cent,
+	// the 3D scene most of it). Journaled when a flip's share differs from the previous one by
+	// more than <points> (default 20; a strip of the scene behind a submenu is a few points) (the second title's scene showing through its black Initial Setup
+	// screen for a frame), and every 600 flips. Format: A2B10G10R10 or 8888 alike, the low 30 bits.
+	{
+		static double       fb_points = 20.0;
+		static const double fb_t0     = [] {
+			const char* e = std::getenv("BC5_DIRECT_FLIP_BRIGHT");
+			if (e == nullptr) return -1.0;
+			char*        end = nullptr;
+			const double t   = std::strtod(e, &end);
+			if (end != nullptr && *end == ':') fb_points = std::strtod(end + 1, nullptr);
+			return t;
+		}();
+		if (fb_t0 >= 0 && Bc5Gc::Direct::timing_now() >= fb_t0) {
+			uint64_t a = 0, n = 0;
+			if (VideoOut::Bc5VideoOutBufferRange(handle, index, &a, &n) && a != 0 && n >= 4096) {
+				const auto*     w   = reinterpret_cast<const volatile uint32_t*>(a);
+				uint64_t        lit = 0, samples = 0;
+				for (uint64_t k = 0; k < n / 4; k += 1024, samples++) lit += (w[k] & 0x3fffffffu) != 0 ? 1 : 0;
+				const double    share = 100.0 * static_cast<double>(lit) / static_cast<double>(samples);
+				static double   prev  = -1.0;
+				static uint64_t flips = 0, jumps = 0;
+				flips++;
+				if (prev >= 0 && (share - prev > fb_points || prev - share > fb_points)) {
+					jumps++;
+					Bc5Gc::Direct::journal("flip bright: t %.3f s flip %" PRIu64 " buffer %d: %.1f%% lit (was %.1f%%)\n", Bc5Gc::Direct::timing_now(), flips, index, share, prev);
+				}
+				if (flips % 600 == 0) Bc5Gc::Direct::journal("flip bright: t %.3f s %" PRIu64 " flips, %" PRIu64 " jumps; now %.1f%% lit\n", Bc5Gc::Direct::timing_now(), flips, jumps, share);
+				prev = share;
+			}
+		}
+	}
+	const double flip_t0 = Bc5Gc::Direct::timing_now();
+	const int rc = VideoOut::VideoOutSubmitFlip(handle, index, flip_mode, flip_arg);
+	static const bool timing_flips_env = std::getenv("BC5_DIRECT_TIMING") != nullptr;
+	const bool timing_flips = timing_flips_env && ::Log::Bc5LoggingOn();
+	if (timing_flips) {
+		Bc5Gc::Direct::journal("timing: t %.3f s flip %d/%d, VideoOutSubmitFlip took %.1f ms\n", flip_t0, handle, index, (Bc5Gc::Direct::timing_now() - flip_t0) * 1e3);
+	}
+	// Experiment 0162: the buffer's flip label goes back to 0 when the flip has been presented, at
+	// the vblank it was due by the flip rate (VideoOutSetFlipRate), as the console's VideoOut does
+	// (the game waits for the label before it renders into the buffer again; run 73). Resetting it
+	// here, at submission, let the second title run its frames at whatever the GPU allowed (22-31
+	// ms instead of the 33.3 ms of its 30 Hz flip rate), and its cutscenes and gameplay sped up and
+	// slowed down with the frame time (the maintainer, runs 793-795). A thread of its own waits for
+	// the presentation, so the game's thread is not held here. BC5_DIRECT_FLIP_LABEL=submit restores
+	// the reset at submission.
+	static const bool label_at_submit = [] {
+		const char* e = std::getenv("BC5_DIRECT_FLIP_LABEL");
+		return e != nullptr && std::strcmp(e, "submit") == 0;
+	}();
+	if (index >= 0 && index < 64) {
+		if (rc != 0 || label_at_submit) {
+			Bc5Gc::g_labels[index] = 0;
+		} else {
+			static std::mutex                      lm;
+			static std::condition_variable         lcv;
+			static std::deque<std::pair<int, int>> lq;
+			static std::once_flag                  lstarted;
+			std::call_once(lstarted, [] {
+				std::thread([] {
+					pthread_setname_np(pthread_self(), "bc5-fliplabel");
+					for (;;) {
+						std::pair<int, int> it;
+						{
+							std::unique_lock lk(lm);
+							lcv.wait(lk, [] { return !lq.empty(); });
+							it = lq.front();
+							lq.pop_front();
+						}
+						VideoOut::Bc5VideoOutWaitFlipDone(it.first, it.second);
+						Bc5Gc::g_labels[it.second] = 0;
+					}
+				}).detach();
+			});
+			{
+				std::lock_guard lk(lm);
+				lq.emplace_back(handle, index);
+			}
+			lcv.notify_one();
+		}
+	}
+	return rc;
+}
