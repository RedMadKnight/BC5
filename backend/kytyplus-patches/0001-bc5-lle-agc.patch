+int KYTY_SYSV_ABI SaveDataGetEventResult(const void* event_param, SaveDataEvent* event) {
+	PRINT_NAME();
+	{ // BC5: the guest return addresses of the event polls, each journaled once (save data diagnosis).
+		static std::mutex m;
+		static std::vector<uint64_t> seen;
+		const auto ra = reinterpret_cast<uint64_t>(__builtin_return_address(0));
+		std::lock_guard lk(m);
