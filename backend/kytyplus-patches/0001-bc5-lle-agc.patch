+static EpollSlot* GetEpollSlot(int eid) {
+	const auto index = eid - EPOLL_ID_BASE;
+	if (index < 0 || index >= static_cast<int>(g_epolls.size())) {
+		return nullptr;
+	}
+	auto& slot = g_epolls[static_cast<size_t>(index)];
+	return slot.used ? &slot : nullptr;
