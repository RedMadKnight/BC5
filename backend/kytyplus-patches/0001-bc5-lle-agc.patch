+	bool ConsumeReserved(uint64_t start, uint64_t size,
+	                     VirtualRangeType type = VirtualRangeType::Reserved) {
+		Common::LockGuard lock(m_mutex);
+		m_gen.fetch_add(1, std::memory_order_acq_rel); // BC5 (experiment 0037)
