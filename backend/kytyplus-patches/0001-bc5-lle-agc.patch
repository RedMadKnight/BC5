+	int       configuration = 0;
+	const int result        = Bc5UsbL().get_configuration(handle, &configuration);
+	return result == BC5_LIBUSB_ERROR_NO_DEVICE ? Bc5UsbGuestError(BC5_LIBUSB_ERROR_NO_DEVICE) : 0;
+}
