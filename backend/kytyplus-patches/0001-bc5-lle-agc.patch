+int KYTY_SYSV_ABI SaveDataDelete(const SaveDataDelete* del) {
+	PRINT_NAME();
+
+	if (del == nullptr || del->dir_name == nullptr) {
+		return SAVE_DATA_ERROR_PARAMETER;
+	}
+
+	LOGF("\t user_id  = %" PRId32 "\n"
+	     "\t title_id = %s\n"
+	     "\t dir_name = %s\n",
+	     del->user_id, del->title_id != nullptr ? del->title_id->data : "<default>",
+	     del->dir_name->data);
+
+	std::string dir =
+	    std::string(SAVE_DATA_DIR) + "/" + get_title_id() + "/" + std::string(del->dir_name->data);
+	if ((g_bc5_save_trace && ::Log::Bc5LoggingOn())) {
+		std::fprintf(stderr, "save trace: SaveDataDelete %s exists %d\n", dir.c_str(),
+		             Common::File::IsDirectoryExisting(dir) ? 1 : 0);
+	}
+	// BC5 (experiment 0158): a save directory holds files, so it goes with std::filesystem's
+	// recursive remove; the host's File::DeleteDirectory is rmdir(2) and left the title's
+	// deleted slots on disk, back in the list at the next start (F205).
+	std::error_code ec;
+	const auto      removed = std::filesystem::remove_all(dir, ec);
+	if ((g_bc5_save_trace && ::Log::Bc5LoggingOn())) {
+		std::fprintf(stderr, "save trace: SaveDataDelete removed %ju entries, error %d\n",
+		             static_cast<uintmax_t>(removed), ec.value());
+	}
+	if (ec) {
+		return SAVE_DATA_ERROR_INTERNAL;
+	}
+	// BC5 (blocks): the save's sidecars go with it.
+	std::error_code sidecar_ec;
+	std::filesystem::remove(save_data_blocks_path(Common::FixFilenameSlash(dir)), sidecar_ec);
+	std::filesystem::remove(save_data_param_path(Common::FixFilenameSlash(dir)), sidecar_ec);
+
+	return OK;
+}
