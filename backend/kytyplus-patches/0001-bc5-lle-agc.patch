+	uint32_t size = 0;
+	Bc5TfRingState(&base, &size, &o0, &o1, &o2);
+	static const bool second = std::getenv("BC5_DIRECT_OFFCHIP_SECOND") != nullptr;
+	// Experiment 0160 (diagnostic): BC5_DIRECT_TF_RING=<hex base>:<hex size>[:<hex offchip>] uses this ring when the
+	// title gave none (e.g. the backend's GDS shadow, BC5_DIRECT_GDS_SHADOW=1, 64 KiB at 0x100004000000).
+	if (base == 0 || size == 0) {
+		static const auto forced = [] {
+			std::tuple<uint64_t, uint32_t, uint64_t> r {0, 0, 0};
+			if (const char* e = std::getenv("BC5_DIRECT_TF_RING"); e != nullptr) {
+				unsigned long long b = 0, z = 0, o = 0;
+				if (std::sscanf(e, "%llx:%llx:%llx", &b, &z, &o) >= 2) r = {b, static_cast<uint32_t>(z), o};
+			}
+			return r;
+		}();
+		base = std::get<0>(forced);
+		size = std::get<1>(forced);
+		o0   = std::get<2>(forced);
+	}
+	uint32_t   off_v        = static_cast<uint32_t>(second ? o1 : o0);
+	bool       write_off    = true;
+	bool       host_default = false, gc_ring = false;
+	if ((base == 0 || size == 0) && gc_tf_ring_on()) { // experiment 0189: the ring the title's driver sent /dev/gc
+		const uint64_t       b = g_gc_tf_base.load();
+		const uint32_t       s = g_gc_tf_size.load();
+		static std::atomic<bool> told {false};
+		const auto           pm = b != 0 && s != 0 && g_dev ? g_dev->sorted_mappings() : nullptr;
+		if (pm != nullptr && covered_sorted(*pm, b, s)) {
+			base      = b;
+			size      = s;
+			gc_ring   = true;
+			write_off = false;
+		} else if (!told.exchange(true)) {
+			journal("tf ring (exp 0189): /dev/gc ring 0x%" PRIx64 " size 0x%x not mapped (yet), not programmed\n", b, s);
+		}
+	}
+	if (gc_hs_offchip_on() && (g_gc_hs_offchip.load() >> 32u) != 0 && (gc_ring || base == 0 || size == 0)) {
+		off_v     = static_cast<uint32_t>(g_gc_hs_offchip.load());
+		write_off = true;
+	}
+	if ((base == 0 || size == 0) && tf_default_on()) { // experiment 0189
+		const uint64_t       va = g_tf_default_va.load();
+		static std::atomic<bool> told {false};
+		const auto           pm = va != 0 && g_dev ? g_dev->sorted_mappings() : nullptr;
+		if (pm != nullptr && covered_sorted(*pm, va, kTfDefaultBytes)) {
+			base         = va;
+			size         = tf_default_size();
+			host_default = true;
+			if (!(gc_hs_offchip_on() && (g_gc_hs_offchip.load() >> 32u) != 0)) write_off = hs_offchip_force(&off_v);
+		} else if (!told.exchange(true)) {
+			journal("tf ring (exp 0189): default ring at 0x%" PRIx64 " not mapped yet, not programmed\n", va);
+		}
+	}
+	if (base == 0 || size == 0) {
+		// Experiment 0189: BC5_DIRECT_GC_HS_OFFCHIP=1 without a ring to program: the parameter alone.
+		if (write_off && gc_hs_offchip_on() && (g_gc_hs_offchip.load() >> 32u) != 0) p.insert(p.end(), {0xC0017900u, 0x24fu, off_v});
+		return;
+	}
+	static std::atomic<uint64_t> n {0};
+	if ((n++ & 0xffffu) == 0) journal("tf ring: base 0x%" PRIx64 " size 0x%x offchip 0x%" PRIx64 " 0x%" PRIx64 " 0x%" PRIx64 " -> VGT_HS_OFFCHIP_PARAM %s0x%x%s (%" PRIu64 " prefixes)\n", base, size, o0, o1, o2, write_off ? "" : "untouched, not ", off_v, host_default ? ", host default ring" : gc_ring ? ", the title's /dev/gc ring" : "", n.load());
+	const uint32_t size_dw = static_cast<uint32_t>(std::min<uint64_t>(size / 4, 0xffffu));
+	if (host_default || gc_ring) {
+		static std::atomic<bool> flushed {false};
+		if (!flushed.exchange(true)) p.insert(p.end(), {0xC0004600u, 0x40fu, 0xC0004600u, 0x24u}); // EVENT_WRITE VS_PARTIAL_FLUSH (index 4), VGT_FLUSH (index 0)
+	}
+	if (write_off) p.insert(p.end(), {0xC0027900u, 0x24eu, size_dw, off_v}); // VGT_TF_RING_SIZE, VGT_HS_OFFCHIP_PARAM
+	else p.insert(p.end(), {0xC0017900u, 0x24eu, size_dw});                  // VGT_TF_RING_SIZE
