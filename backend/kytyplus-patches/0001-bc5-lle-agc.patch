+// BC5: KYTY_BC5_INPUT_TRACE=1 — seconds since the first trace line, for the input trace.
+double InputTraceSeconds() {
+	static const auto start = std::chrono::steady_clock::now();
+	return std::chrono::duration<double>(std::chrono::steady_clock::now() - start).count();
+}
+// Pad reads per second, printed once a second by the trace.
+struct PadReadStats {
+	uint32_t read_state = 0, read = 0, asked = 0, got = 0, skipped = 0;
+	double   last = 0.0;
+};
+static PadReadStats g_pad_read_stats;
+static thread_local const char* g_pad_read_via    = "?";
+static thread_local int         g_pad_read_handle = -1;
+static thread_local int         g_pad_read_i      = 0;
+static thread_local int         g_pad_read_n      = 0;
+static void TracePadReads(double now) {
+	auto& st = g_pad_read_stats;
+	if (now - st.last < 1.0) {
+		return;
+	}
+	std::fprintf(stderr, "input trace: t=%.1f pad reads in the last %.1f s: ReadState %u, Read %u (asked %u, got %u, skipped %u)\n",
+	             now, now - st.last, st.read_state, st.read, st.asked, st.got, st.skipped);
+	std::fflush(stderr);
+	st = PadReadStats {};
+	st.last = now;
+}
