+					std::memcpy(&f, &v, 4);
+					if (std::isfinite(f)) {
+						sum_v += f;
+						max_v = std::max(max_v, static_cast<double>(f));
+					}
+					r = g = b = std::isfinite(f) ? std::fabs(f) / (1.0f + std::fabs(f)) : 1.0f;
+				} else {
+					r = bc5_small_float(v & 0x7ffu, 6), g = bc5_small_float((v >> 11u) & 0x7ffu, 6), b = bc5_small_float((v >> 22u) & 0x3ffu, 5);
