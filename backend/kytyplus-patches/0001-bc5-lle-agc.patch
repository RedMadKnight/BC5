+// BC5 (search). Ported from AnyPS5 core/libs/prx/libSceSaveData.native/Export.cpp @ 7f596df
+// (GPL-2.0), dir_name_match: '%' matches any run of characters, '_' one character; an empty
+// pattern matches every name, and a pattern ending in '%' matches a name that ends where the
+// '%' starts (the loop below left such a pattern unconsumed and answered no match).
+static bool dir_name_match(const char* str, const char* pattern) {
+	if (pattern == nullptr || pattern[0] == '\0') {
+		return true;
+	}
+	while (*str != '\0' && *pattern != '\0') {
+		if (*pattern == '%') {
+			for (const char* s = str;; s++) {
+				if (dir_name_match(s, pattern + 1)) {
+					return true;
+				}
+				if (*s == '\0') {
+					break;
+				}
+			}
+			return false;
+		}
+		if (*pattern == '_') {
+			str++;
+			pattern++;
+			continue;
+		}
+		if (*pattern != *str) {
+			return false;
+		}
+		str++;
+		pattern++;
+	}
+	while (*pattern == '%') {
+		pattern++;
+	}
+	return *str == '\0' && *pattern == '\0';
+}
+
+// BC5 (blocks and params). Ported from AnyPS5 core/libs/prx/libSceSaveData.native/Export.cpp
+// @ 7f596df (GPL-2.0), blocks_path/save_blocks/keep_save_blocks/used_blocks/search_info and
+// param_path/load_param/store_param: two sidecar files next to a save directory, never inside it
+// (the title sees the mount's files), under _SaveData/<title>/: <dir>.blocks holds, in decimal,
+// the blocks the Mount3 that created the save asked for, and <dir>.param the SaveDataParam the
+// title last set. A save is 32 KiB blocks; free blocks are the save's blocks minus its files'
+// sizes, each rounded up to a block. A save without a .blocks file reports the maximum.
+// TODO(verify): the block count cap. This file keeps SAVE_DATA_BLOCKS_MAX = 16384 (KytyPlus);
+// AnyPS5 and shadPS4 use 32768. Neither is from a console measurement.
+static constexpr uint64_t SAVE_DATA_BLOCK_BYTES = 32768;
+
+static std::string save_data_title_root() {
+	// No trailing slash here: a sidecar path is this plus "/<dir>.blocks" (exp 0258, F319: FixDirectorySlash's
+	// trailing slash put the .blocks file inside the save directory and made the delete miss the .param).
+	return Common::FixFilenameSlash(std::string(SAVE_DATA_DIR) + "/" + get_title_id());
+}
+
+static std::string save_data_blocks_path(const std::string& directory) {
+	return directory + ".blocks";
+}
+
+static std::string save_data_param_path(const std::string& directory) {
+	return directory + ".param";
+}
+
+static uint64_t save_data_blocks(const std::string& directory) {
+	std::FILE* f = std::fopen(save_data_blocks_path(directory).c_str(), "rb");
+	if (f == nullptr) {
+		return SAVE_DATA_BLOCKS_MAX;
+	}
+	unsigned long long blocks = 0;
+	const int          read   = std::fscanf(f, "%llu", &blocks);
+	std::fclose(f);
+	if (read != 1 || blocks == 0) {
+		return SAVE_DATA_BLOCKS_MAX;
+	}
+	return std::min<uint64_t>(blocks, SAVE_DATA_BLOCKS_MAX);
+}
+
+static void save_data_keep_blocks(const std::string& directory, uint64_t blocks) {
+	std::FILE* f = std::fopen(save_data_blocks_path(directory).c_str(), "wb");
+	if (f == nullptr) {
+		LOGF("\t save data: the blocks of %s could not be kept\n", directory.c_str());
+		return;
+	}
+	std::fprintf(f, "%llu\n", static_cast<unsigned long long>(std::min<uint64_t>(blocks, SAVE_DATA_BLOCKS_MAX)));
+	std::fclose(f);
+}
+
+static uint64_t save_data_used_blocks(const std::string& directory) {
+	uint64_t        blocks = 0;
+	std::error_code ec;
+	for (auto it = std::filesystem::recursive_directory_iterator(directory, ec);
+	     !ec && it != std::filesystem::recursive_directory_iterator(); it.increment(ec)) {
+		if (!it->is_regular_file(ec)) {
+			continue;
+		}
+		const auto bytes = it->file_size(ec);
+		if (!ec) {
+			blocks += (bytes + SAVE_DATA_BLOCK_BYTES - 1) / SAVE_DATA_BLOCK_BYTES;
+		}
+	}
+	return blocks;
+}
+
+static SaveDataSearchInfo save_data_search_info(const std::string& directory) {
+	SaveDataSearchInfo info {};
+	info.blocks      = save_data_blocks(directory);
+	info.free_blocks = info.blocks - std::min(info.blocks, save_data_used_blocks(directory));
+	return info;
+}
