+	auto& ev = Bc5UsbEv();
+	if (!Bc5UsbAcquireAndClaim(ev)) {
+		return Bc5UsbNoAnswer("sceUsbdHandleEventsTimeout", BC5_USB_LOCKED_TWICE);
+	}
+	const int answer = Bc5UsbHandleLocked(ev, tv);
+	Bc5UsbReleaseAndUnclaim(ev);
+	return answer;
