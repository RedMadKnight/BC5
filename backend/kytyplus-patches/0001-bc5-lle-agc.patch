+int KYTY_SYSV_ABI SaveDataMount3(const SaveDataMount3* mount, SaveDataMountResult* mount_result) {
+	PRINT_NAME();
+
+	EXIT_NOT_IMPLEMENTED(mount == nullptr);
+	EXIT_NOT_IMPLEMENTED(mount_result == nullptr);
+	EXIT_NOT_IMPLEMENTED(mount->dir_name == nullptr);
+
+	LOGF("\t user_id       = %d\n"
+	     "\t dir_name      = %s\n"
+	     "\t blocks        = %" PRIu64 "\n"
+	     "\t system_blocks = %" PRIu64 "\n"
+	     "\t mount_mode    = %" PRIu32 "\n"
+	     "\t resource      = %" PRId32 "\n",
+	     mount->user_id, mount->dir_name->data, mount->blocks, mount->system_blocks,
+	     mount->mount_mode, mount->resource);
+
+	if (!bc5_savedata_fixes_on()) { // experiment 0401 series e4: off, today's clearing before the checks
+		*mount_result = {};
+	}
+
+	Common::LockGuard lock(g_mount_mutex);
+	const std::string dir_name = mount->dir_name->data;
+	const std::string mount_dir =
+	    std::string(SAVE_DATA_DIR) + "/" + get_title_id() + "/" + dir_name;
+	const bool create  = ((mount->mount_mode & 4u) != 0);
+	const bool create2 = ((mount->mount_mode & 32u) != 0);
+	const bool open    = (!create && !create2 && ((mount->mount_mode & 3u) != 0));
+
+	const int slot = g_mount_slots.FindAvailable(dir_name);
+	if (slot == SaveDataMountSlots::BUSY) {
+		return SAVE_DATA_ERROR_BUSY;
+	}
+	if (slot == SaveDataMountSlots::FULL) {
+		return SAVE_DATA_ERROR_MOUNT_FULL;
+	}
+
+	if (!create && !create2 && !open) {
+		LOGF("\t SaveDataMount: unknown mount mode 0x%08" PRIx32 "\n", mount->mount_mode);
+		g_mount_slots.Release(static_cast<size_t>(slot));
+		return SAVE_DATA_ERROR_PARAMETER;
+	}
+
+	if (open && !Common::File::IsDirectoryExisting(mount_dir)) {
+		return SAVE_DATA_ERROR_NOT_FOUND;
+	}
+
+	if (create && Common::File::IsDirectoryExisting(mount_dir)) {
+		return SAVE_DATA_ERROR_EXISTS;
+	}
+
+	bool created = false;
+	if ((create || create2) && !Common::File::IsDirectoryExisting(mount_dir)) {
+		Common::File::CreateDirectories(mount_dir);
+		created = true;
+
+		if (!Common::File::IsDirectoryExisting(mount_dir)) {
+			// The host refused to create the save directory (permissions, read-only
+			// medium). Report it to the guest instead of aborting the title.
+			g_mount_slots.Release(static_cast<size_t>(slot));
+			return SAVE_DATA_ERROR_NO_PERMISSION;
+		}
+	}
+
+	// BC5 (blocks): the size the title asked for is kept with the save it created (AnyPS5 mount3);
+	// a save from before this had no record and gets one from the first mount that names a size.
+	if (mount->blocks != 0 &&
+	    (created || !Common::File::IsFileExisting(save_data_blocks_path(Common::FixFilenameSlash(mount_dir))))) {
+		save_data_keep_blocks(Common::FixFilenameSlash(mount_dir), mount->blocks);
+	}
+
+	if (bc5_savedata_fixes_on()) { // experiment 0401 series e4 (KytyPS5 dfec14a): cleared only on the way to a mount
+		*mount_result = {};
+	}
+	return mount_save_data(slot, dir_name, mount_dir, created ? 1u : 0u, mount_result);
+}
+
+// BC5 (run 115): the save data memory lives in a file, so that a save outlasts the process — the
+// game saves through sceSaveDataSetSaveDataMemory2 only, and this library kept the memory in a
+// vector. The file is _SaveData/<title>/sce_sdmemory/memory.dat under the working directory, or
+// under KYTY_BC5_SAVEDATA_DIR when that is set; it is read once, before the first use, and
+// rewritten (temporary file, then rename) after every set.
+static std::mutex g_save_data_memory_mutex;
+static bool       g_save_data_memory_loaded = false;
+
+static std::string save_data_memory_dir() {
+	const char* root = std::getenv("KYTY_BC5_SAVEDATA_DIR");
+	return std::string(root != nullptr && root[0] != 0 ? root : SAVE_DATA_DIR) + "/" + get_title_id() + "/sce_sdmemory";
+}
+
+static void save_data_memory_load() {
+	if (g_save_data_memory_loaded) {
+		return;
+	}
+	g_save_data_memory_loaded = true;
+	const std::string path    = save_data_memory_dir() + "/memory.dat";
+	std::FILE*        f       = std::fopen(path.c_str(), "rb");
+	if (f == nullptr) {
+		LOGF("\t save data memory: no file at %s\n", path.c_str());
+		return;
+	}
+	std::vector<uint8_t> data;
+	uint8_t              buf[65536];
+	size_t               n = 0;
+	while ((n = std::fread(buf, 1, sizeof(buf), f)) > 0) {
+		data.insert(data.end(), buf, buf + n);
+	}
+	std::fclose(f);
+	if (data.size() > g_save_data_memory.size()) {
+		g_save_data_memory.resize(data.size());
+	}
+	if (!data.empty()) {
+		std::memcpy(g_save_data_memory.data(), data.data(), data.size());
+	}
+	LOGF("\t save data memory: %zu bytes read from %s\n", data.size(), path.c_str());
+}
+
+static bool save_data_memory_store() { // experiment 0401 series e5: true when written ("sync"'s status)
+	const std::string dir = save_data_memory_dir();
+	std::error_code   ec;
+	std::filesystem::create_directories(dir, ec);
+	const std::string path = dir + "/memory.dat";
+	const std::string tmp  = path + ".tmp";
+	std::FILE*        f    = std::fopen(tmp.c_str(), "wb");
+	if (f == nullptr) {
+		LOGF("\t save data memory: cannot write %s\n", tmp.c_str());
+		return false; // experiment 0401 series e5
+	}
+	const size_t written = std::fwrite(g_save_data_memory.data(), 1, g_save_data_memory.size(), f);
+	const bool   ok      = (std::fclose(f) == 0 && written == g_save_data_memory.size());
+	if (!ok || std::rename(tmp.c_str(), path.c_str()) != 0) {
+		LOGF("\t save data memory: writing %s failed\n", path.c_str());
+		std::remove(tmp.c_str());
+		return false; // experiment 0401 series e5
+	}
+	LOGF("\t save data memory: %zu bytes written to %s\n", written, path.c_str());
+	return true; // experiment 0401 series e5
+}
+
+// experiment 0401 series e5 (KYTY_BC5_SAVEDATA_MEMORY_FIXES "existed", R2 KS09 + SS02): the size of the stored memory
+// file, 0 when there is none (KytyPS5 dfec14a load_memory, libs/libSaveData.cpp:457-483; sharpemu 514d766, added in
+// 488b285, SaveDataExports.cs:1525-1526, the backing file's length before the call).
+static size_t bc5_save_data_memory_file_size() {
+	std::error_code ec;
+	const auto      size = std::filesystem::file_size(save_data_memory_dir() + "/memory.dat", ec);
+	return ec ? 0 : static_cast<size_t>(size);
+}
