+// --- a key press shorter than a frame --------------------------------------------------------
+//
+// A press shorter than one game frame is invisible to the game (it reads the pad once a frame and
+// would see the press and the release in the same read). Some keyboards and macro keys deliver a
+// press and its release in the same millisecond, so a release that follows its press by less than
+// KYTY_BC5_KEY_MIN_HOLD_MS (default 60) is held back until the press has lasted that long; a new
+// press of the same key meanwhile cancels the release.
+
+struct PendingRelease {
+	std::size_t control;
+	double      at;
+};
+
+std::map<int, PendingRelease>   g_pending; // by key code
+std::unordered_map<int, double> g_down_at;
+std::condition_variable         g_pending_cv;
+bool                            g_release_thread_started = false;
+
+double NowSeconds() {
+	static const auto start = std::chrono::steady_clock::now();
+	return std::chrono::duration<double>(std::chrono::steady_clock::now() - start).count();
+}
+
+int MinHoldMs() {
+	static const int v = [] {
+		const char* e = std::getenv("KYTY_BC5_KEY_MIN_HOLD_MS");
+		const int   n = e != nullptr ? std::atoi(e) : 60;
+		return n < 0 ? 0 : (n > 1000 ? 1000 : n);
+	}();
+	return v;
+}
+
+void ReleaseThread() {
+	pthread_setname_np(pthread_self(), "bc5-keyhold");
+	std::unique_lock<std::mutex> lock(g_input_mutex);
+	for (;;) {
+		if (g_pending.empty()) {
+			g_pending_cv.wait(lock);
+			continue;
+		}
+		double due = 1e300;
+		for (const auto& [key, r]: g_pending) {
+			due = std::min(due, r.at);
+		}
+		const double now = NowSeconds();
+		if (due > now) {
+			g_pending_cv.wait_for(lock, std::chrono::duration<double>(due - now));
+			continue;
+		}
+		for (auto it = g_pending.begin(); it != g_pending.end();) {
+			if (it->second.at <= now) {
+				SetControl(it->second.control, false);
+				it = g_pending.erase(it);
+			} else {
+				++it;
+			}
+		}
+	}
+}
+
+void StartReleaseThread() {
+	if (!g_release_thread_started) {
+		g_release_thread_started = true;
+		std::thread(ReleaseThread).detach();
+	}
+}
