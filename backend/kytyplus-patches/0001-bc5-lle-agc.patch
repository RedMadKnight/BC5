+	}
+
+	LOGF("\t event_type = %d\n", event_type);
+
+	switch (event_type) {
+		case NET_CTL_EVENT_DISCONNECTED:
+		case 2:
+		case NET_CTL_EVENT_IPOBTAINED: *error_code = OK; break;
+		default: return NET_CTL_ERROR_INVALID_TYPE;
+	}
+
+	return OK;
+}
