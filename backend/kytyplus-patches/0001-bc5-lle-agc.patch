+	LOGF("\t callback = 0x%016" PRIx64 "\n"
+	     "\t userdata = 0x%016" PRIx64 "\n",
+	     reinterpret_cast<uint64_t>(callback), reinterpret_cast<uint64_t>(userdata));
+
+	auto&                                 callbacks = bc5_event_callbacks();
+	std::lock_guard<std::recursive_mutex> calling(callbacks.calling);
+	Common::LockGuard                     slots(g_mount_mutex);
