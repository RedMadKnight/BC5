+// BC5: KYTY_BC5_AUTOPRESS="47:cross,52:cross,480:shake,500:options" presses pad buttons (cross,
+// circle, square, triangle, options) or shakes the pad (two seconds of alternating acceleration)
+// at the given seconds after start — for unattended runs past the title screen. Nothing is
+// pressed without the variable.
+static void Bc5AutoPress(std::string plan) {
+	pthread_setname_np(pthread_self(), "bc5-autopress");
+	const auto start = std::chrono::steady_clock::now();
+	size_t     pos   = 0;
+	while (pos < plan.size()) {
+		size_t end = plan.find(',', pos);
+		if (end == std::string::npos) end = plan.size();
+		const std::string item  = plan.substr(pos, end - pos);
+		pos                     = end + 1;
+		const size_t      colon = item.find(':');
+		if (colon == std::string::npos) continue;
+		const double      at   = std::atof(item.substr(0, colon).c_str());
+		const std::string what = item.substr(colon + 1);
+		std::this_thread::sleep_until(start + std::chrono::milliseconds(static_cast<int64_t>(at * 1000.0)));
+		if (what == "shake") {
+			for (int k = 0; k < 40; k++) {
+				const float a[3] = {(k & 1) != 0 ? 3.0f : -3.0f, 1.0f, (k & 1) != 0 ? -2.0f : 2.0f};
+				const float w[3] = {(k & 1) != 0 ? 8.0f : -8.0f, 0.0f, 0.0f};
+				ControllerMotion(-1000, false, a);
+				ControllerMotion(-1000, true, w);
+				std::this_thread::sleep_for(std::chrono::milliseconds(50));
+			}
+			const float rest[3] = {0.0f, 1.0f, 0.0f}, still[3] = {0.0f, 0.0f, 0.0f};
+			ControllerMotion(-1000, false, rest);
+			ControllerMotion(-1000, true, still);
+			LOGF("[bc5] autopress: shake at %.1f s\n", at);
+			continue;
+		}
+		uint32_t button = 0;
+		if (what == "cross") button = PAD_BUTTON_CROSS;
+		if (what == "circle") button = PAD_BUTTON_CIRCLE;
+		if (what == "square") button = PAD_BUTTON_SQUARE;
+		if (what == "triangle") button = PAD_BUTTON_TRIANGLE;
+		if (what == "options") button = PAD_BUTTON_OPTIONS;
+		if (button == 0) continue;
+		ControllerButton(-1000, button, true);
+		std::this_thread::sleep_for(std::chrono::milliseconds(150));
+		ControllerButton(-1000, button, false);
+		LOGF("[bc5] autopress: %s at %.1f s\n", what.c_str(), at);
+	}
+}
+
+// BC5: KYTY_BC5_INPUT_CMD=<file> lets a script drive the pad while the title runs. A thread tails
+// the file (every 20 ms) and runs each new line in order:
+//   press <button> [ms]          down, ms (default 150), up
+//   hold <button> / release <button>
+//   stick <l|r> <x> <y> [ms]     0..255, 128 = centre; with ms it re-centres afterwards
+//   trigger <l2|r2> <0..255> [ms]
+//   shake | wait <ms> | reset    (reset: centre the sticks, release everything)
+// Buttons: cross circle square triangle options up down left right l1 r1 l2 r2 l3 r3 touchpad.
+// After each line the count of lines done is written to <file>.done. Nothing runs without the
+// variable.
+static uint32_t Bc5ButtonByName(const std::string& n) {
+	static const std::pair<const char*, uint32_t> names[] = {
+	    {"cross", PAD_BUTTON_CROSS}, {"circle", PAD_BUTTON_CIRCLE}, {"square", PAD_BUTTON_SQUARE},
+	    {"triangle", PAD_BUTTON_TRIANGLE}, {"options", PAD_BUTTON_OPTIONS}, {"up", PAD_BUTTON_UP},
+	    {"down", PAD_BUTTON_DOWN}, {"left", PAD_BUTTON_LEFT}, {"right", PAD_BUTTON_RIGHT},
+	    {"l1", PAD_BUTTON_L1}, {"r1", PAD_BUTTON_R1}, {"l2", PAD_BUTTON_L2}, {"r2", PAD_BUTTON_R2},
+	    {"l3", PAD_BUTTON_L3}, {"r3", PAD_BUTTON_R3}, {"touchpad", PAD_BUTTON_TOUCH_PAD}};
+	for (const auto& [name, bit]: names) {
+		if (n == name) return bit;
+	}
+	return 0;
+}
+
+static void Bc5InputCmd(std::string path) {
+	pthread_setname_np(pthread_self(), "bc5-input-cmd");
+	const auto ms = [](int v) { std::this_thread::sleep_for(std::chrono::milliseconds(v)); };
+	uint32_t   held = 0;
+	const auto reset = [&] {
+		for (int a = 0; a < 4; a++) ControllerAxis(-1000, static_cast<Axis>(a), 128);
+		ControllerAxis(-1000, Axis::TriggerLeft, 0);
+		ControllerAxis(-1000, Axis::TriggerRight, 0);
+		for (uint32_t b = 1; b != 0; b <<= 1u) {
+			if ((held & b) != 0) ControllerButton(-1000, b, false);
+		}
+		held = 0;
+	};
+	long        offset = 0;
+	uint64_t    done   = 0;
+	std::string partial;
+	for (;;) {
+		ms(20);
+		FILE* f = std::fopen(path.c_str(), "rb");
+		if (f == nullptr) continue;
+		std::fseek(f, 0, SEEK_END);
+		const long size = std::ftell(f);
+		if (size < offset) offset = 0; // truncated: start over
+		std::fseek(f, offset, SEEK_SET);
+		std::string chunk(static_cast<size_t>(size - offset), '\0');
+		const size_t got = chunk.empty() ? 0 : std::fread(chunk.data(), 1, chunk.size(), f);
+		std::fclose(f);
+		offset += static_cast<long>(got);
+		partial += chunk.substr(0, got);
+		size_t eol = 0;
+		while ((eol = partial.find('\n')) != std::string::npos) {
+			const std::string line = partial.substr(0, eol);
+			partial.erase(0, eol + 1);
+			char a[32] = {}, b[32] = {};
+			int  x = -1, y = -1, t = -1;
+			const int n = std::sscanf(line.c_str(), "%31s %31s %d %d %d", a, b, &x, &y, &t);
+			const std::string cmd = a, arg = b;
+			if (n >= 2 && cmd == "press" && Bc5ButtonByName(arg) != 0) {
+				ControllerButton(-1000, Bc5ButtonByName(arg), true);
+				ms(n >= 3 && x > 0 ? x : 150);
+				ControllerButton(-1000, Bc5ButtonByName(arg), false);
+			} else if (n >= 2 && cmd == "hold" && Bc5ButtonByName(arg) != 0) {
+				held |= Bc5ButtonByName(arg);
+				ControllerButton(-1000, Bc5ButtonByName(arg), true);
+			} else if (n >= 2 && cmd == "release" && Bc5ButtonByName(arg) != 0) {
+				held &= ~Bc5ButtonByName(arg);
+				ControllerButton(-1000, Bc5ButtonByName(arg), false);
+			} else if (n >= 4 && cmd == "stick" && (arg == "l" || arg == "r")) {
+				const Axis ax = arg == "l" ? Axis::LeftX : Axis::RightX;
+				const Axis ay = arg == "l" ? Axis::LeftY : Axis::RightY;
+				ControllerAxis(-1000, ax, std::clamp(x, 0, 255));
+				ControllerAxis(-1000, ay, std::clamp(y, 0, 255));
+				if (n >= 5 && t > 0) {
+					ms(t);
+					ControllerAxis(-1000, ax, 128);
+					ControllerAxis(-1000, ay, 128);
+				}
+			} else if (n >= 3 && cmd == "trigger" && (arg == "l2" || arg == "r2")) {
+				const Axis at = arg == "l2" ? Axis::TriggerLeft : Axis::TriggerRight;
+				ControllerAxis(-1000, at, std::clamp(x, 0, 255));
+				if (n >= 4 && y > 0) {
+					ms(y);
+					ControllerAxis(-1000, at, 0);
+				}
+			} else if (n >= 1 && cmd == "shake") {
+				for (int k = 0; k < 40; k++) {
+					const float acc[3] = {(k & 1) != 0 ? 3.0f : -3.0f, 1.0f, (k & 1) != 0 ? -2.0f : 2.0f};
+					const float w[3]   = {(k & 1) != 0 ? 8.0f : -8.0f, 0.0f, 0.0f};
+					ControllerMotion(-1000, false, acc);
+					ControllerMotion(-1000, true, w);
+					ms(50);
+				}
+				const float rest[3] = {0.0f, 1.0f, 0.0f}, still[3] = {0.0f, 0.0f, 0.0f};
+				ControllerMotion(-1000, false, rest);
+				ControllerMotion(-1000, true, still);
+			} else if (n >= 1 && (cmd == "pause" || cmd == "resume")) { // BC5 (experiment 0166): the window's pause from a script
+				Graphics::WindowSetPaused(cmd == "pause");
+			} else if (n >= 2 && cmd == "wait") {
+				ms(std::clamp(std::atoi(b), 0, 600000));
+			} else if (n >= 1 && cmd == "reset") {
+				reset();
+			} else if (n >= 1 && a[0] != '#') {
+				LOGF("[bc5] input-cmd: unknown line '%s'\n", line.c_str());
+			}
+			done++;
+			if (FILE* d = std::fopen((path + ".done").c_str(), "wb"); d != nullptr) {
+				std::fprintf(d, "%" PRIu64 "\n", done);
+				std::fclose(d);
+			}
+		}
+	}
+}
+
+KYTY_SUBSYSTEM_INIT(Controller) {
+	EXIT_IF(g_controller != nullptr);
+
+	g_controller = new GameController;
+	g_controller->ResetInputState();
+	if (const char* plan = std::getenv("KYTY_BC5_AUTOPRESS"); plan != nullptr && *plan != 0) {
+		std::thread(Bc5AutoPress, std::string(plan)).detach();
+	}
+	if (const char* path = std::getenv("KYTY_BC5_INPUT_CMD"); path != nullptr && *path != 0) {
+		std::thread(Bc5InputCmd, std::string(path)).detach();
+	}
+
+	// The native DualSense HID driver is opt-in and off by default. SDL already
+	// handles every standard pad (including a DualSense); this unvalidated driver is
+	// only opened when explicitly enabled via Config::DualSenseEnabled(), so it never
+	// competes with the SDL controller path for the same device.
+	g_dualsense = nullptr;
+	if (Config::DualSenseEnabled()) {
+		g_dualsense = new ::Libs::DualSense::DualSenseDriver;
+		if (g_dualsense->Open()) {
+			g_dualsense->SetInputCallback(&DualSenseInputCallback, nullptr);
+			g_controller->Connect(DUALSENSE_CONTROLLER_ID);
+		} else {
+			// No DualSense found; the SDL path remains the active input source.
+			delete g_dualsense;
+			g_dualsense = nullptr;
+		}
+	}
+}
+
+KYTY_SUBSYSTEM_UNEXPECTED_SHUTDOWN(Controller) {}
+
+KYTY_SUBSYSTEM_DESTROY(Controller) {
+	if (g_dualsense != nullptr) {
+		g_dualsense->Close();
+		delete g_dualsense;
+		g_dualsense = nullptr;
+	}
+}
