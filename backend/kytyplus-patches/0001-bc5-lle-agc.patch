-		AllocatedBlock right = b;
-		right.start_addr     = start + len;
-		right.size           = old_end - right.start_addr;
-		if (right.map_vaddr != 0) {
-			right.map_vaddr += right.start_addr - old_start;
-			right.map_size = right.size;
-		}
-
-		b.size = start - old_start;
-		if (b.map_vaddr != 0) {
-			b.map_size = b.size;
-		}
