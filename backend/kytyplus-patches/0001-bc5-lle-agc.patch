+#if KYTY_PLATFORM != KYTY_PLATFORM_WINDOWS
+// BC5 (experiment 0022): for a file that does not exist the resolver below listed the whole
+// directory to look for a name differing only in case. ASTRO BOT asks for some 17,000 missing
+// files while its first level loads, in directories of up to 12,000 entries behind the game
+// image's FUSE mount, under the mount table's lock: the load took four minutes for it. The
+// names of a directory are kept, folded to lower case, while its modification time is unchanged.
+// Returns the real name for `name`, empty when the directory has none that matches.
+static std::string Bc5FoldedLookup(const std::filesystem::path& dir, const std::string& name) {
+	struct Entry {
+		bool                                         filled = false;
+		std::filesystem::file_time_type              mtime {};
+		std::unordered_map<std::string, std::string> names;
+	};
+	static std::mutex                             mutex;
+	static std::unordered_map<std::string, Entry> cache;
+	auto fold = [](std::string text) {
+		for (auto& c: text) {
+			c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+		}
+		return text;
+	};
+	std::error_code ec;
+	const auto      mtime = std::filesystem::last_write_time(dir, ec);
+	if (ec) {
+		return {};
+	}
+	std::lock_guard lock(mutex);
+	auto&           e = cache[dir.string()];
+	if (!e.filled || e.mtime != mtime) {
+		e.names.clear();
+		e.mtime  = mtime;
+		e.filled = true;
+		for (std::filesystem::directory_iterator entry(dir, ec), end; entry != end; entry.increment(ec)) {
+			if (ec) {
+				break;
+			}
+			const std::string real = entry->path().filename().string();
+			e.names.emplace(fold(real), real); // the first of several that differ only in case, as before
+		}
+	}
+	const auto found = e.names.find(fold(name));
+	return found != e.names.end() ? found->second : std::string();
+}
+
+// Resolve guest paths case-insensitively on case-sensitive hosts.
+static std::filesystem::path ResolvePathIgnoringCase(const std::filesystem::path& path) {
+	std::error_code ec;
+	if (std::filesystem::exists(path, ec)) {
+		return path;
+	}
+
+	// Preserve unmatched components for the caller's ENOENT path.
+	std::filesystem::path resolved =
+	    path.has_root_path() ? path.root_path() : std::filesystem::path(".");
+	bool matched = true;
+
+	for (const auto& component: path.relative_path()) {
+		if (component.empty()) {
+			continue;
+		}
+
+		auto candidate = resolved / component;
+		if (!matched || std::filesystem::exists(candidate, ec)) {
+			resolved = std::move(candidate);
+			continue;
+		}
+
+		bool found = false;
+		if (const std::string real = Bc5FoldedLookup(resolved, component.string()); !real.empty()) {
+			resolved /= real;
+			found = true;
+		}
+
+		if (!found) {
+			resolved = std::move(candidate);
+			matched  = false;
+		}
+	}
+
+	return resolved;
+}
