+void KernelPauseClocks(bool on) {
+	static std::mutex m;
+	std::lock_guard   lock(m);
+	const uint64_t    now   = KernelReadTscNative();
+	const uint64_t    start = g_pause_tsc_start.load(std::memory_order_acquire);
+	if (on && start == 0) {
+		g_pause_tsc_start.store(now, std::memory_order_release);
+	} else if (!on && start != 0) {
+		g_pause_tsc_total.fetch_add(now > start ? now - start : 0, std::memory_order_acq_rel);
