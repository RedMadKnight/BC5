+
+	if (bc5_savedata_memory_fix(BC5_SDM_FIX_SYNC)) { // experiment 0401 series e5: the checks, the write and the event
+		return bc5_sync_save_data_memory(static_cast<const Bc5SaveDataMemorySync*>(sync_param));
+	}
+	return OK;
+}
