+	// Experiment 0047: the title picks its 3D resolution itself, from the GPU time its timestamps
+	// show (it registers 3840x2160 output buffers and asks the system for no video mode, HANDOFF
+	// F67, F100). The host scales those timestamps; a larger scale makes the title render less.
+	// The title has four steps and no others (experiments 0046-0048, runs 166-176: scales 1.0, 1.2-1.3,
+	// 1.4-2.0 and 2.5-3.0); it went no lower than 1920x1080, even with the GPU slowed to a fifth. The
+	// presets name the usual resolution each step is nearest to and say what the title draws.
+	void DrawVideo() {
+		struct Preset {
+			const char* label;
+			double      k;
+		};
+		static const Preset presets[] = {
+		    {"4K UHD - 2160p (3840x2160): about 57 fps in the first level", 1.0},
+		    {"1800p class (the title draws 3328x1872): 59-60 fps", 1.25},
+		    {"1440p class (the title draws 2432x1368): 60 fps", 1.7},
+		    {"Full HD - 1080p (1920x1080): 60 fps, the GPU half free", 3.0},
+		};
+		uint32_t w = 0, h = 0;
+		const bool   known = Libs::Bc5Gc::Direct::GetMainPass(&w, &h);
+		const double live  = Libs::Bc5Gc::Direct::GetTimestampScale();
+		ImGui::TextWrapped("The game chooses the resolution of its 3D view itself, from the GPU time it measures, "
+		                   "and scales it to its 3840x2160 output; HD (720p) is below what it goes to. A lower "
+		                   "setting makes it render fewer pixels, so the GPU has room for heavier scenes; above "
+		                   "60 fps there is nothing to gain. The change is live; Save keeps it for the next start.");
+		ImGui::Separator();
+		if (known) {
+			ImGui::Text("3D view now: %ux%u    timestamp scale now: %.2f", w, h, live);
+		} else {
+			ImGui::Text("3D view now: not seen yet    timestamp scale now: %.2f", live);
+		}
+		ImGui::Separator();
+		bool fs = WindowIsFullscreen();
+		if (ImGui::Checkbox("Fullscreen, at the display's resolution (F11)", &fs)) {
+			WindowSetFullscreen(fs);
+			draft.SetFullscreen(fs);
+			dirty        = true;
+			video_status = std::string("fullscreen ") + (fs ? "on" : "off") + " (live); Save to keep it";
+		}
+		ImGui::TextDisabled("Resolution of the game's 3D view:");
+		double k = draft.RenderScale() > 0.0 ? draft.RenderScale() : live;
+		for (const auto& p: presets) {
+			if (ImGui::RadioButton(p.label, std::abs(k - p.k) < 0.005)) {
+				draft.SetRenderScale(p.k);
+				dirty = true;
+				Libs::Bc5Gc::Direct::SetTimestampScale(p.k);
+				video_status = "applied (live); Save to keep it";
+			}
+		}
+		float kf = static_cast<float>(k);
+		if (ImGui::SliderFloat("timestamp scale", &kf, 0.5f, 4.0f, "%.2f")) {
+			draft.SetRenderScale(kf);
+			dirty = true;
+			Libs::Bc5Gc::Direct::SetTimestampScale(kf);
+			video_status = "applied (live); Save to keep it";
+		}
+		ImGui::BeginDisabled(path.empty());
+		if (ImGui::Button("Save")) {
+			std::string error;
+			if (!HostInputSave(path, draft.lines, &error)) {
+				video_status = "not saved: " + error;
+			} else if (!HostInputApply(draft.lines, &error)) {
+				video_status = "saved, not applied: " + error;
+			} else {
+				video_status = "saved";
+				dirty        = false;
+			}
+		}
+		ImGui::EndDisabled();
+		ImGui::SameLine();
+		if (ImGui::Button("Close")) {
+			SettingsOverlayToggle();
+		}
+		ImGui::TextUnformatted(video_status.c_str());
+		ImGui::Separator();
+		ImGui::TextWrapped("Restart the game: the emulator stops and the launcher starts it again from the "
+		                   "beginning (the desktop shortcut does; progress since the last save is lost).");
+		ImGui::Checkbox("I have saved", &restart_armed);
+		ImGui::BeginDisabled(!restart_armed);
+		if (ImGui::Button("Restart game")) {
+			std::fflush(nullptr);
+			::sync();
+			std::_Exit(75); // play-astro.sh starts the emulator again on this exit code
+		}
+		ImGui::EndDisabled();
+	}
+
+	bool PrepareFrame(vk::Extent2D frame_extent, vk::Format format, uint32_t image_count) {
+		if (!SettingsOverlayActive()) {
+			was_active = false;
+			return false;
+		}
+		EnsureVulkan(format, image_count);
+		// The settings window loads the live configuration when it opens (the menu bar alone does not).
+		const bool settings_open = g_active.load(std::memory_order_acquire);
+		if (settings_open && !was_active) {
+			LoadDraft();
+			auto& io = ImGui::GetIO();
+			io.ClearEventsQueue();
+			io.ClearInputKeys();
+			io.ClearInputMouse();
+		}
+		was_active = settings_open;
+		DrainInput();
+		TakeCapture();
+
+		auto& io       = ImGui::GetIO();
+		io.DisplaySize = {static_cast<float>(frame_extent.width), static_cast<float>(frame_extent.height)};
+		const auto now = std::chrono::steady_clock::now();
+		io.DeltaTime   = last_frame == std::chrono::steady_clock::time_point {}
+		                     ? 1.0f / 60.0f
+		                     : std::clamp(std::chrono::duration<float>(now - last_frame).count(), 1.0f / 1000.0f, 0.1f);
+		last_frame     = now;
+		ImGui_ImplVulkan_NewFrame();
+		ImGui::NewFrame();
+		Draw(frame_extent);
+		ImGui::Render();
+		extent = frame_extent;
+		return true;
+	}
+
+	void Record(vk::CommandBuffer command, vk::ImageView target) {
+		vk::RenderingAttachmentInfo color {};
+		color.sType       = vk::StructureType::eRenderingAttachmentInfo;
+		color.imageView   = target;
+		color.imageLayout = vk::ImageLayout::eColorAttachmentOptimal;
+		color.loadOp      = vk::AttachmentLoadOp::eLoad;
+		color.storeOp     = vk::AttachmentStoreOp::eStore;
+		vk::RenderingInfo rendering {};
+		rendering.sType                = vk::StructureType::eRenderingInfo;
+		rendering.renderArea.extent    = extent;
+		rendering.layerCount           = 1;
+		rendering.colorAttachmentCount = 1;
+		rendering.pColorAttachments    = &color;
+		command.beginRendering(rendering);
+		{
+			Common::LockGuard queue_lock(graphics.queue_mutex);
+			ImGui_ImplVulkan_RenderDrawData(ImGui::GetDrawData(), static_cast<VkCommandBuffer>(command));
+		}
+		command.endRendering();
+	}
+
+	void ReleaseVulkan() {
+		if (!vulkan_initialized) {
+			return;
+		}
+		ImGui::SetCurrentContext(imgui_context);
+		ImGui_ImplVulkan_Shutdown();
+		vulkan_initialized = false;
+	}
+
+	GraphicContext&                       graphics;
+	std::vector<std::string>              controls;
+	Draft                                 draft;
+	std::string                           path;
+	std::string                           status;
+	bool                                  dirty              = false;
+	std::string                           video_status;
+	bool                                  restart_armed      = false;
+	bool                                  was_active         = false;
+	ImGuiContext*                         imgui_context      = nullptr;
+	bool                                  vulkan_initialized = false;
+	vk::Extent2D                          extent {};
+	std::chrono::steady_clock::time_point last_frame;
+};
+
+SettingsOverlay::SettingsOverlay(GraphicContext& graphics): m_impl(std::make_unique<Impl>(graphics)) {}
+
+SettingsOverlay::~SettingsOverlay() = default;
+
+bool SettingsOverlay::PrepareFrame(vk::Extent2D extent, vk::Format format, uint32_t image_count) {
+	return m_impl->PrepareFrame(extent, format, image_count);
+}
+
+void SettingsOverlay::Record(vk::CommandBuffer command, vk::ImageView target) {
+	m_impl->Record(command, target);
+}
+
+void SettingsOverlay::ReleaseVulkan() {
+	m_impl->ReleaseVulkan();
+}
+
+} // namespace Libs::Graphics
