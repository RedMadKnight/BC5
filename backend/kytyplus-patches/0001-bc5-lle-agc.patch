+// BC5: KYTY_BC5_INPUT_CMD=<file> lets a script drive the pad while the title runs. A thread tails
+// the file (every 20 ms) and runs each new line in order:
+//   press <button> [ms]          down, ms (default 150), up
+//   hold <button> / release <button>
+//   stick <l|r> <x> <y> [ms]     0..255, 128 = centre; with ms it re-centres afterwards
+//   trigger <l2|r2> <0..255> [ms]
+//   shake | wait <ms> | reset    (reset: centre the sticks, release everything)
+// Buttons: cross circle square triangle options up down left right l1 r1 l2 r2 l3 r3 touchpad.
+// After each line the count of lines done is written to <file>.done. Nothing runs without the
+// variable.
+static uint32_t Bc5ButtonByName(const std::string& n) {
+	static const std::pair<const char*, uint32_t> names[] = {
+	    {"cross", PAD_BUTTON_CROSS}, {"circle", PAD_BUTTON_CIRCLE}, {"square", PAD_BUTTON_SQUARE},
+	    {"triangle", PAD_BUTTON_TRIANGLE}, {"options", PAD_BUTTON_OPTIONS}, {"up", PAD_BUTTON_UP},
+	    {"down", PAD_BUTTON_DOWN}, {"left", PAD_BUTTON_LEFT}, {"right", PAD_BUTTON_RIGHT},
+	    {"l1", PAD_BUTTON_L1}, {"r1", PAD_BUTTON_R1}, {"l2", PAD_BUTTON_L2}, {"r2", PAD_BUTTON_R2},
+	    {"l3", PAD_BUTTON_L3}, {"r3", PAD_BUTTON_R3}, {"touchpad", PAD_BUTTON_TOUCH_PAD}};
+	for (const auto& [name, bit]: names) {
+		if (n == name) return bit;
+	}
+	return 0;
+}
