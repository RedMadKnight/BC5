+// BC5: guest range of a registered display buffer (the direct-mode host samples it at flip,
+// BC5_DIRECT_FLIP_BRIGHT).
+bool Bc5VideoOutBufferRange(int handle, int index, uint64_t* addr, uint64_t* size) {
+	auto* video_out = DriverState().Get(handle);
+	if (video_out == nullptr || addr == nullptr || size == nullptr || !IsValidBufferIndex(index) ||
+	    IsSpecialBufferIndex(index)) {
+		return false;
+	}
+	Common::LockGuard lock(video_out->mutex);
+	const auto&       surface = video_out->buffers[index];
+	if (!surface.Occupied() || surface.group_index >= VIDEO_OUT_BUFFER_ATTRIBUTE_NUM_MAX ||
+	    !video_out->groups[surface.group_index].occupied) {
+		return false;
+	}
+	const auto info = video_out->groups[surface.group_index].ImageInfo(surface);
+	*addr           = info.data.address;
+	*size           = info.data.size;
+	return true;
+}
