+		held_large = held_small = 0;
+	}
+	if (large != 0 || small != 0) {
+		held_large = std::max(held_large, large);
+		held_small = std::max(held_small, small);
+		hold_end   = now + std::chrono::milliseconds(80);
+	}
+	const bool changed = held_large != sent_large || held_small != sent_small;
+	const bool refresh = (held_large != 0 || held_small != 0) && now - sent_at >= std::chrono::milliseconds(40);
