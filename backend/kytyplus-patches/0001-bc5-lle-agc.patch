+int KYTY_SYSV_ABI SaveDataGetEventResult(const void* event_param, SaveDataEvent* event) {
+	PRINT_NAME();
+	{ // BC5: the guest return addresses of the event polls, each journaled once (save data diagnosis).
+		static std::mutex m;
+		static std::vector<uint64_t> seen;
+		const auto ra = reinterpret_cast<uint64_t>(__builtin_return_address(0));
+		std::lock_guard lk(m);
+		if (seen.size() < 16 && std::find(seen.begin(), seen.end(), ra) == seen.end()) {
+			seen.push_back(ra);
+			LOGF("bc5 save: SaveDataGetEventResult called from 0x%016" PRIx64 "\n", ra);
+		}
+	}
+
+	LOGF("\t event_param = 0x%016" PRIx64 "\n"
+	     "\t event       = 0x%016" PRIx64 "\n",
+	     reinterpret_cast<uint64_t>(event_param), reinterpret_cast<uint64_t>(event));
+
+	if (event == nullptr) {
+		return SAVE_DATA_ERROR_PARAMETER;
+	}
+
+	if (g_save_data_events.empty()) {
+		return SAVE_DATA_ERROR_NOT_FOUND;
+	}
+
+	*event = g_save_data_events.front();
+	g_save_data_events.pop_front();
+
+	LOGF("\t type       = %" PRIu32 "\n"
+	     "\t error_code = %" PRId32 "\n"
+	     "\t user_id    = %" PRId32 "\n"
+	     "\t title_id   = %.10s\n"
+	     "\t dir_name   = %.32s\n",
+	     event->type, event->error_code, event->user_id, event->title_id.data,
+	     event->dir_name.data);
+
+	return OK;
+}
