+
+// (handle, index, flip_mode, flip_arg, ...): treated as a CPU flip for now.
+// TODO(bc5): the EOP part (flip when the GPU reaches the end of the submitted DCB).
+static KYTY_SYSV_ABI int SubmitEopFlip(int handle, int index, int flip_mode, int64_t flip_arg,
+                                       void* unk) {
+	PRINT_NAME();
+	// Direct mode: does the GPU write the display buffer? A sparse sum over the surface, journaled
+	// per flip (zero = nobody rendered into it; the game's last pass targets these very buffers).
+	// BC5_DIRECT_FLIP_SAMPLE=1 since 2026-10-07: the diagnostic of runs 60-76 read a word per page
+	// of the 33 MB display buffer and of every recent target on the game's thread at every flip.
+	static const bool flip_sample = std::getenv("BC5_DIRECT_FLIP_SAMPLE") != nullptr;
+	if (flip_sample && std::getenv("BC5_GC_MODE") != nullptr && std::strcmp(std::getenv("BC5_GC_MODE"), "direct") == 0) {
+		uint64_t a = 0, n = 0;
+		if (VideoOut::Bc5VideoOutBufferRange(handle, index, &a, &n) && a != 0 && n != 0) {
+			const auto* w = reinterpret_cast<const volatile uint32_t*>(a);
+			// BC5_DIRECT_FLIP_PREFILL=1: after sampling, the sample points get a pattern; the next
+			// flip of this buffer tells "nobody wrote it" (pattern stays) from "the pass wrote
+			// black" (zero) — run 73.
+			static const bool prefill = std::getenv("BC5_DIRECT_FLIP_PREFILL") != nullptr;
+			const uint32_t kPattern = 0x5a5a5a5au;
+			uint64_t sum = 0, nonzero = 0, samples = 0, pattern = 0;
+			for (uint64_t k = 0; k < n / 4; k += 1024, samples++) {
+				const uint32_t v = w[k];
+				sum += v;
+				nonzero += v != 0;
+				pattern += v == kPattern;
+			}
+			// BC5_DIRECT_FLIP_DUMP=<every n>: the display buffer as the GPU left it, raw, as
+			// flip-<count>.raw in the capture directory (when the sampled content changed, at most 10 files; never committed) — the
+			// image itself, whatever the presenter makes of it (run 76).
+			static const long dump_every = std::getenv("BC5_DIRECT_FLIP_DUMP") ? std::atol(std::getenv("BC5_DIRECT_FLIP_DUMP")) : 0;
+			static long flips = 0, dumped = 0;
+			flips++;
+			static uint64_t last_sum = 0; // a dump only when the sampled content changed
+			if (dump_every > 0 && nonzero != 0 && sum != last_sum && (flips % dump_every) == 0 && dumped < 10 && !Bc5Gc::g_dump_dir.empty()) {
+				last_sum = sum;
+				char name[512];
+				std::snprintf(name, sizeof(name), "%s/flip-%03ld.raw", Bc5Gc::g_dump_dir.c_str(), flips);
+				if (FILE* f = std::fopen(name, "wb")) {
+					std::fwrite(reinterpret_cast<const void*>(a), 1, n, f);
+					std::fclose(f);
+					dumped++;
+					Bc5Gc::Direct::journal("flip %ld dumped: %s\n", flips, name);
+				}
+			}
+			if (prefill) {
+				auto* ww = reinterpret_cast<volatile uint32_t*>(a);
+				for (uint64_t k = 0; k < n / 4; k += 1024) ww[k] = kPattern;
+			}
+			Bc5Gc::Direct::journal("flip %d/%d buffer 0x%" PRIx64 " +0x%" PRIx64 ": sum 0x%" PRIx64 " nonzero %" PRIu64 "/%" PRIu64 " pattern %" PRIu64 "\n", handle, index, a, n, sum, nonzero, samples, pattern);
+			// Do any render targets or depth buffers receive pixels at all? Sample 4 MiB from each
+			// base the hint mapper saw (run 60: the flip buffer stays zero with sane counters).
+			for (const auto& t: Bc5Gc::Direct::g_recent_targets) {
+				const auto* tw = reinterpret_cast<const volatile uint32_t*>(t.second);
+				uint64_t nz = 0, smp = 0;
+				std::vector<uint32_t> vals;
+				for (uint64_t k = 0; k < (4u << 20u) / 4; k += 1024, smp++) { const uint32_t v = tw[k]; nz += v != 0; vals.push_back(v); }
+				std::sort(vals.begin(), vals.end());
+				const size_t distinct = static_cast<size_t>(std::unique(vals.begin(), vals.end()) - vals.begin());
+				// a clear leaves one value, rasterised content many (run 62: are the draws real?)
+				Bc5Gc::Direct::journal("  target %s 0x%" PRIx64 ": distinct %zu min 0x%08x max 0x%08x, ", t.first, t.second, distinct, vals.front(), vals[distinct - 1]);
+				Bc5Gc::Direct::journal("  target %s 0x%" PRIx64 ": nonzero %" PRIu64 "/%" PRIu64 "\n", t.first, t.second, nz, smp);
+			}
+			LOGF("[bc5-direct] flip buffer 0x%" PRIx64 ": nonzero samples %" PRIu64 "/%" PRIu64 "\n", a, nonzero, samples);
+		}
+	}
+	static int flip_logged = 0;
+	if (Bc5Gc::gc_log_few(&flip_logged)) {
+		LOGF("[bc5-gc] VideoOutSubmitEopFlip(%d, %d, %d, 0x%" PRIx64 ", %p)\n", handle, index,
+		     flip_mode, flip_arg, unk);
+	}
+	// BC5_GC_QUEUE_TABLE=<hex address>[:entries]: the driver library's own queue table (entries
+	// of 0x90 bytes; +0x70 pointer to the read pointer the kernel publishes, +0x7c ring bytes,
+	// +0x88 the driver's write pointer in dwords — read off its free-space loop, experiment 0018),
+	// journaled every 8th flip for the entries in use: which ring fills up because nobody
+	// advances its read pointer? The address is the maintainer's to give; nothing of the
+	// library is in this source.
+	{
+		static const char* qt_env = std::getenv("BC5_GC_QUEUE_TABLE");
+		static const uint64_t qt = qt_env != nullptr ? std::strtoull(qt_env, nullptr, 16) : 0;
+		static const uint32_t qn = [&]() -> uint32_t {
+			const char* c = qt_env != nullptr ? std::strchr(qt_env, ':') : nullptr;
+			return c != nullptr ? static_cast<uint32_t>(std::strtoul(c + 1, nullptr, 0)) : 56;
+		}();
+		static uint32_t flips_seen = 0;
+		if (qt != 0 && (flips_seen++ % 8) == 0) {
+			for (uint32_t k = 0; k < qn; k++) {
+				const auto* e = reinterpret_cast<const volatile uint8_t*>(qt + static_cast<uint64_t>(k) * 0x90);
+				const uint64_t rp   = *reinterpret_cast<const volatile uint64_t*>(e + 0x70);
+				const uint32_t size = *reinterpret_cast<const volatile uint32_t*>(e + 0x7c);
+				const uint32_t wp   = *reinterpret_cast<const volatile uint32_t*>(e + 0x88);
+				if (wp == 0 || rp < 0x10000 || size == 0) continue;
+				const uint32_t r = *reinterpret_cast<const volatile uint32_t*>(rp);
+				Bc5Gc::Direct::journal("queue table flip %u entry %u: wptr %u rptr %u (at 0x%" PRIx64 ") ring %u dwords, pending %d\n", flips_seen - 1, k, wp, r, rp, size / 4,
+				                       static_cast<int32_t>(wp - r));
+			}
+		}
+	}
+	// Experiment 0025: BC5_DIRECT_FLIP_DEFER=1 — with jobs in flight the flip is not waited for
+	// here. It is queued behind the frame's jobs and submitted by the completion thread once the
+	// GPU has finished them, the buffer's label reset with it; the game's thread goes on with the
+	// next frame instead of idling at the flip, and the GPU does not idle while it does (run 117:
+	// the wait at the flip is where the two wait for each other).
+	static const bool defer = std::getenv("BC5_DIRECT_FLIP_DEFER") != nullptr && Bc5Gc::Direct::async_on();
+	const double t_drain = Bc5Gc::Direct::timing_now();
+	if (!defer) Bc5Gc::Direct::drain(); // BC5_DIRECT_ASYNC: nothing of the frame may still be in flight
+	Bc5Gc::Direct::frame_profile_flip((Bc5Gc::Direct::timing_now() - t_drain) * 1e3);
+	if (defer) {
+		Bc5Gc::Direct::post([handle, index, flip_mode, flip_arg](bool) {
+			VideoOut::VideoOutSubmitFlip(handle, index, flip_mode, flip_arg);
+			if (index >= 0 && index < 64) Bc5Gc::g_labels[index] = 0;
+		});
+		return 0;
+	}
+	const double flip_t0 = Bc5Gc::Direct::timing_now();
+	const int rc = VideoOut::VideoOutSubmitFlip(handle, index, flip_mode, flip_arg);
+	if (std::getenv("BC5_DIRECT_TIMING") != nullptr) {
+		Bc5Gc::Direct::journal("timing: t %.3f s flip %d/%d, VideoOutSubmitFlip took %.1f ms\n", flip_t0, handle, index, (Bc5Gc::Direct::timing_now() - flip_t0) * 1e3);
+	}
+	// The flip is immediate here: the buffer's flip label goes back to 0, as the console's VideoOut
+	// does once the flip has happened (the game waits for that before it renders into the buffer
+	// again; run 73).
+	if (index >= 0 && index < 64) Bc5Gc::g_labels[index] = 0;
+	return rc;
