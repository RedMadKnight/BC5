+// BC5: called by the second title before it mounts a save directory with create (experiment 0145).
+// Its argument starts {int32 user_id; const SceSaveDataDirName* dir_name; ...; uint64 blocks at +0x18}.
+// 0 starts an operation that ends with a save data event of type 5; NOT_FOUND means there is none
+// to run, and the title goes on to SaveDataMount3.
+static int KYTY_SYSV_ABI SaveDataNative_2mfSRGdshtk(const void* param) {
+	const auto* p = static_cast<const uint8_t*>(param);
+	if (p != nullptr) {
+		int32_t     user_id = 0;
+		const char* dir     = nullptr;
+		uint64_t    blocks  = 0;
