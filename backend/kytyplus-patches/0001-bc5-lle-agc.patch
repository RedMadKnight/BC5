diff --git a/src/libs/libNpCommerceDialog.cpp b/src/libs/libNpCommerceDialog.cpp
new file mode 100644
index 0000000..6b58dd4
--- /dev/null
+++ b/src/libs/libNpCommerceDialog.cpp
@@ -0,0 +1,147 @@
+// BC5 experiment 0329: libSceNpCommerce's dialog for the KytyPlus host — the PlayStation Store dialog of a console
+// without a store: every open finishes at once, cancelled by the user, nothing authorized. Ported from
+// boykopovar/AnyPS5 (GPL-2.0, commit 27c88a8) core/libs/prx/libSceNpCommerce/Export.cpp (the state machine, the
+// result layout: int32 result, bool authorized, reserved bytes), with the common dialog error values of shadPS4's
+// commondialog.h (AnyPS5's file carries NOT_FINISHED as 0x80B80006 and ARG_NULL as 0x80B80009, which are
+// INVALID_STATE and OUT_OF_MEMORY there) and this tree's RUNNING state between Open and the first UpdateStatus.
+// SPDX-License-Identifier: GPL-2.0-only
+#include "common/abi.h"
+#include "common/assert.h"
+#include "common/common.h"
+#include "common/logging/log.h"
+#include "libs/errno.h"
+#include "libs/libs.h"
+#include "loader/symbolDatabase.h"
+
+#include <cinttypes>
+#include <cstdint>
+#include <cstring>
+#include <mutex>
+
+namespace Libs::NpCommerceDialog {
+
+LIB_VERSION("NpCommerce", 1, "NpCommerce", 1, 1);
+
+constexpr int STATUS_NONE        = 0;
+constexpr int STATUS_INITIALIZED = 1;
+constexpr int STATUS_RUNNING     = 2;
+constexpr int STATUS_FINISHED    = 3;
+
+constexpr int RESULT_USER_CANCELED = 1;
+
+constexpr int COMMON_DIALOG_ERROR_NOT_INITIALIZED     = static_cast<int>(0x80B80003u);
+constexpr int COMMON_DIALOG_ERROR_ALREADY_INITIALIZED = static_cast<int>(0x80B80004u);
+constexpr int COMMON_DIALOG_ERROR_NOT_FINISHED        = static_cast<int>(0x80B80005u);
+constexpr int COMMON_DIALOG_ERROR_INVALID_STATE       = static_cast<int>(0x80B80006u);
+constexpr int COMMON_DIALOG_ERROR_ARG_NULL            = static_cast<int>(0x80B8000Du);
+
+struct NpCommerceDialogResult {
+	int32_t result;
+	bool    authorized;
+	uint8_t reserved[32];
+};
+
+static std::mutex g_mutex;
+static int        g_status = STATUS_NONE;
+
+int KYTY_SYSV_ABI NpCommerceDialogInitialize() {
+	PRINT_NAME();
+
+	std::lock_guard lock(g_mutex);
+	if (g_status != STATUS_NONE) {
+		return COMMON_DIALOG_ERROR_ALREADY_INITIALIZED;
+	}
+	g_status = STATUS_INITIALIZED;
+	return OK;
+}
+
+int KYTY_SYSV_ABI NpCommerceDialogOpen(const void* param) {
+	PRINT_NAME();
+
+	std::lock_guard lock(g_mutex);
+	if (g_status == STATUS_NONE) {
+		return COMMON_DIALOG_ERROR_NOT_INITIALIZED;
+	}
+	if (param == nullptr) {
+		return COMMON_DIALOG_ERROR_ARG_NULL;
+	}
+	if (g_status != STATUS_INITIALIZED && g_status != STATUS_FINISHED) {
+		return COMMON_DIALOG_ERROR_INVALID_STATE;
+	}
+
+	LOGF("\t param = 0x%016" PRIx64 " (no store on this console: the dialog is cancelled at once)\n",
+	     reinterpret_cast<uint64_t>(param));
+
+	g_status = STATUS_RUNNING;
+	return OK;
+}
+
+int KYTY_SYSV_ABI NpCommerceDialogUpdateStatus() {
+	PRINT_NAME();
+
+	std::lock_guard lock(g_mutex);
+	if (g_status == STATUS_RUNNING) {
+		g_status = STATUS_FINISHED;
+	}
+	return g_status;
+}
+
+int KYTY_SYSV_ABI NpCommerceDialogGetStatus() {
+	PRINT_NAME();
+
+	std::lock_guard lock(g_mutex);
+	return g_status;
+}
+
+int KYTY_SYSV_ABI NpCommerceDialogClose() {
+	PRINT_NAME();
+
+	std::lock_guard lock(g_mutex);
+	if (g_status == STATUS_NONE) {
+		return COMMON_DIALOG_ERROR_NOT_INITIALIZED;
+	}
+	if (g_status == STATUS_RUNNING) {
+		g_status = STATUS_FINISHED;
+	}
+	return OK;
+}
+
+int KYTY_SYSV_ABI NpCommerceDialogGetResult(NpCommerceDialogResult* result) {
+	PRINT_NAME();
+
+	std::lock_guard lock(g_mutex);
+	if (g_status == STATUS_NONE) {
+		return COMMON_DIALOG_ERROR_NOT_INITIALIZED;
+	}
+	if (result == nullptr) {
+		return COMMON_DIALOG_ERROR_ARG_NULL;
+	}
+	if (g_status != STATUS_FINISHED) {
+		return COMMON_DIALOG_ERROR_NOT_FINISHED;
+	}
+	std::memset(result, 0, sizeof(*result));
+	result->result     = RESULT_USER_CANCELED;
+	result->authorized = false;
+	return OK;
+}
+
+int KYTY_SYSV_ABI NpCommerceDialogTerminate() {
+	PRINT_NAME();
+
+	std::lock_guard lock(g_mutex);
+	if (g_status == STATUS_NONE) {
+		return COMMON_DIALOG_ERROR_NOT_INITIALIZED;
+	}
+	g_status = STATUS_NONE;
+	return OK;
+}
+
+LIB_DEFINE(InitNpCommerceDialog_1) {
+	LIB_FUNC("0aR2aWmQal4", NpCommerceDialogInitialize);
+	LIB_FUNC("DfSCDRA3EjY", NpCommerceDialogOpen);
+	LIB_FUNC("LR5cwFMMCVE", NpCommerceDialogUpdateStatus);
+	LIB_FUNC("r42bWcQbtZY", NpCommerceDialogGetResult);
+	LIB_FUNC("m-I92Ab50W8", NpCommerceDialogTerminate);
+}
+
+} // namespace Libs::NpCommerceDialog
diff --git a/src/libs/libNpCppWebApi.cpp b/src/libs/libNpCppWebApi.cpp
new file mode 100644
index 0000000..48a2a11
--- /dev/null
+++ b/src/libs/libNpCppWebApi.cpp
@@ -0,0 +1,1113 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// KytyPlus host library: libSceNpCppWebApi (the PS5's C++ web API — Common, SessionManager V1, TitleCloudStorage V1)
+// for a console that is not signed in to PSN.
+//
+// BC5 experiment 0328. Ported from AnyPS5 (boykopovar/AnyPS5, GPL-2.0, commit 27c88a8), file
+// core/libs/prx/libSceNpCppWebApi/Export.cpp: the intrusive-pointer, string and vector machinery and the 136
+// entry points the second title imports (the title's link list, experiment 0327). AnyPS5's design is kept: each
+// exported C++ member is an extern "C" function named by its mangled symbol, taking `this` explicitly; objects
+// are constructed and released properly (reference counts at the console's offsets, the deleter the object
+// carries); every request entry point fails as a console without a PSN sign-in fails, with
+// SCE_NP_WEBAPI_ERROR_NOT_SIGNED_IN (0x80552907, the constant shadPS4 and fpPS4 document); parameter bookkeeping
+// succeeds; response accessors cannot be reached after a failed request and stop the emulator with a named
+// message instead of returning garbage. Changes from AnyPS5: APS5_VABI -> KYTY_SYSV_ABI, NotImplemented ->
+// the tree's EXIT, the registration through LIB_FUNC by NID (SHA1 of the mangled name, experiment 0327's calculator).
+// AnyPS5's copyright remains with its authors; this file is GPL-2.0 as the rest of the KytyPlus host.
+//
+// The self-aliasing fix in String::append and the two Vector pushBack helpers (a source inside the buffer or the
+// storage the call is about to free or move) is AnyPS5's commit daf4eb3 (PR #9612 by Ondra97, GPL-2.0-only).
+
+#include "common/abi.h"
+#include "common/assert.h"
+#include "common/hostException.h"
+#include "common/logging/log.h"
+#include "libs/libs.h"
+#include "loader/symbolDatabase.h"
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <cstdio> // BC5 experiment 0405: std::fprintf
+#include <cstdlib>
+#include <cstring>
+
+namespace Libs::NpCppWebApi {
+
+LIB_VERSION("NpCppWebApi", 1, "NpCppWebApi", 1, 1);
+
+static constexpr int SCE_NP_WEBAPI_ERROR_NOT_SIGNED_IN = static_cast<int>(0x80552907);
+
+// A response accessor or an unknown object layout: on the console this cannot happen after a request that failed,
+// so the title is stopped with the symbol's name rather than handed a wrong value (AnyPS5 aborts the same way).
+[[noreturn]] static void NotImplemented(const char* function) {
+	{
+		Common::HostException::RawLog log;
+		log.Append("[bc5] NpCppWebApi: not reachable offline, stopping: ");
+		log.Append(function);
+		log.Append("\n");
+		log.Flush();
+	}
+	EXIT("NpCppWebApi: %s is not reachable on an offline console\n", function);
+}
+
+// ---- BC5 experiment 0405 (series e6 of experiment 0401): KYTY_BC5_FW_NET, item "npwebapi" ----
+// exp 0405 R1 verdict row D1 libSceNpCppWebApi 08fa66176 (class excluded-provenance: "finish returns 0x80553508 per the
+// bundled PPSA21564 module"), cleared by the maintainer's decision 1 of 2026-11-04 (a reading of a module's behaviour).
+// Ported in adapted form from AnyPS5 (github.com/boykopovar/AnyPS5, GPL-2.0-only) @ 4f41f4c375f5abb487dbd184fbc150f31994d762, core/libs/prx/libSceNpCppWebApi/Export.cpp:11
+// (TransactionNotStarted) and its finish overrides, commit 08fa66176 "answer finish, abort and getId for never-started
+// transactions as the module does" (Alexandre Figueiredo): finish of a transaction that never started returns 0x80553508,
+// as the libSceNpCppWebApi module bundled with PPSA21564 does. Here every request fails before its transaction starts
+// (SCE_NP_WEBAPI_ERROR_NOT_SIGNED_IN), so every finish this file registers answers 0x80553508 with the item on; today they
+// return 0. Not taken: abort and getId (this file registers neither) and the commit's constructor changes.
+// KYTY_BC5_FW_NET (one switch for this group: libRtc.cpp, libRudp.cpp, network.cpp, libSystemService.cpp,
+// libNpCppWebApi.cpp): unset, empty or "0" is off (today's path exactly); any other value turns every item on, unless it
+// names items (comma-separated): rtc, rudp, resolver, param400, npwebapi. Each unit reads it once; libRtc.cpp prints the
+// group's one stderr line at its registration.
+// AnyPS5's copyright remains with its authors; GPL-2.0 as the rest of this file.
+static constexpr uint32_t BC5_FWN_NPWEBAPI               = 16u;
+static constexpr int      BC5_NP_TRANSACTION_NOT_STARTED = static_cast<int>(0x80553508u);
+
+static uint32_t Bc5FwNetNpParse(const char* e) {
+	if (e == nullptr || e[0] == '\0' || std::strcmp(e, "0") == 0) {
+		return 0;
+	}
+	static const char* const names[] = {"rtc", "rudp", "resolver", "param400", "npwebapi"}; // bit i is names[i]
+	uint32_t                 parts   = 0;
+	const char*              p       = e;
+	for (;;) {
+		const char*  comma = std::strchr(p, ',');
+		const size_t n     = comma != nullptr ? static_cast<size_t>(comma - p) : std::strlen(p);
+		for (uint32_t i = 0; i < 5; i++) {
+			if (n == std::strlen(names[i]) && std::strncmp(p, names[i], n) == 0) {
+				parts |= 1u << i;
+			}
+		}
+		if (comma == nullptr) {
+			break;
+		}
+		p = comma + 1;
+	}
+	return parts != 0 ? parts : 31u; // every item
+}
+
+// The items of KYTY_BC5_FW_NET that are on (0: off), read once (libRtc.cpp prints the group's line).
+static uint32_t Bc5FwNetNpItems() {
+	static const uint32_t parts = Bc5FwNetNpParse(std::getenv("KYTY_BC5_FW_NET"));
+	return parts;
+}
+
+// A stderr line for each of the first 8 calls in this file whose answer KYTY_BC5_FW_NET changed (only when it is on).
+static void Bc5FwNetNpTell(const char* what) {
+	static std::atomic<uint32_t> told {0};
+	if (told.fetch_add(1, std::memory_order_relaxed) < 8) {
+		std::fprintf(stderr, "[bc5] exp 0405: fw-net %s\n", what);
+		std::fflush(stderr);
+	}
+}
+
+// "npwebapi": true when finish answers BC5_NP_TRANSACTION_NOT_STARTED (no transaction here ever starts); false when off.
+static bool Bc5NpFinishNotStarted() {
+	if ((Bc5FwNetNpItems() & BC5_FWN_NPWEBAPI) == 0) {
+		return false;
+	}
+	Bc5FwNetNpTell("npwebapi: finish of a never-started transaction -> 0x80553508 (0 when off)");
+	return true;
+}
+// ---- end of experiment 0405's fw-net NpCppWebApi helpers ----
+
+extern "C" {
+
+struct IntrusivePtr {
+	void* object;
+	void (KYTY_SYSV_ABI* deleter)(void*);
+	void* libContext;
+};
+static_assert(sizeof(IntrusivePtr) == 0x18);
+
+static constexpr std::size_t ReferenceCountOffset       = 0;
+static constexpr std::size_t VectorReferenceCountOffset = 0x30;
+
+static std::atomic_ref<std::int32_t> ReferenceCount(void* object, const std::size_t offset) {
+	return std::atomic_ref<std::int32_t>(*reinterpret_cast<std::int32_t*>(static_cast<std::uint8_t*>(object) + offset));
+}
+
+static void CopyIntrusivePtr(IntrusivePtr* self, const IntrusivePtr* source, const std::size_t referenceCountOffset) {
+	*self = *source;
+	if (self->object) ReferenceCount(self->object, referenceCountOffset).fetch_add(1);
+}
+
+static void ReleaseIntrusivePtr(IntrusivePtr* self, const std::size_t referenceCountOffset, const char* function) {
+	if (!self->object) return;
+	if (ReferenceCount(self->object, referenceCountOffset).fetch_sub(1) != 1) return;
+	if (!self->deleter) NotImplemented(function);
+	self->deleter(self->object);
+	self->object  = nullptr;
+	self->deleter = nullptr;
+}
+
+struct CommonString {
+	std::int32_t  referenceCount;
+	char*         buffer;
+	std::uint64_t bufferSize;
+	void*         libContext;
+};
+static_assert(sizeof(CommonString) == 0x20 && offsetof(CommonString, buffer) == 0x08);
+static_assert(offsetof(CommonString, bufferSize) == 0x10 && offsetof(CommonString, libContext) == 0x18);
+
+static constexpr std::uint64_t VectorBodyMagic = 0x434e507056656342ULL;
+struct VectorBody {
+	std::uint64_t magic;
+	std::uint8_t  reserved[0x28];
+	std::int32_t  referenceCount;
+	std::int32_t  elementKind; // 1 = IntrusivePtr elements, 2 = String elements
+	void*         elements;
+	std::uint64_t size;
+	std::uint64_t capacity;
+};
+static_assert(sizeof(VectorBody) == 0x50 && offsetof(VectorBody, referenceCount) == 0x30);
+
+static void KYTY_SYSV_ABI DestroyVectorBody(void* object) {
+	auto* body = static_cast<VectorBody*>(object);
+	if (body->elementKind == 1) {
+		auto* elements = static_cast<IntrusivePtr*>(body->elements);
+		for (std::uint64_t index = 0; index < body->size; ++index) {
+			ReleaseIntrusivePtr(&elements[index], 0x00, __func__);
+		}
+	} else if (body->elementKind == 2) {
+		auto* elements = static_cast<CommonString*>(body->elements);
+		for (std::uint64_t index = 0; index < body->size; ++index) {
+			std::free(elements[index].buffer);
+		}
+	}
+	std::free(body->elements);
+	std::free(body);
+}
+
+static VectorBody* VectorBodyFor(IntrusivePtr* self, const std::int32_t elementKind, const char* function) {
+	auto* body = static_cast<VectorBody*>(self->object);
+	if (body == nullptr) {
+		body = static_cast<VectorBody*>(std::calloc(1, sizeof(VectorBody)));
+		if (body == nullptr) return nullptr;
+		body->magic          = VectorBodyMagic;
+		body->referenceCount = 1;
+		body->elementKind    = elementKind;
+		self->object         = body;
+		self->deleter        = &DestroyVectorBody;
+		return body;
+	}
+	if (body->magic != VectorBodyMagic || body->elementKind != elementKind) {
+		// appending to a title-provided body needs its element layout, which is unknown
+		NotImplemented(function);
+		return nullptr;
+	}
+	return body;
+}
+
+static bool VectorGrow(VectorBody* body, const std::size_t elementSize) {
+	if (body->size < body->capacity) return true;
+	const std::uint64_t capacity = body->capacity != 0 ? body->capacity * 2 : 4;
+	void* elements = std::realloc(body->elements, static_cast<std::size_t>(capacity) * elementSize);
+	if (elements == nullptr) return false;
+	body->elements = elements;
+	body->capacity = capacity;
+	return true;
+}
+
+static int VectorPushBackIntrusivePtr(IntrusivePtr* self, const IntrusivePtr* element) {
+	VectorBody* body = VectorBodyFor(self, 1, __func__);
+	if (body == nullptr) return -1;
+	const IntrusivePtr copy = *element;
+	if (!VectorGrow(body, sizeof(IntrusivePtr))) return -1;
