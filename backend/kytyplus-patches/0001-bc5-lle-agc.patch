+
+extern "C" void bc5_exp0401_amm_stats(uint64_t* pool_free, uint64_t* pages, uint64_t* prt_bytes) {
+	std::scoped_lock lock(g_bc5_amm_mutex);
+	uint64_t         free_bytes = 0;
+	{
+		std::scoped_lock pool_lock(g_amm_auto_pool_mutex);
+		for (const auto& r: g_amm_auto_free) {
+			free_bytes += r.second;
+		}
+	}
+	uint64_t prt = 0;
+	for (const auto& [a, b]: g_bc5_prt) {
+		prt += b - a;
+	}
+	if (pool_free != nullptr) {
+		*pool_free = free_bytes;
+	}
+	if (pages != nullptr) {
+		*pages = g_bc5_amm_pages.size();
+	}
+	if (prt_bytes != nullptr) {
+		*prt_bytes = prt;
+	}
+}
+
+// 1: the page is in the page table, 2: it is in a PRT range, 4: a counted pool page.
+extern "C" int bc5_exp0401_amm_page(uint64_t va, uint64_t* dmem, int32_t* type, int32_t* prot) {
+	std::scoped_lock lock(g_bc5_amm_mutex);
+	int              flags = 0;
+	if (const auto it = g_bc5_amm_pages.find(va); it != g_bc5_amm_pages.end()) {
+		flags |= 1;
+		if (it->second.owner == BC5_PAGE_COUNTED) {
+			flags |= 4;
+		}
+		if (dmem != nullptr) {
+			*dmem = it->second.dmem;
+		}
+		if (type != nullptr) {
+			*type = it->second.type;
+		}
+		if (prot != nullptr) {
+			*prot = it->second.prot;
+		}
+	}
+	if (Bc5PrtCovers(va, va + AMM_PAGE_SIZE)) {
+		flags |= 2;
+	}
+	return flags;
+}
