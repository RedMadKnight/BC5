+// ADR 0009, waits steps 2 and 3 (BC5_DIRECT_CROSS_RING_WAITS; experiments only, maintainer present):
+// a wait also stays for the GPU when the last pending write of its label is on the other ring:
+// =compute for the compute ring's waits only (a wait that never ends costs a reset of that ring),
+// =all for the GFX ring's too (a GFX ring that hangs without a fault has taken the machine down,
+// F110). Only writes of jobs already submitted are pending, so each job waits on earlier ones and
+// the waits form no cycle.
+static int cross_ring_waits() {
+	static const int v = [] {
+		const char* e = std::getenv("BC5_DIRECT_CROSS_RING_WAITS");
+		if (e == nullptr) return 0;
+		return std::strcmp(e, "all") == 0 ? 2 : 1;
+	}();
+	return v;
+}
