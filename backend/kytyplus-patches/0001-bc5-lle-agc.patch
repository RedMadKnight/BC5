diff --git a/src/graphics/presentation/hostMenu.cpp b/src/graphics/presentation/hostMenu.cpp
new file mode 100644
index 0000000..f3f86d9
--- /dev/null
+++ b/src/graphics/presentation/hostMenu.cpp
@@ -0,0 +1,526 @@
+#include "graphics/presentation/hostMenu.h"
+
+#include "SDL.h"
+#include "graphics/presentation/settingsOverlay.h"
+#include "graphics/presentation/window.h"
+#include "common/logging/log.h"
+#include "imgui.h"
+#include "kytyGitVersion.h"
+
+#include <algorithm>
+#include <atomic>
+#include <cctype>
+#include <cstdio>
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <string>
+#include <system_error>
+#include <unistd.h>
+#include <vector>
+
+namespace Libs::Graphics {
+
+namespace {
+
+constexpr int EXIT_CODE_RESTART = 75; // experiment 0047: the launcher starts the same game again
+constexpr int EXIT_CODE_OPEN    = 76; // ADR 0011: the launcher opens the path in choice.txt
+constexpr int EXIT_CODE_CLOSE   = 77; // ADR 0011: the launcher comes back with --menu
+constexpr size_t RECENT_MAX     = 8;
+
+std::atomic<bool> g_visible {false};
+std::atomic<bool> g_launcher {false};
+
+const char* MenuDir() {
+	static const char* dir = std::getenv("KYTY_BC5_MENU_DIR");
+	return (dir != nullptr && dir[0] != 0) ? dir : nullptr;
+}
+
+std::filesystem::path MenuFile(const char* name) {
+	return std::filesystem::path(MenuDir()) / name;
+}
+
+std::vector<std::string> ReadLines(const std::filesystem::path& path) {
+	std::vector<std::string> lines;
+	std::ifstream            in(path);
+	std::string              line;
+	while (std::getline(in, line)) {
+		if (!line.empty()) {
+			lines.push_back(line);
+		}
+	}
+	return lines;
+}
+
+bool WriteLines(const std::filesystem::path& path, const std::vector<std::string>& lines) {
+	std::error_code ec;
+	std::filesystem::create_directories(path.parent_path(), ec);
+	std::ofstream out(path, std::ios::trunc);
+	for (const auto& l: lines) {
+		out << l << '\n';
+	}
+	return static_cast<bool>(out);
+}
+
+std::string Lower(std::string s) {
+	for (auto& c: s) {
+		c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+	}
+	return s;
+}
+
+enum class Kind {
+	Image,
+	Package,
+};
+
+const char* KindExt(Kind k) {
+	return k == Kind::Image ? ".ffpfsc" : ".pkg";
+}
+
+const char* KindLastDirFile(Kind k) {
+	return k == Kind::Image ? "lastdir-image.txt" : "lastdir-package.txt";
+}
+
+[[noreturn]] void ExitWith(int code) {
+	std::fflush(nullptr);
+	::sync();
+	std::_Exit(code);
+}
+
+struct Entry {
+	std::string name;
+	bool        dir;
+};
+
+struct Browser {
+	bool                  open = false;
+	bool                  want_popup = false;
+	Kind                  kind = Kind::Image;
+	std::filesystem::path dir;
+	std::vector<Entry>    entries;
+	int                   selected = -1;
+	bool                  focus_first = false; // after a folder change the first entry takes the nav focus
+	std::string           error;
+	char                  path_edit[1024] = {};
+
+	void Start(Kind k) {
+		kind     = k;
+		selected = -1;
+		error.clear();
+		dir.clear();
+		if (MenuDir() != nullptr) {
+			const auto last = ReadLines(MenuFile(KindLastDirFile(k)));
+			if (!last.empty() && std::filesystem::is_directory(last.front())) {
+				dir = last.front();
+			}
+		}
+		if (dir.empty()) {
+			const char* home = std::getenv("HOME");
+			const auto  data = std::filesystem::path(home != nullptr ? home : "/") / "bc5-data";
+			dir              = std::filesystem::is_directory(data) ? data : std::filesystem::path(home != nullptr ? home : "/");
+		}
+		Refresh();
+		open       = true;
+		want_popup = true;
+	}
+
+	void Refresh() {
+		entries.clear();
+		selected = -1;
+		error.clear();
+		std::error_code ec;
+		const std::string ext = KindExt(kind);
+		for (const auto& e: std::filesystem::directory_iterator(dir, std::filesystem::directory_options::skip_permission_denied, ec)) {
+			const auto name = e.path().filename().string();
+			if (name.empty() || name[0] == '.') {
+				continue;
+			}
+			std::error_code tec;
+			if (e.is_directory(tec)) {
+				entries.push_back({name, true});
+			} else if (e.is_regular_file(tec)) {
+				const auto lname = Lower(name);
+				if (lname.size() > ext.size() && lname.compare(lname.size() - ext.size(), ext.size(), ext) == 0) {
+					entries.push_back({name, false});
+				}
+			}
+		}
+		if (ec) {
+			error = "cannot read " + dir.string() + ": " + ec.message();
+		}
+		focus_first = true;
+		std::sort(entries.begin(), entries.end(), [](const Entry& a, const Entry& b) {
+			if (a.dir != b.dir) return a.dir;
+			return Lower(a.name) < Lower(b.name);
+		});
+		std::snprintf(path_edit, sizeof(path_edit), "%s", dir.string().c_str());
+	}
+
+	void Enter(const std::filesystem::path& p) {
+		dir = p.lexically_normal();
+		if (MenuDir() != nullptr) {
+			WriteLines(MenuFile(KindLastDirFile(kind)), {dir.string()});
+		}
+		Refresh();
+	}
+};
+
+struct State {
+	Browser                  browser;
+	std::string              status;
+	bool                     want_about        = false;
+	bool                     want_restart      = false;
+	bool                     restart_armed     = false;
+	std::vector<std::string> recent;
+	bool                     recent_loaded     = false;
+};
+
+State& GetState() {
+	static State s;
+	return s;
+}
+
+void LoadRecent(State& s) {
+	if (s.recent_loaded) {
+		return;
+	}
+	s.recent_loaded = true;
+	if (MenuDir() != nullptr) {
+		s.recent = ReadLines(MenuFile("recent.txt"));
+	}
+}
+
+void OpenPath(State& s, const std::string& path) {
+	if (MenuDir() == nullptr) {
+		s.status = "No launcher: start the emulator through play-any.sh (KYTY_BC5_MENU_DIR is not set), "
+		           "or run it with --game <mounted directory>.";
+		return;
+	}
+	auto recent = ReadLines(MenuFile("recent.txt"));
+	recent.erase(std::remove(recent.begin(), recent.end(), path), recent.end());
+	recent.insert(recent.begin(), path);
+	if (recent.size() > RECENT_MAX) {
+		recent.resize(RECENT_MAX);
+	}
+	WriteLines(MenuFile("recent.txt"), recent);
+	if (!WriteLines(MenuFile("choice.txt"), {path})) {
+		s.status = "Cannot write " + MenuFile("choice.txt").string();
+		return;
+	}
+	std::fprintf(stderr, "host menu: open %s (exit %d)\n", path.c_str(), EXIT_CODE_OPEN);
+	ExitWith(EXIT_CODE_OPEN);
+}
+
+void CloseSession() {
+	std::fprintf(stderr, "host menu: close session (exit %d)\n", EXIT_CODE_CLOSE);
+	ExitWith(EXIT_CODE_CLOSE);
+}
+
+void Quit() {
+	// The window loop ends the process as it does when the window is closed.
+	SDL_Event event {};
+	event.type = SDL_QUIT;
+	SDL_PushEvent(&event);
+}
+
+void DrawBrowser(State& s, float width, float height, float scale) {
+	auto& b = s.browser;
+	if (b.want_popup) {
+		ImGui::OpenPopup("Open##browser");
+		b.want_popup = false;
+	}
+	if (!b.open) {
+		return;
+	}
+	const ImVec2 size {std::min(width * 0.85f, 960.0f * scale), std::min(height * 0.85f, 640.0f * scale)};
+	ImGui::SetNextWindowSize(size);
+	ImGui::SetNextWindowPos({(width - size.x) * 0.5f, (height - size.y) * 0.5f});
+	if (!ImGui::BeginPopupModal("Open##browser", &b.open, ImGuiWindowFlags_NoResize | ImGuiWindowFlags_NoMove |
+	                                                            ImGuiWindowFlags_NoSavedSettings)) {
+		return;
+	}
+	ImGui::TextWrapped("%s", b.kind == Kind::Image ? "A game image (.ffpfsc): the launcher mounts it with bc5-mount and starts the game."
+	                                                : "A PS5 package (.pkg): the launcher mounts it with bc5-mount at ~/bc5-data/mnt/pkg-play and starts the game.");
+	ImGui::BeginDisabled(!b.dir.has_parent_path() || b.dir == b.dir.root_path());
+	if (ImGui::Button("Up")) {
+		b.Enter(b.dir.parent_path());
+	}
+	ImGui::EndDisabled();
+	ImGui::SameLine();
+	ImGui::SetNextItemWidth(-1.0f);
+	if (ImGui::InputText("##path", b.path_edit, sizeof(b.path_edit), ImGuiInputTextFlags_EnterReturnsTrue)) {
+		const std::filesystem::path typed(b.path_edit);
+		if (std::filesystem::is_directory(typed)) {
+			b.Enter(typed);
+		} else if (std::filesystem::is_regular_file(typed)) {
+			OpenPath(s, typed.string());
+		} else {
+			b.error = "not found: " + typed.string();
+		}
+	}
+	if (!b.error.empty()) {
+		ImGui::TextColored({1.0f, 0.5f, 0.4f, 1.0f}, "%s", b.error.c_str());
+	}
+	// NavFlattened: the arrows and the d-pad go straight to the entries, no Enter on the list first.
+	ImGui::BeginChild("entries", {0.0f, -ImGui::GetFrameHeightWithSpacing() * 2.2f},
+	                  ImGuiChildFlags_Borders | ImGuiChildFlags_NavFlattened);
+	if (b.entries.empty()) {
+		ImGui::TextDisabled("(no folders and no %s files here)", KindExt(b.kind));
+	}
+	for (int i = 0; i < static_cast<int>(b.entries.size()); i++) {
+		const auto& e     = b.entries[i];
+		const auto  label = (e.dir ? "[" + e.name + "]" : e.name) + "##" + std::to_string(i);
+		if (b.focus_first) {
+			ImGui::SetKeyboardFocusHere();
+			b.focus_first = false;
+		}
+		if (ImGui::Selectable(label.c_str(), b.selected == i, ImGuiSelectableFlags_AllowDoubleClick)) {
+			if (e.dir) {
+				b.Enter(b.dir / e.name);
+				ImGui::EndChild();
+				ImGui::EndPopup();
+				return;
+			}
+			if (b.selected == i && (ImGui::IsMouseDoubleClicked(0) || ImGui::IsKeyPressed(ImGuiKey_Enter) ||
+			                        ImGui::IsKeyPressed(ImGuiKey_GamepadFaceDown))) {
+				OpenPath(s, (b.dir / e.name).string());
+			}
+			b.selected = i;
+		}
+	}
+	ImGui::EndChild();
+	const bool has_file = b.selected >= 0 && b.selected < static_cast<int>(b.entries.size()) && !b.entries[b.selected].dir;
+	if (has_file) {
+		ImGui::TextUnformatted(b.entries[b.selected].name.c_str());
+	} else {
+		ImGui::TextDisabled("Pick a %s file (Cross or Enter on a folder opens it).", KindExt(b.kind));
+	}
+	ImGui::BeginDisabled(!has_file);
+	if (ImGui::Button("Open", {120.0f * scale, 0.0f})) {
+		OpenPath(s, (b.dir / b.entries[b.selected].name).string());
+	}
+	ImGui::EndDisabled();
+	ImGui::SameLine();
+	if (ImGui::Button("Cancel", {120.0f * scale, 0.0f})) {
+		b.open = false;
+		ImGui::CloseCurrentPopup();
+	}
+	if (!s.status.empty()) {
+		ImGui::SameLine();
+		ImGui::TextColored({1.0f, 0.8f, 0.2f, 1.0f}, "%s", s.status.c_str());
+	}
+	ImGui::EndPopup();
+}
+
+void DrawRestartPopup(State& s, float scale) {
+	if (s.want_restart) {
+		ImGui::OpenPopup("Restart game##restart");
+		s.want_restart  = false;
+		s.restart_armed = false;
+	}
+	if (ImGui::BeginPopupModal("Restart game##restart", nullptr,
+	                           ImGuiWindowFlags_AlwaysAutoResize | ImGuiWindowFlags_NoSavedSettings)) {
+		ImGui::TextWrapped("The emulator stops and the launcher starts the game again from the beginning. "
+		                   "Progress since the last save is lost.");
+		ImGui::Checkbox("I have saved", &s.restart_armed);
+		ImGui::BeginDisabled(!s.restart_armed);
+		if (ImGui::Button("Restart", {120.0f * scale, 0.0f})) {
+			ExitWith(EXIT_CODE_RESTART);
+		}
+		ImGui::EndDisabled();
+		ImGui::SameLine();
+		if (ImGui::Button("Cancel", {120.0f * scale, 0.0f})) {
+			ImGui::CloseCurrentPopup();
+		}
+		ImGui::EndPopup();
+	}
+}
+
+void DrawAboutPopup(State& s, float scale) {
+	if (s.want_about) {
+		ImGui::OpenPopup("About##about");
+		s.want_about = false;
+	}
+	if (ImGui::BeginPopupModal("About##about", nullptr, ImGuiWindowFlags_AlwaysAutoResize | ImGuiWindowFlags_NoSavedSettings)) {
+		ImGui::Text("BC5 - PS5 titles on the AMD BC-250"); // ASCII: ImGui's default font has no dash
+		ImGui::Separator();
+		ImGui::Text("Host: KytyPlus %s (GPL-2.0) with the BC5 patch", KYTY_GIT_VERSION);
+		ImGui::Text("GPU path: the title's AGC/PM4 streams and RDNA shaders go to amdgpu as they are.");
+		ImGui::Text("ImGui %s, SDL %d.%d.%d", IMGUI_VERSION, SDL_MAJOR_VERSION, SDL_MINOR_VERSION, SDL_PATCHLEVEL);
+		ImGui::Separator();
+		ImGui::TextUnformatted("F1 or the pad's PS button: menu bar.  F2: settings.  F11: fullscreen.  Space: pause.");
+		ImGui::TextUnformatted("Pad in the menus: d-pad or left stick, Cross = choose, Circle = back, Square = the menu bar.");
+		if (ImGui::Button("Close", {120.0f * scale, 0.0f})) {
+			ImGui::CloseCurrentPopup();
+		}
+		ImGui::EndPopup();
+	}
+}
+
+void DrawLauncherPage(State& s, float width, float height, float scale) {
+	const float  bar  = ImGui::GetFrameHeight();
+	const ImVec2 size {std::min(width * 0.7f, 720.0f * scale), std::min((height - bar) * 0.7f, 480.0f * scale)};
+	ImGui::SetNextWindowPos({(width - size.x) * 0.5f, bar + (height - bar - size.y) * 0.5f});
+	ImGui::SetNextWindowSize(size);
+	ImGui::SetNextWindowBgAlpha(0.9f);
+	ImGui::Begin("BC5##launcher", nullptr,
+	             ImGuiWindowFlags_NoCollapse | ImGuiWindowFlags_NoResize | ImGuiWindowFlags_NoMove |
+	                 ImGuiWindowFlags_NoSavedSettings);
+	ImGui::Text("No game is open.   Logging: %s (Emulation menu)", Log::Bc5LoggingOn() ? "on" : "off");
+	ImGui::TextWrapped("Open a game image or a PS5 package: the launcher mounts it with bc5-mount, keeps the title's "
+	                   "settings, and starts the game in this window. Close session brings this page back.");
+	ImGui::Separator();
+	if (ImGui::Button("Open game image...", {-1.0f, 0.0f})) {
+		s.browser.Start(Kind::Image);
+	}
+	if (ImGui::Button("Open package (.pkg)...", {-1.0f, 0.0f})) {
+		s.browser.Start(Kind::Package);
+	}
+	ImGui::Separator();
+	ImGui::TextDisabled("Recent");
+	if (s.recent.empty()) {
+		ImGui::TextDisabled("(nothing yet)");
+	}
+	ImGui::BeginChild("recent", {0.0f, -ImGui::GetFrameHeightWithSpacing() * 1.4f}, ImGuiChildFlags_NavFlattened);
+	for (size_t i = 0; i < s.recent.size(); i++) {
+		const auto label = s.recent[i] + "##recent" + std::to_string(i);
+		if (ImGui::Selectable(label.c_str(), false)) {
+			OpenPath(s, s.recent[i]);
+		}
+	}
+	ImGui::EndChild();
+	if (!s.status.empty()) {
+		ImGui::TextColored({1.0f, 0.8f, 0.2f, 1.0f}, "%s", s.status.c_str());
+	} else {
+		ImGui::TextDisabled("Pad: d-pad or left stick, Cross = choose, Square = the menu bar. Keyboard: F1 hides the menu.");
+	}
+	ImGui::End();
+}
+
+} // namespace
+
+void HostMenuSetLauncherMode() {
+	g_launcher.store(true, std::memory_order_release);
+	g_visible.store(true, std::memory_order_release);
+}
+
+bool HostMenuLauncherMode() noexcept {
+	return g_launcher.load(std::memory_order_acquire);
+}
+
+void HostMenuToggle() {
+	if (g_launcher.load(std::memory_order_acquire)) {
+		return; // the launcher page needs its menu
+	}
+	const bool now = !g_visible.load(std::memory_order_acquire);
+	g_visible.store(now, std::memory_order_release);
+	SettingsOverlayHostUiChanged();
+}
+
+bool HostMenuVisible() noexcept {
+	return g_visible.load(std::memory_order_acquire);
+}
+
+void HostMenuDraw(float width, float height, float scale) {
+	if (!g_visible.load(std::memory_order_acquire)) {
+		return;
+	}
+	auto&      s        = GetState();
+	const bool launcher = g_launcher.load(std::memory_order_acquire);
+	const bool has_dir  = MenuDir() != nullptr;
+	LoadRecent(s);
+
+	if (ImGui::BeginMainMenuBar()) {
+		if (ImGui::BeginMenu("File")) {
+			if (ImGui::MenuItem("Open game image...", nullptr, false, has_dir)) {
+				s.browser.Start(Kind::Image);
+			}
+			if (ImGui::MenuItem("Open package (.pkg)...", nullptr, false, has_dir)) {
+				s.browser.Start(Kind::Package);
+			}
+			if (ImGui::BeginMenu("Recent", has_dir && !s.recent.empty())) {
+				for (size_t i = 0; i < s.recent.size(); i++) {
+					const auto label = s.recent[i] + "##r" + std::to_string(i);
+					if (ImGui::MenuItem(label.c_str())) {
+						OpenPath(s, s.recent[i]);
+					}
+				}
+				ImGui::Separator();
+				if (ImGui::MenuItem("Clear list")) {
+					s.recent.clear();
+					WriteLines(MenuFile("recent.txt"), {});
+				}
+				ImGui::EndMenu();
+			}
+			if (!has_dir && ImGui::IsItemHovered(ImGuiHoveredFlags_AllowWhenDisabled)) {
+				ImGui::SetTooltip("Start the emulator through play-any.sh to open games from here.");
+			}
+			ImGui::Separator();
+			if (ImGui::MenuItem("Close session", nullptr, false, !launcher)) {
+				CloseSession();
+			}
+			if (ImGui::MenuItem("Quit")) {
+				Quit();
+			}
+			ImGui::EndMenu();
+		}
+		if (ImGui::BeginMenu("Emulation")) {
+			const bool paused = WindowIsPaused();
+			if (ImGui::MenuItem(paused ? "Resume" : "Pause", "Space", false, !launcher)) {
+				WindowSetPaused(!paused);
+			}
+			if (ImGui::MenuItem("Restart", nullptr, false, !launcher)) {
+				s.want_restart = true;
+			}
+			ImGui::Separator();
+			if (ImGui::MenuItem("Settings...", "F2")) {
+				SettingsOverlayOpen();
+			}
+			if (ImGui::MenuItem("Fullscreen", "F11", WindowIsFullscreen())) {
+				WindowSetFullscreen(!WindowIsFullscreen());
+			}
+			ImGui::Separator();
+			// The session's logging switch (journal, LOGF, traces, profile, tally); BC5_LOGGING=0 starts it off.
+			const bool logging = Log::Bc5LoggingOn();
+			if (ImGui::MenuItem(logging ? "Logging: on" : "Logging: off", nullptr, logging)) {
+				Log::Bc5SetLogging(!logging);
+				std::fprintf(stderr, "host menu: logging %s\n", logging ? "off" : "on");
+			}
+			ImGui::EndMenu();
+		}
+		if (ImGui::BeginMenu("Help")) {
+			if (ImGui::MenuItem("About")) {
+				s.want_about = true;
+			}
+			ImGui::EndMenu();
+		}
+		if (!launcher) {
+			const char* hint = Log::Bc5LoggingOn() ? "F1 / PS: hide menu" : "logging off   F1 / PS: hide menu";
+			ImGui::SameLine(ImGui::GetWindowWidth() - ImGui::CalcTextSize(hint).x - ImGui::GetStyle().ItemSpacing.x * 4.0f);
+			ImGui::TextDisabled("%s", hint);
+		}
+		ImGui::EndMainMenuBar();
+	}
+
+	if (launcher) {
+		DrawLauncherPage(s, width, height, scale);
+	} else if (!s.status.empty() && !s.browser.open) {
+		ImGui::SetNextWindowPos({8.0f, ImGui::GetFrameHeight() + 6.0f});
+		ImGui::SetNextWindowBgAlpha(0.8f);
+		ImGui::Begin("##status", nullptr,
+		             ImGuiWindowFlags_NoDecoration | ImGuiWindowFlags_AlwaysAutoResize | ImGuiWindowFlags_NoSavedSettings |
+		                 ImGuiWindowFlags_NoFocusOnAppearing);
+		ImGui::TextColored({1.0f, 0.8f, 0.2f, 1.0f}, "%s", s.status.c_str());
+		ImGui::SameLine();
+		if (ImGui::SmallButton("Dismiss")) {
+			s.status.clear();
+		}
+		ImGui::End();
+	}
+	DrawBrowser(s, width, height, scale);
+	DrawRestartPopup(s, scale);
+	DrawAboutPopup(s, scale);
+}
+
+} // namespace Libs::Graphics
