+int KYTY_SYSV_ABI EpollDestroy(int eid) {
+	std::lock_guard lock(g_epoll_mutex);
+	auto*           slot = GetEpollSlot(eid);
+	if (slot == nullptr) {
+		return SetPosixSocketError(Posix::POSIX_EBADF);
+	}
+
+	slot->used = false;
+	slot->name.clear();
+	slot->registrations.clear();
+	g_epoll_changed.notify_all();
+	return 0;
+}
