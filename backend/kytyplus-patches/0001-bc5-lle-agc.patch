+	if (q == nullptr || data == nullptr || q->size != sizeof(Bc5TcmCalibrationQuery) || q->format != 0 ||
+	    q->function > BC5_TCM_LAST_CALIBRATION_FUN) {
+		return BC5_TCM_ERROR_PARAM;
+	}
+	return BC5_TCM_ERROR_NOT_CONNECTED;
+}
