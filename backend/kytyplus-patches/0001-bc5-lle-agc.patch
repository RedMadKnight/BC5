+		auto offset64  = func_addr - rip_addr;
+		auto offset32  = static_cast<uint32_t>(static_cast<uint64_t>(offset64) & 0xffffffffu);
+
+		std::memcpy(&code[2], &offset32, sizeof(offset32));
+	}
+
+	static uint64_t GetSize() { return 9; }
+
+	// rex.w call func
+	// mov rax,rax
