+static void FillRandomBuffer(void* buf, size_t nbytes) {
+	auto*              out = reinterpret_cast<uint8_t*>(buf);
+	std::random_device random;
+
+	for (size_t i = 0; i < nbytes; i++) {
+		out[i] = static_cast<uint8_t>(random());
+	}
