+	for (const auto& c: CONTROL_INFO) {
+		names.emplace_back(c.name);
+	}
+	return names;
+}
+
+std::vector<std::string> HostInputStatements() {
+	std::lock_guard<std::mutex> lock(g_input_mutex);
+	return Map().Statements();
+}
+
+std::string HostInputConfigPath() {
+	std::lock_guard<std::mutex> lock(g_input_mutex);
+	Map();
+	return g_config_path;
+}
+
+bool HostInputApply(const std::vector<std::string>& lines, std::string* error) {
+	std::vector<std::pair<std::string, std::string>> numbered;
+	for (std::size_t i = 0; i < lines.size(); i++) {
+		numbered.emplace_back(lines[i], "line " + std::to_string(i + 1));
+	}
+	auto map = std::make_unique<InputMap>();
+	if (!map->Load(numbered, error)) {
+		return false;
+	}
+	std::lock_guard<std::mutex> lock(g_input_mutex);
+	ReleaseAll();
+	g_pending.clear();
+	map->Log();
+	if (map->RenderScale() > 0.0) Libs::Bc5Gc::Direct::SetTimestampScale(map->RenderScale());
+	if (map->RayTracing() >= 0) Libs::Bc5Gc::Direct::SetRayTracing(map->RayTracing() == 1); // experiment 0273
+	if (map->MangoHud() >= 0) HostMenuMangoHudSet(map->MangoHud() == 1); // experiment 0301
+	if (map->Fullscreen() >= 0) WindowSetFullscreen(map->Fullscreen() == 1);
+	g_map = std::move(map);
+	return true;
+}
+
+bool HostInputSave(const std::string& path, const std::vector<std::string>& lines, std::string* error) {
+	const std::string tmp = path + ".tmp";
+	{
+		std::ofstream file(tmp, std::ios::trunc);
+		if (!file) {
+			if (error != nullptr) {
+				*error = "cannot write " + tmp;
+			}
+			return false;
+		}
+		file << "# BC5 input configuration, written by the settings overlay (F2). Hand edits are fine;\n"
+		        "# the grammar and the names are in backend/kytyplus-patches/input.example.cfg.\n";
+		for (const auto& line: lines) {
+			file << line << '\n';
+		}
+	}
+	if (std::rename(tmp.c_str(), path.c_str()) != 0) {
+		if (error != nullptr) {
+			*error = "cannot replace " + path;
+		}
+		return false;
+	}
+	return true;
+}
+
+void HostInputReleaseAll() {
+	std::lock_guard<std::mutex> lock(g_input_mutex);
+	Map();
+	ReleaseAll();
+	g_pending.clear();
+}
+
+// Experiment 0337: the title may ask for the language before the window builds the map, so before it exists only the file
+// is read here, without the map's side effects (a bad line leaves -1 here; Map() reports it when it is built).
+// BC5 (experiment 0359): the job-arena fix switch, JobArenaFix.<TITLE_ID>=on|off; KYTY_BC5_JOB_ARENA_FIX=0|1 overrides it.
+int HostInputJobArenaFix() {
+	if (const char* e = std::getenv("KYTY_BC5_JOB_ARENA_FIX"); e != nullptr && *e != 0) return *e == '0' ? 0 : 1;
+	return g_map != nullptr ? g_map->JobArenaFix() : -1;
+}
+void HostInputSetJobArenaFix(int v) {
+	if (g_map != nullptr) g_map->SetJobArenaFix(v);
+}
+extern "C" int bc5_title_switch_job_arena_fix() { // for loader/runtimeLinker.cpp
+	return HostInputJobArenaFix();
+}
+
+int HostInputSystemLanguage() {
+	std::lock_guard<std::mutex> lock(g_input_mutex);
+	if (g_map != nullptr) {
+		return g_map->SystemLanguage();
+	}
+	const char* path = std::getenv("KYTY_BC5_INPUT_CONFIG");
+	if (path == nullptr || *path == 0) {
+		return -1;
+	}
+	std::string error;
+	const auto  lines = ReadConfigLines(path, &error);
+	InputMap    probe;
+	return error.empty() && probe.Load(lines, &error) ? probe.SystemLanguage() : -1;
+}
+
+int HostInputLanguageCount() {
+	return static_cast<int>(LANGUAGE_NAMES.size());
+}
+
+const char* HostInputLanguageName(int language) {
+	return language >= 0 && language < HostInputLanguageCount() ? LANGUAGE_NAMES[language] : "";
+}
+
+int HostInputLanguageFromName(const std::string& name) {
+	return LanguageFromName(name);
+}
+
 } // namespace Libs::Graphics
