+		r       = g_dev->submit(std::span<const uint32_t>(sub_ib, sub_n), opt, 2'000'000'000ull, with_gds, qring);
+		mec_back(r.executed_offsets);
+	}
+	if (r.pending && t_cq == 1 && !g_ring_async) { // BC5_DIRECT_ASYNC: the doorbell consumer waits for its own jobs
+		bc5::direct::SubmitResult fr;
+		{
+			std::shared_lock finish_lock(g_finish_mutex);
+			fr = g_dev->finish(r.seq_no, r.slot, 2'000'000'000ull);
+		}
+		r.pending      = false;
+		r.ok           = fr.ok;
+		r.rc           = fr.rc;
+		r.timed_out    = fr.timed_out;
+		r.fault_addr   = fr.fault_addr;
+		r.fault_status = fr.fault_status;
+		r.fence_ms     = fr.fence_ms;
+		r.submit_ms    = r.cs_ms + fr.fence_ms;
