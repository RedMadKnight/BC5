+// refreshed every 40 ms while non-zero because SDL's rumble runs for a duration (100 ms here).
+void ControllerAudioRumble(uint8_t large, uint8_t small) {
+	using Clock = std::chrono::steady_clock;
+	static std::mutex        mutex;
+	static uint8_t           held_large = 0, held_small = 0, sent_large = 0, sent_small = 0;
+	static Clock::time_point hold_end, sent_at;
