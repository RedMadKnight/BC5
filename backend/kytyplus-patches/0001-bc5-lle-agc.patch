+		--it;
+	}
+	for (; it != g_bc5_prt.end() && it->first < end; ++it) {
+		if (it->second > start) {
+			out->emplace_back(std::max(start, it->first), std::min(end, it->second));
+		}
+	}
+}
+
+// The host pages of a reserved span: the anonymous PROT_NONE placeholder the host keeps there made readable (zero pages)
+// or unreadable again. MapBacking's MAP_FIXED view replaces either; nothing else in the host reads the placeholder's mode.
+static bool Bc5HostReadable(uint64_t va, uint64_t size, bool readable) {
+#if defined(__linux__)
+	return mprotect(reinterpret_cast<void*>(va), static_cast<size_t>(size), readable ? PROT_READ : PROT_NONE) == 0;
+#else
+	(void)va;
+	(void)size;
+	(void)readable;
+	return false;
+#endif
+}
+
+// [_clearPrt]: the range stops being PRT and its zero pages stop being readable. Only the unbacked pages are touched: a
+// backed page's host view stays as it is (the caller unmaps or replaces it, or it stays mapped if that fails).
+static void Bc5PrtEnd(uint64_t start, uint64_t end) {
+	std::vector<std::pair<uint64_t, uint64_t>> parts;
+	Bc5PrtParts(start, end, &parts);
+	for (const auto& [a, b]: parts) {
+		for (uint64_t pos = a; pos < b;) {
+			const auto it = g_bc5_amm_pages.lower_bound(pos);
+			if (it != g_bc5_amm_pages.end() && it->first == pos) {
+				pos += AMM_PAGE_SIZE;
+				continue;
+			}
+			const uint64_t stop = (it == g_bc5_amm_pages.end()) ? b : std::min(b, it->first);
+			(void)Bc5HostReadable(pos, stop - pos, false);
+			pos = stop;
+		}
+	}
+	Bc5PrtRemove(start, end);
+}
+
+// ---- the page table [pages, pooledUses] ----
+static void Bc5PoolReturn(uint64_t dmem, uint64_t size) {
+	std::scoped_lock lock(g_amm_auto_pool_mutex);
+	AmmAutoFreeLocked(dmem, size);
+}
+
+static void Bc5PoolUse(uint64_t dmem) {
+	g_bc5_pool_uses[dmem]++;
+}
+
+static void Bc5PoolUnuse(uint64_t dmem) { // [_releasePage]
+	const auto it = g_bc5_pool_uses.find(dmem);
+	if (it == g_bc5_pool_uses.end()) {
+		return;
+	}
+	if (--it->second == 0) {
+		g_bc5_pool_uses.erase(it);
+		Bc5PoolReturn(dmem, AMM_PAGE_SIZE);
+	}
+}
+
+static void Bc5RecordPages(uint64_t va, uint64_t dmem, uint64_t size, int32_t type, int32_t prot, uint8_t owner) { // [_addPage]
+	for (uint64_t off = 0; off < size; off += AMM_PAGE_SIZE) {
+		g_bc5_amm_pages[va + off] = Bc5AmmPage {dmem + off, type, prot, owner};
+		if (owner == BC5_PAGE_COUNTED) {
+			Bc5PoolUse(dmem + off);
+		}
+	}
+}
+
+// [_forgetPages]: the range's entries go, a counted page loses a use, and today's AmmAutoReleaseVa returns the automatic
+// maps' pool pages.
+static void Bc5ForgetPages(uint64_t va, uint64_t size) {
+	for (auto it = g_bc5_amm_pages.lower_bound(va); it != g_bc5_amm_pages.end() && it->first < va + size;) {
+		if (it->second.owner == BC5_PAGE_COUNTED) {
+			Bc5PoolUnuse(it->second.dmem);
+		}
+		it = g_bc5_amm_pages.erase(it);
+	}
+	AmmAutoReleaseVa(va, size);
+}
+
+// A remap or a multimap of automatic pages: today's g_amm_auto_maps lets go of them without freeing (AmmAutoReleaseVa's
+// split without AmmAutoFreeLocked) and each becomes a counted page with one use.
+static void Bc5DetachAuto(uint64_t va, uint64_t size) {
+	{
+		std::scoped_lock lock(g_amm_auto_pool_mutex);
+		const uint64_t   end = va + size;
+		auto             it  = g_amm_auto_maps.lower_bound(va);
+		if (it != g_amm_auto_maps.begin()) {
+			--it;
+		}
+		while (it != g_amm_auto_maps.end() && it->first < end) {
+			const uint64_t m_va   = it->first;
+			const uint64_t m_end  = m_va + it->second.size;
+			const uint64_t m_dmem = it->second.dmem;
+			if (m_end <= va) {
+				++it;
+				continue;
+			}
+			const uint64_t o0 = std::max(va, m_va);
+			const uint64_t o1 = std::min(end, m_end);
+			g_amm_auto_maps.erase(it);
+			if (m_va < o0) {
+				g_amm_auto_maps[m_va] = AmmAutoMapping {m_dmem, o0 - m_va};
+			}
+			if (o1 < m_end) {
+				g_amm_auto_maps[o1] = AmmAutoMapping {m_dmem + (o1 - m_va), m_end - o1};
+			}
+			it = g_amm_auto_maps.lower_bound(o1);
+		}
+	}
+	for (auto it = g_bc5_amm_pages.lower_bound(va); it != g_bc5_amm_pages.end() && it->first < va + size; ++it) {
+		if (it->second.owner == BC5_PAGE_AUTO) {
+			it->second.owner = BC5_PAGE_COUNTED;
+			Bc5PoolUse(it->second.dmem);
+		}
+	}
+}
+
+static bool Bc5MappedPages(uint64_t va, uint64_t size, std::vector<Bc5AmmPage>* out) { // [_mappedPages]
+	out->clear();
+	auto it = g_bc5_amm_pages.lower_bound(va);
+	for (uint64_t off = 0; off < size; off += AMM_PAGE_SIZE, ++it) {
+		if (it == g_bc5_amm_pages.end() || it->first != va + off) {
+			return false;
+		}
+		out->push_back(it->second);
+	}
+	return true;
+}
+
+// ---- the host side ----
+static int Bc5Reserve(uint64_t va, uint64_t size) { // [_reserve]: back to the AMM reservation, whatever was mapped there
+	void*     addr   = reinterpret_cast<void*>(va);
+	const int result = LibKernel::Memory::KernelReserveVirtualRange(&addr, size, AMM_MAP_FIXED, 0);
+	if (result == OK) {
+		(void)LibKernel::Memory::KernelSetVirtualRangeName(reinterpret_cast<void*>(va), size, "AMM");
+	}
+	return result;
+}
+
+static int Bc5ZeroPages(uint64_t va, uint64_t size, const char* why) { // [_zeroPrt], DoMapZero
+	int result = Bc5Reserve(va, size);
+	if (result == OK && !Bc5HostReadable(va, size, true)) {
+		result = LibKernel::KERNEL_ERROR_ENOMEM;
+	}
+	const uint64_t n = ++g_bc5_journal_zero;
+	if (Bc5JournalDue(n) || result != OK) {
+		std::fprintf(stderr, "[bc5] exp 0401 prt: zero pages #%" PRIu64 " va 0x%016" PRIx64 " size 0x%" PRIx64 " (%s) -> 0x%08x\n",
+		             n, va, size, why, static_cast<unsigned>(result));
+	}
+	return result;
+}
+
+static int Bc5MapRun(uint64_t va, uint64_t dmem, uint64_t size, int32_t type, int32_t prot) { // [_mapRun]
+	void*     addr   = reinterpret_cast<void*>(va);
+	const int result = LibKernel::Memory::KernelMapDirectMemory2(&addr, size, type, Bc5HostProt(prot), AMM_MAP_FIXED,
+	                                                             static_cast<int64_t>(dmem), AMM_PAGE_SIZE);
+	if (result == OK) {
+		(void)LibKernel::Memory::KernelSetVirtualRangeName(reinterpret_cast<void*>(va), size, "AMM");
+	}
+	return result;
+}
+
+static void Bc5JournalBacking(const char* why, uint64_t va, uint64_t dmem, uint64_t size, int32_t type, int32_t prot,
+                              int result) {
+	const uint64_t n = ++g_bc5_journal_back;
+	if (Bc5JournalDue(n) || result != OK) {
+		std::fprintf(stderr,
+		             "[bc5] exp 0401 prt: backing #%" PRIu64 " (%s) va 0x%016" PRIx64 " size 0x%" PRIx64 " dmem 0x%" PRIx64
+		             " type %d prot 0x%x -> 0x%08x\n",
+		             n, why, va, size, dmem, static_cast<int>(type), static_cast<unsigned>(prot), static_cast<unsigned>(result));
+	}
+}
+
+static bool Bc5BackingFails() { // test seam: true for the n-th backing after bc5_exp0401_amm_fail_backing(n)
+	uint32_t n = g_bc5_fail_backing.load();
+	while (n != 0) {
+		if (g_bc5_fail_backing.compare_exchange_weak(n, n - 1)) {
+			return n == 1;
+		}
+	}
+	return false;
+}
+
+// ---- the commands ----
+static int Bc5MapAsPrt(const CommandBufferState::AmmMapCommand& c) { // [_ammMapAsPrt]
+	if (!Bc5InAmmWindow(c.va, c.size)) {
+		return LibKernel::KERNEL_ERROR_EINVAL;
+	}
+	const int result = Bc5ZeroPages(c.va, c.size, "MapAsPrt");
+	if (result != OK) {
+		return result;
+	}
+	Bc5ForgetPages(c.va, c.size);
+	Bc5PrtAdd(c.va, c.va + c.size);
+	return OK;
+}
+
+static int Bc5UnmapToPrt(const CommandBufferState::AmmMapCommand& c) { // [_ammUnmapToPrt]
+	if (!Bc5InAmmWindow(c.va, c.size) || !Bc5PrtCovers(c.va, c.va + c.size)) {
+		return LibKernel::KERNEL_ERROR_EINVAL;
+	}
+	const int result = Bc5ZeroPages(c.va, c.size, "UnmapToPrt");
+	if (result == OK) {
+		Bc5ForgetPages(c.va, c.size);
+	}
+	return result;
+}
+
+// [_ammAllocatePrt] with e3b5192cb and 79fc99774: each run of backed pages takes the type and protection; each run of
+// unbacked pages gets pool pages, and a run whose backing fails returns them and goes back to zero pages.
+static int Bc5AllocatePaForPrt(const CommandBufferState::AmmMapCommand& c) {
+	if (!Bc5InAmmWindow(c.va, c.size) || !Bc5PrtCovers(c.va, c.va + c.size)) {
+		return LibKernel::KERNEL_ERROR_EINVAL;
+	}
+	const uint64_t end = c.va + c.size;
+	for (uint64_t pos = c.va; pos < end;) {
+		auto       it      = g_bc5_amm_pages.lower_bound(pos);
+		const bool backed  = it != g_bc5_amm_pages.end() && it->first == pos;
+		uint64_t   run_end = pos;
+		if (backed) {
+			while (it != g_bc5_amm_pages.end() && it->first == run_end && run_end < end) {
+				it->second.type = c.type;
+				it->second.prot = c.prot;
+				++it;
+				run_end += AMM_PAGE_SIZE;
+			}
+			const int result = LibKernel::Memory::KernelMprotect(reinterpret_cast<void*>(pos), run_end - pos, Bc5HostProt(c.prot));
+			if (result != OK) {
+				return result;
+			}
+		} else {
+			run_end              = (it == g_bc5_amm_pages.end()) ? end : std::min(end, it->first);
+			const uint64_t bytes = run_end - pos;
+			uint64_t       dmem  = 0;
+			if (!AllocateAmmAutoDirectMemory(bytes, c.type, &dmem)) {
+				Bc5JournalBacking("AllocatePaForPrt, no direct memory", pos, 0, bytes, c.type, c.prot, LibKernel::KERNEL_ERROR_EAGAIN);
+				return LibKernel::KERNEL_ERROR_EAGAIN; // nothing of this run changed: it still reads 0
+			}
+			const int result = Bc5BackingFails() ? LibKernel::KERNEL_ERROR_EAGAIN : Bc5MapRun(pos, dmem, bytes, c.type, c.prot);
+			if (result != OK) {
+				Bc5PoolReturn(dmem, bytes);
+				(void)Bc5ZeroPages(pos, bytes, "AllocatePaForPrt, rolled back");
+				Bc5JournalBacking("AllocatePaForPrt, failed", pos, dmem, bytes, c.type, c.prot, result);
+				return result;
+			}
+			AmmAutoRecordVa(pos, dmem, bytes);
+			Bc5RecordPages(pos, dmem, bytes, c.type, c.prot, BC5_PAGE_AUTO);
+			Bc5JournalBacking("AllocatePaForPrt", pos, dmem, bytes, c.type, c.prot, OK);
+		}
+		pos = run_end;
+	}
+	return OK;
+}
+
+// [_ammRemap]: a remap moves the source's pages (the source goes back to the reservation), a multimap (alias) maps them
+// a second time, a PRT remap moves them into a PRT range. The source must be fully mapped; an alias or a PRT remap may
+// not overlap its source. Each counted page holds a use while the ranges change [AmmPageReferences].
+static int Bc5Remap(const CommandBufferState::AmmMapCommand& c, bool alias, bool into_prt) {
+	const uint64_t dst  = c.va;
+	const uint64_t src  = c.source;
+	const uint64_t size = c.size;
+	if (!Bc5InAmmWindow(dst, size) || !Bc5InAmmWindow(src, size)) {
+		return LibKernel::KERNEL_ERROR_EINVAL;
+	}
+	if ((alias || into_prt) && dst < src + size && src < dst + size) {
+		return LibKernel::KERNEL_ERROR_EINVAL;
+	}
+	if (into_prt && !Bc5PrtCovers(dst, dst + size)) {
+		return LibKernel::KERNEL_ERROR_EINVAL;
+	}
+	std::vector<Bc5AmmPage> pages;
+	if (!Bc5MappedPages(src, size, &pages)) {
+		return LibKernel::KERNEL_ERROR_EINVAL;
+	}
+	Bc5DetachAuto(src, size);
+	(void)Bc5MappedPages(src, size, &pages);
+	for (auto& p: pages) {
+		p.prot = c.prot;
+		if (p.owner == BC5_PAGE_COUNTED) {
+			Bc5PoolUse(p.dmem);
+		}
+	}
+	int result = OK;
+	if (!alias) {
+		result = Bc5Reserve(src, size);
+		if (result == OK) {
+			Bc5PrtEnd(src, src + size);
+			Bc5ForgetPages(src, size);
+		}
+	}
+	if (result == OK) {
+		result = Bc5Reserve(dst, size);
+	}
+	if (result == OK) {
+		Bc5ForgetPages(dst, size);
+		if (!into_prt) {
+			Bc5PrtEnd(dst, dst + size);
+		}
+		for (size_t first = 0; first < pages.size() && result == OK;) {
+			size_t last = first + 1;
+			while (last < pages.size() && pages[last].dmem == pages[last - 1].dmem + AMM_PAGE_SIZE &&
+			       pages[last].type == pages[first].type && pages[last].owner == pages[first].owner) {
+				last++;
+			}
+			const uint64_t at    = dst + first * AMM_PAGE_SIZE;
+			const uint64_t bytes = (last - first) * AMM_PAGE_SIZE;
+			result               = Bc5MapRun(at, pages[first].dmem, bytes, pages[first].type, c.prot);
+			if (result == OK) {
+				Bc5RecordPages(at, pages[first].dmem, bytes, pages[first].type, c.prot, pages[first].owner);
+			} else if (into_prt) {
+				(void)Bc5ZeroPages(at, (pages.size() - first) * AMM_PAGE_SIZE, "RemapIntoPrt, map failed");
+			}
+			if (into_prt) {
+				Bc5JournalBacking("RemapIntoPrt", at, pages[first].dmem, bytes, pages[first].type, c.prot, result);
+			}
+			first = last;
+		}
+	}
+	for (const auto& p: pages) {
+		if (p.owner == BC5_PAGE_COUNTED) {
+			Bc5PoolUnuse(p.dmem);
+		}
+	}
+	return result;
+}
+
+// [_ammProtect]: the masked bits of every page of a fully mapped range; the type too for ModifyMtypeProtect.
+static int Bc5Protect(const CommandBufferState::AmmMapCommand& c, bool with_type) {
+	std::vector<Bc5AmmPage> pages;
+	if (!Bc5InAmmWindow(c.va, c.size) || !Bc5MappedPages(c.va, c.size, &pages)) {
+		return LibKernel::KERNEL_ERROR_EINVAL;
+	}
+	auto it = g_bc5_amm_pages.lower_bound(c.va);
+	for (size_t i = 0; i < pages.size(); i++, ++it) {
+		it->second.prot = (it->second.prot & ~c.mask) | (c.prot & c.mask);
+		if (with_type) {
+			it->second.type = c.type;
+		}
+		pages[i] = it->second;
+	}
+	for (size_t first = 0; first < pages.size();) {
+		const int host = Bc5HostProt(pages[first].prot);
+		size_t    last = first + 1;
+		while (last < pages.size() && Bc5HostProt(pages[last].prot) == host) {
+			last++;
+		}
+		const int result = LibKernel::Memory::KernelMprotect(reinterpret_cast<void*>(c.va + first * AMM_PAGE_SIZE),
+		                                                     (last - first) * AMM_PAGE_SIZE, host);
+		if (result != OK) {
+			return result;
+		}
+		first = last;
+	}
+	return OK;
+}
+
+// An unmap with the page table on: today's KernelMunmap, then [_clearPrt] and [_forgetPages] (with today's
+// AmmAutoReleaseVa). Unlike AnyPS5's, the range is not returned to the reservation (today's unmap does not either).
+static int Bc5Unmap(const CommandBufferState::AmmMapCommand& c) {
+	const int result = LibKernel::Memory::KernelMunmap(c.va, c.size);
+	if (result == OK) {
+		Bc5PrtEnd(c.va, c.va + c.size);
+		Bc5ForgetPages(c.va, c.size);
+	}
+	if (AmmTrace()) {
+		AmmTraceStamp(), std::fprintf(stderr, "amm trace: unmap va 0x%016" PRIx64 " size 0x%" PRIx64 " -> 0x%08x\n", c.va,
+		                              c.size, static_cast<unsigned>(result));
+	}
+	return result;
+}
+
+static const char* Bc5AmmKindName(AmmCommandKind kind) {
+	switch (kind) {
+		case AmmCommandKind::Unmap: return "Unmap";
+		case AmmCommandKind::MapAsPrt: return "MapAsPrt";
+		case AmmCommandKind::UnmapToPrt: return "UnmapToPrt";
+		case AmmCommandKind::AllocatePaForPrt: return "AllocatePaForPrt";
+		case AmmCommandKind::RemapIntoPrt: return "RemapIntoPrt";
+		case AmmCommandKind::Remap: return "Remap";
+		case AmmCommandKind::MultiMap: return "MultiMap";
+		case AmmCommandKind::ModifyProtect: return "ModifyProtect";
+		case AmmCommandKind::ModifyMtypeProtect: return "ModifyMtypeProtect";
+		default: return "map";
+	}
+}
+
+// The new kinds, and an unmap while the page table runs (RunOrderedAprCommands). A kind whose switch is off fails.
+static int Bc5ExecuteAmm0401(const CommandBufferState::AmmMapCommand& command) {
+	std::scoped_lock lock(g_bc5_amm_mutex);
+	const bool       prt    = Bc5AmmPrtCmdsOn();
+	const bool       extra  = Bc5AmmExtraCmdsOn();
+	int              result = LibKernel::KERNEL_ERROR_EINVAL;
+	switch (command.kind) {
+		case AmmCommandKind::Unmap: result = Bc5Unmap(command); break;
+		case AmmCommandKind::MapAsPrt: result = prt ? Bc5MapAsPrt(command) : result; break;
+		case AmmCommandKind::UnmapToPrt: result = prt ? Bc5UnmapToPrt(command) : result; break;
+		case AmmCommandKind::AllocatePaForPrt: result = prt ? Bc5AllocatePaForPrt(command) : result; break;
+		case AmmCommandKind::RemapIntoPrt: result = prt ? Bc5Remap(command, false, true) : result; break;
+		case AmmCommandKind::Remap: result = extra ? Bc5Remap(command, false, false) : result; break;
+		case AmmCommandKind::MultiMap: result = extra ? Bc5Remap(command, true, false) : result; break;
+		case AmmCommandKind::ModifyProtect: result = extra ? Bc5Protect(command, false) : result; break;
+		case AmmCommandKind::ModifyMtypeProtect: result = extra ? Bc5Protect(command, true) : result; break;
+		default: break;
+	}
+	if (result != OK && Bc5JournalDue(++g_bc5_journal_fail)) {
+		std::fprintf(stderr,
+		             "[bc5] exp 0401 amm: %s va 0x%016" PRIx64 " source 0x%016" PRIx64 " size 0x%" PRIx64
+		             " prot 0x%x -> 0x%08x, the buffer stops here (#%" PRIu64 ")\n",
+		             Bc5AmmKindName(command.kind), command.va, command.source, command.size, static_cast<unsigned>(command.prot),
+		             static_cast<unsigned>(result), g_bc5_journal_fail);
+	}
+	return result;
+}
+
+// A map with the page table on [_ammMap]: the range's old pages are forgotten and a PRT range there ends, then today's
+// map runs, then its pages enter the table (an automatic map's direct memory read back from today's g_amm_auto_maps).
+static int Bc5ExecuteAmmMap0401(const CommandBufferState::AmmMapCommand& command) {
+	std::scoped_lock lock(g_bc5_amm_mutex);
+	if (ValidateAmmMapArgs(command.va, command.size)) {
+		Bc5PrtEnd(command.va, command.va + command.size);
+		Bc5ForgetPages(command.va, command.size);
+	}
+	const int result = ExecuteAmmMapCommandToday(command);
+	if (result == OK) {
+		if (command.kind == AmmCommandKind::MapAuto) {
+			uint64_t dmem  = 0;
+			bool     found = false;
+			{
+				std::scoped_lock pool_lock(g_amm_auto_pool_mutex);
+				const auto       it = g_amm_auto_maps.find(command.va);
+				if (it != g_amm_auto_maps.end() && it->second.size == command.size) {
+					dmem  = it->second.dmem;
+					found = true;
+				}
+			}
+			if (found) {
+				Bc5RecordPages(command.va, dmem, command.size, command.type, command.prot, BC5_PAGE_AUTO);
+			}
+		} else {
+			Bc5RecordPages(command.va, command.dmem_offset, command.size, command.type, command.prot, BC5_PAGE_TITLE);
+		}
+	}
+	return result;
+}
+
+// ---- the counters [g_counters, _counterField, _readCounter, _applyCounterOperation, _writeCounter, _waitSatisfied] ----
+static std::array<std::atomic<uint32_t>, 256> g_bc5_counters {};
+static std::mutex                               g_bc5_counter_writes;
+
+static void Bc5CounterField(uint8_t access, uint32_t* bits, uint32_t* shift) {
+	if (access == 0) {
+		*bits  = 64;
+		*shift = 0;
+	} else if (access == 1) {
+		*bits  = 32;
+		*shift = 0;
+	} else if (access < 4) {
+		*bits  = 16;
+		*shift = (access - 2u) * 16u;
+	} else {
+		*bits  = 8;
+		*shift = (static_cast<uint32_t>(access & 7u) - 4u) * 8u;
+	}
+}
+
+static uint64_t Bc5FieldMask(uint32_t bits) {
+	return bits == 64 ? ~uint64_t {0} : (uint64_t {1} << bits) - 1u;
+}
+
+static uint32_t Bc5Counter(uint32_t index) {
+	return g_bc5_counters[index % g_bc5_counters.size()].load(std::memory_order_acquire);
+}
+
+static uint64_t Bc5ReadCounter(uint32_t index, uint8_t access) {
+	uint32_t bits  = 0;
+	uint32_t shift = 0;
+	Bc5CounterField(access, &bits, &shift);
+	if (bits == 64) {
+		return Bc5Counter(index) | static_cast<uint64_t>(Bc5Counter(index + 1u)) << 32u;
+	}
+	return (Bc5Counter(index) >> shift) & Bc5FieldMask(bits);
+}
+
+static uint64_t Bc5ApplyCounterOperation(uint8_t operation, uint64_t current, uint64_t value) {
+	switch (operation) {
+		case 0: return value;
+		case 1: return current | value;
+		case 2: return current & ~value;
+		case 3: return current ^ value;
+		default: return current + value;
+	}
+}
+
+static void Bc5WriteCounterValue(uint32_t index, uint8_t access, uint8_t operation, uint64_t value) {
+	uint32_t bits  = 0;
+	uint32_t shift = 0;
+	Bc5CounterField(access, &bits, &shift);
+	std::scoped_lock lock(g_bc5_counter_writes);
+	const uint64_t   next = Bc5ApplyCounterOperation(operation, Bc5ReadCounter(index, access), value) & Bc5FieldMask(bits);
+	auto&            low  = g_bc5_counters[index % g_bc5_counters.size()];
+	if (bits == 64) {
+		g_bc5_counters[(index + 1u) % g_bc5_counters.size()].store(static_cast<uint32_t>(next >> 32u), std::memory_order_release);
+		low.store(static_cast<uint32_t>(next), std::memory_order_release);
+		return;
+	}
+	const auto mask  = static_cast<uint32_t>(Bc5FieldMask(bits) << shift);
+	const auto field = static_cast<uint32_t>(next << shift);
+	low.store((low.load(std::memory_order_relaxed) & ~mask) | field, std::memory_order_release);
+}
+
+static bool Bc5CompareSatisfied(uint8_t compare, uint64_t value, uint64_t reference) {
+	constexpr uint64_t SIGN = uint64_t {1} << 63u;
+	switch (compare) {
+		case 0: return value == reference;
+		case 1: return value > reference;
+		case 2: return value < reference;
+		case 3: return value != reference;
+		case 4: return value - reference < SIGN;
+		case 5: return (value ^ SIGN) > (reference ^ SIGN);
+		default: return (value ^ SIGN) < (reference ^ SIGN);
+	}
+}
+
+// 0 done, 1 a wait not met yet, -1 an address write failed.
+static int Bc5RunCounterCommand0401(const CommandBufferState::Bc5CounterCommand& command) {
+	switch (command.kind) {
+		case 0: Bc5WriteCounterValue(command.counter, command.access, command.operation, command.value); return 0;
+		case 1: {
+			uint32_t bits  = 0;
+			uint32_t shift = 0;
+			Bc5CounterField(command.access, &bits, &shift);
+			const uint32_t unused    = 64u - bits;
+			const uint64_t now       = (Bc5ReadCounter(command.counter, command.access) & command.mask) << unused;
+			const uint64_t reference = (command.value & command.mask) << unused;
+			return Bc5CompareSatisfied(command.compare, now, reference) ? 0 : 1;
+		}
+		default: {
+			uint64_t value = Bc5Counter(command.counter);
+			if (command.kind == 3) {
+				value |= static_cast<uint64_t>(Bc5Counter(command.counter + 1u)) << 32u;
+			}
+			return AprShared::WriteGuest(command.address, value) ? 0 : -1;
+		}
+	}
+}
