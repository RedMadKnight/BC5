+	if (result != OK) {
+		return result;
+	}
+	g_bc5_flip_submit_ns.store(Bc5FlipNowNs()); // BC5 (experiment 0070)
+	g_video_out_driver->SubmitFlipPreparation(request_id);
+
+	return OK;
