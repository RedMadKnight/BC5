+		for (int c = 0; c < 8; c++) {
+			o[c] = i[c];
+		}
+		o[0] += h * i[8];
+		o[1] += h * i[9];
+		o[6] += h * i[10];
+		o[7] += h * i[11];
+	}
+	return out.data();
+}
