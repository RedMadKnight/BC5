+
+	// BC5: the native DualSense driver when it is open, and SDL's rumble otherwise (ControllerRumble);
+	// before this the call reached no pad on Linux. SDL caps a rumble at 5 s.
+	// TODO(verify): how long the console keeps a scePadSetVibration value without a new call.
+	ControllerRumble(param->large_motor, param->small_motor, 5000);
+
+	return OK;
+}
