+// --- GameController implementation -----------------------------------------
+
+void GameController::EnsureSlot(int index) {
+	if (index < 0 || index >= PAD_MAX_CONTROLLERS) {
+		return;
+	}
+	while (static_cast<int>(m_slots.size()) <= index) {
+		m_slots.emplace_back();
+	}
+}
+
+int GameController::InstanceId(int index) {
+	Common::LockGuard lock(m_mutex);
+	return index >= 0 && index < PAD_MAX_CONTROLLERS ? m_ids[index] : -1;
+}
+
+int GameController::OwnerSlot(int id) const {
+	for (int i = 0; i < PAD_MAX_CONTROLLERS; i++) {
+		if (m_ids[i] == id) {
+			return i;
+		}
+	}
+	return -1;
+}
+
+int GameController::FallbackSlot() const {
+	// Keyboard/mouse (and any stray unowned event) follows the primary pad.
+	return 0;
+}
+
+int GameController::PresentCount() const {
+	int count = 1; // player 1 is always present (it may be keyboard-driven)
+	for (int i = 1; i < PAD_MAX_CONTROLLERS; i++) {
+		if (m_ids[i] != -1) {
+			count++;
+		}
+	}
+	return count;
+}
+
+bool GameController::SlotConnected(int index) const {
+	if (index == 0) {
+		return true;
+	}
+	return index > 0 && index < PAD_MAX_CONTROLLERS && m_ids[index] != -1;
+}
+
+void GameController::Connect(int id) {
+	Common::LockGuard lock(m_mutex);
+
+	// HOST_INPUT_CONTROLLER_ID is a merged keyboard/mouse stream, not a physical
+	// pad; it never claims a player slot (it augments the primary slot instead).
+	if (id == HOST_INPUT_CONTROLLER_ID) {
+		EnsureSlot(0);
+		return;
+	}
+
+	// A pad already bound to a slot is left where it is.
+	if (OwnerSlot(id) != -1) {
+		return;
+	}
+
+	// Bind to the lowest free slot: first pad -> slot 0 (player 1), second pad ->
+	// slot 1 (player 2), and so on. Slot N maps to pad handle N+1.
+	for (int i = 0; i < PAD_MAX_CONTROLLERS; i++) {
+		if (m_ids[i] == -1) {
+			EnsureSlot(i);
+			m_ids[i] = id;
+			return;
+		}
+	}
+	// At capacity; ignore extra devices.
+}
+
+void GameController::Disconnect(int id) {
+	Common::LockGuard lock(m_mutex);
+
+	const int slot = OwnerSlot(id);
+	if (slot == -1) {
+		return;
+	}
+
+	m_ids[slot] = -1;
+	EnsureSlot(slot);
+	auto& s       = m_slots[slot];
+	s.states_num  = 0;
+	s.first_state = 0;
+	s.last_state  = ControllerState();
+}
+
+ControllerState GameController::GetLastState(int index) const {
+	if (index < 0 || index >= static_cast<int>(m_slots.size())) {
+		return ControllerState();
+	}
+	const auto& s = m_slots[index];
+	if (s.states_num == 0) {
+		return s.last_state;
+	}
+	auto last = (s.first_state + s.states_num - 1) % STATES_MAX;
+	return s.states[last];
+}
+
+void GameController::AddState(int index, const ControllerState& state) {
+	EnsureSlot(index);
+	auto& s = m_slots[index];
+
+	if (s.states_num >= STATES_MAX) {
+		s.states_num  = STATES_MAX - 1;
+		s.first_state = (s.first_state + 1) % STATES_MAX;
+	}
+
+	auto i = (s.first_state + s.states_num) % STATES_MAX;
+
+	s.states[i]   = state;
+	s.last_state  = state;
+	s.obtained[i] = false;
+
+	s.states_num++;
+}
+
+void GameController::Button(int id, uint32_t button, bool down) {
+	Common::LockGuard lock(m_mutex);
+
+	int slot = OwnerSlot(id);
+	if (slot == -1) {
+		slot = FallbackSlot();
+	}
+	static const bool trace_env = BC5_DIAG_ENV("KYTY_BC5_INPUT_TRACE") != nullptr;
+	const bool trace = trace_env && ::Log::Bc5LoggingOn();
+	if (trace && id == HOST_INPUT_CONTROLLER_ID) {
+		std::fprintf(stderr, "input trace: t=%.3f host stream button 0x%x %s -> slot %d\n", InputTraceSeconds(), button, down ? "down" : "up", slot);
+		std::fflush(stderr);
+	}
+
+	auto state = GetLastState(slot);
+	state.time = LibKernel::KernelGetProcessTime();
+
+	if (down) {
+		state.buttons |= button;
+	} else {
+		state.buttons &= ~button;
+	}
+
+	AddState(slot, state);
+}
+
+void GameController::Axis(int id, Controller::Axis axis, int value) {
+	Common::LockGuard lock(m_mutex);
+
+	int slot = OwnerSlot(id);
+	if (slot == -1) {
+		slot = FallbackSlot();
+	}
+	// BC5: KYTY_BC5_INPUT_TRACE=1 shows what the keyboard/mouse stream writes into the pad slot.
+	static const bool trace_env = BC5_DIAG_ENV("KYTY_BC5_INPUT_TRACE") != nullptr;
+	const bool trace = trace_env && ::Log::Bc5LoggingOn();
+	if (trace && id == HOST_INPUT_CONTROLLER_ID) {
+		std::fprintf(stderr, "input trace: t=%.3f host stream axis %d = %d -> slot %d (pad in slot 0: id %d)\n",
+		             InputTraceSeconds(), static_cast<int>(axis), value, slot, m_ids[0]);
+		std::fflush(stderr);
+	}
+
+	auto state = GetLastState(slot);
+	state.time = LibKernel::KernelGetProcessTime();
+
+	const int axis_id = static_cast<int>(axis);
+	EXIT_IF(axis_id < 0 || axis_id >= static_cast<int>(Controller::Axis::AxisMax));
+
+	// BC5: KYTY_BC5_TRIGGER_DEADZONE=<0..254> for a pad whose trigger does not rest at 0 (the
+	// L2 button bit is set by any value above 0): values up to it read as 0, the rest of the
+	// travel is stretched over the whole range.
+	if (axis == Controller::Axis::TriggerLeft || axis == Controller::Axis::TriggerRight) {
+		static const int dead = [] {
+			const char* e = std::getenv("KYTY_BC5_TRIGGER_DEADZONE");
+			const int   v = (e != nullptr ? std::atoi(e) : 0);
+			return v < 0 ? 0 : (v > 254 ? 254 : v);
+		}();
+		if (dead > 0) {
+			value = (value <= dead ? 0 : (value - dead) * 255 / (255 - dead));
+		}
+	}
+
+	state.axes[axis_id] = value;
+
+	if (trace && (axis == Controller::Axis::TriggerLeft || axis == Controller::Axis::TriggerRight)) {
+		std::fprintf(stderr, "input trace: t=%.3f %s = %d from id %d -> slot %d\n", InputTraceSeconds(),
+		             axis == Controller::Axis::TriggerLeft ? "L2" : "R2", value, id, slot);
+		std::fflush(stderr);
+	}
+
+	if (axis == Controller::Axis::TriggerLeft) {
+		if (value > 0) {
+			state.buttons |= PAD_BUTTON_L2;
+		} else {
+			state.buttons &= ~PAD_BUTTON_L2;
+		}
+	}
+
+	if (axis == Controller::Axis::TriggerRight) {
+		if (value > 0) {
+			state.buttons |= PAD_BUTTON_R2;
+		} else {
+			state.buttons &= ~PAD_BUTTON_R2;
+		}
+	}
+
+	AddState(slot, state);
+}
+
+void GameController::Motion(int id, bool gyro, const float* xyz) {
+	Common::LockGuard lock(m_mutex);
+
+	int slot = OwnerSlot(id);
+	if (slot == -1) {
+		slot = FallbackSlot();
+	}
+	EnsureSlot(slot);
+	auto& s = m_slots[static_cast<size_t>(slot)];
+	for (int k = 0; k < 3; k++) {
+		(gyro ? s.gyro : s.accel)[k] = xyz[k];
+	}
+	if (!gyro) {
+		return;
+	}
+	// BC5: the orientation the pad library reports next to the raw sensors (the game steers its
+	// ship by tilting the pad and reads this, run 116). The angular velocity is integrated in
+	// the pad frame; while the pad is not being accelerated (|a| near 1 G) the estimate is pulled
+	// towards the measured direction of gravity, so pitch and roll do not drift; yaw is relative
+	// to the start or to the last scePadResetOrientation. Identity is the pad lying flat.
+	// TODO(verify) against a console: the reference orientation and what the reset clears.
+	const auto now = std::chrono::steady_clock::now();
+	float      dt  = 0.0f;
+	if (s.gyro_seen) {
+		dt = std::chrono::duration<float>(now - s.gyro_time).count();
+		if (dt > 0.05f) {
+			dt = 0.05f;
+		}
+	}
+	s.gyro_time = now;
+	s.gyro_seen = true;
+	float       w[3] = {s.gyro[0], s.gyro[1], s.gyro[2]};
+	// A pad at rest reports a small bias (0.01 rad/s here); integrated it turns the estimate by
+	// half a degree a second about the vertical, where gravity cannot correct it.
+	if (w[0] * w[0] + w[1] * w[1] + w[2] * w[2] < 0.03f * 0.03f) {
+		w[0] = w[1] = w[2] = 0.0f;
+	}
+	const float x = s.orient[0], y = s.orient[1], z = s.orient[2], qw = s.orient[3];
+	const float an = std::sqrt(s.accel[0] * s.accel[0] + s.accel[1] * s.accel[1] + s.accel[2] * s.accel[2]);
+	if (an > 0.8f && an < 1.2f) {
+		const float a[3] = {s.accel[0] / an, s.accel[1] / an, s.accel[2] / an};
+		// the world's up in the pad frame, as the estimate has it
+		const float v[3] = {2.0f * (x * y + qw * z), 1.0f - 2.0f * (x * x + z * z), 2.0f * (y * z - qw * x)};
+		const float kp   = 2.0f;
+		w[0] += kp * (a[1] * v[2] - a[2] * v[1]);
+		w[1] += kp * (a[2] * v[0] - a[0] * v[2]);
+		w[2] += kp * (a[0] * v[1] - a[1] * v[0]);
+	}
+	float q[4] = {x + 0.5f * dt * (qw * w[0] + y * w[2] - z * w[1]), y + 0.5f * dt * (qw * w[1] + z * w[0] - x * w[2]),
+	              z + 0.5f * dt * (qw * w[2] + x * w[1] - y * w[0]), qw + 0.5f * dt * (-x * w[0] - y * w[1] - z * w[2])};
+	const float qn = std::sqrt(q[0] * q[0] + q[1] * q[1] + q[2] * q[2] + q[3] * q[3]);
+	if (qn > 1e-6f) {
+		for (int k = 0; k < 4; k++) {
+			s.orient[k] = q[k] / qn;
+		}
+	}
+}
+
+void GameController::Touch(int id, int finger, bool down, float x, float y) {
+	Common::LockGuard lock(m_mutex);
+
+	if (finger < 0 || finger > 1) {
+		return;
+	}
+	int slot = OwnerSlot(id);
+	if (slot == -1) {
+		slot = FallbackSlot();
+	}
+	EnsureSlot(slot);
+	auto&      s     = m_slots[static_cast<size_t>(slot)];
+	const auto scale = [](float v, int size) {
+		const int p = static_cast<int>(v * static_cast<float>(size) + 0.5f);
+		return static_cast<uint16_t>(p < 0 ? 0 : (p >= size ? size - 1 : p));
+	};
+	const bool contact = down && !s.finger_down[finger];
+	if (contact) {
+		// TODO(verify) how the console numbers contacts; here 1..127, a new one per contact.
+		s.last_finger_id   = static_cast<uint8_t>(s.last_finger_id % 127 + 1);
+		s.finger_id[finger] = s.last_finger_id;
+	}
+	const bool lift        = !down && s.finger_down[finger];
+	s.finger_down[finger] = down;
+	s.finger_x[finger]    = scale(x, PAD_TOUCH_RESOLUTION_X);
+	s.finger_y[finger]    = scale(y, PAD_TOUCH_RESOLUTION_Y);
+
+	static const bool trace_env = BC5_DIAG_ENV("KYTY_BC5_INPUT_TRACE") != nullptr;
+	if (trace_env && ::Log::Bc5LoggingOn() && (contact || lift)) {
+		std::fprintf(stderr, "input trace: t=%.3f touch finger %d %s at %u,%u id %u -> slot %d\n", InputTraceSeconds(), finger,
+		             contact ? "down" : "up", s.finger_x[finger], s.finger_y[finger], s.finger_id[finger], slot);
+		std::fflush(stderr);
+	}
+}
+
+void GameController::ResetOrientation(int index) {
+	Common::LockGuard lock(m_mutex);
+
+	if (index < 0) {
+		return;
+	}
+	EnsureSlot(index);
+	auto& s     = m_slots[static_cast<size_t>(index)];
+	s.orient[0] = s.orient[1] = s.orient[2] = 0.0f;
+	s.orient[3]                             = 1.0f;
+}
+
+void GameController::ResetInputState() {
+	Common::LockGuard lock(m_mutex);
+
+	for (auto& s : m_slots) {
+		s.states_num  = 0;
+		s.first_state = 0;
+		s.last_state  = ControllerState();
+	}
+
+	EnsureSlot(0);
+	ControllerState state {};
+	state.time = LibKernel::KernelGetProcessTime();
+	AddState(0, state);
+}
