+std::vector<std::pair<std::string, std::string>> ReadConfigLines(const std::string& path, std::string* error) {
+	std::vector<std::pair<std::string, std::string>> lines;
+	std::ifstream                                    file(path);
+	if (!file) {
+		if (error != nullptr) {
+			*error = "cannot open " + path;
+		}
+		return lines;
+	}
+	std::string line;
+	int         number = 0;
+	while (std::getline(file, line)) {
+		number++;
+		lines.emplace_back(line, path + ":" + std::to_string(number));
+	}
+	return lines;
+}
+
+// The map, built on first use from --keymap and the configuration file (a bad line is fatal
+// there: a wrong binding at start-up is better found than played with). Caller holds g_input_mutex.
+InputMap& Map() {
+	if (g_map == nullptr) {
+		std::vector<std::pair<std::string, std::string>> lines;
+		for (const auto& value: Config::GetKeymap()) {
+			lines.emplace_back(value, "--keymap");
+		}
+		if (const char* path = std::getenv("KYTY_BC5_INPUT_CONFIG"); path != nullptr && *path != 0) {
+			g_config_path = path;
+			std::string error;
+			auto        from_file = ReadConfigLines(g_config_path, &error);
+			if (!error.empty()) {
+				EXIT("Input config: %s\n", error.c_str());
+			}
+			lines.insert(lines.end(), from_file.begin(), from_file.end());
+		}
+		auto        map = std::make_unique<InputMap>();
+		std::string error;
+		if (!map->Load(lines, &error)) {
+			EXIT("Input config (%s)\n", error.c_str());
+		}
+		map->Log();
+		g_map = std::move(map);
+	}
+	return *g_map;
 }
 
