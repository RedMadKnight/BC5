+static void pad_fill_data(PadData* data, const ControllerState& state, bool connected,
+                          int connected_count) {
+	EXIT_IF(data == nullptr);
+
+	std::memset(data, 0, sizeof(*data));
+
+	data->buttons                = state.buttons;
+	data->left_stick_x           = state.axes[static_cast<int>(Axis::LeftX)];
+	data->left_stick_y           = state.axes[static_cast<int>(Axis::LeftY)];
+	data->right_stick_x          = state.axes[static_cast<int>(Axis::RightX)];
+	data->right_stick_y          = state.axes[static_cast<int>(Axis::RightY)];
+	data->analog_buttons_l2      = state.axes[static_cast<int>(Axis::TriggerLeft)];
+	data->analog_buttons_r2      = state.axes[static_cast<int>(Axis::TriggerRight)];
+	// BC5: KYTY_BC5_INPUT_TRACE=1 shows R2 as the game reads it, at every change of state.
+	static const bool trace_env   = BC5_DIAG_ENV("KYTY_BC5_INPUT_TRACE") != nullptr;
+	const bool trace = trace_env && ::Log::Bc5LoggingOn();
+	static int        last_r2      = -1;
+	static int        last_l2      = -1;
+	static uint32_t   last_buttons = 0xffffffffu;
+	if (trace && (data->analog_buttons_r2 != last_r2 || data->analog_buttons_l2 != last_l2 || data->buttons != last_buttons)) {
+		std::fprintf(stderr, "input trace: t=%.3f game reads l2 = %d r2 = %d, buttons 0x%x, connected %d, via %s handle %d state %d/%d, state time %" PRIu64 "\n",
+		             InputTraceSeconds(), data->analog_buttons_l2, data->analog_buttons_r2, data->buttons, connected ? 1 : 0,
+		             g_pad_read_via, g_pad_read_handle, g_pad_read_i, g_pad_read_n, static_cast<uint64_t>(state.time));
+		std::fflush(stderr);
+	}
+	last_r2 = data->analog_buttons_r2;
+	last_l2 = data->analog_buttons_l2;
+	last_buttons = data->buttons;
+	data->orientation_x          = state.orient[0];
+	data->orientation_y          = state.orient[1];
+	data->orientation_z          = state.orient[2];
+	data->orientation_w          = state.orient[3];
+	data->acceleration_x         = state.accel[0];
+	data->acceleration_y         = state.accel[1];
+	data->acceleration_z         = state.accel[2];
+	data->angular_velocity_x     = state.gyro[0];
+	data->angular_velocity_y     = state.gyro[1];
+	data->angular_velocity_z     = state.gyro[2];
+	data->touch_data_touch0_id   = 1;
+	data->touch_data_touch1_id   = 2;
+	// BC5 (experiment 0193): the touch points, when KYTY_BC5_PAD_TOUCH=1 forwards them (without it
+	// none, and the ids above as upstream had them).
+	if (state.touch_num > 0) {
+		data->touch_data_touch_num = state.touch_num;
+		data->touch_data_touch0_x  = state.touch_x[0];
+		data->touch_data_touch0_y  = state.touch_y[0];
+		data->touch_data_touch0_id = state.touch_id[0];
+		if (state.touch_num > 1) {
+			data->touch_data_touch1_x  = state.touch_x[1];
+			data->touch_data_touch1_y  = state.touch_y[1];
+			data->touch_data_touch1_id = state.touch_id[1];
+		}
+	}
+	data->connected              = connected;
+	data->timestamp              = state.time;
+	data->connected_count        = pad_connected_count_to_u8(connected_count);
+	data->device_unique_data_len = 0;
+}
