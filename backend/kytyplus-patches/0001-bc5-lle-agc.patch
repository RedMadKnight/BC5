+// "vvvv:pppp" (four hex digits each); false when the text is anything else.
+static bool Bc5UsbParseId(const std::string& text, uint32_t* id) {
+	if (text.size() != 9 || text[4] != ':') {
+		return false;
+	}
+	uint32_t v = 0;
+	for (size_t i = 0; i < 9; i++) {
+		if (i == 4) {
+			continue;
+		}
+		const char c = text[i];
+		int        d = -1;
+		if (c >= '0' && c <= '9') {
+			d = c - '0';
+		} else if (c >= 'a' && c <= 'f') {
+			d = c - 'a' + 10;
+		} else if (c >= 'A' && c <= 'F') {
+			d = c - 'A' + 10;
+		}
+		if (d < 0) {
+			return false;
+		}
+		v = (v << 4u) | static_cast<uint32_t>(d);
+	}
+	*id = v;
+	return true;
