+static int tagged_regs(const bc5::full_state::Tracker& t, char* out, size_t cap) {
+	using S = bc5::full_state::Space;
+	int  w = 0, found = 0;
+	auto one = [&](S sp, uint32_t o, const char* name) {
+		uint32_t v = 0;
+		if (!t.get(sp, o, v) || (v & 0xffu) == 0) return;
+		found++;
+		if (w < static_cast<int>(cap) - 40) w += std::snprintf(out + w, cap - static_cast<size_t>(w), " %s%s0x%x=%08x", name, sp == S::Context ? " ctx " : " sh ", o, v);
+	};
+	for (uint32_t o = 0x390; o <= 0x3af; o++) one(S::Context, o, "ext");
+	for (uint32_t o = 0x01a; o <= 0x01e; o++) one(S::Context, o, "db-hi");
+	one(S::Sh, 0x9, "pgm-hi");
+	one(S::Sh, 0x89, "pgm-hi");
+	one(S::Sh, 0xc9, "pgm-hi");
+	one(S::Sh, 0x20d, "pgm-hi");
+	return found;
+}
+static std::atomic<uint64_t> g_dry_bufs {0}, g_dry_splits {0}, g_dry_prefix {0}, g_dry_ns {0}, g_dry_max_ns {0}, g_dry_kept {0}, g_dry_ok {0},
+    g_dry_failed {0};
