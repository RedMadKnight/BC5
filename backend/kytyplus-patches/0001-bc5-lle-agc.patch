-File* FileDescriptors::GetFile(int d) {
-	Common::LockGuard lock(m_mutex);
-
-	auto index = static_cast<size_t>(d - DESCRIPTOR_MIN);
-
-	if (index >= m_files.size()) {
-		return nullptr;
-	}
-
-	return m_files[index];
