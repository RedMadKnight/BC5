+#ifndef KYTY_GRAPHICS_PRESENTATION_HOST_MENU_H_
+#define KYTY_GRAPHICS_PRESENTATION_HOST_MENU_H_
+
+// BC5 (ADR 0011): the menu bar at the top of the emulator window — File (Open game image...,
+// Open package (.pkg)..., Recent, Close session, Quit), Emulation (Pause/Resume, Restart,
+// Settings..., Fullscreen), Help (About) — and the launcher page shown when the emulator runs
+// without a game (--menu). Drawn with ImGui in the settings overlay's pass; F1 or the pad's Guide
+// (PS) button shows and hides it during play. The host never mounts anything: opening a path
+// writes it to $KYTY_BC5_MENU_DIR/choice.txt and ends the process with exit code 76, closing the
+// session ends it with 77, like the F2 menu's "Restart game" does with 75; the launcher script
+// (play-any.sh on the dev box) mounts and starts the emulator again.
+
+namespace Libs::Graphics {
+
+// No game is loaded: the menu bar stays visible and the launcher page is drawn.
+void HostMenuSetLauncherMode();
+bool HostMenuLauncherMode() noexcept;
+
+void HostMenuToggle();
+bool HostMenuVisible() noexcept;
+
+// Presenter thread, inside the settings overlay's ImGui frame. scale: the overlay's font scale.
+void HostMenuDraw(float width, float height, float scale);
+
+} // namespace Libs::Graphics
+
+#endif // KYTY_GRAPHICS_PRESENTATION_HOST_MENU_H_
