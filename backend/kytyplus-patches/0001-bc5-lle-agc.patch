+#if defined(KYTY_VIRTUAL_MEMORY_ALLOCATION_TESTS)
+static uint32_t g_test_physical_memory_unmaps_before_failure = UINT32_MAX;
+static bool     g_test_fail_next_fixed_reserve_range_add     = false;
+#endif
