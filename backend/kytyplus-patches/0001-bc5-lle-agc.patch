+// BC5 (experiment 0166): the window's pause stops the clocks the title sees - its process time
+// and counter, KernelReadTsc, and the monotonic/uptime clocks - as the console's suspend does for
+// a suspended process; wall time (the realtime clocks) goes on. Before, the title came back from
+// a pause with minutes of elapsed time to catch up on: sound and picture ran fast, then went
+// silent (the maintainer's session of 2026-10-19 10:20, a 380 s pause).
+static std::atomic<uint64_t> g_pause_tsc_total {0}; // ticks of past pauses
+static std::atomic<uint64_t> g_pause_tsc_start {0}; // non-zero while paused
+static uint64_t              KernelPausedTsc() {
+	const uint64_t start = g_pause_tsc_start.load(std::memory_order_acquire);
+	const uint64_t now   = KernelReadTscNative();
+	return g_pause_tsc_total.load(std::memory_order_acquire) + (start != 0 && now > start ? now - start : 0);
+}
+void KernelPauseClocks(bool on) {
+	static std::mutex m;
+	std::lock_guard   lock(m);
+	const uint64_t    now   = KernelReadTscNative();
+	const uint64_t    start = g_pause_tsc_start.load(std::memory_order_acquire);
+	if (on && start == 0) {
+		g_pause_tsc_start.store(now, std::memory_order_release);
+	} else if (!on && start != 0) {
+		g_pause_tsc_total.fetch_add(now > start ? now - start : 0, std::memory_order_acq_rel);
+		g_pause_tsc_start.store(0, std::memory_order_release);
+	}
+}
+bool KernelClocksPaused() {
+	return g_pause_tsc_start.load(std::memory_order_acquire) != 0;
+}
+static uint64_t KernelPausedNs() {
+	const auto frequency = KernelGetTscFrequencyNative();
+	if (frequency == 0) return 0;
+	return static_cast<uint64_t>((static_cast<long double>(KernelPausedTsc()) * 1000000000.0L) / static_cast<long double>(frequency));
+}
+// Takes the paused time off a monotonic/uptime reading (not the realtime, process-CPU or thread-CPU clocks).
+static void KernelPauseAdjust(KernelClockid clock_id, KernelTimespec* tp) {
+	switch (clock_id) {
+		case KERNEL_CLOCK_MONOTONIC:
+		case KERNEL_CLOCK_UPTIME:
+		case KERNEL_CLOCK_UPTIME_PRECISE:
+		case KERNEL_CLOCK_UPTIME_FAST:
+		case KERNEL_CLOCK_MONOTONIC_PRECISE:
+		case KERNEL_CLOCK_MONOTONIC_FAST:
+		case KERNEL_CLOCK_EXT_NETWORK:
+		case KERNEL_CLOCK_EXT_DEBUG_NETWORK:
+		case KERNEL_CLOCK_EXT_AD_NETWORK:
+		case KERNEL_CLOCK_EXT_RAW_NETWORK: break;
+		default: return;
+	}
+	const uint64_t paused = KernelPausedNs();
+	if (paused == 0) return;
+	uint64_t ns = static_cast<uint64_t>(tp->tv_sec) * 1000000000ull + static_cast<uint64_t>(tp->tv_nsec);
+	ns          = ns > paused ? ns - paused : 0;
+	tp->tv_sec  = static_cast<decltype(tp->tv_sec)>(ns / 1000000000ull);
+	tp->tv_nsec = static_cast<decltype(tp->tv_nsec)>(ns % 1000000000ull);
