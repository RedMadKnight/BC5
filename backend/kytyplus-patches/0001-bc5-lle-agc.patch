+// BC5 (experiment 0169, KYTY_BC5_MAP_STATS=1): what the title's memory maps cost the calling
+// thread, once a second: the GPU-side unmaps (a synchronous round trip to the GPU thread) and the
+// AMM map/unmap commands (counted in libAmpr.cpp through Bc5MapStatsAdd).
+std::atomic<uint64_t> g_bc5_ms_gpu_unmaps {0}, g_bc5_ms_gpu_unmap_ns {0}, g_bc5_ms_gpu_unmap_max_ns {0};
+std::atomic<uint64_t> g_bc5_ms_amm_maps {0}, g_bc5_ms_amm_map_ns {0}, g_bc5_ms_amm_unmaps {0}, g_bc5_ms_amm_unmap_ns {0};
+static uint64_t       Bc5MonoNs() {
+	timespec t {};
+	clock_gettime(CLOCK_MONOTONIC, &t);
+	return static_cast<uint64_t>(t.tv_sec) * 1000000000ull + static_cast<uint64_t>(t.tv_nsec);
+}
+bool Bc5MapStatsOn() {
+	static const bool on = BC5_DIAG_ENV("KYTY_BC5_MAP_STATS") != nullptr;
+	return on;
+}
+void Bc5MapStatsTick() {
+	static std::atomic<uint64_t> last {0};
+	const uint64_t               now  = Bc5MonoNs();
+	uint64_t                     prev = last.load(std::memory_order_relaxed);
+	if (prev == 0) {
+		last.compare_exchange_strong(prev, now);
+		return;
+	}
+	if (now - prev < 1000000000ull || !last.compare_exchange_strong(prev, now)) {
+		return;
+	}
+	const uint64_t gu = g_bc5_ms_gpu_unmaps.exchange(0), gun = g_bc5_ms_gpu_unmap_ns.exchange(0), gmax = g_bc5_ms_gpu_unmap_max_ns.exchange(0);
+	const uint64_t am = g_bc5_ms_amm_maps.exchange(0), amn = g_bc5_ms_amm_map_ns.exchange(0), au = g_bc5_ms_amm_unmaps.exchange(0), aun = g_bc5_ms_amm_unmap_ns.exchange(0);
+	if (gu == 0 && am == 0 && au == 0) return;
+	std::fprintf(stderr, "map stats: t %.3f s: AMM maps %" PRIu64 " (%.1f ms), AMM unmaps %" PRIu64 " (%.1f ms), GPU-side unmaps %" PRIu64 " (%.1f ms, max %.2f ms)\n",
+	             static_cast<double>(now) / 1e9, am, static_cast<double>(amn) / 1e6, au, static_cast<double>(aun) / 1e6, gu,
+	             static_cast<double>(gun) / 1e6, static_cast<double>(gmax) / 1e6);
+}
