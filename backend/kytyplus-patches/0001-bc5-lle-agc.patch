+// The pool's free list (g_amm_auto_pool_mutex held): insert a range and merge its neighbours.
+static void AmmAutoFreeLocked(uint64_t start, uint64_t size) {
+	if (size == 0) {
+		return;
+	}
+	auto next = g_amm_auto_free.lower_bound(start);
+	if (next != g_amm_auto_free.begin()) {
+		auto prev = std::prev(next);
+		if (prev->first + prev->second == start) {
+			start = prev->first;
+			size += prev->second;
+			g_amm_auto_free.erase(prev);
+		}
+	}
+	if (next != g_amm_auto_free.end() && start + size == next->first) {
+		size += next->second;
+		g_amm_auto_free.erase(next);
+	}
+	g_amm_auto_free[start] = size;
+}
+
+// First fit from the free list (g_amm_auto_pool_mutex held).
+static bool AmmAutoAllocLocked(uint64_t size, uint64_t* dmem_offset) {
+	for (auto it = g_amm_auto_free.begin(); it != g_amm_auto_free.end(); ++it) {
+		if (it->second >= size) {
+			*dmem_offset          = it->first;
+			const auto rest_start = it->first + size;
+			const auto rest_size  = it->second - size;
+			g_amm_auto_free.erase(it);
+			if (rest_size != 0) {
+				g_amm_auto_free[rest_start] = rest_size;
+			}
+			return true;
+		}
+	}
+	return false;
+}
