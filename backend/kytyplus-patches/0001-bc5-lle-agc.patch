+int KYTY_SYSV_ABI KernelStat(const char* path, FileStat* sb) {
+	PRINT_NAME();
+
+	if (path == nullptr || sb == nullptr) {
+		return KERNEL_ERROR_EINVAL;
+	}
+
+	if (Bc5FsFix(BC5_FS_NAMETOOLONG) && Bc5PathTooLong(path)) { // experiment 0405 (nametoolong)
+		return KERNEL_ERROR_ENAMETOOLONG;
+	}
+
+	LOGF("\t KernelStat: %s\n", path);
+
+	std::string path_s         = std::string(path);
+	auto        real_file_name = g_mount_points->GetRealFilename(path_s);
+	auto        real_directory = g_mount_points->GetRealDirectory(path_s);
+
+	bool is_dir  = Common::File::IsDirectoryExisting(real_file_name) ||
+	               Common::File::IsDirectoryExisting(real_directory);
+	bool is_file = Common::File::IsFileExisting(real_file_name);
+
+	if (!is_dir && !is_file) {
+		LOGF("\t file not found\n");
+		return KERNEL_ERROR_ENOENT;
+	}
+
+	EXIT_NOT_IMPLEMENTED(is_dir && is_file);
+
+	FileStat stat {};
+	stat.st_mode = 0000777u | (is_dir ? 0040000u : 0100000u);
+
+	auto at = Common::DateTime::FromSystemUTC();
+	auto wt = at;
+
+	if (is_dir) {
+		stat.st_size    = 0;
+		stat.st_blksize = Bc5FsFix(BC5_FS_BLKSIZE) ? 0x10000u : 512u; // experiment 0405 (blksize): AnyPS5 da7581eec
+		stat.st_blocks  = 0;
+	} else {
+		stat.st_size    = static_cast<int64_t>(Common::File::Size(real_file_name));
+		stat.st_blksize = 512;
+		stat.st_blocks  = (stat.st_size + 511) / 512;
+
+		Common::File::GetLastAccessAndWriteTimeUTC(real_file_name, &at, &wt);
+	}
+
+	SecToTimespec(&stat.st_atim, at.ToUnix());
+	SecToTimespec(&stat.st_mtim, wt.ToUnix());
+	stat.st_ctim     = stat.st_atim;
+	stat.st_birthtim = stat.st_mtim;
+	*sb              = stat;
+
+	return OK;
+}
+
+int KYTY_SYSV_ABI KernelFstat(int d, FileStat* sb) {
+	PRINT_NAME();
+
+	if (d < DESCRIPTOR_MIN) {
+		return KERNEL_ERROR_EPERM;
+	}
+
+	if (sb == nullptr) {
+		return KERNEL_ERROR_EFAULT;
+	}
+
+	auto* file = g_files->GetFile(d);
+
+	if (file == nullptr) {
+		return KERNEL_ERROR_EBADF;
+	}
+
+	EXIT_IF(!file->opened);
+
+	LOGF("\tKernelFstat: %s\n", Common::PathToString(file->real_name).c_str());
+
+	FileStat stat {};
+	stat.st_mode = 0000777u | (file->directory ? 0040000u : 0100000u);
+
+	auto at = Common::DateTime::FromSystemUTC();
+	auto wt = at;
+
+	if (file->special != SpecialFile::None) {
+		stat.st_size    = 0;
+		stat.st_blksize = 512;
+		stat.st_blocks  = 0;
+		SecToTimespec(&stat.st_atim, at.ToUnix());
+		SecToTimespec(&stat.st_mtim, wt.ToUnix());
+		stat.st_ctim     = stat.st_atim;
+		stat.st_birthtim = stat.st_mtim;
+		*sb              = stat;
+
+		return OK;
+	}
+
+	if (!file->directory) {
+		file->mutex.Lock();
+
+		bool is_invalid = file->f.IsInvalid();
+		auto size       = file->f.Size();
+		file->f.GetLastAccessAndWriteTimeUTC(&at, &wt);
+
+		file->mutex.Unlock();
+
+		if (is_invalid) {
+			LOGF("\tfile is invalid\n");
+			return KERNEL_ERROR_EIO;
+		}
+
+		stat.st_size    = static_cast<int64_t>(size);
+		stat.st_blksize = 512;
+		stat.st_blocks  = (stat.st_size + 511) / 512;
+	} else {
+		stat.st_size    = 0;
+		stat.st_blksize = Bc5FsFix(BC5_FS_BLKSIZE) ? 0x10000u : 512u; // experiment 0405 (blksize): AnyPS5 da7581eec
+		stat.st_blocks  = 0;
+	}
+
+	SecToTimespec(&stat.st_atim, at.ToUnix());
+	SecToTimespec(&stat.st_mtim, wt.ToUnix());
+	stat.st_ctim     = stat.st_atim;
+	stat.st_birthtim = stat.st_mtim;
+	*sb              = stat;
+
+	return OK;
+}
+
+int KYTY_SYSV_ABI KernelFtruncate(int d, int64_t length) {
+	PRINT_NAME();
+
+	if (d < DESCRIPTOR_MIN) {
+		return KERNEL_ERROR_EBADF;
+	}
+
+	if (length < 0) {
+		return KERNEL_ERROR_EINVAL;
+	}
+
+	if (::Libs::Network::Net::IsSocket(d)) {
+		return KERNEL_ERROR_EINVAL;
+	}
+
+	auto* file = g_files->GetFile(d);
+
+	if (file == nullptr || !file->opened) {
+		return KERNEL_ERROR_EBADF;
+	}
+
+	if (!file->writable) {
+		return KERNEL_ERROR_EBADF;
+	}
+
+	if (file->directory || file->special != SpecialFile::None) {
+		return KERNEL_ERROR_EINVAL;
+	}
+
+	Common::LockGuard lock(file->mutex);
+
+	if (file->f.IsInvalid() || !file->f.Truncate(static_cast<uint64_t>(length))) {
+		return KERNEL_ERROR_EIO;
+	}
+
+	LOGF("\tFtruncate (size = %" PRId64 ") file: %s\n", length,
+	     Common::PathToString(file->real_name).c_str());
+
+	return OK;
+}
+
+// Experiment 0327: the path functions the second title imports and the tree lacked. The console's checks
+// come first (a null path EFAULT, a relative path EINVAL, a component over 255 or a path over 1023 bytes
+// ENAMETOOLONG, the read-only mounts EROFS), then the mount points resolve the host file and the host
+// operation runs; a host error is mapped as upstream KytyPlus maps it (Coder787-source, GPL-2.0).
+namespace {
+
+int CheckGuestPath(const char* path) {
+	if (path == nullptr) {
+		return KERNEL_ERROR_EFAULT;
+	}
+	if (path[0] != '/') {
+		return KERNEL_ERROR_EINVAL;
+	}
+	size_t component_length = 0;
+	for (size_t i = 0; path[i] != '\0'; ++i) {
+		if (i >= 1023) {
+			return KERNEL_ERROR_ENAMETOOLONG;
+		}
+		if (path[i] == '/') {
+			component_length = 0;
+		} else if (++component_length > 255) {
+			return KERNEL_ERROR_ENAMETOOLONG;
+		}
+	}
+	return OK;
+}
+
+bool IsReadOnlyGuestPath(const std::string& path) {
+	return Common::StartsWith(path, "/app0") || Common::StartsWith(path, "/system") ||
+	       Common::StartsWith(path, "/hostapp");
+}
+
+int KernelErrorFromHost(const std::error_code& error) {
+	switch (static_cast<std::errc>(error.default_error_condition().value())) {
+		case std::errc::no_such_file_or_directory: return KERNEL_ERROR_ENOENT;
+		case std::errc::not_a_directory: return KERNEL_ERROR_ENOTDIR;
+		case std::errc::is_a_directory: return KERNEL_ERROR_EISDIR;
+		case std::errc::filename_too_long: return KERNEL_ERROR_ENAMETOOLONG;
+		case std::errc::permission_denied: return KERNEL_ERROR_EACCES;
+		case std::errc::read_only_file_system: return KERNEL_ERROR_EROFS;
+		case std::errc::invalid_argument: return KERNEL_ERROR_EINVAL;
+		default: return KERNEL_ERROR_EIO;
+	}
+}
+
+// The host file of a guest path that exists: a regular file or a directory (is_dir says which).
+int ResolveExistingGuestPath(const char* path, std::filesystem::path* real_name, bool* is_dir) {
+	if (const int check = CheckGuestPath(path); check != OK) {
+		return check;
+	}
+	const std::string path_s(path);
+	auto              real_file_name = g_mount_points->GetRealFilename(path_s);
+	auto              real_directory = g_mount_points->GetRealDirectory(path_s);
+	const bool        dir  = Common::File::IsDirectoryExisting(real_file_name) ||
+	                  Common::File::IsDirectoryExisting(real_directory);
+	const bool        file = Common::File::IsFileExisting(real_file_name);
+	if (!dir && !file) {
+		return KERNEL_ERROR_ENOENT;
+	}
+	*is_dir    = dir && !file;
+	*real_name = (*is_dir && !Common::File::IsDirectoryExisting(real_file_name)) ? real_directory
+	                                                                              : real_file_name;
+	return OK;
+}
+
+// The host permissions for a guest mode: the title's bits, with the owner's read and write kept so
+// that the host (and the title through it) can still open its own files.
+std::filesystem::perms HostPermsFor(uint16_t mode) {
+	return static_cast<std::filesystem::perms>((mode & 0777u) | 0600u);
+}
+
+} // namespace
+
+int KYTY_SYSV_ABI KernelTruncate(const char* path, int64_t length) {
+	PRINT_NAME();
+
+	if (const int check = CheckGuestPath(path); check != OK) {
+		return check;
+	}
+	if (length < 0) {
+		return KERNEL_ERROR_EINVAL;
+	}
+	if (IsReadOnlyGuestPath(path)) {
+		return KERNEL_ERROR_EROFS;
+	}
+	std::filesystem::path real_name;
+	bool                  is_dir = false;
+	if (const int r = ResolveExistingGuestPath(path, &real_name, &is_dir); r != OK) {
+		return r;
+	}
+	if (is_dir) {
+		return KERNEL_ERROR_EISDIR;
+	}
+	if (auto* open_file = g_files->GetFile(real_name);
+	    open_file != nullptr && open_file->opened && !open_file->directory) {
+		Common::LockGuard lock(open_file->mutex);
+		if (open_file->f.IsInvalid() || !open_file->f.Truncate(static_cast<uint64_t>(length))) {
+			return KERNEL_ERROR_EIO;
+		}
+	} else {
+		std::error_code error;
+		std::filesystem::resize_file(real_name, static_cast<uint64_t>(length), error);
+		if (error) {
+			return KernelErrorFromHost(error);
+		}
+	}
+
+	LOGF("\tTruncate (size = %" PRId64 ") file: %s\n", length, Common::PathToString(real_name).c_str());
+
+	return OK;
+}
+
+int KYTY_SYSV_ABI KernelChmod(const char* path, uint16_t mode) {
+	PRINT_NAME();
+
+	if (const int check = CheckGuestPath(path); check != OK) {
+		return check;
+	}
+	if (IsReadOnlyGuestPath(path)) {
+		return KERNEL_ERROR_EROFS;
+	}
+	std::filesystem::path real_name;
+	bool                  is_dir = false;
+	if (const int r = ResolveExistingGuestPath(path, &real_name, &is_dir); r != OK) {
+		return r;
+	}
+	std::error_code error;
+	std::filesystem::permissions(real_name, HostPermsFor(mode), std::filesystem::perm_options::replace,
+	                             error);
+	if (error) {
+		return KernelErrorFromHost(error);
+	}
+
+	LOGF("\tChmod (mode = 0%o) %s: %s\n", mode, is_dir ? "directory" : "file",
+	     Common::PathToString(real_name).c_str());
+
+	return OK;
+}
+
+int KYTY_SYSV_ABI KernelFchmod(int d, uint16_t mode) {
+	PRINT_NAME();
+
+	if (d < DESCRIPTOR_MIN) {
+		return KERNEL_ERROR_EBADF;
+	}
+	if (::Libs::Network::Net::IsSocket(d)) {
+		return KERNEL_ERROR_EINVAL;
+	}
+	auto* file = g_files->GetFile(d);
+	if (file == nullptr || !file->opened) {
+		return KERNEL_ERROR_EBADF;
+	}
+	if (file->special != SpecialFile::None) {
+		return KERNEL_ERROR_EINVAL;
+	}
+	Common::LockGuard lock(file->mutex);
+	std::error_code   error;
+	std::filesystem::permissions(file->real_name, HostPermsFor(mode),
+	                             std::filesystem::perm_options::replace, error);
+	if (error) {
+		return KernelErrorFromHost(error);
+	}
+
+	LOGF("\tFchmod (mode = 0%o) file: %s\n", mode, Common::PathToString(file->real_name).c_str());
+
+	return OK;
+}
+
+int KYTY_SYSV_ABI KernelUtimes(const char* path, const LibKernel::KernelTimeval* times) {
+	PRINT_NAME();
+
+	if (const int check = CheckGuestPath(path); check != OK) {
+		return check;
+	}
+	if (times != nullptr && (times[0].tv_usec < 0 || times[0].tv_usec >= 1000000 ||
+	                         times[1].tv_usec < 0 || times[1].tv_usec >= 1000000)) {
+		return KERNEL_ERROR_EINVAL;
+	}
+	if (IsReadOnlyGuestPath(path)) {
+		return KERNEL_ERROR_EROFS;
+	}
+	std::filesystem::path real_name;
+	bool                  is_dir = false;
+	if (const int r = ResolveExistingGuestPath(path, &real_name, &is_dir); r != OK) {
+		return r;
+	}
+#if KYTY_PLATFORM == KYTY_PLATFORM_LINUX
+	timespec ts[2];
+	if (times == nullptr) {
+		ts[0].tv_sec = ts[1].tv_sec = 0;
+		ts[0].tv_nsec = ts[1].tv_nsec = UTIME_NOW;
+	} else {
+		for (int i = 0; i < 2; i++) {
+			ts[i].tv_sec  = static_cast<time_t>(times[i].tv_sec);
+			ts[i].tv_nsec = static_cast<long>(times[i].tv_usec) * 1000L;
+		}
+	}
+	if (::utimensat(AT_FDCWD, Common::PathToString(real_name).c_str(), ts, 0) != 0) {
+		const std::error_code error(errno, std::generic_category());
+		return KernelErrorFromHost(error);
+	}
+#else
+	std::error_code error;
+	const auto      when = (times == nullptr)
+	                           ? std::filesystem::file_time_type::clock::now()
+	                           : std::filesystem::file_time_type(std::chrono::seconds(times[1].tv_sec) +
+	                                                             std::chrono::microseconds(times[1].tv_usec));
+	std::filesystem::last_write_time(real_name, when, error);
+	if (error) {
+		return KernelErrorFromHost(error);
+	}
+#endif
+
+	LOGF("\tUtimes %s: %s\n", times == nullptr ? "(now)" : "(given)", Common::PathToString(real_name).c_str());
+
+	return OK;
+}
+
+// Experiment 0329: sceKernelFsync / fsync — the file's buffered writes reach the host's storage: the host file's
+// stream is flushed, then fsync(2) runs on a second descriptor of the same file (the host file object keeps its
+// stream to itself; any descriptor of the file syncs the same inode). A descriptor opened for reading, a
+// directory or a special file has nothing of ours to flush and succeeds, as on the console. EBADF for a closed
+// descriptor, EINVAL for a socket, the host's error when the sync fails.
+int KYTY_SYSV_ABI KernelFsync(int d) {
+	PRINT_NAME();
+
+	if (d < DESCRIPTOR_MIN) {
+		return KERNEL_ERROR_EBADF;
+	}
+	if (::Libs::Network::Net::IsSocket(d)) {
+		return KERNEL_ERROR_EINVAL;
+	}
+	auto* file = g_files->GetFile(d);
+	if (file == nullptr || !file->opened) {
+		return KERNEL_ERROR_EBADF;
+	}
+	if (!file->writable || file->directory || file->special != SpecialFile::None) {
+		return OK;
+	}
+	Common::LockGuard lock(file->mutex);
+	if (file->f.IsInvalid() || !file->f.Flush()) {
+		return KERNEL_ERROR_EIO;
+	}
+#if KYTY_PLATFORM == KYTY_PLATFORM_LINUX
+	const int host = ::open(Common::PathToString(file->real_name).c_str(), O_RDONLY | O_CLOEXEC);
+	if (host < 0) {
+		const std::error_code error(errno, std::generic_category());
+		return KernelErrorFromHost(error);
+	}
+	const int synced = ::fsync(host);
+	const int saved  = errno;
+	::close(host);
+	if (synced != 0) {
+		const std::error_code error(saved, std::generic_category());
+		return KernelErrorFromHost(error);
+	}
+#endif
+
+	LOGF("\tFsync file: %s\n", Common::PathToString(file->real_name).c_str());
+
+	return OK;
+}
+
+// Experiment 0329: fcntl on a file descriptor (the posix wrapper in libKernel.cpp sorts sockets out first). The
+// FreeBSD commands and flags the console runs (sys/fcntl.h): F_GETFD (1) / F_SETFD (2) keep FD_CLOEXEC (1) on the
+// descriptor; F_GETFL (3) is the access mode (O_RDONLY 0 / O_RDWR 2 — this tree opens a writable file for reading
+// too) with O_APPEND (8) and O_SYNC (0x80) as the file was opened; F_SETFL (4) changes O_APPEND, and O_NONBLOCK (4)
+// is accepted without effect, as on a regular file. The duplication commands (F_DUPFD 0, F_DUP2FD 10,
+// F_DUPFD_CLOEXEC 17) have no implementation in this tree (no dup) and fail with EINVAL. EBADF for a closed
+// descriptor, EINVAL for an unknown command; the result of F_GETFD / F_GETFL otherwise.
+int KYTY_SYSV_ABI KernelFcntl(int d, int cmd, int arg) {
+	PRINT_NAME();
+
+	constexpr int CMD_GETFD = 1, CMD_SETFD = 2, CMD_GETFL = 3, CMD_SETFL = 4; // the names are macros of <fcntl.h>
+	constexpr int FLAG_CLOEXEC = 1, FLAG_RDWR = 2, FLAG_APPEND = 8, FLAG_SYNC = 0x80;
+
+	if (d < DESCRIPTOR_MIN) {
+		return KERNEL_ERROR_EBADF;
+	}
+	auto* file = g_files->GetFile(d);
+	if (file == nullptr || !file->opened) {
+		return KERNEL_ERROR_EBADF;
+	}
+
+	LOGF("\tFcntl cmd = %d, arg = 0x%x, file: %s\n", cmd, arg, Common::PathToString(file->real_name).c_str());
+
+	Common::LockGuard lock(file->mutex);
+	switch (cmd) {
+		case CMD_GETFD: return file->close_on_exec ? FLAG_CLOEXEC : 0;
+		case CMD_SETFD: file->close_on_exec = ((arg & FLAG_CLOEXEC) != 0); return OK;
+		case CMD_GETFL:
+			return (file->writable ? FLAG_RDWR : 0) | (file->append ? FLAG_APPEND : 0) |
+			       (file->sync_writes ? FLAG_SYNC : 0);
+		case CMD_SETFL:
+			if (file->writable) {
+				file->append = ((arg & FLAG_APPEND) != 0);
+			}
+			return OK;
+		default: LOGF("\tFcntl command %d: not supported by this host\n", cmd); return KERNEL_ERROR_EINVAL;
+	}
+}
+
+int KYTY_SYSV_ABI KernelUnlink(const char* path) {
+	PRINT_NAME();
+
+	if (path == nullptr) {
+		return KERNEL_ERROR_EINVAL;
+	}
+
+	if (Bc5FsFix(BC5_FS_NAMETOOLONG) && Bc5PathTooLong(path)) { // experiment 0405 (nametoolong)
+		return KERNEL_ERROR_ENAMETOOLONG;
+	}
+
+	auto path_s         = std::string(path);
+	auto real_file_name = g_mount_points->GetRealFilename(path_s);
+	auto real_directory = g_mount_points->GetRealDirectory(path_s);
+
+	bool is_dir  = Common::File::IsDirectoryExisting(real_file_name) ||
+	               Common::File::IsDirectoryExisting(real_directory);
+	bool is_file = Common::File::IsFileExisting(real_file_name);
+
+	if (is_dir) {
+		return KERNEL_ERROR_EPERM;
+	}
+
+	if (!is_file) {
+		return KERNEL_ERROR_ENOENT;
+	}
+
+	auto* open_file = g_files->GetFile(real_file_name);
+	// Experiment 0405 (kk04): on, the host name is unlinked (what SysFileUnlink does on Linux), not the name the open
+	// file had when it was opened (a rename may have changed it), and the file's descriptors lose the name (Bc5Forget).
+	const bool bc5_kk04 = Bc5FsFix(BC5_FS_KK04);
+	bool       ok       = bc5_kk04 ? Common::File::DeleteFile(real_file_name)
+	                    : (open_file != nullptr && open_file->opened && !open_file->directory
+	                           ? open_file->f.Unlink()
+	                           : Common::File::DeleteFile(real_file_name));
+
+	if (!ok) {
+		return KERNEL_ERROR_EIO;
+	}
+	if (bc5_kk04) {
+		g_files->Bc5Forget(real_file_name);
+	}
+
+	LOGF("\tKernelUnlink: %s\n", path);
+
+	return OK;
+}
+
+// Experiment 0405 (KYTY_BC5_FS_FIXES kk04): sceKernelRename where today's code EXITs (either path open) or answers
+// ENOENT (a directory). A file takes today's steps (its target's parent made, an existing file target replaced), and a
+// directory as its target is EISDIR; a directory is renamed by the host's rename(2): onto a missing name or an empty
+// directory, ENOTEMPTY onto another, ENOTDIR onto a file, EXDEV across host file systems (FreeBSD's rename(2) errors).
+// A rename onto the same file does nothing (today's code deletes the file, then answers EIO). Open descriptors follow
+// (FileDescriptors::Bc5Rename). KytyPS5 dfec14a src/kernel/fileSystem.cpp:1398-1430; sharpemu 1811cef
+// (KernelFileExtendedExports.cs:330-380 @ 514d766).
+static int Bc5RenameFixed(const char* from, const char* to, const std::filesystem::path& real_from,
+                          const std::filesystem::path& real_to) {
+	if (real_from.empty() || real_to.empty()) {
+		return KERNEL_ERROR_ENOENT;
+	}
+	const bool from_dir  = Common::File::IsDirectoryExisting(real_from);
+	const bool from_file = !from_dir && Common::File::IsFileExisting(real_from);
+	if (!from_dir && !from_file) {
+		return KERNEL_ERROR_ENOENT;
+	}
+	std::error_code same_error;
+	if (std::filesystem::equivalent(real_from, real_to, same_error) && !same_error) {
+		LOGF("\tKernelRename: %s -> %s, the same file (experiment 0405)\n", from, to);
+		return OK;
+	}
+	if (from_dir) {
+		std::error_code error;
+		std::filesystem::rename(real_from, real_to, error);
+		if (error) {
+			if (error == std::errc::directory_not_empty || error == std::errc::file_exists) {
+				return KERNEL_ERROR_ENOTEMPTY;
+			}
+			if (error == std::errc::cross_device_link) {
+				return KERNEL_ERROR_EXDEV;
+			}
+			return KernelErrorFromHost(error);
+		}
+	} else {
+		if (Common::File::IsDirectoryExisting(real_to)) {
+			return KERNEL_ERROR_EISDIR;
+		}
+		Common::File::CreateDirectories(real_to.parent_path());
+		if (Common::File::IsFileExisting(real_to)) {
+			Common::File::DeleteFile(real_to);
+		}
+		if (!Common::File::MoveFile(real_from, real_to)) {
+			return KERNEL_ERROR_EIO;
+		}
+	}
+	g_files->Bc5Rename(real_from, real_to);
+	LOGF("\tKernelRename: %s -> %s (experiment 0405)\n", from, to);
+	return OK;
+}
+
+int KYTY_SYSV_ABI KernelRename(const char* from, const char* to) {
+	PRINT_NAME();
+
+	if (from == nullptr || to == nullptr) {
+		return KERNEL_ERROR_EINVAL;
+	}
+
+	if (Bc5FsFix(BC5_FS_NAMETOOLONG) && (Bc5PathTooLong(from) || Bc5PathTooLong(to))) { // experiment 0405 (nametoolong)
+		return KERNEL_ERROR_ENAMETOOLONG;
+	}
+
+	auto from_path = std::string(from);
+	auto to_path   = std::string(to);
+	auto real_from = g_mount_points->GetRealFilename(from_path);
+	auto real_to   = g_mount_points->GetRealFilename(to_path);
+
+	if (Bc5FsFix(BC5_FS_KK04)) {
+		return Bc5RenameFixed(from, to, real_from, real_to); // experiment 0405 (kk04)
+	}
+
+	EXIT_NOT_IMPLEMENTED(g_files->GetFile(real_from) != nullptr);
+	EXIT_NOT_IMPLEMENTED(g_files->GetFile(real_to) != nullptr);
+
+	if (real_to.empty() || !Common::File::IsFileExisting(real_from)) {
+		return KERNEL_ERROR_ENOENT;
+	}
+
+	Common::File::CreateDirectories(real_to.parent_path());
+
+	if (Common::File::IsFileExisting(real_to)) {
+		Common::File::DeleteFile(real_to);
+	}
+
+	if (!Common::File::MoveFile(real_from, real_to)) {
+		return KERNEL_ERROR_EIO;
+	}
+
+	LOGF("\tKernelRename: %s -> %s\n", from, to);
+
+	return OK;
+}
+
+int KYTY_SYSV_ABI KernelGetdirentries(int fd, char* buf, int nbytes, int64_t* basep) {
+	PRINT_NAME();
+
+	if (fd < DESCRIPTOR_MIN) {
+		return KERNEL_ERROR_EBADF;
+	}
+
+	if (buf == nullptr) {
+		return KERNEL_ERROR_EFAULT;
+	}
+
+	auto* file = g_files->GetFile(fd);
+
+	if (file == nullptr) {
+		return KERNEL_ERROR_EBADF;
+	}
+
+	constexpr uint64_t DIR_BLOCK_SIZE   = 512;
+	constexpr uint64_t DIRENT_META_SIZE = 8;
+
+	if (!file->directory || nbytes < static_cast<int>(DIR_BLOCK_SIZE)) {
+		return KERNEL_ERROR_EINVAL;
+	}
+
+	EXIT_IF(!file->opened);
+
+	LOGF("\t dir    = %s\n"
+	     "\t nbytes = %d\n"
+	     "\t offset = %" PRIu64 "\n",
+	     Common::PathToString(file->real_name).c_str(), nbytes, file->dents_offset);
+
+	if (basep != nullptr) {
+		*basep = static_cast<int64_t>(file->dents_offset);
+	}
+
+	std::vector<uint8_t> dirents;
+	dirents.reserve(
+	    std::max<size_t>(static_cast<size_t>(DIR_BLOCK_SIZE), file->dents.size() * 64u));
+
+	uint64_t next_ceiling       = 0;
+	uint64_t dirent_offset      = 0;
+	int64_t  last_reclen_offset = -1;
+
+	for (const auto& entry: file->dents) {
+		const auto& str      = entry.name;
+		auto        str_size = str.size();
+		EXIT_NOT_IMPLEMENTED(str_size > 255);
+
+		uint64_t reclen = AlignUp(DIRENT_META_SIZE + str_size + 1, 4);
+		if (dirent_offset + reclen > next_ceiling) {
+			if (last_reclen_offset >= 0) {
+				auto* last_reclen =
+				    reinterpret_cast<uint16_t*>(dirents.data() + last_reclen_offset);
+				*last_reclen = static_cast<uint16_t>(*last_reclen + (next_ceiling - dirent_offset));
+			}
+
+			dirent_offset = next_ceiling;
+			next_ceiling += DIR_BLOCK_SIZE;
+			dirents.resize(next_ceiling);
+			std::fill(dirents.begin() + static_cast<std::ptrdiff_t>(dirent_offset), dirents.end(),
+			          0);
+		}
+
+		*reinterpret_cast<uint32_t*>(dirents.data() + dirent_offset + 0) =
+		    Common::hash(str.data(), static_cast<uint32_t>(str.size()));
+		*reinterpret_cast<uint16_t*>(dirents.data() + dirent_offset + 4) =
+		    static_cast<uint16_t>(reclen);
+		*reinterpret_cast<uint8_t*>(dirents.data() + dirent_offset + 6) = (entry.is_file ? 8 : 4);
+		*reinterpret_cast<uint8_t*>(dirents.data() + dirent_offset + 7) =
+		    static_cast<uint8_t>(str_size);
+		memcpy(dirents.data() + dirent_offset + 8, str.data(), str_size);
+		dirents[dirent_offset + 8 + str_size] = '\0';
+
+		last_reclen_offset = static_cast<int64_t>(dirent_offset + 4);
+		dirent_offset += reclen;
+
+		LOGF("\t name  = %s\n", str.data());
+	}
+
+	if (last_reclen_offset >= 0) {
+		auto* last_reclen = reinterpret_cast<uint16_t*>(dirents.data() + last_reclen_offset);
+		*last_reclen      = static_cast<uint16_t>(*last_reclen + (next_ceiling - dirent_offset));
+	}
+
+	const uint64_t directory_size = next_ceiling;
+	if (file->dents_offset >= directory_size) {
+		return 0;
+	}
+
+	uint64_t bytes_written        = 0;
+	uint64_t working_offset       = file->dents_offset;
+	uint64_t dirent_buffer_offset = 0;
+	uint64_t aligned_count        = AlignDown(static_cast<uint64_t>(nbytes), DIR_BLOCK_SIZE);
+
+	while (dirent_buffer_offset < dirents.size()) {
+		const auto* normal_dirent = dirents.data() + dirent_buffer_offset;
+		uint16_t    reclen        = *reinterpret_cast<const uint16_t*>(normal_dirent + 4);
+		uint8_t     namlen        = *(normal_dirent + 7);
+
+		if (namlen == 0 || reclen == 0) {
+			break;
+		}
+
+		if (working_offset >= reclen) {
+			dirent_buffer_offset += reclen;
+			working_offset -= reclen;
+			continue;
+		}
+
+		if (bytes_written + reclen > aligned_count) {
+			break;
+		}
+
+		const auto bytes_to_copy = reclen - working_offset;
+		memcpy(buf + bytes_written, normal_dirent + working_offset, bytes_to_copy);
+		bytes_written += bytes_to_copy;
+		dirent_buffer_offset += reclen;
+		working_offset = 0;
+	}
+
+	file->dents_offset += bytes_written;
+	return static_cast<int64_t>(bytes_written);
+}
+
+int KYTY_SYSV_ABI KernelGetdents(int fd, char* buf, int nbytes) {
+	PRINT_NAME();
+
+	return KernelGetdirentries(fd, buf, nbytes, nullptr);
+}
+
+int KYTY_SYSV_ABI KernelMkdir(const char* path, uint16_t mode) {
+	PRINT_NAME();
+
+	if (path == nullptr) {
+		return KERNEL_ERROR_EINVAL;
+	}
+
+	if (Bc5FsFix(BC5_FS_NAMETOOLONG)) { // experiment 0405 (nametoolong): FreeBSD's limits, not every path over 255
+		if (Bc5PathTooLong(path)) {
+			return KERNEL_ERROR_ENAMETOOLONG;
+		}
+	} else if (std::strlen(path) > 255) {
+		return KERNEL_ERROR_ENAMETOOLONG;
+	}
+
+	LOGF("\t path = %s\n"
+	     "\t mode = %04" PRIx16 "\n",
+	     path, mode);
+
+	auto real_name = g_mount_points->GetRealDirectory(std::string(path));
+	if (real_name.empty()) {
+		return KERNEL_ERROR_ENOENT;
+	}
+
+	if (Common::File::IsDirectoryExisting(real_name)) {
+		return KERNEL_ERROR_EEXIST;
+	}
+
+	if (!Common::File::CreateDirectory(real_name)) {
+		return KERNEL_ERROR_EIO;
+	}
+
+	if (!Common::File::IsDirectoryExisting(real_name)) {
+		return KERNEL_ERROR_ENOENT;
+	}
+
+	return OK;
+}
+
+int KYTY_SYSV_ABI KernelRmdir(const char* path) {
+	PRINT_NAME();
+
+	if (path == nullptr) {
+		return KERNEL_ERROR_EINVAL;
+	}
+
+	if (Bc5FsFix(BC5_FS_NAMETOOLONG) && Bc5PathTooLong(path)) { // experiment 0405 (nametoolong)
+		return KERNEL_ERROR_ENAMETOOLONG;
+	}
+
+	LOGF("\t path = %s\n", path);
+
+	auto real_name = g_mount_points->GetRealDirectory(std::string(path));
+
+	if (!Common::File::IsDirectoryExisting(real_name)) {
+		return KERNEL_ERROR_ENOENT;
+	}
+
+	if (!Common::File::DeleteDirectory(real_name)) {
+		return KERNEL_ERROR_EIO;
+	}
+
+	return OK;
+}
+
+int KYTY_SYSV_ABI KernelCheckReachability(const char* path) {
+	PRINT_NAME();
+
+	if (path == nullptr) {
+		return KERNEL_ERROR_EINVAL;
+	}
+
+	if (Bc5FsFix(BC5_FS_NAMETOOLONG)) { // experiment 0405 (nametoolong): FreeBSD's limits, not every path over 255
+		if (Bc5PathTooLong(path)) {
+			return KERNEL_ERROR_ENAMETOOLONG;
+		}
+	} else if (std::strlen(path) > 255) {
+		return KERNEL_ERROR_ENAMETOOLONG;
+	}
+
+	LOGF("\t KernelCheckReachability: %s\n", path);
+
+	std::string mounted_path = std::string(path);
+
+	if (IsRandomDevice(mounted_path)) {
+		return OK;
+	}
+
+	auto real_name = g_mount_points->GetRealFilename(mounted_path);
+
+	if (Common::File::IsFileExisting(real_name) || Common::File::IsDirectoryExisting(real_name)) {
+		return OK;
+	}
+
+	return KERNEL_ERROR_ENOENT;
+}
+
+bool KernelGetSpecialDeviceName(int d, std::string* name) {
+	auto* file = g_files->GetFile(d);
+	if (file == nullptr || !file->opened || file->special != SpecialFile::Device) {
+		return false;
+	}
+	*name = file->name;
+	return true;
+}
+
+} // namespace Libs::LibKernel::FileSystem
