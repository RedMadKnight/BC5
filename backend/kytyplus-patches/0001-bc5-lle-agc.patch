+// BC5 (experiment 0172, KYTY_BC5_FPS_COUNTER=1): a measurement, not a log - it ignores the logging
+// switch. Once a second one stderr line: the flips submitted, the longest interval between two of
+// them, and how many intervals were over 40 and 70 ms (the frame times as the title sees them).
+static void Bc5FpsCount() {
+	static const bool on = BC5_DIAG_ENV("KYTY_BC5_FPS_COUNTER") != nullptr;
+	if (!on) {
+		return;
+	}
+	static std::mutex m;
+	static uint64_t   last_flip = 0, window = 0, flips = 0, max_gap = 0, over40 = 0, over70 = 0;
+	std::lock_guard   lock(m);
+	const uint64_t    now = LibKernel::KernelGetProcessTime();
+	if (last_flip != 0) {
+		const uint64_t gap = now - last_flip;
+		max_gap            = std::max(max_gap, gap);
+		over40 += gap > 40000 ? 1 : 0;
+		over70 += gap > 70000 ? 1 : 0;
+	}
+	last_flip = now;
+	flips++;
+	if (window == 0) {
+		window = now;
+	} else if (now - window >= 1000000) {
+		std::fprintf(stderr, "fps counter: t %.3f s: %" PRIu64 " flips in %.3f s, longest gap %.1f ms, gaps over 40 ms %" PRIu64 ", over 70 ms %" PRIu64 "\n",
+		             static_cast<double>(now) / 1e6, flips, static_cast<double>(now - window) / 1e6, static_cast<double>(max_gap) / 1e3, over40, over70);
+		window = now;
+		flips = max_gap = over40 = over70 = 0;
+	}
+}
