+		if (FILE* f = std::fopen(name, "wb"); f != nullptr) {
+			std::fprintf(f, "P6" "\n" "%u %u" "\n" "255" "\n", cw, ch);
+			for (uint32_t y = cy; y < cy + ch; y++) std::fwrite(&rgb[(static_cast<size_t>(y) * w + cx) * 3u], 1, static_cast<size_t>(cw) * 3u, f);
