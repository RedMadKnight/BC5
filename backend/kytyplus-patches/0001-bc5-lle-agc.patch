+				                             timing_now(), index, post_ms, SoftCp::t_cur_kind, SoftCp::t_cur_n, static_cast<const void*>(SoftCp::t_cur_buf),
+				                             SoftCp::g_soft_polls.load(), static_cast<double>(SoftCp::g_soft_poll_ns.load()) / 1e6, SoftCp::g_soft_timeouts.load());
