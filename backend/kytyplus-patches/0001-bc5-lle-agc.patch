+// BC5: offline entitlement list requests, after KytyPS5 5dec523 (src/libs/libNpEntitlementAccess.cpp):
+// a request completes at once with no entitlements and stays pollable until deleted.
+static std::mutex             g_bc5_ent_mutex;
+static std::map<int64_t, int> g_bc5_ent_requests;
+static int64_t                g_bc5_ent_next = 1;
+
+static int KYTY_SYSV_ABI NpEntitlementAccessRequestUnifiedEntitlementInfoList(int32_t user_id, uint32_t service_label,
+                                                                             const void* list, uint32_t list_num,
+                                                                             const void* param, int64_t* request_id) {
+	PRINT_NAME();
+	LOGF("\t user_id = %" PRId32 ", service_label = %" PRIu32 ", list_num = %" PRIu32 "\n", user_id, service_label, list_num);
+	if (param == nullptr || request_id == nullptr || (list == nullptr && list_num != 0)) {
+		return NP_ENTITLEMENT_ACCESS_ERROR_PARAMETER;
+	}
+	std::lock_guard lock(g_bc5_ent_mutex);
+	*request_id = g_bc5_ent_next++;
+	g_bc5_ent_requests[*request_id] = 0;
+	return 0;
+}
+
+static int KYTY_SYSV_ABI NpEntitlementAccessPollUnifiedEntitlementInfoList(int64_t request_id, int32_t* result, void* list,
+                                                                          uint32_t list_num, uint32_t* hit_num,
+                                                                          int32_t* next_offset, int32_t* previous_offset) {
+	PRINT_NAME();
+	if (result == nullptr || hit_num == nullptr || next_offset == nullptr || previous_offset == nullptr ||
+	    (list == nullptr && list_num != 0)) {
+		return NP_ENTITLEMENT_ACCESS_ERROR_PARAMETER;
+	}
+	std::lock_guard lock(g_bc5_ent_mutex);
+	if (g_bc5_ent_requests.find(request_id) == g_bc5_ent_requests.end()) {
+		return -2122514411; // NP_ENTITLEMENT_ACCESS_ERROR_REQUEST_NOT_FOUND, 0x817D0015
+	}
+	*result          = 0;
+	*hit_num         = 0;
+	*next_offset     = -1;
+	*previous_offset = -1;
+	LOGF("\t request_id = %" PRId64 ": done, 0 entitlements\n", request_id);
+	return 0;
+}
+
+static int KYTY_SYSV_ABI NpEntitlementAccessDeleteRequest(int64_t request_id) {
+	PRINT_NAME();
+	std::lock_guard lock(g_bc5_ent_mutex);
+	g_bc5_ent_requests.erase(request_id);
+	return 0;
+}
