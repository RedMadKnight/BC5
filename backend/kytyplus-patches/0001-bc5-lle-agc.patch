+static void UnmapGpuRange(uint64_t vaddr, uint64_t size) {
+	if (g_gpu_resources == nullptr || !IsGpuAddressRange(vaddr, size)) {
+		return;
+	}
+	if (!Bc5MapStatsOn()) {
+		GetGpuResources().UnmapMemory(vaddr, size);
+		return;
+	}
+	const uint64_t t0 = Bc5MonoNs();
+	GetGpuResources().UnmapMemory(vaddr, size);
+	const uint64_t d = Bc5MonoNs() - t0;
+	g_bc5_ms_gpu_unmaps++;
+	g_bc5_ms_gpu_unmap_ns += d;
+	uint64_t m = g_bc5_ms_gpu_unmap_max_ns.load();
+	while (d > m && !g_bc5_ms_gpu_unmap_max_ns.compare_exchange_weak(m, d)) {
+	}
+	Bc5MapStatsTick();
+}
