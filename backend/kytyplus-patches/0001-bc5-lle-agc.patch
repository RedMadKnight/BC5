-	if (!connected || ret_num == 0) {
-		if (connected) {
-			g_controller->ReadStateForSlot(ControllerIndexFromHandle(handle), &states[0], &connected,
-			                               &connected_count);
-		}
-		ret_num = 1;
-	}
-
-	for (int i = 0; i < ret_num; i++) {
-		pad_fill_data(&data[i], states[i], connected, connected_count);
-	}
-
-	return ret_num;
