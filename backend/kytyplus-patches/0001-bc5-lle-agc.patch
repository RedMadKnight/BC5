+namespace Libs::Bc5Gc::Direct {
+void   SetTimestampScale(double k); // bc5LleAgc.cpp, experiment 0047
+double GetTimestampScale();
+bool   GetMainPass(uint32_t* w, uint32_t* h);
+} // namespace Libs::Bc5Gc::Direct
+
+namespace Libs::Graphics {
+
+namespace {
+
+// --- state shared between the window thread and the presenter thread --------------------------
+
+enum class InputKind {
+	Key,
+	MousePosition,
+	MouseButton,
+	MouseWheel,
+	PadButton,
+	PadAxis,
+	Text, // BC5 (ADR 0011): typed characters, for the file browser's path box
+};
+
+struct InputEvent {
+	InputKind kind;
+	int       id;
+	float     x;
+	float     y;
+	char      text[32] = {};
+};
+
+// KYTY_BC5_SETTINGS_OPEN=1 opens the overlay at start (screenshots, a box without a keyboard).
+std::atomic<bool>     g_active {std::getenv("KYTY_BC5_SETTINGS_OPEN") != nullptr};
+std::atomic<uint64_t> g_revision {0};
+std::mutex            g_mutex;
+std::deque<InputEvent> g_events;
+bool                   g_reset_input = false;
+
+// Binding capture: the overlay asks for an input for a control (g_capture_control >= 0); the next
+// key, mouse button or pad input the window thread sees becomes g_captured.
+std::atomic<int> g_capture_control {-1};
+int              g_captured_control = -1;
+std::string      g_captured_input;
+
+void QueueInput(const InputEvent& event) {
+	std::scoped_lock lock(g_mutex);
+	g_events.push_back(event);
+}
+
+void Bump() {
+	g_revision.fetch_add(1, std::memory_order_acq_rel);
+}
+
+ImGuiKey KeyToImGui(SDL_Keycode key) {
+	switch (key) {
+		case SDLK_UP: return ImGuiKey_UpArrow;
+		case SDLK_DOWN: return ImGuiKey_DownArrow;
+		case SDLK_LEFT: return ImGuiKey_LeftArrow;
+		case SDLK_RIGHT: return ImGuiKey_RightArrow;
+		case SDLK_RETURN:
+		case SDLK_RETURN2:
+		case SDLK_KP_ENTER: return ImGuiKey_Enter;
+		case SDLK_SPACE: return ImGuiKey_Space;
+		case SDLK_TAB: return ImGuiKey_Tab;
+		case SDLK_BACKSPACE: return ImGuiKey_Backspace;
+		case SDLK_DELETE: return ImGuiKey_Delete;
+		case SDLK_HOME: return ImGuiKey_Home;
+		case SDLK_END: return ImGuiKey_End;
+		case SDLK_PAGEUP: return ImGuiKey_PageUp;
+		case SDLK_PAGEDOWN: return ImGuiKey_PageDown;
+		default: return ImGuiKey_None;
+	}
+}
+
+ImGuiKey PadButtonToImGui(int button) {
+	switch (button) {
+		case SDL_CONTROLLER_BUTTON_A: return ImGuiKey_GamepadFaceDown;
+		case SDL_CONTROLLER_BUTTON_B: return ImGuiKey_GamepadFaceRight;
+		case SDL_CONTROLLER_BUTTON_X: return ImGuiKey_GamepadFaceLeft;
+		case SDL_CONTROLLER_BUTTON_Y: return ImGuiKey_GamepadFaceUp;
+		case SDL_CONTROLLER_BUTTON_DPAD_LEFT: return ImGuiKey_GamepadDpadLeft;
+		case SDL_CONTROLLER_BUTTON_DPAD_RIGHT: return ImGuiKey_GamepadDpadRight;
+		case SDL_CONTROLLER_BUTTON_DPAD_UP: return ImGuiKey_GamepadDpadUp;
+		case SDL_CONTROLLER_BUTTON_DPAD_DOWN: return ImGuiKey_GamepadDpadDown;
+		case SDL_CONTROLLER_BUTTON_LEFTSHOULDER: return ImGuiKey_GamepadL1;
+		case SDL_CONTROLLER_BUTTON_RIGHTSHOULDER: return ImGuiKey_GamepadR1;
+		case SDL_CONTROLLER_BUTTON_START: return ImGuiKey_GamepadStart;
+		case SDL_CONTROLLER_BUTTON_BACK: return ImGuiKey_GamepadBack;
+		default: return ImGuiKey_None;
+	}
+}
+
+bool ReservedKey(SDL_Keycode key) {
+	return key == SDLK_ESCAPE || key == SDLK_SPACE || key == SDLK_F1 || key == SDLK_F2;
+}
+
+std::string PadAxisSourceName(int axis, int value) {
+	const bool trigger = axis == SDL_CONTROLLER_AXIS_TRIGGERLEFT || axis == SDL_CONTROLLER_AXIS_TRIGGERRIGHT;
+	std::string name = std::string("Pad:") +
+	                   SDL_GameControllerGetStringForAxis(static_cast<SDL_GameControllerAxis>(axis));
+	if (!trigger) {
+		name += value < 0 ? "-" : "+";
+	}
+	return name;
+}
+
+void Captured(const std::string& input) {
+	const int control = g_capture_control.exchange(-1);
+	if (control < 0) {
+		return;
+	}
+	std::scoped_lock lock(g_mutex);
+	g_captured_control = control;
+	g_captured_input   = input;
+	Bump();
+}
+
+PFN_vkVoidFunction LoadVulkanFunction(const char* name, void* user_data) {
+	auto& graphics = *static_cast<GraphicContext*>(user_data);
+	return graphics.instance.getProcAddr(name);
+}
+
+void CheckVulkanResult(VkResult result) {
+	EXIT_IF(result != VK_SUCCESS);
+}
+
+// --- the configuration as the overlay edits it: a list of statements -------------------------
+
+std::string_view StatementLeft(const std::string& line) {
+	const auto eq = line.find('=');
+	return eq == std::string::npos ? std::string_view(line) : std::string_view(line).substr(0, eq);
+}
+
+std::string_view StatementRight(const std::string& line) {
+	const auto eq = line.find('=');
+	return eq == std::string::npos ? std::string_view() : std::string_view(line).substr(eq + 1);
+}
+
+bool EqualNoCase(std::string_view a, std::string_view b) {
+	return a.size() == b.size() && std::equal(a.begin(), a.end(), b.begin(), [](char x, char y) {
+		       return std::tolower(static_cast<unsigned char>(x)) == std::tolower(static_cast<unsigned char>(y));
+	       });
+}
+
+struct Draft {
+	std::vector<std::string> lines;
+
+	[[nodiscard]] std::string InputOf(const std::string& control) const {
+		std::string found;
+		for (const auto& l: lines) {
+			if (StatementLeft(l) == control) {
+				found = std::string(StatementRight(l));
+			}
+		}
+		return found;
+	}
+
+	void SetControl(const std::string& control, const std::string& input) {
+		lines.erase(std::remove_if(lines.begin(), lines.end(),
+		                           [&](const std::string& l) { return StatementLeft(l) == control; }),
+		            lines.end());
+		if (!input.empty()) {
+			lines.push_back(control + "=" + input);
+		}
+	}
+
+	[[nodiscard]] bool PadDisabled(const std::string& pad_name) const {
+		return std::any_of(lines.begin(), lines.end(), [&](const std::string& l) {
+			return StatementLeft(l) == pad_name && EqualNoCase(StatementRight(l), "none");
+		});
+	}
+
+	void SetPadDisabled(const std::string& pad_name, bool disabled) {
+		lines.erase(std::remove_if(lines.begin(), lines.end(),
+		                           [&](const std::string& l) {
+			                           return StatementLeft(l) == pad_name && EqualNoCase(StatementRight(l), "none");
+		                           }),
+		            lines.end());
+		if (disabled) {
+			lines.insert(lines.begin(), pad_name + "=none");
+		}
+	}
+
+	[[nodiscard]] bool DefaultKeys() const {
+		bool on = true;
+		for (const auto& l: lines) {
+			if (EqualNoCase(StatementLeft(l), "DefaultKeys")) {
+				on = EqualNoCase(StatementRight(l), "on") || EqualNoCase(StatementRight(l), "true") ||
+				     StatementRight(l) == "1";
+			}
+		}
+		return on;
+	}
+
+	void SetDefaultKeys(bool on) {
+		lines.erase(std::remove_if(lines.begin(), lines.end(),
+		                           [&](const std::string& l) { return EqualNoCase(StatementLeft(l), "DefaultKeys"); }),
+		            lines.end());
+		if (!on) {
+			lines.insert(lines.begin(), "DefaultKeys=off");
+		}
+	}
+
+	// Experiment 0047: RenderScale=<k>, the GPU timestamp scale the title's resolution follows.
+	// Per title since 2026-10-15: RenderScale.<TITLE_ID>=<k> (HostInputTitleId).
+	[[nodiscard]] double RenderScale() const {
+		const std::string key = "RenderScale." + HostInputTitleId();
+		double            k   = 0.0;
+		for (const auto& l: lines) {
+			if (EqualNoCase(StatementLeft(l), key)) k = std::strtod(std::string(StatementRight(l)).c_str(), nullptr);
+		}
+		return k;
+	}
+
+	void SetFullscreen(bool on) {
+		lines.erase(std::remove_if(lines.begin(), lines.end(),
+		                           [&](const std::string& l) { return EqualNoCase(StatementLeft(l), "Fullscreen"); }),
+		            lines.end());
+		lines.insert(lines.begin(), on ? "Fullscreen=on" : "Fullscreen=off");
+	}
+
+	void SetRenderScale(double k) {
+		const std::string key = "RenderScale." + HostInputTitleId();
+		lines.erase(std::remove_if(lines.begin(), lines.end(),
+		                           [&](const std::string& l) { return EqualNoCase(StatementLeft(l), key); }),
+		            lines.end());
+		char b[64];
+		std::snprintf(b, sizeof(b), "%s=%.2f", key.c_str(), k);
+		lines.insert(lines.begin(), b);
+	}
+};
+
+} // namespace
+
+// --- window-thread side -----------------------------------------------------------------------
+
+void SettingsOverlayHostUiChanged() {
+	g_capture_control.store(-1);
+	{
+		std::scoped_lock lock(g_mutex);
+		g_events.clear();
+		g_reset_input = true;
+	}
+	if (SettingsOverlayActive()) {
+		HostInputReleaseAll();
+	}
+	Bump();
+}
+
+void SettingsOverlayToggle() {
+	const bool now_active = !g_active.load(std::memory_order_acquire);
+	g_active.store(now_active, std::memory_order_release);
+	SettingsOverlayHostUiChanged();
+}
+
+void SettingsOverlayOpen() {
+	if (!g_active.load(std::memory_order_acquire)) {
+		SettingsOverlayToggle();
+	}
+}
+
+bool SettingsOverlayActive() noexcept {
+	return g_active.load(std::memory_order_acquire) || HostMenuVisible();
+}
+
+uint64_t SettingsOverlayRevision() noexcept {
+	return g_revision.load(std::memory_order_acquire);
+}
+
+bool ProcessSettingsInput(const SDL_Event& event) {
+	// BC5 (ADR 0011): the pad's Guide (PS) button shows and hides the menu bar; a PS5 title never
+	// sees that button (the console keeps it for its own menu), so neither its press nor its
+	// release goes on to the game.
+	if ((event.type == SDL_CONTROLLERBUTTONDOWN || event.type == SDL_CONTROLLERBUTTONUP) &&
+	    event.cbutton.button == SDL_CONTROLLER_BUTTON_GUIDE) {
+		if (event.type == SDL_CONTROLLERBUTTONDOWN) {
+			HostMenuToggle();
+		}
+		return true;
+	}
+	if (!SettingsOverlayActive()) {
+		return false;
+	}
+	const bool capturing = g_capture_control.load() >= 0;
+	switch (event.type) {
+		case SDL_KEYDOWN:
+		case SDL_KEYUP: {
+			const bool down = event.type == SDL_KEYDOWN;
+			const auto key  = event.key.keysym.sym;
+			if (down && !event.key.repeat && key == SDLK_F2) {
+				SettingsOverlayToggle();
+				return true;
+			}
+			if (down && !event.key.repeat && key == SDLK_F1) {
+				HostMenuToggle();
+				return true;
+			}
+			if (down && !event.key.repeat && key == SDLK_F11) {
+				WindowSetFullscreen(!WindowIsFullscreen());
+				return true;
+			}
+			if (capturing) {
+				if (down && key == SDLK_ESCAPE) {
+					g_capture_control.store(-1);
+					Bump();
+				} else if (down && !ReservedKey(key)) {
+					Captured(SDL_GetKeyName(key));
+				}
+				return true;
+			}
+			if (down && !event.key.repeat && key == SDLK_ESCAPE) {
+				if (g_active.load(std::memory_order_acquire)) {
+					SettingsOverlayToggle();
+				} else {
+					HostMenuToggle();
+				}
+				return true;
+			}
+			const ImGuiKey imgui_key = KeyToImGui(key);
+			if (imgui_key != ImGuiKey_None) {
+				QueueInput({InputKind::Key, static_cast<int>(imgui_key), down ? 1.0f : 0.0f, 0.0f});
+				Bump();
+			}
+			return true;
+		}
+		case SDL_TEXTINPUT: {
+			InputEvent text {InputKind::Text, 0, 0.0f, 0.0f};
+			std::snprintf(text.text, sizeof(text.text), "%s", event.text.text);
+			QueueInput(text);
+			Bump();
+			return true;
+		}
+		case SDL_TEXTEDITING: return true;
+		case SDL_MOUSEMOTION:
+			QueueInput({InputKind::MousePosition, 0, static_cast<float>(event.motion.x),
+			            static_cast<float>(event.motion.y)});
+			Bump();
+			return true;
+		case SDL_MOUSEBUTTONDOWN:
+		case SDL_MOUSEBUTTONUP: {
+			const bool down = event.type == SDL_MOUSEBUTTONDOWN;
+			if (capturing) {
+				if (down) {
+					const char* name = event.button.button == SDL_BUTTON_LEFT     ? "Mouse:Left"
+					                   : event.button.button == SDL_BUTTON_MIDDLE ? "Mouse:Middle"
+					                   : event.button.button == SDL_BUTTON_RIGHT  ? "Mouse:Right"
+					                   : event.button.button == SDL_BUTTON_X1     ? "Mouse:X1"
+					                   : event.button.button == SDL_BUTTON_X2     ? "Mouse:X2"
+					                                                              : nullptr;
+					if (name != nullptr) {
+						Captured(name);
+					}
+				}
+				return true;
+			}
+			QueueInput({InputKind::MouseButton, event.button.button, down ? 1.0f : 0.0f, 0.0f});
+			Bump();
+			return true;
+		}
+		case SDL_MOUSEWHEEL:
+			QueueInput({InputKind::MouseWheel, 0, static_cast<float>(event.wheel.x),
+			            static_cast<float>(event.wheel.y)});
+			Bump();
+			return true;
+		case SDL_CONTROLLERBUTTONDOWN:
+		case SDL_CONTROLLERBUTTONUP: {
+			const bool down = event.type == SDL_CONTROLLERBUTTONDOWN;
+			if (capturing) {
+				if (down) {
+					Captured(std::string("Pad:") + SDL_GameControllerGetStringForButton(
+					                                   static_cast<SDL_GameControllerButton>(event.cbutton.button)));
+				}
+				return true;
+			}
+			QueueInput({InputKind::PadButton, event.cbutton.button, down ? 1.0f : 0.0f, 0.0f});
+			Bump();
+			return true;
+		}
+		case SDL_CONTROLLERAXISMOTION: {
+			const int value = event.caxis.value;
+			if (capturing) {
+				if (value > 16384 || value < -16384) {
+					Captured(PadAxisSourceName(event.caxis.axis, value));
+				}
+				return true;
+			}
+			QueueInput({InputKind::PadAxis, event.caxis.axis, static_cast<float>(value), 0.0f});
+			return true;
+		}
+		default:
+			// Window, display and device events go on to the game as usual.
+			return false;
+	}
+}
+
+// --- presenter-thread side --------------------------------------------------------------------
+
+struct SettingsOverlay::Impl {
+	explicit Impl(GraphicContext& context): graphics(context), controls(HostInputControlNames()) {}
+
+	~Impl() {
+		ReleaseVulkan();
+		if (imgui_context != nullptr) {
+			ImGui::DestroyContext(imgui_context);
+		}
+	}
+
+	void EnsureContext() {
+		if (imgui_context != nullptr) {
+			ImGui::SetCurrentContext(imgui_context);
+			return;
+		}
+		IMGUI_CHECKVERSION();
+		imgui_context = ImGui::CreateContext();
+		ImGui::SetCurrentContext(imgui_context);
+		auto& io       = ImGui::GetIO();
+		io.IniFilename = nullptr;
+		io.LogFilename = nullptr;
+		io.ConfigFlags |= ImGuiConfigFlags_NavEnableKeyboard | ImGuiConfigFlags_NavEnableGamepad;
+		io.BackendFlags |= ImGuiBackendFlags_HasGamepad;
+		io.BackendPlatformName = "BC5 settings overlay";
+		ImGui::StyleColorsDark();
+		auto& style          = ImGui::GetStyle();
+		style.WindowRounding = 8.0f;
+		style.FrameRounding  = 4.0f;
+		style.ItemSpacing    = {8.0f, 6.0f};
+	}
