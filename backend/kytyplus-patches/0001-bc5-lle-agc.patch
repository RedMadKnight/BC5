--- /dev/null
+++ b/src/graphics/presentation/settingsOverlay.cpp
@@ -0,0 +1,702 @@
+#include "graphics/presentation/settingsOverlay.h"
+
+#include "SDL.h"
+#include "common/assert.h"
+#include "graphics/host_gpu/graphicContext.h"
+#include "graphics/presentation/window/hostInput.h"
+#include "imgui.h"
+#include "imgui_impl_vulkan.h"
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <deque>
+#include <mutex>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace Libs::Graphics {
+
+namespace {
+
+// --- state shared between the window thread and the presenter thread --------------------------
+
+enum class InputKind {
+	Key,
+	MousePosition,
+	MouseButton,
+	MouseWheel,
+	PadButton,
+	PadAxis,
+};
+
+struct InputEvent {
+	InputKind kind;
+	int       id;
+	float     x;
+	float     y;
+};
+
+// KYTY_BC5_SETTINGS_OPEN=1 opens the overlay at start (screenshots, a box without a keyboard).
+std::atomic<bool>     g_active {std::getenv("KYTY_BC5_SETTINGS_OPEN") != nullptr};
+std::atomic<uint64_t> g_revision {0};
+std::mutex            g_mutex;
+std::deque<InputEvent> g_events;
+bool                   g_reset_input = false;
+
+// Binding capture: the overlay asks for an input for a control (g_capture_control >= 0); the next
+// key, mouse button or pad input the window thread sees becomes g_captured.
+std::atomic<int> g_capture_control {-1};
+int              g_captured_control = -1;
+std::string      g_captured_input;
+
+void QueueInput(const InputEvent& event) {
+	std::scoped_lock lock(g_mutex);
+	g_events.push_back(event);
+}
+
+void Bump() {
+	g_revision.fetch_add(1, std::memory_order_acq_rel);
+}
+
+ImGuiKey KeyToImGui(SDL_Keycode key) {
+	switch (key) {
+		case SDLK_UP: return ImGuiKey_UpArrow;
+		case SDLK_DOWN: return ImGuiKey_DownArrow;
+		case SDLK_LEFT: return ImGuiKey_LeftArrow;
+		case SDLK_RIGHT: return ImGuiKey_RightArrow;
+		case SDLK_RETURN:
+		case SDLK_RETURN2:
+		case SDLK_KP_ENTER: return ImGuiKey_Enter;
+		case SDLK_SPACE: return ImGuiKey_Space;
+		case SDLK_TAB: return ImGuiKey_Tab;
+		case SDLK_BACKSPACE: return ImGuiKey_Backspace;
+		case SDLK_DELETE: return ImGuiKey_Delete;
+		case SDLK_HOME: return ImGuiKey_Home;
+		case SDLK_END: return ImGuiKey_End;
+		case SDLK_PAGEUP: return ImGuiKey_PageUp;
+		case SDLK_PAGEDOWN: return ImGuiKey_PageDown;
+		default: return ImGuiKey_None;
+	}
+}
+
+ImGuiKey PadButtonToImGui(int button) {
+	switch (button) {
+		case SDL_CONTROLLER_BUTTON_A: return ImGuiKey_GamepadFaceDown;
+		case SDL_CONTROLLER_BUTTON_B: return ImGuiKey_GamepadFaceRight;
+		case SDL_CONTROLLER_BUTTON_X: return ImGuiKey_GamepadFaceLeft;
+		case SDL_CONTROLLER_BUTTON_Y: return ImGuiKey_GamepadFaceUp;
+		case SDL_CONTROLLER_BUTTON_DPAD_LEFT: return ImGuiKey_GamepadDpadLeft;
+		case SDL_CONTROLLER_BUTTON_DPAD_RIGHT: return ImGuiKey_GamepadDpadRight;
+		case SDL_CONTROLLER_BUTTON_DPAD_UP: return ImGuiKey_GamepadDpadUp;
+		case SDL_CONTROLLER_BUTTON_DPAD_DOWN: return ImGuiKey_GamepadDpadDown;
+		case SDL_CONTROLLER_BUTTON_LEFTSHOULDER: return ImGuiKey_GamepadL1;
+		case SDL_CONTROLLER_BUTTON_RIGHTSHOULDER: return ImGuiKey_GamepadR1;
+		case SDL_CONTROLLER_BUTTON_START: return ImGuiKey_GamepadStart;
+		case SDL_CONTROLLER_BUTTON_BACK: return ImGuiKey_GamepadBack;
+		default: return ImGuiKey_None;
+	}
+}
+
+bool ReservedKey(SDL_Keycode key) {
+	return key == SDLK_ESCAPE || key == SDLK_SPACE || key == SDLK_F1 || key == SDLK_F2;
+}
+
+std::string PadAxisSourceName(int axis, int value) {
+	const bool trigger = axis == SDL_CONTROLLER_AXIS_TRIGGERLEFT || axis == SDL_CONTROLLER_AXIS_TRIGGERRIGHT;
+	std::string name = std::string("Pad:") +
+	                   SDL_GameControllerGetStringForAxis(static_cast<SDL_GameControllerAxis>(axis));
+	if (!trigger) {
+		name += value < 0 ? "-" : "+";
+	}
+	return name;
+}
+
+void Captured(const std::string& input) {
+	const int control = g_capture_control.exchange(-1);
+	if (control < 0) {
+		return;
+	}
+	std::scoped_lock lock(g_mutex);
+	g_captured_control = control;
+	g_captured_input   = input;
+	Bump();
+}
+
+PFN_vkVoidFunction LoadVulkanFunction(const char* name, void* user_data) {
+	auto& graphics = *static_cast<GraphicContext*>(user_data);
+	return graphics.instance.getProcAddr(name);
+}
+
+void CheckVulkanResult(VkResult result) {
+	EXIT_IF(result != VK_SUCCESS);
+}
+
+// --- the configuration as the overlay edits it: a list of statements -------------------------
+
+std::string_view StatementLeft(const std::string& line) {
+	const auto eq = line.find('=');
+	return eq == std::string::npos ? std::string_view(line) : std::string_view(line).substr(0, eq);
+}
+
+std::string_view StatementRight(const std::string& line) {
+	const auto eq = line.find('=');
+	return eq == std::string::npos ? std::string_view() : std::string_view(line).substr(eq + 1);
+}
+
+bool EqualNoCase(std::string_view a, std::string_view b) {
+	return a.size() == b.size() && std::equal(a.begin(), a.end(), b.begin(), [](char x, char y) {
+		       return std::tolower(static_cast<unsigned char>(x)) == std::tolower(static_cast<unsigned char>(y));
+	       });
+}
+
+struct Draft {
+	std::vector<std::string> lines;
+
+	[[nodiscard]] std::string InputOf(const std::string& control) const {
+		std::string found;
+		for (const auto& l: lines) {
+			if (StatementLeft(l) == control) {
+				found = std::string(StatementRight(l));
+			}
+		}
+		return found;
+	}
+
+	void SetControl(const std::string& control, const std::string& input) {
+		lines.erase(std::remove_if(lines.begin(), lines.end(),
+		                           [&](const std::string& l) { return StatementLeft(l) == control; }),
+		            lines.end());
+		if (!input.empty()) {
+			lines.push_back(control + "=" + input);
+		}
+	}
+
+	[[nodiscard]] bool PadDisabled(const std::string& pad_name) const {
+		return std::any_of(lines.begin(), lines.end(), [&](const std::string& l) {
+			return StatementLeft(l) == pad_name && EqualNoCase(StatementRight(l), "none");
+		});
+	}
+
+	void SetPadDisabled(const std::string& pad_name, bool disabled) {
+		lines.erase(std::remove_if(lines.begin(), lines.end(),
+		                           [&](const std::string& l) {
+			                           return StatementLeft(l) == pad_name && EqualNoCase(StatementRight(l), "none");
+		                           }),
+		            lines.end());
+		if (disabled) {
+			lines.insert(lines.begin(), pad_name + "=none");
+		}
+	}
+
+	[[nodiscard]] bool DefaultKeys() const {
+		bool on = true;
+		for (const auto& l: lines) {
+			if (EqualNoCase(StatementLeft(l), "DefaultKeys")) {
+				on = EqualNoCase(StatementRight(l), "on") || EqualNoCase(StatementRight(l), "true") ||
+				     StatementRight(l) == "1";
+			}
+		}
+		return on;
+	}
+
+	void SetDefaultKeys(bool on) {
+		lines.erase(std::remove_if(lines.begin(), lines.end(),
+		                           [&](const std::string& l) { return EqualNoCase(StatementLeft(l), "DefaultKeys"); }),
+		            lines.end());
+		if (!on) {
+			lines.insert(lines.begin(), "DefaultKeys=off");
+		}
+	}
+};
+
+} // namespace
+
+// --- window-thread side -----------------------------------------------------------------------
+
+void SettingsOverlayToggle() {
+	const bool now_active = !g_active.load(std::memory_order_acquire);
+	g_active.store(now_active, std::memory_order_release);
+	g_capture_control.store(-1);
+	{
+		std::scoped_lock lock(g_mutex);
+		g_events.clear();
+		g_reset_input = true;
+	}
+	if (now_active) {
+		HostInputReleaseAll();
+	}
+	Bump();
+}
+
+bool SettingsOverlayActive() noexcept {
+	return g_active.load(std::memory_order_acquire);
+}
+
+uint64_t SettingsOverlayRevision() noexcept {
+	return g_revision.load(std::memory_order_acquire);
+}
+
+bool ProcessSettingsInput(const SDL_Event& event) {
+	if (!g_active.load(std::memory_order_acquire)) {
+		return false;
+	}
+	const bool capturing = g_capture_control.load() >= 0;
+	switch (event.type) {
+		case SDL_KEYDOWN:
+		case SDL_KEYUP: {
+			const bool down = event.type == SDL_KEYDOWN;
+			const auto key  = event.key.keysym.sym;
+			if (down && !event.key.repeat && key == SDLK_F2) {
+				SettingsOverlayToggle();
+				return true;
+			}
+			if (capturing) {
+				if (down && key == SDLK_ESCAPE) {
+					g_capture_control.store(-1);
+					Bump();
+				} else if (down && !ReservedKey(key)) {
+					Captured(SDL_GetKeyName(key));
+				}
+				return true;
+			}
+			if (down && !event.key.repeat && key == SDLK_ESCAPE) {
+				SettingsOverlayToggle();
+				return true;
+			}
+			const ImGuiKey imgui_key = KeyToImGui(key);
+			if (imgui_key != ImGuiKey_None) {
+				QueueInput({InputKind::Key, static_cast<int>(imgui_key), down ? 1.0f : 0.0f, 0.0f});
+				Bump();
+			}
+			return true;
+		}
+		case SDL_TEXTINPUT:
+		case SDL_TEXTEDITING: return true;
+		case SDL_MOUSEMOTION:
+			QueueInput({InputKind::MousePosition, 0, static_cast<float>(event.motion.x),
+			            static_cast<float>(event.motion.y)});
+			Bump();
+			return true;
+		case SDL_MOUSEBUTTONDOWN:
+		case SDL_MOUSEBUTTONUP: {
+			const bool down = event.type == SDL_MOUSEBUTTONDOWN;
+			if (capturing) {
+				if (down) {
+					const char* name = event.button.button == SDL_BUTTON_LEFT     ? "Mouse:Left"
+					                   : event.button.button == SDL_BUTTON_MIDDLE ? "Mouse:Middle"
+					                   : event.button.button == SDL_BUTTON_RIGHT  ? "Mouse:Right"
+					                   : event.button.button == SDL_BUTTON_X1     ? "Mouse:X1"
+					                   : event.button.button == SDL_BUTTON_X2     ? "Mouse:X2"
+					                                                              : nullptr;
+					if (name != nullptr) {
+						Captured(name);
+					}
+				}
+				return true;
+			}
+			QueueInput({InputKind::MouseButton, event.button.button, down ? 1.0f : 0.0f, 0.0f});
+			Bump();
+			return true;
+		}
+		case SDL_MOUSEWHEEL:
+			QueueInput({InputKind::MouseWheel, 0, static_cast<float>(event.wheel.x),
+			            static_cast<float>(event.wheel.y)});
+			Bump();
+			return true;
+		case SDL_CONTROLLERBUTTONDOWN:
+		case SDL_CONTROLLERBUTTONUP: {
+			const bool down = event.type == SDL_CONTROLLERBUTTONDOWN;
+			if (capturing) {
+				if (down) {
+					Captured(std::string("Pad:") + SDL_GameControllerGetStringForButton(
+					                                   static_cast<SDL_GameControllerButton>(event.cbutton.button)));
+				}
+				return true;
+			}
+			QueueInput({InputKind::PadButton, event.cbutton.button, down ? 1.0f : 0.0f, 0.0f});
+			Bump();
+			return true;
+		}
+		case SDL_CONTROLLERAXISMOTION: {
+			const int value = event.caxis.value;
+			if (capturing) {
+				if (value > 16384 || value < -16384) {
+					Captured(PadAxisSourceName(event.caxis.axis, value));
+				}
+				return true;
+			}
+			QueueInput({InputKind::PadAxis, event.caxis.axis, static_cast<float>(value), 0.0f});
+			return true;
+		}
+		default:
+			// Window, display and device events go on to the game as usual.
+			return false;
+	}
+}
+
+// --- presenter-thread side --------------------------------------------------------------------
+
+struct SettingsOverlay::Impl {
+	explicit Impl(GraphicContext& context): graphics(context), controls(HostInputControlNames()) {}
+
+	~Impl() {
+		ReleaseVulkan();
+		if (imgui_context != nullptr) {
+			ImGui::DestroyContext(imgui_context);
+		}
+	}
+
+	void EnsureContext() {
+		if (imgui_context != nullptr) {
+			ImGui::SetCurrentContext(imgui_context);
+			return;
+		}
+		IMGUI_CHECKVERSION();
+		imgui_context = ImGui::CreateContext();
+		ImGui::SetCurrentContext(imgui_context);
+		auto& io       = ImGui::GetIO();
+		io.IniFilename = nullptr;
+		io.LogFilename = nullptr;
+		io.ConfigFlags |= ImGuiConfigFlags_NavEnableKeyboard | ImGuiConfigFlags_NavEnableGamepad;
+		io.BackendFlags |= ImGuiBackendFlags_HasGamepad;
+		io.BackendPlatformName = "BC5 settings overlay";
+		ImGui::StyleColorsDark();
+		auto& style          = ImGui::GetStyle();
+		style.WindowRounding = 8.0f;
+		style.FrameRounding  = 4.0f;
+		style.ItemSpacing    = {8.0f, 6.0f};
+	}
+
+	void EnsureVulkan(vk::Format format, uint32_t image_count) {
+		EnsureContext();
+		if (vulkan_initialized) {
+			return;
+		}
+		EXIT_IF(image_count < 2);
+		EXIT_IF(!ImGui_ImplVulkan_LoadFunctions(VK_API_VERSION_1_3, LoadVulkanFunction, &graphics));
+
+		const VkFormat            color_format = static_cast<VkFormat>(format);
+		ImGui_ImplVulkan_InitInfo info {};
+		info.ApiVersion                   = VK_API_VERSION_1_3;
+		info.Instance                     = static_cast<VkInstance>(graphics.instance);
+		info.PhysicalDevice               = static_cast<VkPhysicalDevice>(graphics.physical_device);
+		info.Device                       = static_cast<VkDevice>(graphics.device);
+		info.QueueFamily                  = graphics.queue_family;
+		info.Queue                        = static_cast<VkQueue>(graphics.queue);
+		info.DescriptorPoolSize           = IMGUI_IMPL_VULKAN_MINIMUM_SAMPLED_IMAGE_POOL_SIZE;
+		info.MinImageCount                = image_count;
+		info.ImageCount                   = image_count;
+		info.UseDynamicRendering          = true;
+		info.PipelineInfoMain.MSAASamples = VK_SAMPLE_COUNT_1_BIT;
+		info.PipelineInfoMain.PipelineRenderingCreateInfo.sType =
+		    VK_STRUCTURE_TYPE_PIPELINE_RENDERING_CREATE_INFO;
+		info.PipelineInfoMain.PipelineRenderingCreateInfo.colorAttachmentCount    = 1;
+		info.PipelineInfoMain.PipelineRenderingCreateInfo.pColorAttachmentFormats = &color_format;
+		info.CheckVkResultFn = CheckVulkanResult;
+		EXIT_IF(!ImGui_ImplVulkan_Init(&info));
+		vulkan_initialized = true;
+	}
+
+	void DrainInput() {
+		std::deque<InputEvent> events;
+		bool                   reset = false;
+		{
+			std::scoped_lock lock(g_mutex);
+			events.swap(g_events);
+			reset         = g_reset_input;
+			g_reset_input = false;
+		}
+		auto& io = ImGui::GetIO();
+		if (reset) {
+			io.ClearEventsQueue();
+			io.ClearInputKeys();
+			io.ClearInputMouse();
+		}
+		for (const auto& event: events) {
+			switch (event.kind) {
+				case InputKind::Key: io.AddKeyEvent(static_cast<ImGuiKey>(event.id), event.x != 0.0f); break;
+				case InputKind::MousePosition: io.AddMousePosEvent(event.x, event.y); break;
+				case InputKind::MouseButton: {
+					const int button = event.id == SDL_BUTTON_LEFT     ? 0
+					                   : event.id == SDL_BUTTON_RIGHT  ? 1
+					                   : event.id == SDL_BUTTON_MIDDLE ? 2
+					                                                   : -1;
+					if (button >= 0) {
+						io.AddMouseButtonEvent(button, event.x != 0.0f);
+					}
+					break;
+				}
+				case InputKind::MouseWheel: io.AddMouseWheelEvent(event.x, event.y); break;
+				case InputKind::PadButton: {
+					const ImGuiKey key = PadButtonToImGui(event.id);
+					if (key != ImGuiKey_None) {
+						io.AddKeyEvent(key, event.x != 0.0f);
+					}
+					break;
+				}
+				case InputKind::PadAxis: {
+					const float value = event.x / (event.x < 0.0f ? 32768.0f : 32767.0f);
+					if (event.id == SDL_CONTROLLER_AXIS_LEFTX) {
+						io.AddKeyAnalogEvent(ImGuiKey_GamepadLStickLeft, value < -0.25f, std::max(-value, 0.0f));
+						io.AddKeyAnalogEvent(ImGuiKey_GamepadLStickRight, value > 0.25f, std::max(value, 0.0f));
+					} else if (event.id == SDL_CONTROLLER_AXIS_LEFTY) {
+						io.AddKeyAnalogEvent(ImGuiKey_GamepadLStickUp, value < -0.25f, std::max(-value, 0.0f));
+						io.AddKeyAnalogEvent(ImGuiKey_GamepadLStickDown, value > 0.25f, std::max(value, 0.0f));
+					}
+					break;
+				}
+			}
+		}
+	}
+
+	void TakeCapture() {
+		std::scoped_lock lock(g_mutex);
+		if (g_captured_control >= 0 && g_captured_control < static_cast<int>(controls.size())) {
+			draft.SetControl(controls[g_captured_control], g_captured_input);
+			dirty  = true;
+			status = controls[g_captured_control] + " = " + g_captured_input;
+		}
+		g_captured_control = -1;
+	}
+
+	void LoadDraft() {
+		draft.lines = HostInputStatements();
+		path        = HostInputConfigPath();
+		dirty       = false;
+		status.clear();
+	}
+
+	void Draw(vk::Extent2D extent) {
+		const float scale = std::clamp(static_cast<float>(extent.height) / 720.0f, 1.0f, 3.0f);
+		ImGui::GetIO().FontGlobalScale = scale;
+		const ImVec2 size {std::min(static_cast<float>(extent.width) * 0.9f, 760.0f * scale),
+		                   std::min(static_cast<float>(extent.height) * 0.92f, 640.0f * scale)};
+		ImGui::SetNextWindowPos({(static_cast<float>(extent.width) - size.x) * 0.5f,
+		                         (static_cast<float>(extent.height) - size.y) * 0.5f});
+		ImGui::SetNextWindowSize(size);
+		ImGui::SetNextWindowBgAlpha(0.94f);
+		ImGui::Begin("BC5 settings", nullptr,
+		             ImGuiWindowFlags_NoCollapse | ImGuiWindowFlags_NoResize | ImGuiWindowFlags_NoMove |
+		                 ImGuiWindowFlags_NoSavedSettings);
+
+		ImGui::TextWrapped("F2 or Escape closes. Bind: press the key, mouse button or pad input you want "
+		                   "(Escape cancels). Apply makes it live; Save writes the file and applies.");
+		if (path.empty()) {
+			ImGui::TextWrapped("No configuration file: start the emulator with --input-config <file> or "
+			                   "KYTY_BC5_INPUT_CONFIG=<file> to be able to save.");
+		} else {
+			ImGui::TextWrapped("File: %s", path.c_str());
+		}
+		ImGui::Separator();
+
+		if (ImGui::BeginTabBar("tabs")) {
+			if (ImGui::BeginTabItem("Pad")) {
+				bool default_keys = draft.DefaultKeys();
+				if (ImGui::Checkbox("Built-in keyboard layout (arrows, J I K L, Q E U O, Enter, W A S D, T F G H)",
+				                    &default_keys)) {
+					draft.SetDefaultKeys(default_keys);
+					dirty = true;
+				}
+				const int capturing = g_capture_control.load();
+				ImGui::BeginChild("controls", {0.0f, -ImGui::GetFrameHeightWithSpacing() * 3.0f}, true);
+				if (ImGui::BeginTable("bindings", 3,
+				                      ImGuiTableFlags_RowBg | ImGuiTableFlags_SizingStretchProp)) {
+					ImGui::TableSetupColumn("Control", ImGuiTableColumnFlags_WidthStretch, 1.4f);
+					ImGui::TableSetupColumn("Host input", ImGuiTableColumnFlags_WidthStretch, 2.0f);
+					ImGui::TableSetupColumn("", ImGuiTableColumnFlags_WidthStretch, 1.6f);
+					ImGui::TableHeadersRow();
+					for (int i = 0; i < static_cast<int>(controls.size()); i++) {
+						ImGui::TableNextRow();
+						ImGui::TableSetColumnIndex(0);
+						ImGui::TextUnformatted(controls[i].c_str());
+						ImGui::TableSetColumnIndex(1);
+						const std::string input = draft.InputOf(controls[i]);
+						if (capturing == i) {
+							ImGui::TextColored({1.0f, 0.8f, 0.2f, 1.0f}, "press an input...");
+						} else if (input.empty()) {
+							ImGui::TextDisabled("(pad, built-in key)");
+						} else {
+							ImGui::TextUnformatted(input.c_str());
+						}
+						ImGui::TableSetColumnIndex(2);
+						ImGui::PushID(i);
+						if (ImGui::SmallButton("Bind")) {
+							g_capture_control.store(i);
+						}
+						ImGui::SameLine();
+						if (ImGui::SmallButton("Clear")) {
+							draft.SetControl(controls[i], "");
+							dirty = true;
+						}
+						ImGui::SameLine();
+						if (ImGui::SmallButton("None")) {
+							draft.SetControl(controls[i], "none");
+							dirty = true;
+						}
+						ImGui::PopID();
+					}
+					ImGui::EndTable();
+				}
+				if (ImGui::CollapsingHeader("Pad inputs to ignore (a stuck trigger, say)")) {
+					ImGui::Columns(3, nullptr, false);
+					for (int b = 0; b < SDL_CONTROLLER_BUTTON_MAX; b++) {
+						const std::string name =
+						    std::string("Pad:") + SDL_GameControllerGetStringForButton(static_cast<SDL_GameControllerButton>(b));
+						bool off = draft.PadDisabled(name);
+						if (ImGui::Checkbox(name.c_str(), &off)) {
+							draft.SetPadDisabled(name, off);
+							dirty = true;
+						}
+						ImGui::NextColumn();
+					}
+					for (int a = 0; a < SDL_CONTROLLER_AXIS_MAX; a++) {
+						const std::string name =
+						    std::string("Pad:") + SDL_GameControllerGetStringForAxis(static_cast<SDL_GameControllerAxis>(a));
+						bool off = draft.PadDisabled(name);
+						if (ImGui::Checkbox(name.c_str(), &off)) {
+							draft.SetPadDisabled(name, off);
+							dirty = true;
+						}
+						ImGui::NextColumn();
+					}
+					ImGui::Columns(1);
+				}
+				ImGui::EndChild();
+
+				if (ImGui::Button("Apply")) {
+					std::string error;
+					status = HostInputApply(draft.lines, &error) ? "applied" : "not applied: " + error;
+				}
+				ImGui::SameLine();
+				ImGui::BeginDisabled(path.empty());
+				if (ImGui::Button("Save")) {
+					std::string error;
+					if (!HostInputSave(path, draft.lines, &error)) {
+						status = "not saved: " + error;
+					} else if (!HostInputApply(draft.lines, &error)) {
+						status = "saved, not applied: " + error;
+					} else {
+						status = "saved and applied";
+						dirty  = false;
+					}
+				}
+				ImGui::EndDisabled();
+				ImGui::SameLine();
+				if (ImGui::Button("Revert")) {
+					LoadDraft();
+					status = "reverted to the live configuration";
+				}
+				ImGui::SameLine();
+				if (ImGui::Button("Close")) {
+					SettingsOverlayToggle();
+				}
+				if (dirty) {
+					ImGui::SameLine();
+					ImGui::TextDisabled("(unapplied changes)");
+				}
+				ImGui::TextUnformatted(status.c_str());
+				ImGui::EndTabItem();
+			}
+			ImGui::EndTabBar();
+		}
+		ImGui::End();
+	}
+
+	bool PrepareFrame(vk::Extent2D frame_extent, vk::Format format, uint32_t image_count) {
+		if (!g_active.load(std::memory_order_acquire)) {
+			was_active = false;
+			return false;
+		}
+		EnsureVulkan(format, image_count);
+		if (!was_active) {
+			was_active = true;
+			LoadDraft();
+			auto& io = ImGui::GetIO();
+			io.ClearEventsQueue();
+			io.ClearInputKeys();
+			io.ClearInputMouse();
+		}
+		DrainInput();
+		TakeCapture();
+
+		auto& io       = ImGui::GetIO();
+		io.DisplaySize = {static_cast<float>(frame_extent.width), static_cast<float>(frame_extent.height)};
+		const auto now = std::chrono::steady_clock::now();
+		io.DeltaTime   = last_frame == std::chrono::steady_clock::time_point {}
+		                     ? 1.0f / 60.0f
+		                     : std::clamp(std::chrono::duration<float>(now - last_frame).count(), 1.0f / 1000.0f, 0.1f);
+		last_frame     = now;
+		ImGui_ImplVulkan_NewFrame();
+		ImGui::NewFrame();
+		Draw(frame_extent);
+		ImGui::Render();
+		extent = frame_extent;
+		return true;
+	}
+
+	void Record(vk::CommandBuffer command, vk::ImageView target) {
+		vk::RenderingAttachmentInfo color {};
+		color.sType       = vk::StructureType::eRenderingAttachmentInfo;
+		color.imageView   = target;
+		color.imageLayout = vk::ImageLayout::eColorAttachmentOptimal;
+		color.loadOp      = vk::AttachmentLoadOp::eLoad;
+		color.storeOp     = vk::AttachmentStoreOp::eStore;
+		vk::RenderingInfo rendering {};
+		rendering.sType                = vk::StructureType::eRenderingInfo;
+		rendering.renderArea.extent    = extent;
+		rendering.layerCount           = 1;
+		rendering.colorAttachmentCount = 1;
+		rendering.pColorAttachments    = &color;
+		command.beginRendering(rendering);
+		{
+			Common::LockGuard queue_lock(graphics.queue_mutex);
+			ImGui_ImplVulkan_RenderDrawData(ImGui::GetDrawData(), static_cast<VkCommandBuffer>(command));
+		}
+		command.endRendering();
+	}
+
+	void ReleaseVulkan() {
+		if (!vulkan_initialized) {
+			return;
+		}
+		ImGui::SetCurrentContext(imgui_context);
+		ImGui_ImplVulkan_Shutdown();
+		vulkan_initialized = false;
+	}
+
+	GraphicContext&                       graphics;
+	std::vector<std::string>              controls;
+	Draft                                 draft;
+	std::string                           path;
+	std::string                           status;
+	bool                                  dirty              = false;
+	bool                                  was_active         = false;
+	ImGuiContext*                         imgui_context      = nullptr;
+	bool                                  vulkan_initialized = false;
+	vk::Extent2D                          extent {};
+	std::chrono::steady_clock::time_point last_frame;
+};
+
+SettingsOverlay::SettingsOverlay(GraphicContext& graphics): m_impl(std::make_unique<Impl>(graphics)) {}
+
+SettingsOverlay::~SettingsOverlay() = default;
+
+bool SettingsOverlay::PrepareFrame(vk::Extent2D extent, vk::Format format, uint32_t image_count) {
+	return m_impl->PrepareFrame(extent, format, image_count);
+}
+
+void SettingsOverlay::Record(vk::CommandBuffer command, vk::ImageView target) {
+	m_impl->Record(command, target);
+}
+
+void SettingsOverlay::ReleaseVulkan() {
+	m_impl->ReleaseVulkan();
+}
