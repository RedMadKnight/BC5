+		while ((eol = partial.find('\n')) != std::string::npos) {
+			const std::string line = partial.substr(0, eol);
+			partial.erase(0, eol + 1);
+			char a[32] = {}, b[32] = {};
+			int  x = -1, y = -1, t = -1;
+			const int n = std::sscanf(line.c_str(), "%31s %31s %d %d %d", a, b, &x, &y, &t);
+			const std::string cmd = a, arg = b;
+			if (n >= 2 && cmd == "press" && Bc5ButtonByName(arg) != 0) {
+				ControllerButton(-1000, Bc5ButtonByName(arg), true);
+				ms(n >= 3 && x > 0 ? x : 150);
+				ControllerButton(-1000, Bc5ButtonByName(arg), false);
+			} else if (n >= 2 && cmd == "hold" && Bc5ButtonByName(arg) != 0) {
+				held |= Bc5ButtonByName(arg);
+				ControllerButton(-1000, Bc5ButtonByName(arg), true);
+			} else if (n >= 2 && cmd == "release" && Bc5ButtonByName(arg) != 0) {
+				held &= ~Bc5ButtonByName(arg);
+				ControllerButton(-1000, Bc5ButtonByName(arg), false);
+			} else if (n >= 4 && cmd == "stick" && (arg == "l" || arg == "r")) {
+				const Axis ax = arg == "l" ? Axis::LeftX : Axis::RightX;
+				const Axis ay = arg == "l" ? Axis::LeftY : Axis::RightY;
+				ControllerAxis(-1000, ax, std::clamp(x, 0, 255));
+				ControllerAxis(-1000, ay, std::clamp(y, 0, 255));
+				if (n >= 5 && t > 0) {
+					ms(t);
+					ControllerAxis(-1000, ax, 128);
+					ControllerAxis(-1000, ay, 128);
+				}
+			} else if (n >= 3 && cmd == "trigger" && (arg == "l2" || arg == "r2")) {
+				const Axis at = arg == "l2" ? Axis::TriggerLeft : Axis::TriggerRight;
+				ControllerAxis(-1000, at, std::clamp(x, 0, 255));
+				if (n >= 4 && y > 0) {
+					ms(y);
+					ControllerAxis(-1000, at, 0);
+				}
+			} else if (n >= 1 && cmd == "shake") {
+				for (int k = 0; k < 40; k++) {
+					const float acc[3] = {(k & 1) != 0 ? 3.0f : -3.0f, 1.0f, (k & 1) != 0 ? -2.0f : 2.0f};
+					const float w[3]   = {(k & 1) != 0 ? 8.0f : -8.0f, 0.0f, 0.0f};
+					ControllerMotion(-1000, false, acc);
+					ControllerMotion(-1000, true, w);
+					ms(50);
+				}
+				const float rest[3] = {0.0f, 1.0f, 0.0f}, still[3] = {0.0f, 0.0f, 0.0f};
+				ControllerMotion(-1000, false, rest);
+				ControllerMotion(-1000, true, still);
+			} else if (n >= 1 && (cmd == "pause" || cmd == "resume")) { // BC5 (experiment 0166): the window's pause from a script
+				Graphics::WindowSetPaused(cmd == "pause");
