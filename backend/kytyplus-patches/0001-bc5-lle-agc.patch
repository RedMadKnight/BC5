+// Experiment 0135: speculative graphics waits and their watchdog.
+static uint64_t spec_wait_ns() {
+	static const uint64_t v = (std::getenv("BC5_DIRECT_SPEC_WAIT_MS") ? std::strtoull(std::getenv("BC5_DIRECT_SPEC_WAIT_MS"), nullptr, 10) : 0ull) * 1'000'000ull;
