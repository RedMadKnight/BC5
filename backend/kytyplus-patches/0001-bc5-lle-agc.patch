+// AnyPS5 :73-77.
+static int32_t Bc5UsbGuestError(int result) {
+	if (result >= 0) {
+		return result;
+	}
+	if (result == BC5_LIBUSB_ERROR_OTHER) {
+		return static_cast<int32_t>(0x802400FFu);
+	}
+	return static_cast<int32_t>(0x80240000u - static_cast<uint32_t>(result));
+}
