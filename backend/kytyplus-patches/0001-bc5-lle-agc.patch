+static void Bc5RecAxis(int id, Axis axis, int value) {
+	if (id == -1000 || Bc5RecFile() == nullptr) return;
+	static int  cur[6] = {128, 128, 128, 128, 0, 0}, written[6] = {128, 128, 128, 128, 0, 0};
+	static auto last_write = std::chrono::steady_clock::now();
