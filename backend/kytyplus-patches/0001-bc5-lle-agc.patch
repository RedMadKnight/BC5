+			if (!t.used) {
+				t = cn;
+				return Id::Create(index, Id::Type::Request);
+			}
+			index++;
+		}
+
+		if (index < Id::MAX_ID) {
+			m_requests.push_back(cn);
+			return Id::Create(index, Id::Type::Request);
+		}
+	}
+
+	return Id::Invalid();
