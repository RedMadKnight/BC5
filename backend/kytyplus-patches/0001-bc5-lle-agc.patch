+	if (a < 0 || a >= 6) return;
+	std::lock_guard lock(g_rec_mutex);
+	cur[a] = value;
+	if (std::abs(cur[a] - written[a]) <= 6 && !(value == 128 && a < 4 && written[a] != 128) && !(value == 0 && a >= 4 && written[a] != 0)) return;
