+// BC5: KYTY_BC5_INPUT_RECORD=<file> writes what the real pad does as KYTY_BC5_INPUT_CMD lines
+// (hold/release, stick, trigger, with wait lines between them), so that a route played once by
+// hand can be replayed by a script. Stick moves are written at most every 30 ms, when one axis
+// moved by more than 6. The scripted input itself (id -1000) is not recorded.
+static std::mutex g_rec_mutex;
+static FILE*      Bc5RecFile() {
+	static FILE* f = [] {
+		const char* path = BC5_DIAG_ENV("KYTY_BC5_INPUT_RECORD");
+		return (path != nullptr && *path != 0) ? std::fopen(path, "w") : nullptr;
+	}();
+	return f;
+}
+static void Bc5RecLine(const char* line) { // the caller holds g_rec_mutex
+	static auto last = std::chrono::steady_clock::now();
+	static bool first = true;
+	const auto  now   = std::chrono::steady_clock::now();
+	const auto  ms    = std::chrono::duration_cast<std::chrono::milliseconds>(now - last).count();
+	FILE*       f     = Bc5RecFile();
+	if (!first && ms > 0) std::fprintf(f, "wait %lld\n", static_cast<long long>(ms));
+	first = false;
+	last  = now;
+	std::fprintf(f, "%s\n", line);
+	std::fflush(f);
+}
+static void Bc5RecButton(int id, uint32_t button, bool down) {
+	if (id == -1000 || Bc5RecFile() == nullptr) return;
+	static const std::pair<const char*, uint32_t> names[] = {
+	    {"cross", PAD_BUTTON_CROSS}, {"circle", PAD_BUTTON_CIRCLE}, {"square", PAD_BUTTON_SQUARE},
+	    {"triangle", PAD_BUTTON_TRIANGLE}, {"options", PAD_BUTTON_OPTIONS}, {"up", PAD_BUTTON_UP},
+	    {"down", PAD_BUTTON_DOWN}, {"left", PAD_BUTTON_LEFT}, {"right", PAD_BUTTON_RIGHT},
+	    {"l1", PAD_BUTTON_L1}, {"r1", PAD_BUTTON_R1}, {"l2", PAD_BUTTON_L2}, {"r2", PAD_BUTTON_R2},
+	    {"l3", PAD_BUTTON_L3}, {"r3", PAD_BUTTON_R3}, {"touchpad", PAD_BUTTON_TOUCH_PAD}};
+	std::lock_guard lock(g_rec_mutex);
+	for (const auto& [name, bit]: names) {
+		if ((button & bit) == 0) continue;
+		char line[64];
+		std::snprintf(line, sizeof(line), "%s %s", down ? "hold" : "release", name);
+		Bc5RecLine(line);
+	}
+}
+static void Bc5RecAxis(int id, Axis axis, int value) {
+	if (id == -1000 || Bc5RecFile() == nullptr) return;
+	static int  cur[6] = {128, 128, 128, 128, 0, 0}, written[6] = {128, 128, 128, 128, 0, 0};
+	static auto last_write = std::chrono::steady_clock::now();
+	const int   a          = static_cast<int>(axis);
+	if (a < 0 || a >= 6) return;
+	std::lock_guard lock(g_rec_mutex);
+	cur[a] = value;
+	if (std::abs(cur[a] - written[a]) <= 6 && !(value == 128 && a < 4 && written[a] != 128) && !(value == 0 && a >= 4 && written[a] != 0)) return;
+	const auto now = std::chrono::steady_clock::now();
+	const bool settle = (a < 4 && value == 128) || (a >= 4 && value == 0); // a stick back to rest is never dropped
+	if (!settle && now - last_write < std::chrono::milliseconds(30)) return;
+	last_write = now;
+	char line[64];
+	if (a < 4) {
+		const int sx = a < 2 ? 0 : 2;
+		std::snprintf(line, sizeof(line), "stick %s %d %d", a < 2 ? "l" : "r", cur[sx], cur[sx + 1]);
+		written[sx]     = cur[sx];
+		written[sx + 1] = cur[sx + 1];
+	} else {
+		std::snprintf(line, sizeof(line), "trigger %s %d", a == 4 ? "l2" : "r2", cur[a]);
+		written[a] = cur[a];
+	}
+	Bc5RecLine(line);
+}
+
+void ControllerButton(int id, uint32_t button, bool down) {
+	EXIT_IF(g_controller == nullptr);
+	Bc5RecButton(id, button, down);
+	g_controller->Button(id, button, down);
+}
+
+void ControllerAxis(int id, Axis axis, int value) {
+	EXIT_IF(g_controller == nullptr);
+	Bc5RecAxis(id, axis, value);
+	g_controller->Axis(id, axis, value);
+}
