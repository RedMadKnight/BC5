-			if (it->frame != nullptr) {
-				frames.push_back(it->frame);
-			}
-			it = queue->erase(it);
-		}
-	}
-	m_done_cond_var.SignalAll();
-	m_submit_slot_cond_var.SignalAll();
-	m_submit_cond_var.SignalAll();
-	m_mutex.Unlock();
-	for (auto* frame: frames) {
