+	}
+	if (bc5_events_lock.owns_lock() && bc5_savedata_event_cb_on()) { // experiment 0401 series e4 (switch on): then to the registered callback (series e5: not for the "lock" item alone)
+		bc5_events_lock.unlock();
+		bc5_deliver_event(event);
+	}
