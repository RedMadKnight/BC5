+// BC5 (experiment 0359): the job-arena fix, a TEMPORARY game-code workaround for the second title. What and why:
+// bc5/job_arena_fix.hpp. The hook replaces the owner's help call `call [r15+0x80]` (eboot.bin+0x3cca87b) and
+// wraps the title's own call in the title's own override window: the special index into the thread's worker slot
+// and a stack arena, built as the title builds it, into image+0xb064018; both restored after. To be REMOVED once
+// the host's throughput at the fight is fixed (docs/HANDOFF.md Q24).
+extern "C" uint8_t* bc5_tls_main_tcb(); // loader/runtimeLinker.cpp: the current thread's tcb of the main program
+static uint64_t              g_bc5_jaf_base = 0;
+static std::atomic<uint64_t> g_bc5_jaf_calls {0};
+static std::atomic<uint64_t> g_bc5_jaf_wrapped {0};
+using bc5_guest_block_fn = void (KYTY_SYSV_ABI*)(void* job, void* block, uint64_t size, uint32_t n1);
+extern "C" KYTY_SYSV_ABI void bc5_job_arena_owner_help(void* job, void* block, uint64_t size, uint32_t n1) {
+	using namespace bc5::job_arena_fix;
+	const uint64_t base = g_bc5_jaf_base;
+	const auto     fn   = *reinterpret_cast<const bc5_guest_block_fn*>(static_cast<uint8_t*>(job) + 0x80);
+	uint8_t*       tcb  = bc5_tls_main_tcb();
+	auto*          index = reinterpret_cast<int32_t*>(tcb + kIndexSlotFromTcb);
+	auto*          slot  = reinterpret_cast<uint64_t*>(base + kOverrideArenaOffset);
+	const int32_t  old_index = *index;
+	const uint64_t old_slot  = *slot;
+	const bool     wrap      = wrap_needed(old_index);
+	alignas(16) OverrideArena arena {};
+	if (wrap) {
+		build_arena(&arena, reinterpret_cast<uint64_t>(block), static_cast<uint32_t>(size), reinterpret_cast<const uint8_t*>(base + kArenaConstsOffset),
+		            base + kArenaTailOffset);
+		*slot  = reinterpret_cast<uint64_t>(&arena);
+		*index = *reinterpret_cast<const int32_t*>(base + kSpecialIndexOffset);
+	}
+	const uint64_t n = g_bc5_jaf_calls.fetch_add(1, std::memory_order_relaxed) + 1;
+	const uint64_t w = wrap ? g_bc5_jaf_wrapped.fetch_add(1, std::memory_order_relaxed) + 1 : g_bc5_jaf_wrapped.load(std::memory_order_relaxed);
+	if (n == 1 || n % 1000 == 0) {
+		std::fprintf(stderr, "game fix: job-arena hook call %" PRIu64 " (%" PRIu64 " wrapped), thread index %d%s\n", n, w, old_index, wrap ? " -> the window" : "");
+	}
+	fn(job, block, size, n1);
+	if (wrap) {
+		*slot  = old_slot;
+		*index = old_index;
+	}
+}
+
+bool ApplyJobArenaFix(Program* program, int setting) {
+	using namespace bc5::job_arena_fix;
+	std::string title;
+	SystemContentParamSfoGetString("TITLE_ID", &title);
+	const bool  title_ok = Common::EqualNoCase(title, kTitleId);
+	const char* src      = setting == 1 ? "input.cfg on" : setting == 0 ? "input.cfg off" : "not set, on for that title";
+	const bool  on       = setting == 1 || (setting < 0 && title_ok);
+	std::fprintf(stderr, "game fix (temporary, exp 0359): job-arena fix %s for %s (%s)\n", on ? "ON" : "OFF", title.c_str(), src);
+	if (!on) return false;
+	if (!title_ok) {
+		std::fprintf(stderr, "game fix: not applied, the fix is for %s only\n", kTitleId);
+		return false;
+	}
+	if (program == nullptr || program->elf == nullptr || program->base_vaddr == 0) {
+		std::fprintf(stderr, "game fix: not applied, the main executable is not loaded\n");
+		return false;
+	}
+	const uint64_t base = program->base_vaddr;
+	auto*          site = reinterpret_cast<uint8_t*>(base + kSiteOffset);
+	auto*          slot = reinterpret_cast<uint8_t*>(base + kSlotOffset);
+	if (!site_matches(site) || !slot_matches(slot)) {
+		std::fprintf(stderr, "game fix: not applied, the bytes at +0x%" PRIx64 " or +0x%" PRIx64 " are not the expected ones (another build of the title?)\n", kSiteOffset, kSlotOffset);
+		return false;
+	}
+	std::array<uint8_t, 7> enc {};
+	if (!encode_site(base + kSiteOffset, base + kSlotOffset, &enc)) {
+		std::fprintf(stderr, "game fix: not applied, the slot is out of reach\n");
+		return false;
+	}
+	g_bc5_jaf_base      = base;
+	const uint64_t hook = reinterpret_cast<uint64_t>(&bc5_job_arena_owner_help);
+	std::memcpy(slot, &hook, sizeof(hook));
+	std::memcpy(site, enc.data(), enc.size());
+	if (!Common::VirtualMemory::FlushInstructionCache(reinterpret_cast<uint64_t>(site), enc.size()) ||
+	    !Common::VirtualMemory::FlushInstructionCache(reinterpret_cast<uint64_t>(slot), sizeof(hook))) {
+		std::fprintf(stderr, "game fix: the instruction cache flush failed after the write\n");
+	}
+	std::fprintf(stderr, "game fix: job-arena fix APPLIED: site +0x%" PRIx64 " -> slot +0x%" PRIx64 " -> host hook %p (temporary; input.cfg JobArenaFix.%s=off turns it off)\n",
+	             kSiteOffset, kSlotOffset, reinterpret_cast<void*>(hook), kTitleId);
+	return true;
+}
