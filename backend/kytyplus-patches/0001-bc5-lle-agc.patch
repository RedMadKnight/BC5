-		#elif KYTY_PLATFORM == KYTY_PLATFORM_LINUX
-			long pages = sysconf(_SC_PHYS_PAGES);
-			long page  = sysconf(_SC_PAGE_SIZE);
-			if (pages > 0 && page > 0) {
-				host_total = static_cast<uint64_t>(pages) * static_cast<uint64_t>(page);
-			}
