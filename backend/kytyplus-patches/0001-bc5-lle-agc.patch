diff --git a/src/bc5/job_arena_fix.hpp b/src/bc5/job_arena_fix.hpp
new file mode 100644
index 0000000..7d2c08d
--- /dev/null
+++ b/src/bc5/job_arena_fix.hpp
@@ -0,0 +1,105 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Experiment 0359: the job-arena fix for the second title (PPSA03671) — a TEMPORARY game-code workaround.
+//
+// What it is (experiments 0358, F447–F454): at the end of a frame the title's main thread ("the owner" of its job
+// system) waits for a job and, while waiting, runs pending jobs itself. One kind of job looks its per-thread frame
+// arena up by the thread's worker slots in thread-local storage; the owner is never a registered worker, so on the
+// owner that lookup yields a null arena and the job dereferences it (eboot.bin+0x3d7eca0). The title's other inline
+// path (the "override window") sets the special index and a stack arena around the call and the lookup honours
+// them; the owner's help loop does not. On the console the race is won by the workers, which take the job before
+// the owner gets to it; on this host it is lost at the fight because the box's cores are saturated (F454).
+//
+// The fix: the owner's help call `call [r15+0x80]` (eboot.bin+0x3cca87b, 7 bytes) is redirected through an 8-byte
+// slot in a padding cave (eboot.bin+0x3cca4c8, eight int3 after a __stack_chk_fail stub) to a host hook, which wraps
+// the title's own call in the title's own override window (the special index into the thread's slot, a stack arena
+// built as the title builds it into image+0xb064018) and restores both after. Nothing else of the title changes.
+//
+// It is a change to the title's code, kept behind a per-title switch (input.cfg JobArenaFix.<TITLE_ID>=on|off,
+// the Emulation menu's "Game fixes"), and is to be REMOVED once the host's throughput at the fight is fixed
+// (docs/HANDOFF.md Q24). This header holds the pure parts (constants, the encoding, the arena layout) so they can be
+// unit-tested; the host side (the hook, the writes) lives in the KytyPlus unit loader/gamePatch.cpp.
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+namespace bc5::job_arena_fix {
+
+inline constexpr const char* kTitleId = "PPSA03671";
+
+// The call site in the owner's help loop and the slot cave, as offsets from the image base.
+inline constexpr std::uint64_t kSiteOffset = 0x3cca87b;
+inline constexpr std::uint64_t kSlotOffset = 0x3cca4c8;
+// The title's globals the override window uses: the special index (N, the worker count) and the override arena.
+inline constexpr std::uint64_t kSpecialIndexOffset  = 0xb064020;
+inline constexpr std::uint64_t kOverrideArenaOffset = 0xb064018;
+// The thread-local worker index the job's arena lookup reads (an offset from the thread control block).
+inline constexpr std::int64_t kIndexSlotFromTcb = -0x104;
+// The two constants the title's override window copies into its stack arena.
+inline constexpr std::uint64_t kArenaConstsOffset = 0x77f9c30; // 16 bytes
+inline constexpr std::uint64_t kArenaTailOffset   = 0x7555574; // a pointer stored at +0x30
+
+// The minimal expected bytes: the instruction at the site and the padding at the slot.
+inline constexpr std::array<std::uint8_t, 7> kSiteExpected {0x41, 0xff, 0x97, 0x80, 0x00, 0x00, 0x00}; // call [r15+0x80]
+inline constexpr std::array<std::uint8_t, 8> kSlotExpected {0xcc, 0xcc, 0xcc, 0xcc, 0xcc, 0xcc, 0xcc, 0xcc};
+
+// The replacement at the site: call [rip+disp32] (6 bytes) through the slot, then a nop.
+inline bool encode_site(std::uint64_t site, std::uint64_t slot, std::array<std::uint8_t, 7>* out) {
+    const std::int64_t disp = static_cast<std::int64_t>(slot) - static_cast<std::int64_t>(site + 6);
+    if (disp < INT32_MIN || disp > INT32_MAX) {
+        return false;
+    }
+    const auto d = static_cast<std::uint32_t>(static_cast<std::int32_t>(disp));
+    (*out)[0] = 0xff;
+    (*out)[1] = 0x15;
+    (*out)[2] = static_cast<std::uint8_t>(d & 0xffu);
+    (*out)[3] = static_cast<std::uint8_t>((d >> 8u) & 0xffu);
+    (*out)[4] = static_cast<std::uint8_t>((d >> 16u) & 0xffu);
+    (*out)[5] = static_cast<std::uint8_t>((d >> 24u) & 0xffu);
+    (*out)[6] = 0x90;
+    return true;
+}
+
+inline bool site_matches(const std::uint8_t* site) {
+    return std::memcmp(site, kSiteExpected.data(), kSiteExpected.size()) == 0;
+}
+
+inline bool slot_matches(const std::uint8_t* slot) {
+    return std::memcmp(slot, kSlotExpected.data(), kSlotExpected.size()) == 0;
+}
+
+// The stack arena the title's override window builds (0x38 bytes): the block, its size, 16 bytes of constants,
+// a zero, 16 zero bytes, the tail pointer.
+struct OverrideArena {
+    std::uint64_t block;
+    std::uint32_t size;
+    std::uint8_t  consts[16];
+    std::uint32_t zero;
+    std::uint8_t  zeros[16];
+    std::uint64_t tail;
+};
+static_assert(sizeof(OverrideArena) == 0x38, "the override arena is 0x38 bytes");
+static_assert(offsetof(OverrideArena, size) == 0x8, "size at +0x8");
+static_assert(offsetof(OverrideArena, consts) == 0xc, "constants at +0xc");
+static_assert(offsetof(OverrideArena, zero) == 0x1c, "zero at +0x1c");
+static_assert(offsetof(OverrideArena, zeros) == 0x20, "zeros at +0x20");
+static_assert(offsetof(OverrideArena, tail) == 0x30, "tail at +0x30");
+
+inline void build_arena(OverrideArena* arena, std::uint64_t block, std::uint32_t size, const std::uint8_t* consts16,
+                        std::uint64_t tail) {
+    arena->block = block;
+    arena->size  = size;
+    std::memcpy(arena->consts, consts16, sizeof(arena->consts));
+    arena->zero = 0;
+    std::memset(arena->zeros, 0, sizeof(arena->zeros));
+    arena->tail = tail;
+}
+
+// Only a thread without a worker slot (the owner, index -1) needs the window; a registered worker keeps its own.
+inline bool wrap_needed(std::int32_t index) {
+    return index == -1;
+}
+
+} // namespace bc5::job_arena_fix
diff --git a/src/bc5/pad_audio_route.hpp b/src/bc5/pad_audio_route.hpp
new file mode 100644
index 0000000..226a60e
--- /dev/null
+++ b/src/bc5/pad_audio_route.hpp
@@ -0,0 +1,182 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Experiment 0372: where a pad port's frames may go after the DualSense is unplugged and plugged in again.
+//
+// What went wrong (2026-10-28 23:32, the second title, USB DualSense, the shared normal build): the title's pad-speaker
+// port (type 4) and its vibration port (type 10) each open an SDL device on the controller's PipeWire sink. When the
+// sink goes away, SDL 2.33.0 (KytyPlus f266548's 3rdparty/SDL2, 4b69833) stops only the FIRST open device on that node
+// (SDL_RemoveAudioDevice breaks out of its loop after one: src/audio/SDL_audio.c:522-529), and its PipeWire backend
+// reports nothing itself
+// (stream_state_changed_callback, src/audio/pipewire/SDL_pipewire.c:1129-1140). The second port's device stays
+// "playing"; its stream carries target.object but neither node.dont-reconnect nor node.dont-fallback
+// (SDL_pipewire.c:1160, 1243-1272), so WirePlumber 0.5.17 neither destroys it (linking/find-defined-target.lua:116)
+// nor keeps it from a new target (linking/prepare-link.lua:71-76): it was linked to the default sink, where the
+// haptics were heard. Before exp 0181 SDL's PulseAudio backend opened a named device with PA_STREAM_DONT_MOVE
+// (SDL_pulseaudio.c:695-699), which pipewire-pulse turns into PW_STREAM_FLAG_DONT_RECONNECT (PipeWire 1.6.9
+// module-protocol-pulse/pulse-server.c, do_create_playback_stream): by today's WirePlumber scripts the second stream
+// was then left unlinked, silent rather than on the speakers (not observed), and F94 saw only the pad-speaker port
+// reopen after the unplugs of 2026-10-09.
+//
+// The host now follows the controller's device by SDL's audio device events, counted by an event watch on the thread
+// that pushes them (SDL_PushEvent calls the watches first, src/events/SDL_events.c:1156-1176), and decides here, per
+// port and per call on the thread that writes the port, what to do with its device. This header holds that decision
+// and the PIPEWIRE_PROPS value for a pad stream, so they can be unit-tested; the host side lives in KytyPlus
+// src/libs/audio.cpp (Audio::PadRouteStep).
+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <string_view>
+
+namespace bc5::pad_audio_route {
+
+// How often a port that is on the controller, or waiting for it, looks at the device list without an event.
+inline constexpr std::uint64_t kLookPeriodMs = 1000;
+
+// SDL_AUDIODEVICEREMOVED / SDL_AUDIODEVICEADDED of output devices since the start (wrapping counters).
+struct DeviceEvents {
+    std::uint32_t removed = 0;
+    std::uint32_t added   = 0;
+};
+
+// What the port's writer does before queueing its frames.
+enum class Step : std::uint8_t {
+    Play,  // keep the device the port has (on the controller, or on the default sink) and queue on it
+    Drop,  // the port has no device now: its frames are dropped
+    Close, // close the port's device (its controller device has gone) and drop the frames
+    Open,  // open the port on the controller's device; a device still on the controller is closed first, one on
+           // the default sink only after the new one is open
+};
+
+enum class Why : std::uint8_t {
+    None,
+    DeviceRemoved, // an output device was removed since the port last looked
+    DeviceStopped, // SDL stopped the port's device (the first device on a removed node, F93)
+    NotListed,     // the once-a-second look did not find the controller's device (an event missed)
+    DeviceAdded,   // an output device was added since the port last looked
+    Retry,         // the once-a-second retry after a failed open, or while the controller is away
+};
+
+struct PortState {
+    bool          wants_pad   = false; // the port belongs on the controller (type 4 unless =main, type 10)
+    bool          on_pad      = false; // its stream is laid out for the controller (6 channels, pad_route != 0)
+    bool          has_device  = false; // an SDL device is open for it
+    bool          stopped     = false; // SDL reports that device stopped
+    bool          retry_armed = false; // look once a second without an event
+    DeviceEvents  seen {};             // the events the port has acted on
+    std::uint64_t last_look_ms = 0;    // when it last looked at the device list
+};
+
+struct Decision {
+    Step step   = Step::Play;
+    Why  why    = Why::None;
+    bool looked = false; // `present` was called
+};
+
+// The decision for one call. `present()` looks for the controller's device in SDL's list (and keeps its name); it is
+// called at most once, and only when the port has to look.
+//
+// A port whose stream is on the controller never keeps it after a removal: SDL cannot say which node went, and a
+// stream whose node went may already be on the default sink. If the controller is listed again (a replug faster than
+// the port's next write, or the removed device was another sink), the port is reopened at once, at the cost of one
+// close and open; otherwise it is closed and its frames are dropped. A port without a stream on the controller looks
+// at every device event, and once a second when it is armed; with no controller listed, a port on the default sink
+// (a DualShock 4's pad speaker, F329/F330) keeps playing there and a port without a device drops its frames.
+template <class Present>
+Decision decide(const PortState& p, DeviceEvents now, std::uint64_t now_ms, Present&& present) {
+    Decision d;
+    if (!p.wants_pad) {
+        return d;
+    }
+    const bool removed = now.removed != p.seen.removed;
+    const bool added   = now.added != p.seen.added;
+    const bool due     = now_ms - p.last_look_ms >= kLookPeriodMs;
+    if (p.on_pad && p.has_device) {
+        if (removed || p.stopped) {
+            d.why    = removed ? Why::DeviceRemoved : Why::DeviceStopped;
+            d.looked = true;
+            d.step   = present() ? Step::Open : Step::Close;
+            return d;
+        }
+        if (due) {
+            d.looked = true;
+            if (!present()) {
+                d.step = Step::Close;
+                d.why  = Why::NotListed;
+            }
+        }
+        return d;
+    }
+    if (removed || added || (p.retry_armed && due)) {
+        d.looked = true;
+        if (present()) {
+            d.step = Step::Open;
+            d.why  = removed ? Why::DeviceRemoved : added ? Why::DeviceAdded : Why::Retry;
+            return d;
+        }
+    }
+    d.step = p.has_device ? Step::Play : Step::Drop;
+    return d;
+}
+
+// The port after the step was carried out (`open_ok`: the open of Step::Open succeeded).
+inline PortState after(const PortState& p, const Decision& d, DeviceEvents now, std::uint64_t now_ms, bool open_ok) {
+    PortState n = p;
+    n.seen      = now;
+    if (d.looked) {
+        n.last_look_ms = now_ms;
+    }
+    switch (d.step) {
+    case Step::Play:
+    case Step::Drop:
+        // A port that was never on the controller stops polling once a look found nothing; one that was on it
+        // keeps looking once a second until it is back (F93).
+        if (d.looked && !p.on_pad) {
+            n.retry_armed = false;
+        }
+        break;
+    case Step::Close:
+        n.has_device  = false;
+        n.stopped     = false;
+        n.retry_armed = true;
+        break;
+    case Step::Open:
+        if (open_ok) {
+            n.on_pad      = true;
+            n.has_device  = true;
+            n.stopped     = false;
+            n.retry_armed = false;
+        } else {
+            // A stream on the controller was closed before the open; one on the default sink is kept.
+            n.has_device  = !p.on_pad && p.has_device;
+            n.stopped     = false;
+            n.retry_armed = true;
+        }
+        break;
+    }
+    return n;
+}
+
+// The host's PIPEWIRE_PROPS default (exp 0181: PipeWire's downmix normalized so that it cannot clip).
+inline constexpr char kHostStreamProps[] = "{ channelmix.normalize = true }";
+// What a stream on the controller adds: never moved to another sink when its target goes, never linked to the default
+// sink when its target is not found (pipewire-props(7), PipeWire 1.6.9: node.dont-reconnect, node.dont-fallback;
+// WirePlumber 0.5.17 linking/prepare-link.lua:71-76 and find-defined-target.lua:116-123, which destroys such a stream,
+// node.linger unset). dont-fallback matters most: with dont-reconnect alone, a reopen that reaches WirePlumber before
+// the returning sink is linkable would be linked to the default sink and then kept there (prepare-link.lua:63-67);
+// with dont-fallback it fails, and the port retries a second later.
+inline constexpr std::string_view kPadStreamKeys = "node.dont-reconnect = true node.dont-fallback = true";
+
+// The PIPEWIRE_PROPS value for a stream opened on the controller: the host's default with kPadStreamKeys added, or
+// empty when `current` is not the host's default (a value the user set is left as it is).
+inline std::string pad_stream_props(std::string_view current) {
+    const std::string_view host(kHostStreamProps);
+    if (current != host) {
+        return {};
+    }
+    std::string out(host.substr(0, host.rfind('}')));
+    out += kPadStreamKeys;
+    out += " }";
+    return out;
+}
+
+} // namespace bc5::pad_audio_route
diff --git a/src/bc5/switch_defaults.hpp b/src/bc5/switch_defaults.hpp
new file mode 100644
index 0000000..edaf6e3
--- /dev/null
+++ b/src/bc5/switch_defaults.hpp
@@ -0,0 +1,111 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Experiment 0413: the defaults of switches that went from the private test builds (exps 0401, 0405, 0409, 0412) into
+// both shared builds. Each row is applied at process start with setenv(name, value, 0), before any static initializer
+// reads a switch, so a value set in the environment always wins and NAME=0 restores the old behaviour of that row.
+// KYTY_BC5_SWITCH_DEFAULTS=0 skips the whole table (the code then behaves as in the private builds with nothing set).
+// One audit row of experiments/0413-np-session-v2-shared/audit-unintegrated.md per block, in the audit's order.
+// Left out on purpose (the top session's rules, 2026-11-12): the zero skip and its poll, the orphan release, split and
+// forget (launcher only); CP_COHER_START_DELAY (never A/B'd; the second title's launcher keeps it); NOGPU_UNPIN,
+// SET_PREDICATION, the catchers and journals (off).
+#pragma once
+
+#include <cstdlib>
+#include <cstring>
+
+namespace bc5::switch_defaults {
+
+struct Default {
+	const char* name;
+	const char* value;
+};
