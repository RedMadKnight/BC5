+	EXIT_NOT_IMPLEMENTED(mode != 0 && mode != 1);
+
+	if (!g_net->HttpAddRequestHeader(Network::Id(id), name, value, mode == 1)) {
+		return HTTP_ERROR_INVALID_ID;
+	}
+
+	return OK;
+}
