+#ifndef KYTY_GRAPHICS_PRESENTATION_SETTINGS_OVERLAY_H_
+#define KYTY_GRAPHICS_PRESENTATION_SETTINGS_OVERLAY_H_
+
+// BC5: the settings overlay — F2 in the game window opens a menu over the game's picture in
+// which the controller mapping (the input configuration file) is edited: a control is bound by
+// pressing the key, mouse button or pad input wanted, a physical pad input is switched off, the
+// built-in keyboard layout is kept or dropped, and the result is applied live and saved to the
+// file. Drawn with ImGui in the presentation pass like the IME's on-screen keyboard; while it is
+// open the keyboard, the mouse and the pad drive the menu, not the game.
+
+#include "common/common.h"
+#include "graphics/host_gpu/vulkanCommon.h"
+
+#include <cstdint>
+#include <memory>
+
+union SDL_Event;
+
+namespace Libs::Graphics {
+
+struct GraphicContext;
+
+// Window-thread side.
+void SettingsOverlayToggle();
+bool SettingsOverlayActive() noexcept;
+// A counter that changes whenever the overlay opens, closes or wants a redraw.
+uint64_t SettingsOverlayRevision() noexcept;
+// Takes an SDL event for the overlay; true when the event was consumed (it must not reach the game).
+bool ProcessSettingsInput(const SDL_Event& event);
+
+// Presenter-thread side: drawn into the swapchain image after the game's picture.
+class SettingsOverlay final {
+public:
+	explicit SettingsOverlay(GraphicContext& graphics);
+	~SettingsOverlay();
+	KYTY_CLASS_NO_COPY(SettingsOverlay);
+
+	[[nodiscard]] bool PrepareFrame(vk::Extent2D extent, vk::Format format, uint32_t image_count);
+	void               Record(vk::CommandBuffer command, vk::ImageView target);
+	void               ReleaseVulkan();
+
+private:
+	struct Impl;
+	std::unique_ptr<Impl> m_impl;
+};
+
+} // namespace Libs::Graphics
+
+#endif // KYTY_GRAPHICS_PRESENTATION_SETTINGS_OVERLAY_H_
