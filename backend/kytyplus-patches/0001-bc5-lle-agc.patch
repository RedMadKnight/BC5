+					old_to_new[q] = static_cast<uint32_t>(mec_ib.size());
+					mec_ib.insert(mec_ib.end(), ib + q, ib + q + len);
+				}
+				q += len;
+			}
+			old_to_new[num_dwords] = static_cast<uint32_t>(mec_ib.size());
