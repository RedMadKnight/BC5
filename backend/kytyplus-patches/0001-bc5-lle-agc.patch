+// AnyPS5 :484-489.
+static std::optional<int> Bc5UsbCheckConnected(void* handle) {
+	std::optional<int> answer;
+	if (!Bc5UsbOpenHandle("sceUsbdCheckConnected", handle, &answer)) {
