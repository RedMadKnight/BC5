+bool RuntimeLinker::Bc5FindHleByNid(const std::string& nid, SymbolType type,
+                                    SymbolRecord* out_info) {
+	Common::LockGuard lock(m_mutex);
+	EXIT_IF(out_info == nullptr);
+	if (m_symbols != nullptr) {
+		if (const auto* rec = m_symbols->FindByNid(nid, type); rec != nullptr) {
+			*out_info = *rec;
+			return true;
+		}
+	}
+	return false;
+}
+
 bool RuntimeLinker::ResolveLoadedSymbolByNid(const std::string& nid, SymbolType type,
                                              SymbolRecord* out_info) {
 	KYTY_PROFILER_FUNCTION();
@@ -2503,6 +2530,13 @@ static std::vector<std::string> KytyLleSysmoduleDenylist() {
 		}
 	}
 
+#if defined(KYTY_BC5_DIRECT)
+	// BC5 (libs/bc5Reimpl.cpp): a pack copy of a module BC5 provides (its BC5_REIMPL_* switch not =0) stays off the LLE load.
+	for (const auto& name: Libs::Bc5Reimpl::DeniedSysmodules()) {
+		list.push_back(Common::ToLower(name));
+	}
+#endif
+
 	return list;
 }
 
