+// SPDX-License-Identifier: GPL-2.0-only
+//
+// BC5 (github.com/RedMadKnight/BC5): host glue for the clean-room re-creations of libSceAgc,
+// libSceAgcDriver and libScePsml (BC5 backend/src/reimpl, provenance in its PROVENANCE.md).
+//
+// Which implementation a title gets, per module (bc5/reimpl/select.hpp; the maintainer's rule of
+// 2026-11-20, "by default take BC5's own, unless the game has its own"):
+//   - BC5's own re-creation by default: no module from another game is needed;
+//   - the game's own copy when the title ships one (its root, sce_module/ or sce_modules/): the
+//     loader loads it as before and BC5's is not registered;
+//   - BC5_REIMPL_AGC=0 / BC5_REIMPL_AGCDRIVER=0 / BC5_REIMPL_PSML=0 opts out: the host's previous
+//     behaviour (the module pack from SHADPS4_SYSMODULES_PACK_DIR, else KytyPlus's HLE).
+// One log line per module says which was chosen.
+//   BC5_REIMPL_FW_DIR=<dir>  optional: where the modules' own diagnostics (BC5_REIMPL_FW_DATA=1,
+//                            BC5_REIMPL_FW_COMPARE=1) read a module file; default
+//                            SHADPS4_SYSMODULES_PACK_DIR. Nothing needs it by default.
+//
+// Order: once the title's programs and the pack's modules are loaded and before relocation (the
+// hook in RuntimeLinker), the choice is made with the title's directory known; BC5's exports are
+// then added to the host's symbol table (library v1, module v1.1, the versions every importer of
+// these modules declares; added last, so they win the exact key), every chosen module's imports
+// are bound (BC5's own exports first, then a loaded module's, then the host's HLE, by NID), and
+// the modules' load-time initialisation runs (driver, then Agc, then Psml). A pack copy of a
+// module BC5 provides is kept off the LLE load (DeniedSysmodules).
+
+#if defined(KYTY_BC5_DIRECT)
+
+#include "bc5/reimpl/agc.hpp"
+#include "bc5/reimpl/agc_driver.hpp"
+#include "bc5/reimpl/fw_image.hpp"
+#include "bc5/reimpl/module.hpp"
+#include "bc5/reimpl/select.hpp"
+#include "common/logging/log.h"
+#include "libs/libs.h"
+#include "loader/runtimeLinker.h"
+#include "loader/symbolDatabase.h"
+
+#include <cstdio>
+#include <cstring>
+#include <initializer_list>
+#include <sys/mman.h>
+#include <cstdlib>
+#include <filesystem>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <span>
+#include <string>
+#include <vector>
+
+namespace Libs::Bc5Reimpl {
+
+namespace {
+
+struct ModuleDef {
+    const char *name; // module and file stem
+    const char *env;  // switch
+    std::span<const bc5::reimpl::ExportEntry> (*exports)();
+    std::span<const bc5::reimpl::ImportSlot> (*imports)();
+    std::int32_t (*start)(); // load-time initialisation, run once the imports are bound
+};
+
+const ModuleDef kModules[] = {
+    {"libSceAgc", "BC5_REIMPL_AGC", bc5::reimpl::agc::exports, bc5::reimpl::agc::imports,
+     bc5::reimpl::agc::module_load},
+    {"libSceAgcDriver", "BC5_REIMPL_AGCDRIVER", bc5::reimpl::agc_driver::exports,
+     bc5::reimpl::agc_driver::imports, bc5::reimpl::agc_driver::initialize},
+    {"libScePsml", "BC5_REIMPL_PSML", bc5::reimpl::psml::exports, bc5::reimpl::psml::imports,
+     nullptr},
+};
+
+std::mutex g_mu;
+std::map<std::string, bc5::reimpl::Choice> g_choice; // filled once by ResolveImports
+
+bool switch_allows(const ModuleDef &m) { return bc5::reimpl::switch_allows(std::getenv(m.env)); }
+
+bool chosen_bc5(const ModuleDef &m) {
+    std::lock_guard<std::mutex> lock(g_mu);
+    const auto it = g_choice.find(m.name);
+    return it != g_choice.end() && it->second == bc5::reimpl::Choice::Bc5Own;
+}
+
+// The module that owns a library name ("libSceAgcDriverPaDebug" -> libSceAgcDriver).
+const ModuleDef *owner_of_library(const std::string &library) {
+    const ModuleDef *best = nullptr;
+    std::size_t best_len = 0;
+    for (const auto &m : kModules) {
+        const std::string n = m.name;
+        if (library.rfind(n, 0) == 0 && n.size() > best_len) {
+            best = &m;
+            best_len = n.size();
+        }
+    }
+    return best;
+}
+
+// FirmwareData from a module file, only for the diagnostics that ask for it.
+class PackFirmwareData final : public bc5::reimpl::FirmwareData {
+  public:
+    const std::uint8_t *get(const char *module, std::uint64_t vaddr, std::uint64_t size) override {
+        std::lock_guard<std::mutex> lock(mu_);
+        auto &slot = images_[module];
+        if (!slot) {
+            slot = std::make_unique<bc5::reimpl::FwImage>();
+            const std::string path = dir() + "/" + module + ".sprx";
+            if (!slot->load_file(path)) {
+                std::fprintf(stderr, "[bc5-reimpl] module file for %s not available (%s): %s\n", module,
+                     path.c_str(), slot->error().c_str());
+            }
+        }
+        return slot->at(vaddr, size);
+    }
+
+  private:
+    static std::string dir() {
+        for (const char *e : {"BC5_REIMPL_FW_DIR", "SHADPS4_SYSMODULES_PACK_DIR"}) {
+            const char *v = std::getenv(e);
+            if (v != nullptr && *v != 0) {
+                return v;
+            }
+        }
+        return ".";
+    }
+    std::mutex mu_;
+    std::map<std::string, std::unique_ptr<bc5::reimpl::FwImage>> images_;
+};
+
+void log_sink(const char *module, const char *message) {
+    std::fprintf(stderr, "[bc5-reimpl %s] %s\n", module, message); // stderr: LOGF is silent here
+}
+
+// ---- BC5_REIMPL_CALLTRACE=1 (diagnostic, default off) ---------------------------------------------
+// Every export of a chosen module is registered through a small x86-64 thunk that saves the argument
+// registers (rdi, rsi, rdx, rcx, r8, r9, rax and xmm0-7), calls call_seen(index) and jumps on to the
+// real function, so the guest's calls are seen in order. The first three calls of each export are
+// logged, and the last 64 calls are printed at exit (also after a guest crash).
+struct TraceEntry {
+    const char *module;
+    const char *name;
+    const char *nid;
+};
+std::vector<TraceEntry> g_trace_entries;
+std::vector<unsigned> g_trace_count;
+unsigned g_trace_ring[64];
+unsigned g_trace_seq = 0;
+std::mutex g_trace_mu;
+
+extern "C" void bc5_reimpl_call_seen(unsigned index) {
+    std::lock_guard<std::mutex> lock(g_trace_mu);
+    g_trace_ring[g_trace_seq % 64] = index;
+    ++g_trace_seq;
+    if (index < g_trace_count.size() && g_trace_count[index]++ < 3) {
+        const TraceEntry &t = g_trace_entries[index];
+        std::fprintf(stderr, "[bc5-reimpl call #%u] %s %s (%s)\n", g_trace_seq, t.module,
+                     t.name[0] != 0 ? t.name : t.nid, t.nid);
+    }
+}
+
+void trace_dump_at_exit() {
+    std::lock_guard<std::mutex> lock(g_trace_mu);
+    const unsigned n = g_trace_seq < 64 ? g_trace_seq : 64;
+    std::fprintf(stderr, "[bc5-reimpl] last %u of %u calls:\n", n, g_trace_seq);
+    for (unsigned k = g_trace_seq - n; k < g_trace_seq; ++k) {
+        const TraceEntry &t = g_trace_entries[g_trace_ring[k % 64]];
+        std::fprintf(stderr, "[bc5-reimpl]   #%u %s %s (%s)\n", k + 1, t.module,
+                     t.name[0] != 0 ? t.name : t.nid, t.nid);
+    }
+}
+
+bool calltrace_on() {
+    const char *v = std::getenv("BC5_REIMPL_CALLTRACE");
+    return v != nullptr && v[0] != 0 && !(v[0] == '0' && v[1] == 0);
+}
+
+// One thunk; returns its size. Encodings: Intel SDM vol. 2 (PUSH/POP r64, SUB/ADD r/m64 imm32,
+// MOVDQU xmm/m128 F3 0F 6F/7F, MOV r32 imm32 B8+r, MOV r64 imm64 REX.W B8+r, CALL r/m64 FF /2,
+// JMP r/m64 FF /4 with RIP-relative disp32 0).
+std::size_t emit_thunk(std::uint8_t *p, unsigned index, std::uint64_t target) {
+    std::uint8_t *s = p;
+    auto b = [&](std::initializer_list<int> v) { for (int x : v) *p++ = static_cast<std::uint8_t>(x); };
+    auto u32 = [&](std::uint32_t v) { std::memcpy(p, &v, 4); p += 4; };
+    auto u64 = [&](std::uint64_t v) { std::memcpy(p, &v, 8); p += 8; };
+    b({0x57, 0x56, 0x52, 0x51, 0x41, 0x50, 0x41, 0x51, 0x50}); // push rdi rsi rdx rcx r8 r9 rax
+    b({0x48, 0x81, 0xEC}); u32(128);                           // sub rsp, 128 (rsp 16-aligned)
+    for (int x = 0; x < 8; ++x) b({0xF3, 0x0F, 0x7F, 0x44 | (x << 3), 0x24, 16 * x}); // movdqu [rsp+16x], xmmx
+    b({0xBF}); u32(index);                                      // mov edi, index
+    b({0x48, 0xB8}); u64(reinterpret_cast<std::uint64_t>(&bc5_reimpl_call_seen)); // mov rax, fn
+    b({0xFF, 0xD0});                                            // call rax
+    for (int x = 0; x < 8; ++x) b({0xF3, 0x0F, 0x6F, 0x44 | (x << 3), 0x24, 16 * x}); // movdqu xmmx, [rsp+16x]
+    b({0x48, 0x81, 0xC4}); u32(128);                            // add rsp, 128
+    b({0x58, 0x41, 0x59, 0x41, 0x58, 0x59, 0x5A, 0x5E, 0x5F}); // pop rax r9 r8 rcx rdx rsi rdi
+    b({0xFF, 0x25}); u32(0); u64(target);                       // jmp [rip+0] -> target
+    return static_cast<std::size_t>(p - s);
+}
+
+void register_exports(Loader::SymbolDatabase *s, const ModuleDef &m) {
+    int n = 0;
+    std::uint8_t *thunks = nullptr;
+    std::size_t used = 0;
+    if (calltrace_on()) {
+        const std::size_t bytes = (m.exports().size() * 192 + 4095) & ~std::size_t{4095};
+        void *mem = mmap(nullptr, bytes, PROT_READ | PROT_WRITE | PROT_EXEC, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+        thunks = mem == MAP_FAILED ? nullptr : static_cast<std::uint8_t *>(mem);
+        static bool once = false;
+        if (!once) {
+            once = true;
+            std::atexit(trace_dump_at_exit);
+        }
+        std::fprintf(stderr, "[bc5-reimpl] %s: call trace %s\n", m.name, thunks != nullptr ? "on" : "FAILED");
+    }
+    for (const auto &e : m.exports()) {
+        std::uint64_t addr = reinterpret_cast<uint64_t>(e.address);
+        if (thunks != nullptr && !e.is_object) {
+            {
+                std::lock_guard<std::mutex> lock(g_trace_mu);
+                g_trace_entries.push_back({m.name, e.name, e.nid});
+                g_trace_count.push_back(0);
+            }
+            const auto index = static_cast<unsigned>(g_trace_entries.size() - 1);
+            std::uint8_t *t = thunks + used;
+            used += (emit_thunk(t, index, addr) + 15) & ~std::size_t{15};
+            addr = reinterpret_cast<uint64_t>(t);
+        }
+        Loader::SymbolResolve sr{};
+        sr.name = e.nid;
+        sr.library = e.library;
+        sr.library_version = 1;
+        sr.module = m.name;
+        sr.module_version_major = 1;
+        sr.module_version_minor = 1;
+        sr.type = e.is_object ? Loader::SymbolType::Object : Loader::SymbolType::Func;
+        s->Add(sr, addr,
+               std::string("bc5reimpl:") + (e.name[0] != 0 ? e.name : e.nid));
+        ++n;
+    }
+    std::fprintf(stderr, "[bc5-reimpl] %s: %d exports registered\n", m.name, n);
+}
+
+} // namespace
+
+// Called by the LLE loader's denylist: a pack copy of a module BC5 provides stays off the LLE load.
+// (The title's own copies are loaded by a different path that this list does not touch.)
+std::vector<std::string> DeniedSysmodules() {
+    std::vector<std::string> out;
+    for (const auto &m : kModules) {
+        if (switch_allows(m)) {
+            out.push_back(std::string(m.name) + ".sprx");
+        }
+    }
+    return out;
+}
+
+// Kept for the host's InitAll: only the shared sinks (no registration here, the title's directory
+// is not known yet).
+LIB_DEFINE(InitBc5Reimpl_1) {
+    (void)s;
+    static PackFirmwareData fw;
+    bc5::reimpl::set_firmware_data(&fw);
+    bc5::reimpl::set_log(log_sink);
+}
+
+// After the title's programs and the LLE modules are loaded, before relocation.
+void ResolveImports(Loader::RuntimeLinker *rt, const std::filesystem::path &title_root) {
+    {
+        std::lock_guard<std::mutex> lock(g_mu);
+        for (const auto &m : kModules) {
+            const std::filesystem::path own = bc5::reimpl::find_game_copy(title_root, m.name);
+            const bc5::reimpl::Choice c = bc5::reimpl::choose(std::getenv(m.env), !own.empty());
+            g_choice[m.name] = c;
+            std::fprintf(stderr, "[bc5-reimpl] %s: %s%s%s\n", m.name, bc5::reimpl::choice_name(c),
+                 own.empty() ? "" : " at ", own.empty() ? "" : own.string().c_str());
+        }
+    }
+    Loader::SymbolDatabase *syms = rt->Symbols();
+    for (const auto &m : kModules) {
+        if (chosen_bc5(m) && syms != nullptr) {
+            register_exports(syms, m);
+            // Self-check: the key an importer's relocation looks up (library and module v1 / v1.1,
+            // Func) must find BC5's export for the module's first entry.
+            const auto ex = m.exports();
+            if (!ex.empty()) {
+                Loader::SymbolResolve sr{};
+                sr.name = ex[0].nid;
+                sr.library = ex[0].library;
+                sr.library_version = 1;
+                sr.module = m.name;
+                sr.module_version_major = 1;
+                sr.module_version_minor = 1;
+                sr.type = ex[0].is_object ? Loader::SymbolType::Object : Loader::SymbolType::Func;
+                const Loader::SymbolRecord *rec = syms->Find(sr);
+                const Loader::SymbolRecord *any = syms->FindByNid(ex[0].nid, sr.type);
+                std::fprintf(stderr,
+                             "[bc5-reimpl] %s: key check %s -> %s (%s); by NID -> %s\n", m.name,
+                             Loader::SymbolDatabase::GenerateName(sr).c_str(),
+                             rec != nullptr ? rec->dbg_name.c_str() : "none",
+                             rec != nullptr && rec->dbg_name.rfind("bc5reimpl:", 0) == 0 ? "BC5's"
+                                                                                         : "NOT BC5's",
+                             any != nullptr ? any->dbg_name.c_str() : "none");
+            }
+        }
+    }
+    for (const auto &m : kModules) {
+        if (!chosen_bc5(m)) {
+            continue;
+        }
+        int ok = 0, missing = 0;
+        for (const auto &imp : m.imports()) {
+            *imp.slot = nullptr;
+            const ModuleDef *owner = owner_of_library(imp.library);
+            if (owner != nullptr && chosen_bc5(*owner)) {
+                for (const auto &e : owner->exports()) {
+                    if (std::string(e.nid) == imp.nid && std::string(e.library) == imp.library) {
+                        *imp.slot = e.address;
+                        break;
+                    }
+                }
+            }
+            Loader::SymbolRecord rec{};
+            if (*imp.slot == nullptr &&
+                rt->ResolveLoadedSymbolByNid(imp.nid, Loader::SymbolType::Func, &rec) &&
+                rec.vaddr != 0) {
+                *imp.slot = reinterpret_cast<void *>(rec.vaddr);
+            }
+            if (*imp.slot == nullptr &&
+                rt->Bc5FindHleByNid(imp.nid, Loader::SymbolType::Func, &rec) && rec.vaddr != 0) {
+                *imp.slot = reinterpret_cast<void *>(rec.vaddr);
+            }
+            if (*imp.slot != nullptr) {
+                ++ok;
+            } else {
+                ++missing;
+                std::fprintf(stderr, "[bc5-reimpl] %s: import %s (%s, %s) unresolved\n", m.name, imp.nid,
+                     imp.library, imp.name);
+            }
+        }
+        std::fprintf(stderr, "[bc5-reimpl] %s: %d imports resolved, %d unresolved\n", m.name, ok, missing);
+    }
+    // Load-time initialisation in load order (driver, then Agc, then Psml), as the firmware
+    // modules' own start code would run.
+    for (const char *name : {"libSceAgcDriver", "libSceAgc", "libScePsml"}) {
+        for (const auto &m : kModules) {
+            if (std::string(m.name) == name && chosen_bc5(m) && m.start != nullptr) {
+                const std::int32_t r = m.start();
+                std::fprintf(stderr, "[bc5-reimpl] %s: started (%d)\n", m.name, r);
+            }
+        }
+    }
+}
+
+} // namespace Libs::Bc5Reimpl
+
+#endif // KYTY_BC5_DIRECT
