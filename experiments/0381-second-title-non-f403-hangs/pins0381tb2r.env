# Test build 2 on the rebuilt shared base fab8660 (build0381tb2.sh, PIN_MODE=rebased). The values marked FILL need a box read and are
# committed after it: the scripts refuse to run while any is left. A change here is a new commit and a new review.
PIN_MODE=rebased
# Shared files after the merge and the rebuild, read only. The first three are the top session's values. PIN_TREE_UNIT and PIN_NP are
# files that patch 0001 creates, taken from fab8660's patch: their blobs match the patch's index lines (dd54973, 0e19c18). The box's files
# are not read yet, so the build's own compare is what proves them.
PIN_SHARED=78f25172
PIN_LEAN=7b246487
PIN_ARCHIVE=3292bdaf
PIN_TREE_UNIT=29b3d8c6
PIN_PLAY_PKG=FILL
PIN_LIBC=FILL
PIN_NP=7c40b784
# main's patch 0001 at fab8660
PIN_PATCH=716dcaf6db2c2aa436475d6c844be91d
# Unchanged from test build 1: r1's parts, the restore on the r1 unit, main's header.
PIN_R1_BIN=44417414
PIN_R1_UNIT=c46144c4
PIN_R1_LINKER=5f2bc982
PIN_R1_ZERO=782ca0e9
PIN_R1_LAUNCHER=299a2519
PIN_UNIT=c743bb76
PIN_HEADER=d01f31c6
PIN_0372_LINES=5
# The two launchers as built from r1's pinned one and the scripts of this commit; a change in either script needs these read again.
PIN_TB2_LAUNCHER=fb93a9b9
PIN_TB2_SMOKE=a28f78c1
