+bool Bc5RangesDirtyTouching(void (*cb)(size_t, uint64_t, uint64_t, uint64_t, int, int, const char*, void*), void* ctx, uint64_t* gen,
+                            std::vector<std::pair<uint64_t, uint64_t>>* spans, bool* complete) {
