+// vector code. Read once; one stderr line.
+static bool Bc5A1pOn() {
+	static const bool on = [] {
+		const char* e = std::getenv("KYTY_BC5_0438_A1P");
+		const bool  v = !(e != nullptr && std::strcmp(e, "0") == 0); // exp 0438 (bake438b): on unless "0"
+		std::fprintf(stderr, "[bc5] exp 0438 A1P memory tables in maps: %s (tag a1p438)\n", v ? "on" : "off");
+		return v;
+	}();
+	return on;
