+};
+struct Pre {
+	const uint32_t*                                          ib = nullptr;
+	uint32_t                                                 n  = 0;
+	std::shared_ptr<const std::vector<bc5::direct::Mapping>> snap;
+	std::vector<Miss>                                        miss;
+	bool                                                     valid = false;
+};
