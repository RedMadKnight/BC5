+// Experiment 0221 (BC5_DIRECT_FLIP_TRACE=1, off by default; journal only; v2 of experiment 0219): when the
+// label of a given-up wait is written, against the GPU jobs, and by whom. After a cpu-wait is given up, a
+// thread of its own ("bc5-flipw") reads its label every ~50 us for up to 2 s and journals each change of the
+// value and the moment the wait would have been satisfied, with the jobs in flight on each completion queue
+// and the last job completed by then. At the give-up it journals the compute queue's state: the label its
+// held-back buffer waits on (g_unready_label), whether the given-up label is among those that buffer writes
+// past its wait, and whether the compute label is among those the waiting buffer writes; the watcher follows
+// that compute label too. While a label is watched (and for 20 ms after), every job's completion is journaled.
+// A game-thread wait served after 4 ms or more gets the same summary at its end. BC5_DIRECT_FLIP_TRACE_WP=1
+// adds hardware write breakpoints (counting only, user space only, this process only) on both labels in every
+// thread, read when a watched label changes: a CPU write shows on the writing thread, a GPU write on none.
+// Nothing waits longer and nothing more is submitted.
+namespace flip0221 {
+struct Done {
+	uint64_t ns = 0, n = 0;
+	uint32_t dwords = 0;
+	int      queue  = 0;
+	char     kind[8] {};
+};
+struct Item {
+	uint64_t id = 0, a = 0, t_wait0 = 0, t_give = 0, v_give = 0;
+	uint64_t c = 0, c_give = 0; // the compute queue's blocked label at the give-up (0: none) and its value
+	uint32_t pkt[8] {};
+	uint32_t num_dwords = 0, at = 0;
+	int32_t  q0_at_give = 0, q1_at_give = 0;
+	int      waiter = 0; // the thread that gave up
+	bool     is64 = false, game = false;
+	char     kind[8] {};
+};
+struct Last {
+	uint64_t between = 0;    // completions in [from, t]
+	double   ago_ms  = -1.0; // the last completion at or before t, this long before it (-1: none)
+	uint64_t n       = 0;
+	uint32_t dwords  = 0;
+	int      queue   = -1;
+	char     kind[8] {};
+};
+struct Wp {
+	int      fd = -1, tid = 0, which = 0; // which: unused
+	uint64_t seen = 0;                    // the count at the last read
+};
+static std::mutex              mutex;
+static std::condition_variable cv;
+static std::deque<Item>        fresh;            // given up, not yet taken by the watcher
+static Done                    ring[4096];       // the last completions (under mutex)
+static uint64_t                done_count = 0;   // completions so far (under mutex)
+static std::atomic<int32_t>    in_flight[2] {};  // jobs queued and not yet completed, per completion queue
+static std::atomic<uint32_t>   watched {0};      // labels being watched
+static std::atomic<uint64_t>   linger_until {0}; // journal completions until then (SoftCp::now_ns)
+static std::atomic<uint64_t>   next_id {0};
+static bool env() {
+	static const bool e = BC5_DIAG_ENV("BC5_DIRECT_FLIP_TRACE") != nullptr;
+	return e;
+}
+static bool on() {
+	return env() && ::Log::Bc5LoggingOn();
+}
+static bool wp_on() {
+	static const bool e = BC5_DIAG_ENV("BC5_DIRECT_FLIP_TRACE_WP") != nullptr;
+	return e;
+}
+static double t_of(uint64_t ns) { // the journal's t of a SoftCp::now_ns() time
+	const uint64_t now = SoftCp::now_ns();
+	return timing_now() - static_cast<double>(static_cast<int64_t>(now - ns)) / 1e9;
+}
+static uint64_t value_of(const Item& it) {
+	return it.is64 ? *reinterpret_cast<const volatile uint64_t*>(it.a & ~7ull) : *reinterpret_cast<const volatile uint32_t*>(it.a);
+}
+static uint64_t value64(uint64_t a) {
+	return a == 0 ? 0 : *reinterpret_cast<const volatile uint64_t*>(a & ~7ull);
+}
+static Last last_before(uint64_t t, uint64_t from) {
+	Last l;
+	std::lock_guard lk(mutex);
+	for (uint64_t k = 0; k < 4096 && k < done_count; k++) {
+		const Done& d = ring[(done_count - 1 - k) % 4096];
+		if (d.ns > t) continue;
+		if (l.queue < 0) {
+			l.ago_ms = static_cast<double>(t - d.ns) / 1e6;
+			l.n      = d.n;
+			l.dwords = d.dwords;
+			l.queue  = d.queue;
+			std::memcpy(l.kind, d.kind, sizeof(l.kind));
+		}
+		if (d.ns < from) break;
+		l.between++;
+	}
+	return l;
+}
+static void linger(uint64_t until) {
+	uint64_t cur = linger_until.load();
+	while (cur < until && !linger_until.compare_exchange_weak(cur, until)) {
+	}
+}
+static void queued(int queue) {
+	if (env()) in_flight[queue & 1]++;
+}
+static void done(uint64_t n, const char* kind, uint32_t dwords, int queue) {
+	if (!env()) return;
+	in_flight[queue & 1]--;
+	const uint64_t now = SoftCp::now_ns();
+	{
+		std::lock_guard lk(mutex);
+		Done& d  = ring[done_count % 4096];
+		d.ns     = now;
+		d.n      = n;
+		d.dwords = dwords;
+		d.queue  = queue;
+		std::snprintf(d.kind, sizeof(d.kind), "%s", kind != nullptr ? kind : "");
+		done_count++;
+	}
+	if (on() && (watched.load() != 0 || now < linger_until.load())) {
+		journal("flip trace: job #%" PRIu64 " %s %u dwords done at t %.6f s (cq%d); in flight cq0 %d cq1 %d\n", n, kind != nullptr ? kind : "", dwords, t_of(now), queue,
+				in_flight[0].load(), in_flight[1].load());
+	}
+}
+static void thread_name(int tid, char* out, size_t n) {
+	char path[64];
+	std::snprintf(path, sizeof(path), "/proc/self/task/%d/comm", tid);
+	std::snprintf(out, n, "?");
+	if (FILE* f = std::fopen(path, "r"); f != nullptr) {
+		if (std::fgets(out, static_cast<int>(n), f) != nullptr) {
+			size_t l = std::strlen(out);
+			while (l > 0 && (out[l - 1] == '\n' || out[l - 1] == ' ')) out[--l] = 0;
+		}
+		std::fclose(f);
+	}
+}
+// The labels with write breakpoints: armed the first time a give-up names them (arming every thread takes
+// 5-15 ms, longer than many flips) and kept armed for the rest of the run, at most 4 (x86 has four debug
+// registers per thread). Used by the watcher thread only.
+struct WpLabel {
+	uint64_t        addr = 0;
+	std::vector<Wp> wps;
+};
+static std::vector<WpLabel> wp_labels;
+static WpLabel* wp_label(uint64_t addr) {
+	for (auto& l: wp_labels) {
+		if (l.addr == (addr & ~7ull)) return &l;
+	}
+	return nullptr;
+}
+// One hardware write breakpoint per thread, counting only: no samples, no signal, no single step.
+static void wp_arm(WpLabel& l, int& failed, int& err) {
+	DIR* d = opendir("/proc/self/task");
+	if (d == nullptr) {
+		failed++;
+		err = errno;
+		return;
+	}
+	while (dirent* e = readdir(d)) {
+		const int tid = std::atoi(e->d_name);
+		if (tid <= 0) continue;
+		perf_event_attr a {};
+		a.type           = PERF_TYPE_BREAKPOINT;
+		a.size           = sizeof(a);
+		a.bp_type        = HW_BREAKPOINT_W;
+		a.bp_addr        = l.addr;
+		a.bp_len         = HW_BREAKPOINT_LEN_8;
+		a.exclude_kernel = 1;
+		a.exclude_hv     = 1;
+		const int fd     = static_cast<int>(syscall(SYS_perf_event_open, &a, tid, -1, -1, PERF_FLAG_FD_CLOEXEC));
+		if (fd < 0) {
+			failed++;
+			err = errno;
+			continue;
+		}
+		l.wps.push_back({fd, tid, 0, 0});
+	}
+	closedir(d);
+}
+// Reads a label's breakpoints; journals each thread whose count rose since the last read.
+static uint32_t wp_read(WpLabel& l, const Item& it, const char* which, const char* when, uint64_t now) {
+	uint32_t rose = 0;
+	for (auto& w: l.wps) {
+		uint64_t c = 0;
+		if (::read(w.fd, &c, sizeof(c)) != static_cast<ssize_t>(sizeof(c)) || c == w.seen) continue;
+		char name[32];
+		thread_name(w.tid, name, sizeof(name));
+		journal("flip trace: #%" PRIu64 " CPU write to the %s label 0x%" PRIx64 ": thread %d (%s)%s, %" PRIu64 " write(s), seen %s at t %.6f s, %.3f ms after the give-up\n", it.id, which, l.addr,
+				w.tid, name, w.tid == it.waiter ? " = the thread that gave up" : "", c - w.seen, when, t_of(now), static_cast<double>(now - it.t_give) / 1e6);
+		w.seen = c;
+		rose++;
+	}
+	return rose;
+}
+static void watcher() {
+	pthread_setname_np(pthread_self(), "bc5-flipw");
+	std::vector<Item>     active;
+	std::vector<uint64_t> last_v, last_c;
+	std::vector<uint32_t> changes;
+	wp_labels.reserve(4); // the pointers into it stay valid
+	for (;;) {
+		std::vector<Item> taken;
+		{
+			std::unique_lock lk(mutex);
+			if (active.empty()) cv.wait(lk, [] { return !fresh.empty(); });
+			while (!fresh.empty()) {
+				active.push_back(fresh.front());
+				last_v.push_back(fresh.front().v_give);
+				last_c.push_back(fresh.front().c_give);
+				changes.push_back(0);
+				taken.push_back(fresh.front());
+				fresh.pop_front();
+			}
+		}
+		for (const Item& it: taken) { // the breakpoints: the compute label first (it flips first), then the given-up label
+			if (!wp_on()) break;
+			const char* state[2] = {"none", "none"};
+			for (int w = 1; w >= 0; w--) {
+				const uint64_t addr = w == 1 ? it.c : it.a;
+				if (addr == 0 || (w == 0 && it.c != 0 && (it.c & ~7ull) == (it.a & ~7ull))) continue;
+				WpLabel* l = wp_label(addr);
+				if (l != nullptr) {
+					state[w] = "armed before this give-up";
+				} else if (wp_labels.size() < 4) {
+					int            failed = 0, err = 0;
+					const uint64_t t1     = SoftCp::now_ns();
+					wp_labels.push_back({addr & ~7ull, {}});
+					l = &wp_labels.back();
+					wp_arm(*l, failed, err);
+					const uint64_t t2 = SoftCp::now_ns();
+					journal("flip trace: #%" PRIu64 " write breakpoints on the %s label 0x%" PRIx64 ": %zu armed, %d failed (errno %d), in %.3f ms, armed %.3f ms after the give-up; value then 0x%" PRIx64 "\n",
+							it.id, w == 1 ? "compute" : "given-up", l->addr, l->wps.size(), failed, err, static_cast<double>(t2 - t1) / 1e6, static_cast<double>(t2 - it.t_give) / 1e6,
+							value64(addr));
+					state[w] = "armed now";
+					continue; // counted from now on
+				} else {
+					state[w] = "none (all four debug registers in use)";
+				}
+				wp_read(*l, it, w == 1 ? "compute" : "given-up", "at the watch start (since the last read)", SoftCp::now_ns());
+			}
+			journal("flip trace: #%" PRIu64 " breakpoints: given-up label %s; compute label %s\n", it.id, state[0], it.c != 0 ? state[1] : "- (no compute label)");
+		}
+		for (size_t k = 0; k < active.size();) {
+			const Item&    it    = active[k];
+			const uint64_t now   = SoftCp::now_ns();
+			const uint64_t v     = value_of(it);
+			const uint64_t c     = value64(it.c);
+			if (v != last_v[k] || (it.c != 0 && c != last_c[k])) {
+				// read the breakpoints right away: the writer's count is then from this change
+				for (int w = 0; w < 2; w++) {
+					const bool changed = w == 0 ? v != last_v[k] : (it.c != 0 && c != last_c[k]);
+					WpLabel*   l       = changed ? wp_label(w == 0 ? it.a : it.c) : nullptr;
+					if (changed && l != nullptr && wp_read(*l, it, w == 0 ? "given-up" : "compute", "at a change", now) == 0) {
+						journal("flip trace: #%" PRIu64 " no CPU write counted for that change of the %s label (a GPU write)\n", it.id, w == 0 ? "given-up" : "compute");
+					}
+				}
+			}
+			if (v != last_v[k]) {
+				if (changes[k] < 16) {
+					journal("flip trace: #%" PRIu64 " 0x%" PRIx64 ": 0x%" PRIx64 " -> 0x%" PRIx64 " at t %.6f s, %.3f ms after the give-up; in flight cq0 %d cq1 %d\n", it.id, it.a, last_v[k], v,
+							t_of(now), static_cast<double>(now - it.t_give) / 1e6, in_flight[0].load(), in_flight[1].load());
+				}
+				changes[k]++;
+				last_v[k] = v;
+			}
+			if (it.c != 0 && c != last_c[k]) {
+				journal("flip trace: #%" PRIu64 " compute label 0x%" PRIx64 ": 0x%" PRIx64 " -> 0x%" PRIx64 " at t %.6f s, %.3f ms after the give-up; in flight cq0 %d cq1 %d\n", it.id, it.c, last_c[k], c,
+						t_of(now), static_cast<double>(now - it.t_give) / 1e6, in_flight[0].load(), in_flight[1].load());
+				last_c[k] = c;
+			}
+			const bool sat = wait_satisfied(it.pkt, it.is64);
+			if (sat || now - it.t_give >= 2'000'000'000ull) {
+				const Last l = last_before(now, it.t_give);
+				journal("flip trace: #%" PRIu64 " 0x%" PRIx64 " %s %.3f ms after the give-up (%.3f ms after the wait began), t %.6f s; in flight cq0 %d cq1 %d (at the give-up %d %d); %" PRIu64
+						" jobs done since the give-up, the last %.3f ms before (#%" PRIu64 " %s %u dwords, cq%d); value 0x%" PRIx64 ", %u changes; compute label 0x%" PRIx64 " now 0x%" PRIx64 "\n",
+						it.id, it.a, sat ? "satisfied" : "NOT satisfied within 2 s", static_cast<double>(now - it.t_give) / 1e6, static_cast<double>(now - it.t_wait0) / 1e6, t_of(now),
+						in_flight[0].load(), in_flight[1].load(), it.q0_at_give, it.q1_at_give, l.between, l.ago_ms, l.n, l.kind, l.dwords, l.queue, v, changes[k], it.c, c);
+				for (int w = 0; w < 2; w++) {
+					WpLabel* wl = (w == 1 && it.c == 0) ? nullptr : wp_label(w == 0 ? it.a : it.c);
+					if (wl != nullptr) wp_read(*wl, it, w == 0 ? "given-up" : "compute", "at the end", now);
+				}
+				linger(now + 20'000'000ull);
+				active.erase(active.begin() + static_cast<std::ptrdiff_t>(k));
+				last_v.erase(last_v.begin() + static_cast<std::ptrdiff_t>(k));
+				last_c.erase(last_c.begin() + static_cast<std::ptrdiff_t>(k));
+				changes.erase(changes.begin() + static_cast<std::ptrdiff_t>(k));
+				watched--;
+				continue;
+			}
+			k++;
+		}
+		std::this_thread::sleep_for(std::chrono::microseconds(20));
+	}
+}
+} // namespace flip0221
+
+static void flip_trace_wait(const uint32_t* p, uint32_t len, bool is64, uint64_t label, uint64_t t0_ns, bool ok, bool game, const char* kind, uint32_t num_dwords, uint32_t at,
+							const std::vector<uint64_t>& written) {
+	if (!flip0221::on()) return;
+	const uint64_t now       = SoftCp::now_ns();
+	const double   waited_ms = static_cast<double>(now - t0_ns) / 1e6;
+	if (ok) {
+		if (!game || now - t0_ns < 4'000'000ull) return;
+		const flip0221::Last l = flip0221::last_before(now, t0_ns);
+		journal("flip trace: served %s %u dwords at %u on 0x%" PRIx64 " after %.3f ms, t %.6f s; in flight cq0 %d cq1 %d; %" PRIu64 " jobs done during the wait, the last %.3f ms before its end (#%" PRIu64
+				" %s %u dwords, cq%d); compute queue blocked on 0x%" PRIx64 "\n",
+				kind, num_dwords, at, label, waited_ms, flip0221::t_of(now), flip0221::in_flight[0].load(), flip0221::in_flight[1].load(), l.between, l.ago_ms, l.n, l.kind, l.dwords, l.queue,
+				g_unready_label.load());
+		flip0221::linger(now + 5'000'000ull);
+		return;
+	}
+	if (flip0221::watched.load() >= 64) return;
+	flip0221::Item it;
+	it.id            = ++flip0221::next_id;
+	const uint32_t n = is64 ? 8u : (len < 8 ? len : 8u); // wait_satisfied() reads 8 dwords of a WAIT_REG_MEM64
+	for (uint32_t k = 0; k < n; k++) it.pkt[k] = p[k];
+	it.a          = (p[2] & ~3u) | (static_cast<uint64_t>(p[3] & 0xffffu) << 32u);
+	it.is64       = is64;
+	it.game       = game;
+	it.t_wait0    = t0_ns;
+	it.t_give     = now;
+	it.num_dwords = num_dwords;
+	it.at         = at;
+	it.waiter     = static_cast<int>(syscall(SYS_gettid));
+	it.q0_at_give = flip0221::in_flight[0].load();
+	it.q1_at_give = flip0221::in_flight[1].load();
+	std::snprintf(it.kind, sizeof(it.kind), "%s", kind != nullptr ? kind : "");
+	it.v_give              = flip0221::value_of(it);
+	const flip0221::Last l = flip0221::last_before(now, now);
+	journal("flip trace: #%" PRIu64 " given up: %s %u dwords at %u on 0x%" PRIx64 " (game thread %d) after %.3f ms, t %.6f s; value 0x%" PRIx64 "; in flight cq0 %d cq1 %d; the last job done %.3f ms before (#%" PRIu64
+			" %s %u dwords, cq%d)\n",
+			it.id, it.kind, num_dwords, at, label, game ? 1 : 0, waited_ms, flip0221::t_of(now), it.v_give, it.q0_at_give, it.q1_at_give, l.ago_ms, l.n, l.kind, l.dwords, l.queue);
+	// The compute queue's state: its held-back buffer's wait label, and what that buffer writes past it.
+	const uint64_t blocked = g_unready_label.load();
+	size_t         n_after = 0;
+	bool           in_after = false;
+	{
+		std::lock_guard lk(g_unready_mutex);
+		n_after  = g_unready_writes.size();
+		in_after = std::find(g_unready_writes.begin(), g_unready_writes.end(), label) != g_unready_writes.end();
+	}
+	const bool c_written = blocked != 0 && std::find(written.begin(), written.end(), blocked) != written.end();
+	it.c                 = blocked;
+	it.c_give            = flip0221::value64(blocked);
+	if (blocked != 0) {
+		journal("flip trace: #%" PRIu64 " compute queue held back on 0x%" PRIx64 " (value 0x%" PRIx64 "); its buffer writes %zu label(s) past that wait, the given-up label %s; the waiting buffer writes %zu label(s), the compute label %s\n",
+				it.id, blocked, it.c_give, n_after, in_after ? "AMONG them" : "not among them", written.size(), c_written ? "AMONG them" : "not among them");
+	} else {
+		journal("flip trace: #%" PRIu64 " compute queue not held back (g_unready_label 0); the waiting buffer writes %zu label(s)\n", it.id, written.size());
+	}
+	{
+		std::lock_guard lk(flip0221::mutex);
+		flip0221::fresh.push_back(it);
+		flip0221::watched++;
+	}
+	static std::once_flag once;
+	std::call_once(once, [] { std::thread(flip0221::watcher).detach(); });
+	flip0221::cv.notify_one();
+}
