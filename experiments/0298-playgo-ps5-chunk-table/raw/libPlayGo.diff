 static uint32_t g_chunks_num = 0;
 
+// BC5 experiment 0298: the title's PlayGo calls on stderr (the play log), the first 32 of each kind.
+static void bc5_pg(std::atomic<int>& n, const char* fmt, ...) {
+	if (n.fetch_add(1) >= 32) {
+		return;
+	}
+	va_list ap;
+	va_start(ap, fmt);
+	std::fputs("bc5 playgo: ", stderr);
+	std::vfprintf(stderr, fmt, ap);
+	va_end(ap);
+}
+#define BC5_PG(...)                                   \
+	do {                                              \
+		static std::atomic<int> bc5_pg_n {0};           \
+		bc5_pg(bc5_pg_n, __VA_ARGS__);                  \
+	} while (0)
+
