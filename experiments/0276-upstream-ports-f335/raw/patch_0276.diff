+// Ported from KytyPlus 41beda43 "ampr: fix APR completion loss in 768-byte read batches"
+// (github.com/Coder787-source/KytyPlus, src/libs/libAmpr.cpp, GPL-2.0): a WriteAddress or
+// WriteAddressOnCompletion record is 8, 12 or 16 bytes by the value it writes, not a fixed 0x20;
+// a title that measures its records and packs them (768-byte read batches there) otherwise
+// loses the completion write that follows. The counter and time-counter variants stay at 0x20.
+// TODO(verify): the record sizes against a title's own measured layout on the box.
+static uint64_t WriteAddressRecordSize(uint64_t value) {
+	return value <= 3 ? 8 : value < (uint64_t {1} << 34) ? 12 : 16;
+}
