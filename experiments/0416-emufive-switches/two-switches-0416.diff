+// BC5 (exp 0414's list, item 1b; the idea is KytyPS5 c86d31b "coalesce repeated GPU interrupts with the same data"):
+// with KYTY_BC5_EVENT_COALESCE_SAME=1 a trigger for a still unread event whose data equals the newest unread entry's
+// only counts on that entry. Unset, empty and "0" are off: the code below runs as before.
+static bool Bc5EopCoalesceSame() {
+	static const bool on = [] {
+		const char* e = std::getenv("KYTY_BC5_EVENT_COALESCE_SAME");
+		const bool  v = e != nullptr && e[0] != '\0' && std::strcmp(e, "0") != 0;
+		if (v) {
+			std::fprintf(stderr, "[bc5] KYTY_BC5_EVENT_COALESCE_SAME on: a repeated EOP trigger with the same data counts on the newest unread entry\n");
+		}
+		return v;
+	}();
+	return on;
+}
