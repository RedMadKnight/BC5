diff --git a/src/libs/controller.cpp b/src/libs/controller.cpp
index a2befc5a..9688dafe 100644
--- a/src/libs/controller.cpp
+++ b/src/libs/controller.cpp
@@ -20,6 +20,7 @@
 
 #include <cmath>
 #include <thread>
+#include <condition_variable>
 #include <chrono>
 #include <string>
 #include <cstdlib>
@@ -566,7 +567,28 @@ void ControllerDisconnect(int id) {
 // TODO(verify): which actuator the console drives for each byte of scePadSetVibration; the
 // large/small naming here follows dualsense.h and AnyPS5 (large = the vibration stream's left
 // channel), neither of which was checked against a console.
-void ControllerRumble(uint8_t large, uint8_t small, uint32_t duration_ms) {
+// BC5 (experiment 0267): the write to the pad happens on a thread of its own. SDL_JoystickRumble
+// takes the joystick lock, which the window thread holds while it scans /dev/input on a hotplug,
+// and then does an ioctl and a write on the device; called from the title's pad thread
+// (scePadSetVibration) or its audio thread (the vibration-port fallback), that could hold them
+// for the length of a scan. The latest value wins; nothing waits.
+namespace {
+struct RumbleOutput {
+	std::mutex              mutex;
+	std::condition_variable cv;
+	uint8_t                 large = 0, small = 0;
+	uint32_t                duration_ms = 0;
+	uint64_t                seq         = 0;
+};
+RumbleOutput& RumbleOut() {
+	static RumbleOutput r;
+	return r;
+}
+
+// The write itself. A pad window.cpp opened as a raw joystick (no game-controller mapping, as can
+// happen after a replug) has no SDL_GameController, so the joystick API is the fallback; a failure
+// is logged once per pad instance (KYTY_BC5_INPUT_TRACE=1 logs every change too).
+void RumbleWrite(uint8_t large, uint8_t small, uint32_t duration_ms) {
 	auto* ds = static_cast<Libs::DualSense::DualSenseDriver*>(DualSenseDriverInstance());
 	if (ds != nullptr && ds->IsOpen()) {
 		Libs::DualSense::VibrationParam v;
@@ -581,12 +603,67 @@ void ControllerRumble(uint8_t large, uint8_t small, uint32_t duration_ms) {
 	if (id < 0) {
 		return;
 	}
-	SDL_GameController* pad = SDL_GameControllerFromInstanceID(id);
-	if (pad != nullptr) {
-		SDL_GameControllerRumble(pad, static_cast<Uint16>(static_cast<unsigned>(large) * 257u),
-		                         static_cast<Uint16>(static_cast<unsigned>(small) * 257u), duration_ms);
+	const auto  lo  = static_cast<Uint16>(static_cast<unsigned>(large) * 257u);
+	const auto  hi  = static_cast<Uint16>(static_cast<unsigned>(small) * 257u);
+	int         rc  = -1;
+	const char* via = "none";
+	if (SDL_GameController* pad = SDL_GameControllerFromInstanceID(id); pad != nullptr) {
+		rc  = SDL_GameControllerRumble(pad, lo, hi, duration_ms);
+		via = "game controller";
+	} else if (SDL_Joystick* joy = SDL_JoystickFromInstanceID(id); joy != nullptr) {
+		rc  = SDL_JoystickRumble(joy, lo, hi, duration_ms);
+		via = "raw joystick";
+	}
+	static const bool trace     = std::getenv("KYTY_BC5_INPUT_TRACE") != nullptr;
+	static int        failed_id = -1;
+	if (rc != 0 && failed_id != id) {
+		failed_id = id;
+		LOGF("rumble: pad instance %d via %s: %s\n", id, via,
+		     std::strcmp(via, "none") == 0 ? "no SDL device for this instance id" : SDL_GetError());
+	} else if (rc == 0 && failed_id == id) {
+		failed_id = -1;
+	}
+	if (trace) {
+		std::fprintf(stderr, "input trace: rumble %u/%u for %u ms via %s -> %d\n", large, small, duration_ms, via, rc);
+	}
+}
+
+void RumbleThread() {
+	auto&    out  = RumbleOut();
+	uint64_t seen = 0;
+	for (;;) {
+		uint8_t  large       = 0;
+		uint8_t  small       = 0;
+		uint32_t duration_ms = 0;
+		{
+			std::unique_lock<std::mutex> lock(out.mutex);
+			out.cv.wait(lock, [&] { return out.seq != seen; });
+			seen        = out.seq;
+			large       = out.large;
+			small       = out.small;
+			duration_ms = out.duration_ms;
+		}
+		RumbleWrite(large, small, duration_ms);
 	}
 }
+} // namespace
+
+void ControllerRumble(uint8_t large, uint8_t small, uint32_t duration_ms) {
+	static const bool started = [] {
+		std::thread(RumbleThread).detach();
+		return true;
+	}();
+	(void)started;
+	auto& out = RumbleOut();
+	{
+		std::lock_guard<std::mutex> lock(out.mutex);
+		out.large       = large;
+		out.small       = small;
+		out.duration_ms = duration_ms;
+		out.seq++;
+	}
+	out.cv.notify_one();
+}
 
