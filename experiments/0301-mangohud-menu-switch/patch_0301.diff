+	char buf[256];
+	while (::recv(g_hud_fd, buf, sizeof(buf), MSG_DONTWAIT) > 0) {
+	}
+	if (::send(g_hud_fd, ":hud;", 5, MSG_DONTWAIT | MSG_NOSIGNAL) != 5) {
+		MangoHudLost("control socket", errno);
+		return;
+	}
+	const bool shown = !g_hud_shown.load(std::memory_order_acquire);
+	g_hud_shown.store(shown, std::memory_order_release);
+	std::fprintf(stderr, "host menu: MangoHud %s\n", shown ? "shown" : "hidden");
+}
