+void HostMenuMangoHudSync() {
+	if (!HostMenuMangoHudPending()) {
+		return;
+	}
+	if (g_hud_fd < 0) {
+		// The layer opened its socket at vkCreateInstance, long before the first present; a refused
+		// connection means the layer is not there (not installed, or MANGOHUD=0).
+		const int fd = ::socket(AF_UNIX, SOCK_STREAM | SOCK_NONBLOCK | SOCK_CLOEXEC, 0);
+		if (fd < 0) {
+			MangoHudLost("socket", errno);
+			return;
+		}
+		sockaddr_un addr {};
+		addr.sun_family  = AF_UNIX;
+		const size_t len = std::strlen(g_hud_socket);
+		std::memcpy(addr.sun_path + 1, g_hud_socket, len); // abstract name: a leading NUL, no file (mesa os_socket.c)
+		if (::connect(fd, reinterpret_cast<sockaddr*>(&addr), static_cast<socklen_t>(offsetof(sockaddr_un, sun_path) + 1 + len)) != 0) {
