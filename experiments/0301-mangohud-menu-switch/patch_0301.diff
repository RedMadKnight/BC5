+__attribute__((constructor)) void MangoHudEnvironment() {
+	const char* sw = std::getenv("KYTY_BC5_MANGOHUD");
+	if (sw != nullptr && std::strcmp(sw, "0") == 0) {
+		return;
+	}
+	if (sw != nullptr && std::strcmp(sw, "1") == 0) {
+		g_hud_on.store(true, std::memory_order_release);
+	}
+	if (std::getenv("MANGOHUD_CONFIG") != nullptr || std::getenv("MANGOHUD_CONFIGFILE") != nullptr) {
+		return; // a layout of the caller's own: MangoHud loads with it (MANGOHUD=1 is the caller's too), unswitched
+	}
