+// BC5 (experiment 0203): KYTY_BC5_APR_READAHEAD=<n> (1-16; off by default) gives each priority's queue n reader
+// threads beside its worker. In the second title's cutscene bursts (80-125 submissions a second) one serial worker
+// per priority fell 3-16 s behind, and the cutscene clock voice's next read came late or never (exps 0200, 0203).
+// A reader takes a queued buffer from the first 64 and reads its file ranges into host memory ahead of time. The
+// worker still takes the buffers in order and runs every command at its turn; at a read it copies the host data
+// into the guest (after the same range check) instead of reading the file. Guest memory is therefore written in
+// the original order (maps, waits, reads, events and the title's completion sequence all keep it); only the file
+// I/O goes ahead. The first version wrote into the guest from the readers and faulted on AMM pages an earlier
+// buffer had not mapped yet. KYTY_BC5_APR_READAHEAD_MIB (default 32) caps the host memory held for read-ahead data.
+static size_t AprReadahead() {
+	static const size_t n = [] {
+		const char* e = std::getenv("KYTY_BC5_APR_READAHEAD");
+		const long  v = e != nullptr ? std::strtol(e, nullptr, 10) : 0;
+		return v > 0 ? static_cast<size_t>(std::min<long>(v, 16)) : size_t {0};
+	}();
+	return n;
+}
+
+static uint64_t AprReadaheadCap() {
+	static const uint64_t cap = [] {
+		const char* e = std::getenv("KYTY_BC5_APR_READAHEAD_MIB");
+		const long  v = e != nullptr ? std::strtol(e, nullptr, 10) : 32;
+		return static_cast<uint64_t>(std::max<long>(v, 1)) << 20u;
+	}();
+	return cap;
