+// BC5 (experiment 0203): KYTY_BC5_APR_FILE_JOURNAL=<file id>[,<file id>...] (hex) journals on stderr what
+// becomes of the APR reads of those files: each ReadFile record (command buffer, offset, size, destination,
+// result, caller), the completion commands recorded into the same buffer (address writes, address waits,
+// kernel events), the buffer's submit (priority, submission id, queue depth), each of its commands as it runs,
+// and its finish. With the switch set, every ReadFile record and every submit that fails is journaled too,
+// whatever the file (the first 200, then every 1000th). The second title's cutscene clock voice is file
+// 0x7cd713df (exp 0200), whose next loop's read stopped coming in a cutscene. Off by default. Lines start with
+// "apr journal (exp 0203): mono <CLOCK_MONOTONIC s>".
+static const std::vector<uint32_t>& AprJournalFiles() {
+	static const std::vector<uint32_t> files = [] {
+		std::vector<uint32_t> v;
+		const char*           e = BC5_DIAG_ENV("KYTY_BC5_APR_FILE_JOURNAL");
+		for (const char* p = e; p != nullptr && *p != '\0';) {
+			char*      end = nullptr;
+			const auto id  = std::strtoul(p, &end, 16);
+			if (end == p) {
+				break;
+			}
+			v.push_back(static_cast<uint32_t>(id));
+			p = (*end == ',') ? end + 1 : end;
+		}
+		return v;
+	}();
+	return files;
+}
+static bool AprJournalOn() {
+	return !AprJournalFiles().empty();
+}
+static bool AprJournalFile(uint32_t file_id) {
+	const auto& v = AprJournalFiles();
+	return std::find(v.begin(), v.end(), file_id) != v.end();
+}
+static void AprJournal(const char* fmt, ...) __attribute__((format(printf, 1, 2)));
+static void AprJournal(const char* fmt, ...) {
+	timespec ts {};
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	char    line[512];
+	va_list args;
+	va_start(args, fmt);
+	std::vsnprintf(line, sizeof(line), fmt, args);
+	va_end(args);
+	std::fprintf(stderr, "apr journal (exp 0203): mono %.3f %s\n",
+	             static_cast<double>(ts.tv_sec) + static_cast<double>(ts.tv_nsec) / 1e9, line);
+}
+// Failures of any file: the first 200, then every 1000th.
+static bool AprJournalFailureDue() {
+	static std::atomic<uint64_t> n {0};
+	const auto                   k = ++n;
+	return k <= 200 || k % 1000 == 0;
+}
