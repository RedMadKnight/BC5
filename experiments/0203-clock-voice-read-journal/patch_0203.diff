+		const size_t     window = std::min<size_t>(queue.size(), 64);
+		for (size_t i = 0; i < window && pick == nullptr; i++) {
+			auto& b = queue[i];
+			if (b.ra_state != 0 || b.next != 0 || b.state.read_file_commands.empty()) {
