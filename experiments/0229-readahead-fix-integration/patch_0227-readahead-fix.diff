+// BC5 (experiment 0227): with the read-ahead on, level loads took much longer in both titles (the maintainer,
+// 2026-10-22). The readers took the large loading buffers and read them at the same time as each other and the worker,
+// often from one archive. bc5-mount decodes ahead only for a file read in order (its per-file stream: a read starting
+// within 1 MiB of where the file's last read ended; tools/bc5-mount/src/fuse.rs), so it likely decoded every block on
+// demand (TODO(verify): exp 0227's load-time A/B). And a buffer the worker reads on KYTY_BC5_APR_PARALLEL threads
+// (exp 0112) was read serially by one reader. Now a reader leaves to the worker
+// a buffer whose reads total more than KYTY_BC5_APR_READAHEAD_MAX_KIB (default 1024; 0 = no limit), and any buffer the
+// worker would read in parallel. Large loads run as before exp 0203; small streaming reads, such as the cutscene clock
+// voice's (about 90 KiB), keep the read-ahead.
+static uint64_t AprReadaheadMaxBuffer() {
+	static const uint64_t max = [] {
+		const char* e = std::getenv("KYTY_BC5_APR_READAHEAD_MAX_KIB");
+		const long  v = e != nullptr ? std::strtol(e, nullptr, 10) : 1024;
+		return v > 0 ? static_cast<uint64_t>(v) << 10u : uint64_t {0};
+	}();
+	return max;
+}
