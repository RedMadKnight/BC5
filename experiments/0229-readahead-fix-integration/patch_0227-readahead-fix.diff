+// BC5 (experiment 0227): true when the worker would read part of b on KYTY_BC5_APR_PARALLEL threads.
+static bool AprWorkerReadsInParallel(const ParkedAprBuffer& b) {
+	if (AprParallelReads() == 0) {
+		return false;
+	}
+	for (size_t pos = 0; pos < b.ordered.size(); pos++) {
+		if (b.ordered[pos].kind == CommandKind::ReadFile && AprParallelReadRun(b.state, b.ordered, pos) > pos + 1) {
+			return true;
+		}
+	}
+	return false;
+}
