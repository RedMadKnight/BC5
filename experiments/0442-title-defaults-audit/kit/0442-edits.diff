@@ -0,0 +1,19 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// BC5 experiment 0442 (tag tg442): BC5_DIRECT_INDIRECT_DRAWS read as one mode in both of its places. Unset, empty and
+// "0" are off (the code default: DRAW_INDIRECT 0x24 and the multi-draws 0x2c/0x38 dropped, no drop after a given-up
+// wait); "multi" lets all of them through; any other value lets DRAW_INDIRECT through only (exps 0054, 0057). Before
+// exp 0442 "0" counted as set.
+#pragma once
+
+#include <cstring>
+
+namespace bc5 {
+
+enum class IndirectDraws { off, draw, multi };
+
+inline IndirectDraws indirect_draws_mode(const char* e) {
+	if (e == nullptr || e[0] == 0 || std::strcmp(e, "0") == 0) return IndirectDraws::off;
+	return std::strcmp(e, "multi") == 0 ? IndirectDraws::multi : IndirectDraws::draw;
+}
+
+} // namespace bc5
