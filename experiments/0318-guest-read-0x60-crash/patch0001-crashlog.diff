+// BC5 (experiment 0318): the crash diagnostics of KytyExceptionHandler go to stderr through RawLog,
+// whatever the printf direction (the launchers pass --printf-direction Silent, which drops every LOGF)
+// and the session's logging switch; before, a crash left only the register dump in the play log.
+// Text is gathered per line so a byte dump stays one line; vsnprintf into a fixed buffer, no allocation.
+#if defined(__GNUC__) || defined(__clang__)
+__attribute__((format(printf, 1, 2)))
+#endif
+static void Bc5CrashLog(const char* format, ...) {
+	static thread_local char   line[1024];
+	static thread_local size_t len = 0;
+	va_list                    args;
+	va_start(args, format);
+	const int n = std::vsnprintf(line + len, sizeof(line) - len, format, args);
+	va_end(args);
+	if (n > 0) {
+		len = std::min(len + static_cast<size_t>(n), sizeof(line) - 1);
+	}
+	if (len > 0 && (line[len - 1] == '\n' || len >= sizeof(line) - 64)) {
+		Common::HostException::RawLog log;
+		log.Append(line);
+		log.Flush();
+		len = 0;
+	}
+}
