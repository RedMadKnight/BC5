+// view instead of one per freshly written 2 MiB chunk during the loads.
+static bool fs421_eager_on() {
+	static const bool on = [] {
+		const char* e = std::getenv("BC5_DIRECT_FS_EAGER");
+		const bool  v = !(e != nullptr && e[0] == '0' && e[1] == 0);
