+void GameController::Touch(int id, int finger, bool down, float x, float y) {
+	Common::LockGuard lock(m_mutex);
+
+	if (finger < 0 || finger > 1) {
+		return;
+	}
+	int slot = OwnerSlot(id);
+	if (slot == -1) {
+		slot = FallbackSlot();
+	}
+	EnsureSlot(slot);
+	auto&      s     = m_slots[static_cast<size_t>(slot)];
+	const auto scale = [](float v, int size) {
+		const int p = static_cast<int>(v * static_cast<float>(size) + 0.5f);
+		return static_cast<uint16_t>(p < 0 ? 0 : (p >= size ? size - 1 : p));
+	};
+	const bool contact = down && !s.finger_down[finger];
+	if (contact) {
+		// TODO(verify) how the console numbers contacts; here 1..127, a new one per contact.
+		s.last_finger_id   = static_cast<uint8_t>(s.last_finger_id % 127 + 1);
+		s.finger_id[finger] = s.last_finger_id;
+	}
+	const bool lift        = !down && s.finger_down[finger];
+	s.finger_down[finger] = down;
+	s.finger_x[finger]    = scale(x, PAD_TOUCH_RESOLUTION_X);
+	s.finger_y[finger]    = scale(y, PAD_TOUCH_RESOLUTION_Y);
+
+	static const bool trace_env = BC5_DIAG_ENV("KYTY_BC5_INPUT_TRACE") != nullptr;
+	if (trace_env && ::Log::Bc5LoggingOn() && (contact || lift)) {
+		std::fprintf(stderr, "input trace: t=%.3f touch finger %d %s at %u,%u id %u -> slot %d\n", InputTraceSeconds(), finger,
+		             contact ? "down" : "up", s.finger_x[finger], s.finger_y[finger], s.finger_id[finger], slot);
+		std::fflush(stderr);
+	}
+}
