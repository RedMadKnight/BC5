+// Ports pack 1 (notes/ports-20261118.md H1): CONTEXT_REG_RMW (type-3 opcode 0x51) has no row in pm4-policy.tsv, so
+// `default-op drop` NOP-s it. AnyPS5 (6cec611cd0, Pm4.cpp, from PAL) runs it as a masked register write
+// (CB_COLORn_INFO, DB_Z_INFO, DB_COUNT_CONTROL, DCC_CONTROL). This only COUNTS how often a title sends it and how often
+// it is dropped; nothing about the packet changes (a pass row needs the maintainer's word). The count is process-wide
+// and printed at the 1st, 2nd, 4th, 8th ... packet seen, so a run that ends in a crash still shows it.
+namespace {
+std::atomic<std::uint64_t> g_ctx_reg_rmw_seen {0};
+std::atomic<std::uint64_t> g_ctx_reg_rmw_dropped {0};
+
+void note_ctx_reg_rmw(bool dropped, std::uint32_t len, std::uint32_t reg_offset) {
+    const std::uint64_t d = dropped ? g_ctx_reg_rmw_dropped.fetch_add(1, std::memory_order_relaxed) + 1
+                                    : g_ctx_reg_rmw_dropped.load(std::memory_order_relaxed);
+    const std::uint64_t n = g_ctx_reg_rmw_seen.fetch_add(1, std::memory_order_relaxed) + 1;
+    if ((n & (n - 1)) == 0) {
+        std::fprintf(stderr,
+                     "[bc5] ports pack 1: CONTEXT_REG_RMW (0x51) seen %llu, dropped %llu (this one: len %u, reg 0x%x, %s)\n",
+                     static_cast<unsigned long long>(n), static_cast<unsigned long long>(d), len, reg_offset,
+                     dropped ? "dropped" : "kept");
+    }
+}
+} // namespace
