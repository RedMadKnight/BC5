+// ports pack 1, K6 (KytyPS5 21124245, GPL-2.0, hostException.cpp:169-207): a per-thread alternate signal stack.
+// BC5 change: 256 KiB, not upstream's 64 KiB, because our fault path also writes exp 0412's fault record; and a
+// failure is reported once and the thread keeps running on its own stack (upstream ends the process).
+namespace {
+class Bc5ThreadSignalStack {
+public:
+	Bc5ThreadSignalStack() {
+		const auto page_size  = static_cast<size_t>(::getpagesize());
+		const auto want       = static_cast<size_t>(256 * 1024) > static_cast<size_t>(MINSIGSTKSZ) ? static_cast<size_t>(256 * 1024)
+		                                                                                       : static_cast<size_t>(MINSIGSTKSZ);
+		const auto stack_size = (want + page_size - 1) & ~(page_size - 1);
+		if (::posix_memalign(&m_memory, page_size, stack_size) != 0) {
+			m_memory = nullptr;
+			return;
+		}
+		stack_t stack {};
+		stack.ss_sp   = m_memory;
+		stack.ss_size = stack_size;
+		if (::sigaltstack(&stack, &m_previous) != 0) {
+			std::free(m_memory);
+			m_memory = nullptr;
+		}
+	}
+	~Bc5ThreadSignalStack() {
+		if (m_memory != nullptr && ::sigaltstack(&m_previous, nullptr) == 0) {
+			std::free(m_memory);
+		}
+	}
+	Bc5ThreadSignalStack(const Bc5ThreadSignalStack&)            = delete;
+	Bc5ThreadSignalStack& operator=(const Bc5ThreadSignalStack&) = delete;
+	[[nodiscard]] bool IsInitialized() const { return m_memory != nullptr; }
+
+private:
+	void*   m_memory = nullptr;
+	stack_t m_previous {};
+};
+} // namespace
+
+bool InitializeThreadSignalStack() {
+	if (!BC5_P1("KYTY_BC5_P1_ALTSTACK")) {
+		return true;
+	}
+	thread_local Bc5ThreadSignalStack signal_stack;
+	if (!signal_stack.IsInitialized()) {
+		static std::atomic<bool> told {false};
+		if (!told.exchange(true)) {
+			std::fprintf(stderr, "[bc5] ports pack 1 K6: sigaltstack failed for a thread; it handles faults on its own stack\n");
+		}
+		return false;
+	}
+	return true;
+}
+#endif
