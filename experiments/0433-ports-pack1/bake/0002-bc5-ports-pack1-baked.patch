+// The protection of the page holding `addr` as the kernel has it, PROT_* bits; PROT_NONE when not mapped or unreadable.
+static int Bc5P1KernelProt(uintptr_t addr) {
+	int         prot = PROT_NONE;
+	std::FILE* f    = std::fopen("/proc/self/maps", "r");
+	if (f == nullptr) {
+		return prot;
+	}
+	char line[512];
+	while (std::fgets(line, sizeof(line), f) != nullptr) {
+		unsigned long long lo = 0;
+		unsigned long long hi = 0;
+		char               perms[5] {};
+		if (std::sscanf(line, "%llx-%llx %4s", &lo, &hi, perms) != 3) {
+			continue;
+		}
+		if (addr >= lo && addr < hi) {
+			prot = (perms[0] == 'r' ? PROT_READ : 0) | (perms[1] == 'w' ? PROT_WRITE : 0) | (perms[2] == 'x' ? PROT_EXEC : 0);
+			break;
+		}
+	}
+	std::fclose(f);
+	return prot;
+}
