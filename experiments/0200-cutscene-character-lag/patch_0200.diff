 static std::mutex                                     g_ajm_instances_mutex;
 static std::unordered_map<uint32_t, AjmInstanceState> g_ajm_instances;
 
+// BC5 (experiment 0200): KYTY_BC5_AJM_UNIQUE_IDS. An instance id is codec << 14 | a 14-bit slot from a counter
+// that comes round every 16,384 creations, and AjmInstanceCreate assigned g_ajm_instances[id] over an instance
+// still live on that id; the destroy of either then erased the other, whose decodes from then on return
+// AJM_RESULT_INVALID_PARAMETER and no samples. The second title creates ~3,000 instances a minute in fights,
+// and its long-lived clock voice, which its cutscenes follow, stood still (exp 0200).
+//   =log  journal on stderr each id assigned over a live instance, each destroy of an id not present and the
+//         first decode on a missing instance (then every 1024th); the behaviour stays as it was
+//   =1    skip ids that are live, as AnyPS5 does (core/libs/prx/libSceAjm.native/src/Ajm.cpp:1723-1740 @
+//         27c88a8, GPL-2.0), with AJM_ERROR_OUT_OF_RESOURCES when all 16,384 are; and journal each skip
+// Off (0) by default. Lines start with "ajm ids (exp 0200): mono <CLOCK_MONOTONIC s>".
+static int AjmUniqueIdsMode() {
+	static const int mode = [] {
+		const char* e = std::getenv("KYTY_BC5_AJM_UNIQUE_IDS");
+		if (e == nullptr || *e == '\0' || std::strcmp(e, "0") == 0) {
+			return 0;
+		}
+		return std::strcmp(e, "log") == 0 ? 1 : 2;
+	}();
+	return mode;
+}
+
+static double AjmMonoNow() {
+	timespec ts {};
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return static_cast<double>(ts.tv_sec) + static_cast<double>(ts.tv_nsec) / 1e9;
+}
+
+// g_ajm_instances_mutex held.
+static void AjmJournalLiveId(const char* what, uint32_t id, const AjmInstanceState& old, uint32_t codec,
+                             uint32_t counter) {
+	const double now = AjmMonoNow();
+	std::fprintf(stderr,
+	             "ajm ids (exp 0200): mono %.3f %s 0x%05x: live instance codec %u, age %.1f s, %" PRIu64
+	             " jobs, %" PRIu64 " bytes, %" PRIu64 " samples; new codec %u; counter %u (wrap %u)\n",
+	             now, what, id, old.codec, now - old.bc5_created, old.bc5_jobs, old.bc5_bytes, old.bc5_samples,
+	             codec, counter, counter >> 14u);
+}
