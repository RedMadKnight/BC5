+static const char* x0308_inside(uint64_t a, CompExt* out) {
+	std::lock_guard<std::mutex> lk(g_x0308_m);
+	for (auto it = g_x0308_comp.rbegin(); it != g_x0308_comp.rend(); ++it) {
+		const char* k = nullptr;
