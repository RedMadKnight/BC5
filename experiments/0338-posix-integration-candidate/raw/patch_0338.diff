+static FILE* bc5_import_log() {
+	static FILE* f = [] {
+		const char* p = std::getenv("BC5_IMPORT_LOG");
+		FILE*       x = p != nullptr && *p != 0 ? std::fopen(p, "a") : nullptr;
+		if (x != nullptr) {
