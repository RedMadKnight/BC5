+void Bc5DiagText(const char* line) {
+	if (FILE* f = bc5_import_log(); f != nullptr) {
+		static std::mutex m;
+		std::lock_guard   lock(m);
+		std::fprintf(f, "%.3f %s\n", bc5_import_now(), line);
