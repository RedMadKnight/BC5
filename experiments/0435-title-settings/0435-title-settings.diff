+// Experiment 0435: the input configuration this run reads and saves: the title's own file,
+// <menu dir>/titles/<TITLE_ID>/input.cfg, seeded from KYTY_BC5_INPUT_CONFIG on the title's first start; the
+// shared file without a title id or with KYTY_BC5_TITLE_SETTINGS=0 (kSoft default 1). Empty: no file at all.
+bc5::title_settings::Resolved ResolveConfig() {
+	const char* shared = std::getenv("KYTY_BC5_INPUT_CONFIG");
+	if (shared == nullptr || *shared == 0) return {};
+	if (!bc5::env_rule::on(std::getenv("KYTY_BC5_TITLE_SETTINGS"))) return {shared, shared, "", "KYTY_BC5_TITLE_SETTINGS off: the shared file"};
+	namespace ts = bc5::title_settings;
+	return ts::Resolve(ts::TitlesRoot(std::getenv("KYTY_BC5_MENU_DIR"), shared), HostInputTitleId(), shared);
+}
 
