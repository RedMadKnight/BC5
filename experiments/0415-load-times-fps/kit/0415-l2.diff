@@ -0,0 +1,90 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Experiment 0415 (tag ls415b/c): an APR file read as open + posix_fadvise(POSIX_FADV_RANDOM) + pread, for
+// KYTY_BC5_APR_POSIX. Every APR read used to open its file anew and read it with fread; a fresh descriptor has no
+// read-ahead history, so the kernel read ahead of each read and the disk delivered 2.2-2.4 times the bytes the title
+// asked for (exp 0415 section 6). Pure POSIX, no host types: experiments/0415-load-times-fps/kit/test0415apr.cpp
+// tests it against a plain read of the same file.
+#pragma once
+
+#if defined(__linux__)
+
+#include <algorithm>
+#include <cerrno>
+#include <cstdint>
+#include <cstring>
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#include <vector>
+
+namespace bc5::apr_posix {
+
+// Opens the file for one read of [offset, offset + size). Returns the descriptor (advised random) or -1 when the file
+// cannot be opened or is not a regular file. *readable is what the file holds of the range (0 past its end).
+inline int open_for_read(const char* host_path, uint64_t file_offset, uint64_t size, uint64_t* readable) {
+	*readable    = 0;
+	const int fd = ::open(host_path, O_RDONLY | O_CLOEXEC);
+	if (fd < 0) return -1;
+	struct stat sb {};
+	if (::fstat(fd, &sb) != 0 || !S_ISREG(sb.st_mode)) {
+		::close(fd);
+		return -1;
+	}
+	::posix_fadvise(fd, 0, 0, POSIX_FADV_RANDOM);
+	const auto file_size = static_cast<uint64_t>(sb.st_size);
+	if (file_offset < file_size) *readable = std::min<uint64_t>(size, file_size - file_offset);
+	return fd;
+}
+
+// Reads up to `want` bytes at `offset` into dst, `chunk` bytes per call at most. Returns the bytes read: fewer than
+// `want` at the end of the file or on an error. *efault (when given) is set if the kernel refused the destination.
+inline uint64_t pread_all(int fd, uint8_t* dst, uint64_t want, uint64_t offset, uint64_t chunk, bool* efault) {
+	uint64_t done = 0;
+	while (done < want) {
+		const ssize_t r = ::pread(fd, dst + done, static_cast<size_t>(std::min<uint64_t>(want - done, chunk)), static_cast<off_t>(offset + done));
+		if (r < 0) {
+			if (errno == EINTR) continue;
+			if (errno == EFAULT && efault != nullptr) *efault = true;
+			break;
+		}
+		if (r == 0) break;
+		done += static_cast<uint64_t>(r);
+	}
+	return done;
+}
+
+// One whole read into memory at `dest`. direct: pread straight into dest; where the kernel refuses the destination
+// (EFAULT: a page the process can only reach through its own fault handler) the rest goes the old way, through a
+// staging buffer and memcpy, which takes the fault as any other access of the process does. Not direct: all of it
+// through the staging buffer. Returns 0, or -1 when the file cannot be opened. *bytes_read is what arrived at dest;
+// *staged_bytes (when given) how much of it went through the staging buffer.
+inline int read_to(const char* host_path, uint64_t file_offset, uint64_t size, uint8_t* dest, bool direct, uint64_t chunk, uint64_t* bytes_read,
+                   uint64_t* staged_bytes = nullptr) {
+	*bytes_read = 0;
+	if (staged_bytes != nullptr) *staged_bytes = 0;
+	uint64_t  readable = 0;
+	const int fd       = open_for_read(host_path, file_offset, size, &readable);
+	if (fd < 0) return -1;
+	bool staged = !direct;
+	if (!staged && readable != 0) {
+		bool efault = false;
+		*bytes_read = pread_all(fd, dest, readable, file_offset, chunk, &efault);
+		staged      = efault;
+	}
+	if (staged && *bytes_read < readable) {
+		std::vector<uint8_t> staging(static_cast<size_t>(std::min<uint64_t>(chunk, readable - *bytes_read)));
+		while (*bytes_read < readable) {
+			const uint64_t got = pread_all(fd, staging.data(), std::min<uint64_t>(staging.size(), readable - *bytes_read), file_offset + *bytes_read, chunk, nullptr);
+			if (got == 0) break;
+			std::memcpy(dest + *bytes_read, staging.data(), static_cast<size_t>(got));
+			*bytes_read += got;
+			if (staged_bytes != nullptr) *staged_bytes += got;
+		}
+	}
+	::close(fd);
+	return 0;
+}
+
+} // namespace bc5::apr_posix
+
+#endif // __linux__
