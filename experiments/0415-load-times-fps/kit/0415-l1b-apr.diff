 // (nothing past the end of the file; OK with no data at or past the end), without touching guest memory.
+// Experiment 0415 (ls415b), KYTY_BC5_APR_POSIX, default off (unset, empty, "0"). Run b1 measured the cause: every APR
+// read opens its file anew, so the kernel takes each one for the start of a sequential stream and reads ahead: the
+// disk delivered 11.7 GiB for 5.1 GiB asked in the menu load, at the NVMe's limit, with a read outstanding 97 % of
+// the time. "random" (or 1): the read uses open + posix_fadvise(POSIX_FADV_RANDOM) + pread, through the same staging
+// buffer and memcpy as before. "direct": that, and the bytes are read straight into the guest's pages (no staging
+// buffer, no second copy); a destination the kernel refuses (EFAULT) falls back to the staging copy for the rest.
+static int AprPosixMode() {
+#if defined(__linux__)
+	static const int mode = [] {
+		const char* e = std::getenv("KYTY_BC5_APR_POSIX");
+		if (!bc5::load_stat::env_set(e)) return 0;
+		const int m = std::strcmp(e, "direct") == 0 ? 2 : 1;
+		std::fprintf(stderr, "[bc5] exp 0415: APR reads by pread with POSIX_FADV_RANDOM%s (tag ls415b)\n", m == 2 ? ", straight into the guest" : "");
+		std::fflush(stderr);
+		return m;
+	}();
+	return mode;
+#else
+	return 0;
+#endif
