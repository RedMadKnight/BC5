+#if defined(__linux__)
+// Opens the file for one read of [offset, offset + size): the descriptor (advised random), or -1 when it cannot be
+// opened; *readable is what the file holds of the range.
+static int AprPosixOpen(const std::string& host_path, uint64_t file_offset, uint64_t size, uint64_t* readable) {
+	*readable    = 0;
+	const int fd = ::open(host_path.c_str(), O_RDONLY | O_CLOEXEC);
+	if (fd < 0) return -1;
+	struct stat sb {};
+	if (::fstat(fd, &sb) != 0 || !S_ISREG(sb.st_mode)) {
+		::close(fd);
+		return -1;
+	}
+	::posix_fadvise(fd, 0, 0, POSIX_FADV_RANDOM);
+	const auto file_size = static_cast<uint64_t>(sb.st_size);
+	if (file_offset < file_size) *readable = std::min<uint64_t>(size, file_size - file_offset);
+	return fd;
+}
+
+// Reads up to `want` bytes at `offset` into dst; the bytes read (a short count at the end of the file or on an
+// error; *efault says the kernel refused the destination).
+static uint64_t AprPosixPread(int fd, uint8_t* dst, uint64_t want, uint64_t offset, bool* efault) {
+	uint64_t done = 0;
+	while (done < want) {
+		const ssize_t r = ::pread(fd, dst + done, static_cast<size_t>(std::min<uint64_t>(want - done, APR_HOST_READ_CHUNK_SIZE)), static_cast<off_t>(offset + done));
+		if (r < 0) {
+			if (errno == EINTR) continue;
+			if (errno == EFAULT && efault != nullptr) *efault = true;
+			break;
+		}
+		if (r == 0) break;
+		done += static_cast<uint64_t>(r);
+	}
+	return done;
+}
+#endif
