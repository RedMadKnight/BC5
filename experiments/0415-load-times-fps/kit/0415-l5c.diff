+// BC5 experiment 0415 (tag as415), stage S5 of experiments/0415-load-times-fps/DESIGN-lock-side.md: the pieces of the
+// anonymous sync that the submission path and the checking thread share, kept apart from the device so that they can be
+// tested on any CPU (experiments/0415-load-times-fps/kit/test0415anon.cpp).
+#pragma once
+
+#include <cinttypes>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+
+namespace bc5::anon_sync {
+
+inline constexpr uint64_t kGuestMin = 0x40000ull, kGuestMax = 0xfbffffffffull;
+
+// One line of /proc/self/maps: true when it is a readable anonymous VMA inside the guest's address span (not backed by
+// a file, not [stack]/[heap]/...); the rule sync_mappings has used since experiment 0016.
+inline bool parse_line(const char* line, uint64_t* start, uint64_t* end, bool* readonly) {
+	uint64_t s = 0, e = 0, offset = 0, inode = 0;
+	char     perms[8] = {};
+	char     dev[16]  = {};
+	if (std::sscanf(line, "%" SCNx64 "-%" SCNx64 " %7s %" SCNx64 " %15s %" SCNu64, &s, &e, perms, &offset, dev, &inode) < 6) return false;
+	if (perms[0] != 'r' || inode != 0 || s < kGuestMin || e > kGuestMax + 1) return false;
+	if (std::strchr(line, '/') != nullptr || std::strchr(line, '[') != nullptr) return false;
+	*start    = s;
+	*end      = e;
+	*readonly = perms[1] != 'w';
+	return true;
+}
+
+// KYTY_BC5_ANON_SYNC: 0 off (unset, empty, "0"); 2 "thread" (the submission path leaves the walk out while the checking
+// thread's last pass saw what the last walk saw); 1 anything else ("verify": the walk runs as before and
+// is compared with what "thread" would have done).
+inline int mode_of(const char* e) {
+	if (e == nullptr || e[0] == '\0' || std::strcmp(e, "0") == 0) return 0;
+	return std::strcmp(e, "thread") == 0 ? 2 : 1;
+}
+
+// The signature of what a walk acts on: the list of VMAs and, inside each, the resident runs at the walk's 64 KiB grain.
+// Two walks with the same signature (and the same mappings on the device) add and drop nothing.
+inline constexpr uint64_t kSigEmpty = 0x9e3779b97f4a7c15ull;
+inline uint64_t fold(uint64_t h, uint64_t v) {
+	h ^= v + 0x9e3779b97f4a7c15ull + (h << 6u) + (h >> 2u);
+	return h * 0xff51afd7ed558ccdull;
+}
+inline uint64_t sig_vma(uint64_t h, uint64_t start, uint64_t end, bool readonly) {
+	return fold(fold(fold(h, start), end), readonly ? 3 : 1);
+}
+// vec: mincore's bytes for [start, end), bit 0 = resident. The runs are rounded as sync_mappings rounds them.
+inline uint64_t sig_runs(uint64_t h, uint64_t start, uint64_t end, const unsigned char* vec, size_t pages) {
+	constexpr uint64_t kPage = 4096, kGrain = 65536;
+	size_t i = 0;
+	while (i < pages) {
+		while (i < pages && (vec[i] & 1) == 0) i++;
+		if (i >= pages) break;
+		size_t j = i;
+		while (j < pages && (vec[j] & 1) != 0) j++;
+		const uint64_t a = start + (i * kPage / kGrain) * kGrain;
+		uint64_t       b = start + ((j * kPage + kGrain - 1) / kGrain) * kGrain;
+		if (b > end) b = end;
+		h = fold(fold(h, a), b);
+		i = j;
+	}
+	return h;
+}
+
+// May the submission path leave the walk out? Only when the thread has finished at least one pass and its last pass
+// saw exactly what the last walk on the submission path saw (the same VMAs, the same resident runs), and that walk's
+// result still stands (no device reopen since).
+inline bool can_skip(uint64_t thread_passes, uint64_t thread_sig, bool walk_valid, uint64_t walk_sig) {
+	return thread_passes != 0 && walk_valid && thread_sig == walk_sig;
+}
+
+} // namespace bc5::anon_sync
