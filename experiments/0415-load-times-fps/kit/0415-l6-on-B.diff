+// thread's last pass saw what the last walk saw); 3 "events" (tag as415c: no thread; the walk runs at the first call
+// after a host call that made anonymous memory readable in the guest's span, and otherwise only while the last walk's
+// list was not empty); 1 anything else ("verify": the walk runs as before and is compared with what "thread" and
+// "events" would have done).
 inline int mode_of(const char* e) {
 	if (e == nullptr || e[0] == '\0' || std::strcmp(e, "0") == 0) return 0;
+	if (std::strcmp(e, "events") == 0) return 3;
 	return std::strcmp(e, "thread") == 0 ? 2 : 1;
 }
 
+// Tag as415c (DESIGN-lock-side.md section 8). One process-wide counter of the host calls that can make anonymous
+// memory readable inside the guest's span: an anonymous map with a readable protection, or a protect call that turns
+// reading on. The sites call note() AFTER the kernel call has succeeded, so a walk that read the counter before its
+// read of /proc/self/maps either sees the mapping or sees the counter move at the next call. A protect site cannot
+// tell a file view from an anonymous range, so it notes every readable protect in the span: too often is safe (one
+// walk more), too rarely is not. The console needs none of this: there a mapping is visible to the GPU when the call
+// that made it returns [inferred: one address space for CPU and GPU]; the rule kept here is "walked by the first
+// submission after the call".
+inline std::atomic<uint64_t>& events() {
+	static std::atomic<uint64_t> v {0};
+	return v;
+}
+inline bool in_span(uint64_t addr, uint64_t len) {
+	return len != 0 && addr <= kGuestMax && addr + len > kGuestMin;
+}
+inline void note(uint64_t addr, uint64_t len, bool readable) {
+	if (readable && in_span(addr, len)) events().fetch_add(1, std::memory_order_release);
+}
+// "events": must this call walk at once (whatever the time limits say)? Yes when no walk stands (start, device
+// reopen) or the counter has moved since the last walk read it.
+inline bool events_moved(uint64_t ev_now, uint64_t ev_at_walk, bool walk_valid) {
+	return !walk_valid || ev_now != ev_at_walk;
+}
+// "events": may this call leave the walk out altogether? Only when the counter has not moved and the last walk found
+// no anonymous guest VMA at all (inside such a VMA pages become resident without any call, so while one exists the
+// walk keeps its old timing).
+inline bool events_skip(bool moved, bool last_list_empty) {
+	return !moved && last_list_empty;
+}
