diff --git a/src/bc5/apr_posix.hpp b/src/bc5/apr_posix.hpp
new file mode 100644
index 0000000..9bd3c5d
--- /dev/null
+++ b/src/bc5/apr_posix.hpp
@@ -0,0 +1,90 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Experiment 0415 (tag ls415b/c): an APR file read as open + posix_fadvise(POSIX_FADV_RANDOM) + pread, for
+// KYTY_BC5_APR_POSIX. Every APR read used to open its file anew and read it with fread; a fresh descriptor has no
+// read-ahead history, so the kernel read ahead of each read and the disk delivered 2.2-2.4 times the bytes the title
+// asked for (exp 0415 section 6). Pure POSIX, no host types: experiments/0415-load-times-fps/kit/test0415apr.cpp
+// tests it against a plain read of the same file.
+#pragma once
+
+#if defined(__linux__)
+
+#include <algorithm>
+#include <cerrno>
+#include <cstdint>
+#include <cstring>
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#include <vector>
+
+namespace bc5::apr_posix {
+
+// Opens the file for one read of [offset, offset + size). Returns the descriptor (advised random) or -1 when the file
+// cannot be opened or is not a regular file. *readable is what the file holds of the range (0 past its end).
+inline int open_for_read(const char* host_path, uint64_t file_offset, uint64_t size, uint64_t* readable) {
+	*readable    = 0;
+	const int fd = ::open(host_path, O_RDONLY | O_CLOEXEC);
+	if (fd < 0) return -1;
+	struct stat sb {};
+	if (::fstat(fd, &sb) != 0 || !S_ISREG(sb.st_mode)) {
+		::close(fd);
+		return -1;
+	}
+	::posix_fadvise(fd, 0, 0, POSIX_FADV_RANDOM);
+	const auto file_size = static_cast<uint64_t>(sb.st_size);
+	if (file_offset < file_size) *readable = std::min<uint64_t>(size, file_size - file_offset);
+	return fd;
+}
+
+// Reads up to `want` bytes at `offset` into dst, `chunk` bytes per call at most. Returns the bytes read: fewer than
+// `want` at the end of the file or on an error. *efault (when given) is set if the kernel refused the destination.
+inline uint64_t pread_all(int fd, uint8_t* dst, uint64_t want, uint64_t offset, uint64_t chunk, bool* efault) {
+	uint64_t done = 0;
+	while (done < want) {
+		const ssize_t r = ::pread(fd, dst + done, static_cast<size_t>(std::min<uint64_t>(want - done, chunk)), static_cast<off_t>(offset + done));
+		if (r < 0) {
+			if (errno == EINTR) continue;
+			if (errno == EFAULT && efault != nullptr) *efault = true;
+			break;
+		}
+		if (r == 0) break;
+		done += static_cast<uint64_t>(r);
+	}
+	return done;
+}
+
+// One whole read into memory at `dest`. direct: pread straight into dest; where the kernel refuses the destination
+// (EFAULT: a page the process can only reach through its own fault handler) the rest goes the old way, through a
+// staging buffer and memcpy, which takes the fault as any other access of the process does. Not direct: all of it
+// through the staging buffer. Returns 0, or -1 when the file cannot be opened. *bytes_read is what arrived at dest;
+// *staged_bytes (when given) how much of it went through the staging buffer.
+inline int read_to(const char* host_path, uint64_t file_offset, uint64_t size, uint8_t* dest, bool direct, uint64_t chunk, uint64_t* bytes_read,
+                   uint64_t* staged_bytes = nullptr) {
+	*bytes_read = 0;
+	if (staged_bytes != nullptr) *staged_bytes = 0;
+	uint64_t  readable = 0;
+	const int fd       = open_for_read(host_path, file_offset, size, &readable);
+	if (fd < 0) return -1;
+	bool staged = !direct;
+	if (!staged && readable != 0) {
+		bool efault = false;
+		*bytes_read = pread_all(fd, dest, readable, file_offset, chunk, &efault);
+		staged      = efault;
+	}
+	if (staged && *bytes_read < readable) {
+		std::vector<uint8_t> staging(static_cast<size_t>(std::min<uint64_t>(chunk, readable - *bytes_read)));
+		while (*bytes_read < readable) {
+			const uint64_t got = pread_all(fd, staging.data(), std::min<uint64_t>(staging.size(), readable - *bytes_read), file_offset + *bytes_read, chunk, nullptr);
+			if (got == 0) break;
+			std::memcpy(dest + *bytes_read, staging.data(), static_cast<size_t>(got));
+			*bytes_read += got;
+			if (staged_bytes != nullptr) *staged_bytes += got;
+		}
+	}
+	::close(fd);
+	return 0;
+}
+
+} // namespace bc5::apr_posix
+
+#endif // __linux__
diff --git a/src/bc5/load_stat.hpp b/src/bc5/load_stat.hpp
new file mode 100644
index 0000000..7e76a70
--- /dev/null
+++ b/src/bc5/load_stat.hpp
@@ -0,0 +1,354 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Experiment 0415 (tag ls415): where a load's wall-clock time goes. One counter table shared by every unit, three
+// knobs that change a latency so that its place on a load's critical path can be measured, and three candidate fixes.
+// Everything is off by default; unset, empty and "0" are off (bc5::env_on's reading, F767); each word is read once.
+//   KYTY_BC5_LOAD_STAT=<file>     the counters: per cause a count, the summed time, the longest single time of the last
+//                                 second and a byte or item count; one line per second with CLOCK_MONOTONIC and the
+//                                 journal's time of the last flip; "mark" lines for single events. No change of behaviour.
+//   KYTY_BC5_RING_POLL_US=<n>     the doorbell poll's sleep after a pass (200 today; the long-idle sleep stays 5 times it).
+//   KYTY_BC5_LOAD_DELAY=<cause>:<us>   a busy delay added to each event of one cause (the names of kNames). Measurement only.
+//   KYTY_BC5_RING_SPIN_US=<n>     fix candidate: after a pass that served packets, look at the doorbells again without
+//                                 sleeping for n microseconds (cpu_relax between looks).
+//   KYTY_BC5_TIMERSLACK_NS=<n>    fix candidate: PR_SET_TIMERSLACK at process start (threads inherit it): the host's
+//                                 20-50 us sleep polls stop overshooting by the default 50 us.
+//   KYTY_BC5_MUTEX_SPIN_US=<n>    fix candidate: a guest mutex that is held is tried again for n microseconds before the
+//                                 thread sleeps on its condition variable. Lock order and ownership rules unchanged.
+#pragma once
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <ctime>
+#include <mutex>
+#include <thread>
+
+#if defined(__x86_64__) || defined(__i386__)
+#include <immintrin.h>
+#endif
+#if defined(__linux__)
+#include <pthread.h>
+#include <sys/prctl.h>
+#endif
+
+namespace bc5::load_stat {
+
+enum Cause : unsigned {
+	kFlip,           // n = flips
+	kRingPass,       // n = doorbell passes that served packets, items = packets
+	kRingAfterSleep, // n = of those, passes that found work right after a sleep (the work waited for the poll)
+	kDrain,          // the flip's drain: n, time
+	kInflightCap,    // the wait for fewer than 24 jobs in flight
+	kLabelWait,      // CPU-served label waits (all sites)
+	kWaitJobs,       // wait_jobs(): the GPU drained before mappings change
+	kDevLockWait,    // g_dev_mutex in submit_now: time waited
+	kDevLockHold,    // ... and held
+	kImport,         // import_memfd: n, time, items = bytes
+	kDirectSync,     // direct_sync (whole)
+	kAnonSync,       // sync_mappings (whole, it holds direct_sync)
+	kLearned,        // learned_apply
+	kAprBuffer,      // an APR/AMM command buffer from submit to complete: n, time
+	kAprQueueWait,   // ... from submit to the worker taking it
+	kAprRead,        // one file read into the guest: n, time, items = bytes
+	kAprBusy,        // wall-clock time with at least one command buffer outstanding (n = idle->busy edges)
+	kAmmCmd,         // AMM map/unmap/remap commands: n, time
+	kMemLockWait,    // g_memory_operation_mutex: contended acquisitions and their wait
+	kCommitZero,     // Commit's zeroing of recommitted private memory: n, time, items = bytes
+	kMutexLock,      // guest mutex locks: n
+	kMutexContended, // ... that found the mutex held: n, time until owned
+	kMutexSpinWon,   // ... taken inside the spin window (KYTY_BC5_MUTEX_SPIN_US)
+	kCondSignal,     // guest condition signals and broadcasts: n, items = waiters present
+	kCondWait,       // guest condition waits: n, time
+	kSemaSignal,     // semaphore signals: n, items = waiters present
+	kSemaWait,       // semaphore waits that blocked: n, time
+	kFileOpen,       // sceKernelOpen: n, time
+	kFileStat,       // sceKernelStat/Fstat: n, time
+	kFileRead,       // sceKernelRead/Pread: n, time, items = bytes
+	kHttpSend,       // HttpFetchSync: n, time
+	// tag ls415c: the device mutex's hold in submit_now by part, direct_sync by part, and the APR fallback
+	kAprFallback,    // KYTY_BC5_APR_POSIX=direct: reads whose destination the kernel refused; items = bytes that went through the staging copy
+	kHoldProbe,      // submit_now: from the lock to the anonymous sync (the probe)
+	kHoldHints,      // submit_now: after the learned windows, to the end of the hints
+	kHoldPre,        // submit_now: from the hints to the device call (aliases, the buffer's survey, split, options)
+	kDevCall,        // submit_now: the device call as a whole (the first one of a submission)
+	kDevPrepare,     // ... its prepare (filter, state tracker), as the device reports it
+	kDevList,        // ... its BO list
+	kDevCs,          // ... its CS ioctl
+	kDsViews,        // direct_sync_one: the views
+	kDsScan,         // direct_sync_one: the scan for chunks to import and the imports
+	kDsMerge,        // direct_sync_one: merges and the lazy release
+	kDsDrain,        // direct_sync_one: the GPU drained before mappings change
+	kDsMaps,         // direct_sync_one: the mappings (want, drop, add)
+	// tag ls415d
+	kFastDiff,       // a "verify" mode of bc5/sync_fast.hpp found the fast form differing from the old one (the old one's result is used)
+	kLearnedApply,   // learned_apply past its "same layout" return: n, time
+	kLearnedChanged, // ... windows that mapped something: n, items = bytes
+	// tag mr415 (stage S1 of DESIGN-lock-side.md)
+	kMapRecord,      // comparisons of the view list kept from records with the rebuilt one: n, items = records applied
+	kRecMismatch,    // ... that differed (the rebuilt list is used; the kept one is reset to it)
+	kRecOverflow,    // ... not made because the record log was full
+	kMapsCheck,      // tag mr415b: checks of /proc/self/maps against the range table: n, items = uncovered bytes, summed over checks
+	kMapsUncovered,  // ... checks that found a readable guest-span VMA (or part of one) with no range in the table: n, items = such spans
+	kCount
+};
+
+inline constexpr const char* kNames[kCount] = {
+    "flip",     "ring_pass",  "ring_after_sleep", "drain",    "inflight_cap", "label_wait",  "wait_jobs",       "dev_wait",
+    "dev_hold", "import",     "direct_sync",      "anon_sync", "learned",     "apr_buffer",  "apr_queue_wait",  "apr_read",
+    "apr_busy", "amm_cmd",    "mem_lock_wait",    "commit_zero", "mutex_lock", "mutex_contended", "mutex_spin_won", "cond_signal",
+    "cond_wait", "sema_signal", "sema_wait",      "file_open", "file_stat",   "file_read",   "http_send",
+    "apr_fallback", "hold_probe", "hold_hints",   "hold_pre",  "dev_call",    "dev_prepare", "dev_list",        "dev_cs",
+    "ds_views", "ds_scan",    "ds_merge",         "ds_drain",  "ds_maps",     "fast_diff",   "learned_apply",   "learned_changed",
+    "map_record", "rec_mismatch", "rec_overflow",    "maps_check", "maps_uncovered"};
+
+static_assert(kNames[kCount - 1] != nullptr, "a name per cause");
+
+struct Slot {
+	std::atomic<uint64_t> n {0}, ns {0}, max_ns {0}, items {0};
+};
+
+struct State {
+	Slot                  slot[kCount];
+	std::atomic<uint64_t> journal_t_us {0}; // the journal's clock at the last flip, microseconds
+	std::atomic<int>      apr_outstanding {0};
+	std::atomic<uint64_t> apr_busy_since {0};
+	std::mutex            file_mutex;
+	FILE*                 file = nullptr;
+};
+
+inline State& state() {
+	static State s;
+	return s;
+}
+
+// CLOCK_MONOTONIC on Linux (libstdc++'s steady_clock; test0415.cpp checks that on the box), so the lines join perf's
+// "-k CLOCK_MONOTONIC" samples.
+inline uint64_t now_ns() {
+	return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count());
+}
+
+inline bool env_set(const char* e) {
+	return e != nullptr && e[0] != 0 && !(e[0] == '0' && e[1] == 0);
+}
+
+// A non-negative number of at most `cap`, or `dflt` when the word is unset, empty, not a number or over the cap.
+inline uint64_t env_num(const char* name, uint64_t dflt, uint64_t cap) {
+	const char* e = std::getenv(name);
+	if (e == nullptr || e[0] == 0) return dflt;
+	char*                    end = nullptr;
+	const unsigned long long v   = std::strtoull(e, &end, 10);
+	if (end == e || *end != 0 || v > cap) return dflt;
+	return v;
+}
+
+inline void cpu_relax() {
+#if defined(__x86_64__) || defined(__i386__)
+	_mm_pause();
+#endif
+}
+
+inline void write_line_locked(State& s, const char* line) {
+	if (s.file == nullptr) return;
+	std::fputs(line, s.file);
+	std::fflush(s.file);
+}
+
+inline void writer_thread() {
+#if defined(__linux__)
+	pthread_setname_np(pthread_self(), "bc5-loadstat");
+#endif
+	State& s = state();
+	char   buf[12288];
+	for (;;) {
+		std::this_thread::sleep_for(std::chrono::seconds(1));
+		int o = std::snprintf(buf, sizeof(buf), "s mono_ns=%llu jt_us=%llu apr_out=%d", static_cast<unsigned long long>(now_ns()),
+		                      static_cast<unsigned long long>(s.journal_t_us.load(std::memory_order_relaxed)), s.apr_outstanding.load(std::memory_order_relaxed));
+		for (unsigned c = 0; c < kCount && o > 0 && static_cast<size_t>(o) < sizeof(buf) - 160; c++) {
+			Slot&          x  = s.slot[c];
+			const uint64_t mx = x.max_ns.exchange(0, std::memory_order_relaxed);
+			o += std::snprintf(buf + o, sizeof(buf) - static_cast<size_t>(o), " %s=%llu,%llu,%llu,%llu", kNames[c], static_cast<unsigned long long>(x.n.load(std::memory_order_relaxed)),
+			                   static_cast<unsigned long long>(x.ns.load(std::memory_order_relaxed)), static_cast<unsigned long long>(mx),
+			                   static_cast<unsigned long long>(x.items.load(std::memory_order_relaxed)));
+		}
+		if (o > 0 && static_cast<size_t>(o) < sizeof(buf) - 2) {
+			buf[o]     = '\n';
+			buf[o + 1] = 0;
+		}
+		std::lock_guard lk(s.file_mutex);
+		write_line_locked(s, buf);
+	}
+}
+
+inline bool init_on() {
+	const char* p = std::getenv("KYTY_BC5_LOAD_STAT");
+	if (!env_set(p)) return false;
+	State& s = state();
+	s.file   = std::fopen(p, "a");
+	if (s.file == nullptr) return false;
+	{
+		char line[512];
+		std::snprintf(line, sizeof(line), "# exp 0415 load stat (tag ls415): s lines are cumulative name=n,ns,max_ns_of_the_second,items; mono_ns %llu\n",
+		              static_cast<unsigned long long>(now_ns()));
+		std::lock_guard lk(s.file_mutex);
+		write_line_locked(s, line);
+	}
+	std::thread(writer_thread).detach();
+	return true;
+}
+
+inline bool on() {
+	static const bool v = init_on();
+	return v;
+}
+
+// The busy delay of KYTY_BC5_LOAD_DELAY=<cause>:<us> for cause c, 0 when none. At most 100,000 us.
+inline uint64_t delay_ns_of(unsigned c) {
+	static const struct D {
+		unsigned c  = kCount;
+		uint64_t ns = 0;
+		D() {
+			const char* e = std::getenv("KYTY_BC5_LOAD_DELAY");
+			if (!env_set(e)) return;
+			const char* colon = std::strchr(e, ':');
+			if (colon == nullptr) return;
+			char*                    end = nullptr;
+			const unsigned long long us  = std::strtoull(colon + 1, &end, 10);
+			if (end == colon + 1 || *end != 0 || us == 0 || us > 100'000ull) return;
+			const size_t len = static_cast<size_t>(colon - e);
+			for (unsigned k = 0; k < kCount; k++) {
+				if (std::strlen(kNames[k]) == len && std::strncmp(kNames[k], e, len) == 0) {
+					c  = k;
+					ns = us * 1000ull;
+				}
+			}
+		}
+	} d;
+	return d.c == c ? d.ns : 0;
+}
+
+inline void delay(unsigned c) {
+	const uint64_t ns = delay_ns_of(c);
+	if (ns == 0) return;
+	const uint64_t t0 = now_ns();
+	while (now_ns() - t0 < ns) cpu_relax();
+}
+
+inline void add(unsigned c, uint64_t ns, uint64_t items = 0, uint64_t n = 1) {
+	Slot& x = state().slot[c];
+	x.n.fetch_add(n, std::memory_order_relaxed);
+	if (ns != 0) {
+		x.ns.fetch_add(ns, std::memory_order_relaxed);
+		uint64_t m = x.max_ns.load(std::memory_order_relaxed);
+		while (ns > m && !x.max_ns.compare_exchange_weak(m, ns, std::memory_order_relaxed)) {}
+	}
+	if (items != 0) x.items.fetch_add(items, std::memory_order_relaxed);
+}
+
+// Start of a timed stretch: 0 when the counters are off (then end() does nothing).
+inline uint64_t begin() {
+	return on() ? now_ns() : 0;
+}
+
+inline void end(unsigned c, uint64_t t0, uint64_t items = 0) {
+	if (t0 != 0) add(c, now_ns() - t0, items);
+}
+
+struct Scope {
+	unsigned c;
+	uint64_t t0;
+	uint64_t items = 0;
+	explicit Scope(unsigned cause): c(cause), t0(begin()) {}
+	~Scope() { end(c, t0, items); }
+	Scope(const Scope&)            = delete;
+	Scope& operator=(const Scope&) = delete;
+};
+
+inline void count(unsigned c, uint64_t items = 0) {
+	if (on()) add(c, 0, items);
+}
+
+inline void flip(double journal_t_s) {
+	if (!on()) return;
+	state().journal_t_us.store(journal_t_s > 0 ? static_cast<uint64_t>(journal_t_s * 1e6) : 0, std::memory_order_relaxed);
+	add(kFlip, 0);
+}
+
+// One line for a single event ("mark <mono_ns> <jt_us> <text>").
+inline void mark(const char* text) {
+	if (!on()) return;
+	State& s = state();
+	char   line[320];
+	std::snprintf(line, sizeof(line), "mark mono_ns=%llu jt_us=%llu %.200s\n", static_cast<unsigned long long>(now_ns()),
+	              static_cast<unsigned long long>(s.journal_t_us.load(std::memory_order_relaxed)), text);
+	std::lock_guard lk(s.file_mutex);
+	write_line_locked(s, line);
+}
+
+// Command buffers outstanding: the wall-clock time with at least one is kAprBusy.
+inline void apr_enter() {
+	if (!on()) return;
+	State& s = state();
+	if (s.apr_outstanding.fetch_add(1, std::memory_order_acq_rel) == 0) s.apr_busy_since.store(now_ns(), std::memory_order_release);
+}
+
+inline void apr_leave() {
+	if (!on()) return;
+	State& s = state();
+	if (s.apr_outstanding.fetch_sub(1, std::memory_order_acq_rel) == 1) {
+		const uint64_t t0 = s.apr_busy_since.load(std::memory_order_acquire);
+		const uint64_t t1 = now_ns();
+		if (t0 != 0 && t1 >= t0) add(kAprBusy, t1 - t0); // a stretch shorter than the clock's step still counts as one
+	}
+}
+
+// A lock that counts the wait of a contended acquisition (and nothing else). Off: a plain lock().
+template <class M>
+inline void lock_counted(M& m, unsigned wait_cause) {
+	if (!on()) {
+		m.lock();
+		return;
+	}
+	if (m.try_lock()) return;
+	const uint64_t t0 = now_ns();
+	m.lock();
+	add(wait_cause, now_ns() - t0);
+}
+
+template <class M>
+struct CountedLock {
+	M& m;
+	CountedLock(M& mu, unsigned wait_cause): m(mu) { lock_counted(m, wait_cause); }
+	~CountedLock() { m.unlock(); }
+	CountedLock(const CountedLock&)            = delete;
+	CountedLock& operator=(const CountedLock&) = delete;
+};
+
+inline uint64_t ring_poll_us() {
+	static const uint64_t v = [] {
+		const uint64_t x = env_num("KYTY_BC5_RING_POLL_US", 200, 20'000);
+		return x == 0 ? uint64_t {200} : x;
+	}();
+	return v;
+}
+
+inline uint64_t ring_spin_ns() {
+	static const uint64_t v = env_num("KYTY_BC5_RING_SPIN_US", 0, 5'000) * 1000ull;
+	return v;
+}
+
+inline uint64_t mutex_spin_ns() {
+	static const uint64_t v = env_num("KYTY_BC5_MUTEX_SPIN_US", 0, 1'000) * 1000ull;
+	return v;
+}
+
+// At process start, before any thread exists: the timer slack every later thread inherits.
+inline void apply_timer_slack() {
+#if defined(__linux__)
+	const uint64_t ns = env_num("KYTY_BC5_TIMERSLACK_NS", 0, 50'000);
+	if (ns != 0) prctl(PR_SET_TIMERSLACK, static_cast<unsigned long>(ns), 0, 0, 0);
+#endif
+}
+
+} // namespace bc5::load_stat
diff --git a/src/bc5/map_records.hpp b/src/bc5/map_records.hpp
new file mode 100644
index 0000000..847ac04
--- /dev/null
+++ b/src/bc5/map_records.hpp
@@ -0,0 +1,63 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Experiment 0415 (tag mr415), stage S1 of experiments/0415-load-times-fps/DESIGN-lock-side.md: the guest's ranges
+// leave a record of every change (the span [start, start + size) a mutator of the range table was called with), and a
+// list derived from the ranges is brought up to date from those spans instead of being rebuilt from every range.
+// KYTY_BC5_MAP_RECORDS=verify (the only mode in S1; default off): the direct path keeps such a list of its views
+// beside the rebuilt one and compares the two at every rebuild; the rebuilt list is what is used.
+//
+// Why a span is enough [C, kernel/memory.cpp VirtualRanges]: each mutator changes ranges inside its span and merges or
+// splits only ranges that overlap or touch it. So after a change, every entry that differs from before lies inside the
+// extent of the current ranges that overlap or touch the span: those ranges are read again and replace whatever the
+// list held there. Reading the CURRENT ranges for an OLD span is right as well (the result is the current state of
+// that extent), so several spans can be applied in any order against one snapshot.
+// Pure functions; CPU test experiments/0415-load-times-fps/kit/test0415rec.cpp.
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <utility>
+#include <vector>
+
+namespace bc5::map_records {
+
+inline uint64_t end_of(uint64_t start, uint64_t size) {
+	return size > UINT64_MAX - start ? UINT64_MAX : start + size;
+}
+
+// `ranges` sorted by start, not overlapping (R has .start and .size). The index range [first, last) of the ranges
+// that overlap [lo, hi) or touch it (end == lo, or start == hi).
+template <class R>
+inline std::pair<size_t, size_t> touching(const std::vector<R>& ranges, uint64_t lo, uint64_t hi) {
+	// ends are in order too, since the ranges do not overlap
+	const auto first = std::lower_bound(ranges.begin(), ranges.end(), lo, [](const R& r, uint64_t x) { return end_of(r.start, r.size) < x; });
+	const auto last  = std::upper_bound(ranges.begin(), ranges.end(), hi, [](uint64_t x, const R& r) { return x < r.start; });
+	const auto a     = static_cast<size_t>(first - ranges.begin());
+	const auto b     = static_cast<size_t>(last - ranges.begin());
+	return {a, b < a ? a : b};
+}
+
+// `views` sorted by va, not overlapping (V has .va and .size), derived from the ranges by `make` (bool make(const R&,
+// V*): false when the range is not a view). Brings `views` up to date for a change inside [lo, hi).
+template <class V, class R, class Make>
+inline void apply(std::vector<V>& views, const std::vector<R>& ranges, uint64_t lo, uint64_t hi, Make&& make) {
+	const auto [a, b] = touching(ranges, lo, hi);
+	uint64_t   slo = lo, shi = hi;
+	if (a < b) {
+		slo = std::min(slo, ranges[a].start);
+		shi = std::max(shi, end_of(ranges[b - 1].start, ranges[b - 1].size));
+	}
+	// the views that overlap [slo, shi), and the ones of zero extent inside it, go
+	auto from = std::lower_bound(views.begin(), views.end(), slo, [](const V& v, uint64_t x) { return end_of(v.va, v.size) <= x; });
+	auto to   = from;
+	while (to != views.end() && to->va < shi) ++to;
+	const auto at = static_cast<size_t>(from - views.begin());
+	views.erase(from, to);
+	std::vector<V> fresh;
+	for (size_t i = a; i < b; i++) {
+		V v {};
+		if (make(ranges[i], &v)) fresh.push_back(std::move(v));
+	}
+	views.insert(views.begin() + static_cast<std::ptrdiff_t>(at), std::make_move_iterator(fresh.begin()), std::make_move_iterator(fresh.end()));
+}
+
+} // namespace bc5::map_records
