+// SPDX-License-Identifier: GPL-2.0-only
+// Experiment 0415 (tag ls415d): three pieces of the mapping maintenance that runs under the device mutex, each with
+// its old form and a faster form that gives the same result, as pure functions (CPU test:
+// experiments/0415-load-times-fps/kit/test0415sync.cpp, old against new on random and adversarial inputs).
+// Each has a switch, default off; "verify" runs both forms and counts differences.
+//   KYTY_BC5_WINDOW_FAST   a window's uncovered pieces: mappings that do not touch the window are passed over without
+//                          rebuilding the piece list (the old loop rebuilt it once per mapping: 21,300 mappings x 81
+//                          windows per application, 4.8 s a run).
+//                          A STOPGAP: the learned windows themselves are being replaced by a rule (exp 0412).
+//   KYTY_BC5_VMA_FAST      "is [a, b) inside one VMA of this kind": a binary search in the VMA list when that list is
+//                          sorted and its entries do not overlap (checked each time; else the old walk).
+//   KYTY_BC5_NAMES_FAST    the lazy / eager classification of a range's name, remembered per name.
+// None changes what is mapped: same pieces, same answer, same class. What each could leave stale if it were wrong is
+// stated at its use in bc5LleAgc.cpp.
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+
+namespace bc5::sync_fast {
+
+using Piece = std::pair<uint64_t, uint64_t>; // [first, second)
+
+// 0 off, 1 on, 2 verify (both forms, differences counted). Unset, empty and "0" are off.
+inline int mode_of(const char* e) {
+	if (e == nullptr || e[0] == 0 || (e[0] == '0' && e[1] == 0)) return 0;
+	return std::strcmp(e, "verify") == 0 ? 2 : 1;
+}
+
+// ---- a window's pieces minus the mappings -----------------------------------------------------------------------
+// M needs .va and .size. The old form, as map_window had it: every mapping rebuilds the list.
+template <class M>
+inline void subtract_old(std::vector<Piece>& pieces, const std::vector<M>& have) {
+	for (const auto& m: have) {
+		std::vector<Piece> next;
+		for (const auto& [pa, pb]: pieces) {
+			if (m.va + m.size <= pa || m.va >= pb) {
+				next.emplace_back(pa, pb);
+				continue;
+			}
+			if (m.va > pa) next.emplace_back(pa, m.va);
+			if (m.va + m.size < pb) next.emplace_back(m.va + m.size, pb);
+		}
+		pieces.swap(next);
+	}
+}
+
+// The new form. Every piece lies inside [lo, hi) (the caller clips the window to the VMAs first), so a mapping that
+// does not touch [lo, hi) touches no piece and the old loop copied the list unchanged for it: it is passed over.
+// No order of `have` is assumed.
+template <class M>
+inline void subtract_fast(std::vector<Piece>& pieces, const std::vector<M>& have, uint64_t lo, uint64_t hi) {
+	std::vector<Piece> next;
+	for (const auto& m: have) {
+		if (m.va + m.size <= lo || m.va >= hi) continue;
+		next.clear();
+		for (const auto& [pa, pb]: pieces) {
+			if (m.va + m.size <= pa || m.va >= pb) {
+				next.emplace_back(pa, pb);
+				continue;
+			}
+			if (m.va > pa) next.emplace_back(pa, m.va);
+			if (m.va + m.size < pb) next.emplace_back(m.va + m.size, pb);
+		}
+		pieces.swap(next);
+	}
+}
+
+// ---- [a, b) inside one VMA of the kind ---------------------------------------------------------------------------
+// V needs .start, .end, .readonly. The old form, as sync_mappings had it.
+template <class V>
+inline bool inside_old(const std::vector<V>& vmas, uint64_t a, uint64_t b, bool readonly) {
+	for (const auto& v: vmas) {
+		if (a >= v.start && b <= v.end && v.readonly == readonly) return true;
+	}
+	return false;
+}
+
+// True when the list is sorted by start and no entry reaches into the next one (what /proc/self/maps gives).
+template <class V>
+inline bool vmas_ordered(const std::vector<V>& vmas) {
+	for (size_t i = 0; i < vmas.size(); i++) {
+		if (vmas[i].end < vmas[i].start) return false;
+		if (i > 0 && vmas[i].start < vmas[i - 1].end) return false;
+	}
+	return true;
+}
+
+// The new form, for a list vmas_ordered() accepted. The entries that can hold `a` are the ones with start <= a; in an
+// ordered list their ends do not pass the next start, so only the last of them (and, for an empty [a, a) on a
+// boundary, the ones that end exactly at a before it) can satisfy a >= start && b <= end. The walk goes back from the
+// last entry with start <= a while an entry still ends at or after a.
+template <class V>
+inline bool inside_fast(const std::vector<V>& vmas, uint64_t a, uint64_t b, bool readonly) {
+	if (b < a) return inside_old(vmas, a, b, readonly); // not a range: the argument below needs a <= b
+	auto it = std::upper_bound(vmas.begin(), vmas.end(), a, [](uint64_t x, const V& v) { return x < v.start; });
+	while (it != vmas.begin()) {
+		--it;
+		if (it->end < a) break; // every earlier entry ends at or before this one's start, so before a as well
+		if (b <= it->end && it->readonly == readonly) return true;
+	}
+	return false;
+}
+
+// ---- the class of a range's name ---------------------------------------------------------------------------------
+// Remembers what `classify` (the old function) said for a name. One instance per classification, used under the
+// caller's lock (direct_views builds under its own mutex). A null name is not remembered: the old function is asked.
+class NameMemo {
+public:
+	template <class F>
+	bool get(const char* name, F&& classify) {
+		if (name == nullptr) return classify(name);
+		auto it = m_seen.find(name);
+		if (it != m_seen.end()) return it->second;
+		const bool v = classify(name);
+		if (m_seen.size() < 4096) m_seen.emplace(name, v);
+		return v;
+	}
+
+private:
+	std::unordered_map<std::string, bool> m_seen;
+};
+
+} // namespace bc5::sync_fast
