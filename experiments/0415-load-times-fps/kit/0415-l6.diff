+	const ff412::Fail* kept[ff412::kRing];
+	unsigned           n = 0;
+	uint64_t           all = 0;
+	{
+		std::scoped_lock lk(g_ff412_mutex);
+		n   = g_ff412_ring.list(kept);
+		all = g_ff412_ring.count;
+		char who[64];
+		ff412_thread(who, sizeof(who));
