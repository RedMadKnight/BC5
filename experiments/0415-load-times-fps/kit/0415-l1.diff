new file mode 100644
index 0000000..f14377f
--- /dev/null
+++ b/src/bc5/load_stat.hpp
@@ -0,0 +1,327 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Experiment 0415 (tag ls415): where a load's wall-clock time goes. One counter table shared by every unit, three
+// knobs that change a latency so that its place on a load's critical path can be measured, and three candidate fixes.
+// Everything is off by default; unset, empty and "0" are off (bc5::env_on's reading, F767); each word is read once.
+//   KYTY_BC5_LOAD_STAT=<file>     the counters: per cause a count, the summed time, the longest single time of the last
+//                                 second and a byte or item count; one line per second with CLOCK_MONOTONIC and the
+//                                 journal's time of the last flip; "mark" lines for single events. No change of behaviour.
+//   KYTY_BC5_RING_POLL_US=<n>     the doorbell poll's sleep after a pass (200 today; the long-idle sleep stays 5 times it).
+//   KYTY_BC5_LOAD_DELAY=<cause>:<us>   a busy delay added to each event of one cause (the names of kNames). Measurement only.
+//   KYTY_BC5_RING_SPIN_US=<n>     fix candidate: after a pass that served packets, look at the doorbells again without
+//                                 sleeping for n microseconds (cpu_relax between looks).
+//   KYTY_BC5_TIMERSLACK_NS=<n>    fix candidate: PR_SET_TIMERSLACK at process start (threads inherit it): the host's
+//                                 20-50 us sleep polls stop overshooting by the default 50 us.
+//   KYTY_BC5_MUTEX_SPIN_US=<n>    fix candidate: a guest mutex that is held is tried again for n microseconds before the
+//                                 thread sleeps on its condition variable. Lock order and ownership rules unchanged.
+#pragma once
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <ctime>
+#include <mutex>
+#include <thread>
+
+#if defined(__x86_64__) || defined(__i386__)
+#include <immintrin.h>
+#endif
+#if defined(__linux__)
+#include <pthread.h>
+#include <sys/prctl.h>
+#endif
+
+namespace bc5::load_stat {
+
+enum Cause : unsigned {
+	kFlip,           // n = flips
+	kRingPass,       // n = doorbell passes that served packets, items = packets
+	kRingAfterSleep, // n = of those, passes that found work right after a sleep (the work waited for the poll)
+	kDrain,          // the flip's drain: n, time
+	kInflightCap,    // the wait for fewer than 24 jobs in flight
+	kLabelWait,      // CPU-served label waits (all sites)
+	kWaitJobs,       // wait_jobs(): the GPU drained before mappings change
+	kDevLockWait,    // g_dev_mutex in submit_now: time waited
+	kDevLockHold,    // ... and held
+	kImport,         // import_memfd: n, time, items = bytes
+	kDirectSync,     // direct_sync (whole)
+	kAnonSync,       // sync_mappings (whole, it holds direct_sync)
+	kLearned,        // learned_apply
+	kAprBuffer,      // an APR/AMM command buffer from submit to complete: n, time
+	kAprQueueWait,   // ... from submit to the worker taking it
+	kAprRead,        // one file read into the guest: n, time, items = bytes
+	kAprBusy,        // wall-clock time with at least one command buffer outstanding (n = idle->busy edges)
+	kAmmCmd,         // AMM map/unmap/remap commands: n, time
+	kMemLockWait,    // g_memory_operation_mutex: contended acquisitions and their wait
+	kCommitZero,     // Commit's zeroing of recommitted private memory: n, time, items = bytes
+	kMutexLock,      // guest mutex locks: n
+	kMutexContended, // ... that found the mutex held: n, time until owned
+	kMutexSpinWon,   // ... taken inside the spin window (KYTY_BC5_MUTEX_SPIN_US)
+	kCondSignal,     // guest condition signals and broadcasts: n, items = waiters present
+	kCondWait,       // guest condition waits: n, time
+	kSemaSignal,     // semaphore signals: n, items = waiters present
+	kSemaWait,       // semaphore waits that blocked: n, time
+	kFileOpen,       // sceKernelOpen: n, time
+	kFileStat,       // sceKernelStat/Fstat: n, time
+	kFileRead,       // sceKernelRead/Pread: n, time, items = bytes
+	kHttpSend,       // HttpFetchSync: n, time
+	kCount
+};
+
+inline constexpr const char* kNames[kCount] = {
+    "flip",     "ring_pass",  "ring_after_sleep", "drain",    "inflight_cap", "label_wait",  "wait_jobs",       "dev_wait",
+    "dev_hold", "import",     "direct_sync",      "anon_sync", "learned",     "apr_buffer",  "apr_queue_wait",  "apr_read",
+    "apr_busy", "amm_cmd",    "mem_lock_wait",    "commit_zero", "mutex_lock", "mutex_contended", "mutex_spin_won", "cond_signal",
+    "cond_wait", "sema_signal", "sema_wait",      "file_open", "file_stat",   "file_read",   "http_send"};
+
+static_assert(kNames[kCount - 1] != nullptr, "a name per cause");
+
+struct Slot {
+	std::atomic<uint64_t> n {0}, ns {0}, max_ns {0}, items {0};
+};
+
+struct State {
+	Slot                  slot[kCount];
+	std::atomic<uint64_t> journal_t_us {0}; // the journal's clock at the last flip, microseconds
+	std::atomic<int>      apr_outstanding {0};
+	std::atomic<uint64_t> apr_busy_since {0};
+	std::mutex            file_mutex;
+	FILE*                 file = nullptr;
+};
+
+inline State& state() {
+	static State s;
+	return s;
+}
+
+// CLOCK_MONOTONIC on Linux (libstdc++'s steady_clock; test0415.cpp checks that on the box), so the lines join perf's
+// "-k CLOCK_MONOTONIC" samples.
+inline uint64_t now_ns() {
+	return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count());
+}
+
+inline bool env_set(const char* e) {
+	return e != nullptr && e[0] != 0 && !(e[0] == '0' && e[1] == 0);
+}
+
+// A non-negative number of at most `cap`, or `dflt` when the word is unset, empty, not a number or over the cap.
+inline uint64_t env_num(const char* name, uint64_t dflt, uint64_t cap) {
+	const char* e = std::getenv(name);
+	if (e == nullptr || e[0] == 0) return dflt;
+	char*                    end = nullptr;
+	const unsigned long long v   = std::strtoull(e, &end, 10);
+	if (end == e || *end != 0 || v > cap) return dflt;
+	return v;
+}
+
+inline void cpu_relax() {
+#if defined(__x86_64__) || defined(__i386__)
+	_mm_pause();
+#endif
+}
+
+inline void write_line_locked(State& s, const char* line) {
+	if (s.file == nullptr) return;
+	std::fputs(line, s.file);
+	std::fflush(s.file);
+}
+
+inline void writer_thread() {
+#if defined(__linux__)
+	pthread_setname_np(pthread_self(), "bc5-loadstat");
+#endif
+	State& s = state();
+	char   buf[8192];
+	for (;;) {
+		std::this_thread::sleep_for(std::chrono::seconds(1));
+		int o = std::snprintf(buf, sizeof(buf), "s mono_ns=%llu jt_us=%llu apr_out=%d", static_cast<unsigned long long>(now_ns()),
+		                      static_cast<unsigned long long>(s.journal_t_us.load(std::memory_order_relaxed)), s.apr_outstanding.load(std::memory_order_relaxed));
+		for (unsigned c = 0; c < kCount && o > 0 && static_cast<size_t>(o) < sizeof(buf) - 160; c++) {
+			Slot&          x  = s.slot[c];
+			const uint64_t mx = x.max_ns.exchange(0, std::memory_order_relaxed);
+			o += std::snprintf(buf + o, sizeof(buf) - static_cast<size_t>(o), " %s=%llu,%llu,%llu,%llu", kNames[c], static_cast<unsigned long long>(x.n.load(std::memory_order_relaxed)),
+			                   static_cast<unsigned long long>(x.ns.load(std::memory_order_relaxed)), static_cast<unsigned long long>(mx),
+			                   static_cast<unsigned long long>(x.items.load(std::memory_order_relaxed)));
+		}
+		if (o > 0 && static_cast<size_t>(o) < sizeof(buf) - 2) {
+			buf[o]     = '\n';
+			buf[o + 1] = 0;
+		}
+		std::lock_guard lk(s.file_mutex);
+		write_line_locked(s, buf);
+	}
+}
+
+inline bool init_on() {
+	const char* p = std::getenv("KYTY_BC5_LOAD_STAT");
+	if (!env_set(p)) return false;
+	State& s = state();
+	s.file   = std::fopen(p, "a");
+	if (s.file == nullptr) return false;
+	{
+		char line[512];
+		std::snprintf(line, sizeof(line), "# exp 0415 load stat (tag ls415): s lines are cumulative name=n,ns,max_ns_of_the_second,items; mono_ns %llu\n",
+		              static_cast<unsigned long long>(now_ns()));
+		std::lock_guard lk(s.file_mutex);
+		write_line_locked(s, line);
+	}
+	std::thread(writer_thread).detach();
+	return true;
+}
+
+inline bool on() {
+	static const bool v = init_on();
+	return v;
+}
+
+// The busy delay of KYTY_BC5_LOAD_DELAY=<cause>:<us> for cause c, 0 when none. At most 100,000 us.
+inline uint64_t delay_ns_of(unsigned c) {
+	static const struct D {
+		unsigned c  = kCount;
+		uint64_t ns = 0;
+		D() {
+			const char* e = std::getenv("KYTY_BC5_LOAD_DELAY");
+			if (!env_set(e)) return;
+			const char* colon = std::strchr(e, ':');
+			if (colon == nullptr) return;
+			char*                    end = nullptr;
+			const unsigned long long us  = std::strtoull(colon + 1, &end, 10);
+			if (end == colon + 1 || *end != 0 || us == 0 || us > 100'000ull) return;
+			const size_t len = static_cast<size_t>(colon - e);
+			for (unsigned k = 0; k < kCount; k++) {
+				if (std::strlen(kNames[k]) == len && std::strncmp(kNames[k], e, len) == 0) {
+					c  = k;
+					ns = us * 1000ull;
+				}
+			}
+		}
+	} d;
+	return d.c == c ? d.ns : 0;
+}
+
+inline void delay(unsigned c) {
+	const uint64_t ns = delay_ns_of(c);
+	if (ns == 0) return;
+	const uint64_t t0 = now_ns();
+	while (now_ns() - t0 < ns) cpu_relax();
+}
+
+inline void add(unsigned c, uint64_t ns, uint64_t items = 0, uint64_t n = 1) {
+	Slot& x = state().slot[c];
+	x.n.fetch_add(n, std::memory_order_relaxed);
+	if (ns != 0) {
+		x.ns.fetch_add(ns, std::memory_order_relaxed);
+		uint64_t m = x.max_ns.load(std::memory_order_relaxed);
+		while (ns > m && !x.max_ns.compare_exchange_weak(m, ns, std::memory_order_relaxed)) {}
+	}
+	if (items != 0) x.items.fetch_add(items, std::memory_order_relaxed);
+}
+
+// Start of a timed stretch: 0 when the counters are off (then end() does nothing).
+inline uint64_t begin() {
+	return on() ? now_ns() : 0;
+}
+
+inline void end(unsigned c, uint64_t t0, uint64_t items = 0) {
+	if (t0 != 0) add(c, now_ns() - t0, items);
+}
+
+struct Scope {
+	unsigned c;
+	uint64_t t0;
+	uint64_t items = 0;
+	explicit Scope(unsigned cause): c(cause), t0(begin()) {}
+	~Scope() { end(c, t0, items); }
+	Scope(const Scope&)            = delete;
+	Scope& operator=(const Scope&) = delete;
+};
+
+inline void count(unsigned c, uint64_t items = 0) {
+	if (on()) add(c, 0, items);
+}
+
+inline void flip(double journal_t_s) {
+	if (!on()) return;
+	state().journal_t_us.store(journal_t_s > 0 ? static_cast<uint64_t>(journal_t_s * 1e6) : 0, std::memory_order_relaxed);
+	add(kFlip, 0);
+}
+
+// One line for a single event ("mark <mono_ns> <jt_us> <text>").
+inline void mark(const char* text) {
+	if (!on()) return;
+	State& s = state();
+	char   line[320];
+	std::snprintf(line, sizeof(line), "mark mono_ns=%llu jt_us=%llu %.200s\n", static_cast<unsigned long long>(now_ns()),
+	              static_cast<unsigned long long>(s.journal_t_us.load(std::memory_order_relaxed)), text);
+	std::lock_guard lk(s.file_mutex);
+	write_line_locked(s, line);
+}
+
+// Command buffers outstanding: the wall-clock time with at least one is kAprBusy.
+inline void apr_enter() {
+	if (!on()) return;
+	State& s = state();
+	if (s.apr_outstanding.fetch_add(1, std::memory_order_acq_rel) == 0) s.apr_busy_since.store(now_ns(), std::memory_order_release);
+}
+
+inline void apr_leave() {
+	if (!on()) return;
+	State& s = state();
+	if (s.apr_outstanding.fetch_sub(1, std::memory_order_acq_rel) == 1) {
+		const uint64_t t0 = s.apr_busy_since.load(std::memory_order_acquire);
+		const uint64_t t1 = now_ns();
+		if (t0 != 0 && t1 > t0) add(kAprBusy, t1 - t0);
+	}
+}
+
+// A lock that counts the wait of a contended acquisition (and nothing else). Off: a plain lock().
+template <class M>
+inline void lock_counted(M& m, unsigned wait_cause) {
+	if (!on()) {
+		m.lock();
+		return;
+	}
+	if (m.try_lock()) return;
+	const uint64_t t0 = now_ns();
+	m.lock();
+	add(wait_cause, now_ns() - t0);
+}
+
+template <class M>
+struct CountedLock {
+	M& m;
+	CountedLock(M& mu, unsigned wait_cause): m(mu) { lock_counted(m, wait_cause); }
+	~CountedLock() { m.unlock(); }
+	CountedLock(const CountedLock&)            = delete;
+	CountedLock& operator=(const CountedLock&) = delete;
+};
+
+inline uint64_t ring_poll_us() {
+	static const uint64_t v = [] {
+		const uint64_t x = env_num("KYTY_BC5_RING_POLL_US", 200, 20'000);
+		return x == 0 ? uint64_t {200} : x;
+	}();
+	return v;
+}
+
+inline uint64_t ring_spin_ns() {
+	static const uint64_t v = env_num("KYTY_BC5_RING_SPIN_US", 0, 5'000) * 1000ull;
+	return v;
+}
+
+inline uint64_t mutex_spin_ns() {
+	static const uint64_t v = env_num("KYTY_BC5_MUTEX_SPIN_US", 0, 1'000) * 1000ull;
+	return v;
+}
+
+// At process start, before any thread exists: the timer slack every later thread inherits.
+inline void apply_timer_slack() {
+#if defined(__linux__)
+	const uint64_t ns = env_num("KYTY_BC5_TIMERSLACK_NS", 0, 50'000);
+	if (ns != 0) prctl(PR_SET_TIMERSLACK, static_cast<unsigned long>(ns), 0, 0, 0);
+#endif
+}
+
+} // namespace bc5::load_stat
