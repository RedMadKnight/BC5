+struct LeafSnap {
+	uint64_t st = 0, submit = 0;
+	double   t = 0;
+	uint32_t h78 = 0, h7c = 0, h6c = 0, h50 = 0, h54 = 0, ud8 = 0;
+	uint32_t rec1[3] = {};
